+# ==================== 配置 ====================
+BASE_IMAGE="relay_dds:3.4.0"           # 现有镜像
+NEW_IMAGE="relay_dds:$(date +%Y%m%d)"   # 新镜像标签
+LIB_SOURCE="./release/lib/"                        # 新的lib文件目录
+TEMP_DIR="docker_update_$$"               # 临时目录
+
+# 颜色输出
+RED='\033[0;31m'
+GREEN='\033[0;32m'
+YELLOW='\033[1;33m'
+NC='\033[0m'
+
+print_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
+print_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
+print_error() { echo -e "${RED}[ERROR]${NC} $1"; }
+
+# 清理
+cleanup() {
+    [ -d "$TEMP_DIR" ] && rm -rf "$TEMP_DIR"
+}
+trap cleanup EXIT
+
+# 检查lib文件
+if [ ! -d "$LIB_SOURCE" ] || [ -z "$(ls -A "$LIB_SOURCE" 2>/dev/null)" ]; then
+    print_error "lib目录为空或不存在: $LIB_SOURCE"
+    exit 1
+fi
+
+print_info "开始更新镜像 $BASE_IMAGE -> $NEW_IMAGE"
+
+# 创建临时目录
+mkdir -p "$TEMP_DIR/lib"
+
+# 创建新的Dockerfile（基于现有镜像）
+cat > "$TEMP_DIR/Dockerfile" << EOF
+FROM $BASE_IMAGE
+
+# 复制新的lib文件（会覆盖旧的）
+COPY release/lib/* /usr/local/lib/
+
+# 重新运行ldconfig更新动态链接库缓存
+# RUN ldconfig
+
+# 保持原有配置不变
+EOF
+
+# 复制新的lib文件
+print_info "复制新的lib文件..."
+cp -v "$LIB_SOURCE"/* "$TEMP_DIR/lib/" 2>/dev/null || cp -v "$LIB_SOURCE"/*.so* "$TEMP_DIR/lib/" 2>/dev/null
+
+# 显示将要更新的文件
+print_info "以下文件将被更新:"
+ls -la "$TEMP_DIR/lib/"
+
+# 构建新镜像
+print_info "构建新镜像: $NEW_IMAGE"
+
+# 检查原有镜像
+print_info "检查基础镜像: $BASE_IMAGE"
+if ! docker image inspect "$BASE_IMAGE" > /dev/null 2>&1; then
+    print_error "基础镜像不存在！脚本即将退出..."
+    exit 1
+fi
+
+cd "$TEMP_DIR"
+docker build -t "$NEW_IMAGE" .
+
+# 可选：也更新latest标签
+docker tag "$NEW_IMAGE" "relay_dds:latest"
+
+print_info "✅ 镜像更新完成"
+print_info "新镜像: $NEW_IMAGE"
+print_info "也更新了标签: relay_dds:latest"
+
+# 显示新旧镜像对比
+echo -e "\n新旧镜像对比:"
+docker images | grep -E "relay_dds.*(latest|$(date +%Y%m%d))"
+
+# 清理旧镜像提示
+print_warn "如果确认新镜像正常，可以删除旧镜像:"
+echo "  docker rmi $BASE_IMAGE"

