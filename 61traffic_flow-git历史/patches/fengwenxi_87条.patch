+# -*- coding: utf-8 -*-
+from PyQt6.QtWidgets import (
+    QMainWindow, QWidget, QFileDialog, QPushButton, QVBoxLayout
+)
+
+from draw_roi_page import DrawRoiPage
+from traffic_flow_entry_page import TrafficFlowEntryPage
+
+class MainPage(QMainWindow):
+    def __init__(self):
+        super().__init__()
+        self.setWindowTitle("FusionFlow")
+
+        central_widget = QWidget()
+        self.setCentralWidget(central_widget)
+
+        layout = QVBoxLayout()
+        central_widget.setLayout(layout)
+
+        self.load_dir_button = QPushButton("加载工作区目录")
+        self.feature1_button = QPushButton("像素坐标提取(🔥火速开发中，敬请期待🔥)")
+        self.feature2_button = QPushButton("像素坐标转84坐标投影(🔥火速开发中，敬请期待🔥)")
+        self.feature3_button = QPushButton("交通流量ROI绘制")
+
+        layout.addWidget(self.load_dir_button)
+        layout.addWidget(self.feature1_button)
+        layout.addWidget(self.feature2_button)
+        layout.addWidget(self.feature3_button)
+
+        self.feature1_button.setEnabled(False)
+        self.feature2_button.setEnabled(False)
+        self.feature3_button.setEnabled(False)
+
+        self.load_dir_button.clicked.connect(self.load_working_directory)
+        self.feature1_button.clicked.connect(self.open_feature1)
+        self.feature2_button.clicked.connect(self.open_feature1)
+        self.feature3_button.clicked.connect(self.open_feature2)
+
+        self.image_dir = None
+
+    def load_working_directory(self):
+        directory = QFileDialog.getExistingDirectory(self, "Select Working Directory")
+        if directory:
+            self.image_dir = directory
+            # self.feature1_button.setEnabled(True)
+            # self.feature2_button.setEnabled(True)
+            self.feature3_button.setEnabled(True)
+
+    def open_feature1(self):
+        if not self.image_dir:
+            return
+        self.hide()
+        self.main_window = DrawRoiPage(self.image_dir)
+        self.main_window.show()
+        self.main_window.destroyed.connect(self.show)
+
+    def open_feature2(self):
+        if not self.image_dir:
+            return
+        self.hide()
+        self.traffic_entry_window = TrafficFlowEntryPage(self.image_dir)
+        self.traffic_entry_window.main_page_ref = self
+        self.traffic_entry_window.show()
