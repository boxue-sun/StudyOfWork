diff --git a/src/traffic_flow/waste_time_cycle_store.cpp b/src/traffic_flow/waste_time_cycle_store.cpp
new file mode 100644
index 0000000..4cee896
--- /dev/null
+++ b/src/traffic_flow/waste_time_cycle_store.cpp
@@ -0,0 +1,61 @@
+#include "waste_time_cycle_store.h"
+
+namespace fusion_perception::traffic_flow {
+
+WasteTimeCycleStore::Average WasteTimeCycleStore::consume(std::vector<Sample>& samples, uint64_t until_ts) {
+    Average avg;
+    size_t taken = 0;
+    double sum = 0.0;
+    while (taken < samples.size() && samples[taken].timestamp <= until_ts) {
+        sum += samples[taken].waste_time;
+        avg.values.push_back(samples[taken].waste_time);
+        ++taken;
+    }
+    if (taken == 0) {
+        return avg;
+    }
+    samples.erase(samples.begin(), samples.begin() + static_cast<long>(taken));
+    avg.value = sum / static_cast<double>(taken);
+    avg.cycle_count = taken;
+    return avg;
+}
+
+void WasteTimeCycleStore::add_lane_sample(const std::string& lane_tag, double waste_time, uint64_t timestamp) {
+    if (lane_tag.empty()) return;
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto& samples = _lane_samples[lane_tag];
+    samples.push_back({timestamp, waste_time});
+    if (samples.size() > kMaxSamplesPerKey) {
+        samples.erase(samples.begin(),
+                      samples.begin() + static_cast<long>(samples.size() - kMaxSamplesPerKey));
+    }
+}
+
+void WasteTimeCycleStore::add_flow_sample(const std::string& branch_tag, int flow_type,
+                                         double waste_time, uint64_t timestamp) {
+    if (branch_tag.empty()) return;
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto& samples = _flow_samples[{branch_tag, flow_type}];
+    samples.push_back({timestamp, waste_time});
+    if (samples.size() > kMaxSamplesPerKey) {
+        samples.erase(samples.begin(),
+                      samples.begin() + static_cast<long>(samples.size() - kMaxSamplesPerKey));
+    }
+}
+
+WasteTimeCycleStore::Average WasteTimeCycleStore::take_lane_average(const std::string& lane_tag, uint64_t until_ts) {
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto it = _lane_samples.find(lane_tag);
+    if (it == _lane_samples.end()) return Average{};
+    return consume(it->second, until_ts);
+}
+
+WasteTimeCycleStore::Average WasteTimeCycleStore::take_flow_average(const std::string& branch_tag, int flow_type,
+                                                                   uint64_t until_ts) {
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto it = _flow_samples.find({branch_tag, flow_type});
+    if (it == _flow_samples.end()) return Average{};
+    return consume(it->second, until_ts);
+}
+
+}  // namespace fusion_perception::traffic_flow
diff --git a/src/traffic_flow/waste_time_cycle_store.h b/src/traffic_flow/waste_time_cycle_store.h
new file mode 100644
index 0000000..170e71c
--- /dev/null
+++ b/src/traffic_flow/waste_time_cycle_store.h
@@ -0,0 +1,47 @@
+#ifndef WASTE_TIME_CYCLE_STORE_H
+#define WASTE_TIME_CYCLE_STORE_H
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace fusion_perception::traffic_flow {
+
+// 浪费时间的栅格级（5min）指标不是对原始帧再累积一遍，而是「窗口内各完整信号灯周期值的平均」，
+// 因此周期级结果要作为样本存下来，供栅格通道取用。
+// 车道级样本由 AccumulateWasteTimeDetector 写入；流向级样本由工厂在流向聚合后写入。
+class WasteTimeCycleStore {
+public:
+    struct Average {
+        double value = 0.0;          // 无样本时为 0（协议：无有效数据填 0）
+        size_t cycle_count = 0;      // 参与平均的完整周期数
+        std::vector<double> values;  // 各周期原值，用于拼 WasteTimeDetail
+    };
+
+    void add_lane_sample(const std::string& lane_tag, double waste_time, uint64_t timestamp);
+    void add_flow_sample(const std::string& branch_tag, int flow_type, double waste_time, uint64_t timestamp);
+
+    // 取走并消费 timestamp <= until_ts 的全部样本（消费后即删除，窗口不重叠不留缝）。
+    Average take_lane_average(const std::string& lane_tag, uint64_t until_ts);
+    Average take_flow_average(const std::string& branch_tag, int flow_type, uint64_t until_ts);
+
+private:
+    struct Sample {
+        uint64_t timestamp;
+        double waste_time;
+    };
+    static Average consume(std::vector<Sample>& samples, uint64_t until_ts);
+
+    // 栅格通道未配置 waste_time 时样本无人消费，加上限防止无限增长。
+    static constexpr size_t kMaxSamplesPerKey = 512;
+
+    mutable std::mutex _mutex;
+    std::map<std::string, std::vector<Sample>> _lane_samples;
+    std::map<std::pair<std::string, int>, std::vector<Sample>> _flow_samples;
+};
+
+}  // namespace fusion_perception::traffic_flow
+#endif  // WASTE_TIME_CYCLE_STORE_H

