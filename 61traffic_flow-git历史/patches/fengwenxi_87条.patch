+/**
+ * @file occupancy_detector.h
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief 
+ * @version 0.1
+ * @date 2024-10-21
+ * 
+ * <========================================================================>
+ *                   © 2024 CICTCI. All Rights Reserved.                
+ * <========================================================================>
+ * 
+ */
+#ifndef TRAFFIC_FLOW_OCCUPANCY_DETECTOR_H
+#define TRAFFIC_FLOW_OCCUPANCY_DETECTOR_H
+
+#include <map>
+#include <set>
+#include <vector>
+#include <atomic>
+
+#include "traffic_flow_detector.h"
+
+namespace fusion_perception {
+namespace math {
+class Vec2D;
+class Segment2D;
+
+}  // namespace math
+
+namespace traffic_flow {
+class OccupancyDetector final : public TrafficFlowDetector {
+public:
+    OccupancyDetector(const DetectorConfig& detector_config);
+    virtual ~OccupancyDetector() = default;
+
+    virtual void detect(const PerceptionResult& new_frame_result) override;
+
+private:
+    void calculate_volume();
+
+private:
+    std::set<InnerType> _object_types;
+    uint64_t _detect_period;
+    uint64_t _current_period_start;
+    std::vector<math::Vec2D> _stop_line_points;
+    std::vector<math::Segment2D> _stop_line_segments;
+    // key: inner_id, value: track info
+    std::map<uint64_t, TrackInfo> _object_tracks;
+};
+
+}  // namespace traffic_flow
+}  // namespace fusion_perception
+
