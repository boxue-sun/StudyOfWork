@@ -0,0 +1,122 @@
+#include "log.h"
+#include <sstream>
+#include <cstdio>
+#include <cstdarg>
+#include <algorithm>
+
+namespace data_fusion::plugin {
+
+std::queue<std::string> Log::queue_;
+std::mutex Log::mutex_;
+std::string Log::name_;
+LogLevel Log::level_;
+size_t Log::queue_size_;
+
+bool Log::Create(const std::string& name, const std::string& level, size_t queue_size) {
+    level_ = GetLevel(level);
+    if (!name.empty()) {
+        name_ = "[" + name + "]";
+    }
+
+    queue_size_ = queue_size;
+    if (queue_size_ == 0) {
+        queue_size_ = 10;
+    }
+
+    return true;
+}
+
+void Log::Enqueue(LogLevel level, const std::string& message) {
+    std::lock_guard<std::mutex> lock(mutex_);
+
+    if (queue_.size() >= queue_size_) {
+        queue_.pop();
+    }
+
+    std::stringstream ss;
+    ss << name_ << " " << GetPrefix(level) << " " << message;
+    queue_.push(ss.str());
+}
+
+bool Log::Dequeue(std::string& dst) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (queue_.empty()) {
+        return false;
+    }
+    std::string message = queue_.front();
+    dst = std::string(message.c_str());
+    queue_.pop();
+    return true;
+}
+
+std::string Log::Format(const char* fmt, ...) {
+    // 通过变长参数列表处理输入参数
+    va_list args;
+    va_start(args, fmt);
+
+    // 获取格式化后的字符串长度
+    int size = std::vsnprintf(nullptr, 0, fmt, args);
+
+    // 分配足够的空间来存储格式化后的字符串
+    std::string result(size + 1, '\0');
+
+    // 使用 vsnprintf 将格式化后的字符串存储到 result 中
+    std::vsnprintf(&result[0], size + 1, fmt, args);
+
+    // 清理变长参数列表
+    va_end(args);
+
+    return result;
+}
+
+LogLevel Log::GetLevel(const std::string& level) {
+    if (level.empty()) {
+        return LogLevel_Error;
+    }
+
+    std::string level_lower;
+    level_lower.resize(level.size());
+    std::transform(level.begin(), level.end(), level_lower.begin(), ::tolower);
+
+    if (level_lower == "trace") {
+        return LogLevel_Trace;
+    } else if (level_lower == "debug") {
+        return LogLevel_Debug;
+    } else if (level_lower == "info") {
+        return LogLevel_Info;
+    } else if (level_lower == "warning") {
+        return LogLevel_Warn;
+    } else if (level_lower == "error") {
+        return LogLevel_Error;
+    } else if (level_lower == "fatal") {
+        return LogLevel_Fatal;
+    } else if (level_lower == "off") {
+        return LogLevel_Off;
+    } else {
+        return LogLevel_Error;
+    }
+}
+
+std::string Log::GetPrefix(LogLevel level) {
+    switch (level) {
+    case LogLevel_Trace:
+        return "[T]";
+    case LogLevel_Debug:
+        return "[D]";
+    case LogLevel_Info:
+        return "[I]";
+    case LogLevel_Warn:
+        return "[W]";
+    case LogLevel_Error:
+        return "[E]";
+    case LogLevel_Fatal:
+        return "[F]";
+    case LogLevel_Off:
+        return "[O]";
+    default:
+        break;
+    }
+    return "[E]";
+}
+
+}  // namespace data_fusion::plugin
