+/**
+ * @file volume_detector.cpp
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief
+ * @version 0.1
+ * @date 2024-10-21
+ *
+ * <========================================================================>
+ *                   © 2024 CICTCI. All Rights Reserved.
+ * <========================================================================>
+ *
+ */
+#include "volume_detector.h"
+
+namespace fusion_perception {
+
+VolumeDetector::VolumeDetector(const DetectorConfig& detector_config)
+    : TrafficFlowDetector(detector_config),
+      object_type_(detector_config.object_type),
+      detect_period_(detector_config.detect_period),
+      current_period_start_(0) {}
+
+uint16_t VolumeDetector::CalculateVolume() {
+    uint16_t volume = 0;
+#ifdef DEBUG
+    std::cout << "[DEBUG] VolumeDetector " << to_string(detector_type_) << " calculates once, has " << volume
+              << " cars from " << current_period_start_ << " in" << detect_period_ << " ms." << std::endl;
+#endif
+}
+
+void VolumeDetector::Detect(const PerceptionResult& new_frame_result) {
+    for (const auto& one_object : new_frame_result.traffic_objects) {
+        if (one_object.inner_type != object_type_) {
+            continue;
+        }
+        auto& object_track_info = track_infos_[one_object.inner_id];
+        object_track_info.track.emplace_back(GeoPosition(one_object.longitude, one_object.latitude));
+        if (object_track_info.id != one_object.inner_id) {
+            object_track_info.id = one_object.inner_id;
+        }
+    }
+    /* Delete old objects that no longer exist */
+    for (auto it = track_infos_.begin(); it != track_infos_.end();) {
+        uint64_t elapsed_time = new_frame_result.timestamp - it->second.track.end()->timestamp;
+        if (elapsed_time > kObjectClearTime) {
+            it = track_infos_.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    /* Init first detect period. */
+    if (!current_period_start_) {
+        current_period_start_ = new_frame_result.timestamp;
+#ifdef DEBUG
+        std::cout << "[DEBUG] VolumeDetector " << to_string(detector_type_) << " first detect." << std::endl;
+#endif
+    }
+    while ((current_period_start_ + detect_period_) < new_frame_result.timestamp) {
+        uint16_t volume = CalculateVolume();
+        /* Calc next period. */
+        current_period_start_ += detect_period_;
+    }
+}
+
+}  // namespace fusion_perception
