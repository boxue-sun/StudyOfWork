new file mode 100644
index 0000000..72fa750
--- /dev/null
+++ b/src/traffic_flow/detectors/pcu_detector.cpp
@@ -0,0 +1,126 @@
+/**
+ * @file pcu_detector.cpp
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief
+ * @version 0.1
+ * @date 2024-10-23
+ *
+ * <========================================================================>
+ *                   © 2024 CICTCI. All Rights Reserved.
+ * <========================================================================>
+ *
+ */
+#include "pcu_detector.h"
+#include "common/geo_calc.h"
+
+#include "nlohmann/json.hpp"
+#include <iostream>
+
+namespace fusion_perception {
+
+const std::unordered_map<InnerType, float> PcuDetector::s_type_to_coefficient_ = {{InnerType::kBicycle, 0.2},
+                                                                                  {InnerType::kTricycle, 0.6},
+                                                                                  {InnerType::kCar, 1.0},
+                                                                                  {InnerType::kBus, 2.0},
+                                                                                  {InnerType::kTruck, 3.0}};
+
+PcuDetector::PcuDetector(const DetectorConfig& detector_config)
+    : TrafficFlowDetector(detector_config),
+      object_types_(detector_config.object_types),
+      detect_period_(detector_config.detect_period),
+      current_period_start_(0) {}
+
+float PcuDetector::GetCoefficient(const InnerType& type) {
+    auto find_it = s_type_to_coefficient_.find(type);
+    if (find_it == s_type_to_coefficient_.end()) {
+        return 0.0;
+    }
+    return find_it->second;
+}
+
+float PcuDetector::CalculatePcu() {
+    float pcu = 0;
+    for (auto& one_object : object_tracks_) {
+        std::list<GeoPosition> track_section;
+        auto& one_track = one_object.second.track;
+        /* Delete old tracks and put track in this period to {track_section} */
+        // TODO: May lead to false result because of the incontinuity of the track.
+        for (auto it = one_track.begin(); it != one_track.end(); ++it) {
+            if (it->timestamp >= current_period_start_ && it->timestamp <= (current_period_start_ + detect_period_)) {
+                track_section.emplace_back(it->position);
+            }
+        }
+        if (track_section.size() <= 1) {
+            continue;
+        } else if (geo_calc::IsLineIntersect(track_section, section_line_)) {
+            pcu += GetCoefficient(one_object.second.type);
+        }
+    }
+#ifdef DEBUG
+    std::cout << "[DEBUG] PcuDetector " << to_string(detector_type_) << " calculates once, has " << volume
+              << " cars from " << current_period_start_ << " in" << detect_period_ << " ms." << std::endl;
+#endif
+    return pcu;
+}
+
+void PcuDetector::Detect(const PerceptionResult& new_frame_result) {
+    for (const auto& one_object : new_frame_result.traffic_objects) {
+        auto find_it = object_types_.find(one_object.inner_type);
+        if (find_it == object_types_.end()) {
+            continue;
+        }
+        auto& object_track_info = object_tracks_[one_object.inner_id];
+        object_track_info.track.emplace_back(GeoPosition(one_object.longitude, one_object.latitude));
+        if (object_track_info.id != one_object.inner_id) {
+            object_track_info.id = one_object.inner_id;
+        }
+        if (object_track_info.type != one_object.inner_type) {
+            if (object_track_info.type != InnerType::kDefault) {
+                std::cerr << "Warning, object type changed from " << to_string(object_track_info.type) << " to "
+                          << to_string(one_object.inner_type) << std::endl;
+            }
+            object_track_info.type = one_object.inner_type;
+        }
+    }
+    /* Delete old objects that no longer exist */
+    for (auto it = object_tracks_.begin(); it != object_tracks_.end();) {
+        uint64_t elapsed_time = new_frame_result.timestamp - it->second.track.end()->timestamp;
+        if (elapsed_time > kObjectClearTime) {
+            it = object_tracks_.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    /* Init first detect period. */
+    if (!current_period_start_) {
+        current_period_start_ = new_frame_result.timestamp;
+#ifdef DEBUG
+        std::cout << "[DEBUG] PcuDetector " << to_string(detector_type_) << " first detect." << std::endl;
+#endif
+    }
+#ifdef DEBUG
+    uint8_t calc_count = 0;
+#endif
+    while ((current_period_start_ + detect_period_) < new_frame_result.timestamp) {
+        float pcu = CalculatePcu();
+        /* Calc next period. */
+        current_period_start_ += detect_period_;
+        nlohmann::json result;
+        result["type"] = to_string(detector_type_);
+        result["value"] = pcu;
+        result["timestamp"] = current_period_start_;
+        result["detect_period"] = detect_period_;
+        if (!deliver_callback_(result)) {
+            std::cerr << "Error, detector send result failed!" << std::endl;
+        }
+#ifdef DEBUG
+        ++calc_count;
+#endif
+    }
+#ifdef DEBUG
+    std::cout << "[DEBUG] PcuDetector " << to_string(detector_type_) << " calculated " << calc_count << " times once."
+              << std::endl;
+#endif
+}
+
+}  // namespace fusion_perception
