+template <typename T>
+void try_parse(const std::string& key, const nlohmann::json& j, T& to) {
+#ifdef DEBUG
+    if (!j.contains(key)) {
+        std::cerr << "Warning! json object doesn't contain " << key
+                  << std::endl;
+    }
+#else
+    if (j.contains(key)) {
+        j.at(key).get_to(to);
+    }
+#endif
+}
+
+void to_json(nlohmann::json& j, const TrafficObject& object) {
+    j = nlohmann::json{
+        {"id", object.id},
+        {"inner_id", object.inner_id},
+        {"inner_type", static_cast<uint16_t>(object.inner_type)},
+        {"type", static_cast<uint8_t>(object.object_type)},
+        {"associate_type", static_cast<uint8_t>(object.association_type)},
+        {"speed", object.speed},
+        {"speed_confidence", object.speed_confidence},
+        {"accel", object.accel},
+        {"accel_confidence", object.accel_confidence},
+        {"heading", object.heading},
+        {"heading_confidence", object.heading_confidence},
+        {"lon", object.longitude},
+        {"lat", object.latitude},
+        {"ele", object.elevation},
+        {"non_veh_type", static_cast<uint8_t>(object.non_vehicle_subtype)},
+        {"veh_type", static_cast<uint8_t>(object.vehicle_subtype)},
+        {"length", object.length},
+        {"width", object.width},
+        {"height", object.height},
+        {"x_pos", object.x_pos},
+        {"y_pos", object.y_pos},
+        {"duration", object.duration},
+        {"lane_no", object.lane_no},
+        {"color", static_cast<uint8_t>(object.color)},
+        {"plate_type", static_cast<uint8_t>(object.plate_type)},
+        {"plate_color", static_cast<uint8_t>(object.plate_color)},
+        {"plate_num", object.plate_num},
+        {"plate_confidence", object.plate_confidence},
+        {"extra_length", object.extra_length},
+        {"extra", object.extra_params}};
+}
+
+void from_json(const nlohmann::json& j, TrafficObject& object) {
+    try_parse("id", j, object.id);
+    try_parse("inner_id", j, object.inner_id);
+    uint16_t inner_type = 0;
+    try_parse("inner_type", j, inner_type);
+    object.inner_type = static_cast<InnerType>(inner_type);
+    uint8_t type = 0;
+    try_parse("type", j, type);
+    object.object_type = static_cast<ObjectType>(type);
+    uint8_t associate_type = 0;
+    try_parse("associate_type", j, associate_type);
+    object.association_type = static_cast<AssociationType>(associate_type);
+    try_parse("speed", j, object.speed);
+    try_parse("speed_confidence", j, object.speed_confidence);
+    try_parse("accel", j, object.accel);
+    try_parse("accel_confidence", j, object.accel_confidence);
+    try_parse("heading", j, object.heading);
+    try_parse("heading_confidence", j, object.heading_confidence);
+    try_parse("lon", j, object.longitude);
+    try_parse("lat", j, object.latitude);
+    try_parse("ele", j, object.elevation);
+    uint8_t non_veh_type = 0;
+    try_parse("non_veh_type", j, non_veh_type);
+    object.non_vehicle_subtype = static_cast<NonVehicleSubtype>(non_veh_type);
+    uint8_t veh_type = 0;
+    try_parse("veh_type", j, veh_type);
+    object.vehicle_subtype = static_cast<VehicleSubtype>(veh_type);
+    try_parse("length", j, object.length);
+    try_parse("width", j, object.width);
+    try_parse("height", j, object.height);
+    try_parse("x_pos", j, object.x_pos);
+    try_parse("y_pos", j, object.y_pos);
+    try_parse("duration", j, object.duration);
+    try_parse("lane_no", j, object.lane_no);
+    uint8_t color = 0;
+    try_parse("color", j, color);
+    object.color = static_cast<ObjectColor>(color);
+    uint8_t plate_type = 0;
+    try_parse("plate_type", j, plate_type);
+    object.plate_type = static_cast<PlateType>(plate_type);
+    uint8_t plate_color = 0;
+    try_parse("plate_color", j, plate_color);
+    object.plate_color = static_cast<PlateColor>(plate_color);
+    try_parse("plate_num", j, object.plate_num);
+    try_parse("plate_confidence", j, object.plate_confidence);
+    try_parse("extra_length", j, object.extra_length);
+    try_parse("extra", j, object.extra_params);
+}
+
+void to_json(nlohmann::json& j, const InternalResult& result) {
+    j = nlohmann::json{{"msg_type", result.message_type},
+                       {"dev_no", result.dev_no},
+                       {"radar_no", result.radar_no},
+                       {"lidar_no", result.lidar_no},
+                       {"mec_no", result.mec_no},
+                       {"timestamp_readable", result.timestamp_readable},
+                       {"timestamp", result.timestamp},
+                       {"object_count", result.object_count},
+                       {"object_result", result.traffic_objects},
+                       {"event_count", result.event_count}};
+}
+
+void from_json(const nlohmann::json& j, InternalResult& result) {
+    uint16_t msg_type = 0;
+    try_parse("msg_type", j, msg_type);
+    result.message_type = static_cast<InternalMessageType>(msg_type);
+    try_parse("dev_no", j, result.dev_no);
+    try_parse("radar_no", j, result.radar_no);
+    try_parse("lidar_no", j, result.lidar_no);
+    try_parse("mec_no", j, result.mec_no);
+    try_parse("timestamp_readable", j, result.timestamp_readable);
+    try_parse("timestamp", j, result.timestamp);
+    try_parse("object_count", j, result.object_count);
+    try_parse("object_result", j, result.traffic_objects);
+}
+
+}  // namespace fusion_perception
