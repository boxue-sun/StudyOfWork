+/**
+ * @file vec2d.hpp
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief 2D vector calculation
+ * @version 0.1
+ * @date 2024-10-24
+ *
+ * <========================================================================>
+ *                   © 2024 FengWenxi. All Rights Reserved.
+ * <========================================================================>
+ *
+ */
+#ifndef _TRAFFIC_FLOW_VEC2D_HPP_
+#define _TRAFFIC_FLOW_VEC2D_HPP_
+
+#include <cmath>
+#include <string>
+
+namespace fusion_perception::math {
+
+class Vec2D {
+public:
+    constexpr Vec2D() noexcept : Vec2D(0, 0) {}
+    constexpr Vec2D(const double& x, const double& y) noexcept : _x(x), _y(y) {}
+
+    double x() const { return _x; }
+    double y() const { return _y; }
+    void set_x(const double& x) { _x = x; }
+    void set_y(const double& y) { _y = y; }
+
+    double angle() const { return atan2(_y, _x); }
+    double length() const { return hypot(_x, _y); }
+    double length_sqr() const { return _x * _x + _y * _y; }
+    double distance_to(const Vec2D& other) const { return hypot(_x - other._x, _y - other._y); }
+    double distance_sqr_to(const Vec2D& other) const {
+        const double dx = _x - other._x;
+        const double dy = _y - other._y;
+        return dx * dx + dy * dy;
+    }
+
+    double cross_product(const Vec2D& other) const { return _x * other.y() - _y * other.x(); }
+    double inner_product(const Vec2D& other) const { return _x * other.x() + _y * other.y(); }
+
+    std::string to_string() const {
+        std::string output_string;
+        output_string = " Vec2D (" + std::to_string(_x) + "," + std::to_string(_y) + ")";
+        return output_string;
+    }
+
+protected:
+    double _x = 0.0;
+    double _y = 0.0;
+};
+
+inline double cross_product(const Vec2D& point1, const Vec2D& point2, const Vec2D& point3)
+{
+    return (point2.x() - point1.x()) * (point3.y() - point1.y()) - (point3.x() - point1.x()) * (point2.y() - point1.y());
+}
+
+}  // namespace fusion_perception::math
+
+#endif
