+/**
+ * @file geo_calc.cpp
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief Utils for geographic calculations
+ * @version 0.1
+ * @date 2024-10-22
+ *
+ * <========================================================================>
+ *                   © 2024 FengWenxi. All Rights Reserved.
+ * <========================================================================>
+ *
+ */
+#include "geo_calc.h"
+
+#include <cmath>
+
+namespace fusion_perception::geo_calc {
+
+bool IsLineIntersect(const std::list<GeoPosition>& line1, const std::list<GeoPosition>& line2) {
+    if (line1.size() < 2 || line2.size() < 2) {
+        return false;
+    }
+    for (auto line1_point1 = line1.begin(); std::next(line1_point1) != line1.end(); ++line1_point1) {
+        for (auto line2_point1 = line2.begin(); std::next(line2_point1) != line2.end(); ++line2_point1) {
+            /* Whether line segment is intersected. */
+            auto line1_point2 = std::next(line1_point1);
+            auto line2_point2 = std::next(line2_point1);
+            float cross_product_1 =
+                (line1_point2->longitude - line1_point1->longitude) *
+                    (line2_point2->latitude - line2_point1->latitude) -
+                (line2_point2->longitude - line2_point1->longitude) * (line1_point2->latitude - line1_point1->latitude);
+            if (fabs(cross_product_1 - 0) < std::numeric_limits<float>::epsilon()) {
+                continue;  // parallel
+            }
+            float cross_product_2 =
+                (line2_point2->longitude - line2_point1->longitude) *
+                    (line1_point1->latitude - line2_point1->latitude) -
+                (line1_point1->longitude - line2_point1->longitude) * (line2_point2->latitude - line2_point1->latitude);
+            float ratio_1 = cross_product_2 / cross_product_1;
+            float cross_product_3 =
+                (line1_point2->longitude - line1_point1->longitude) *
+                    (line1_point1->latitude - line2_point1->latitude) -
+                (line1_point1->longitude - line2_point1->longitude) * (line1_point2->latitude - line1_point1->latitude);
+            float ratio_2 = cross_product_3 / cross_product_1;
+            if (ratio_1 < 0 || ratio_1 > 1 || ratio_2 < 0 || ratio_2 > 1) {
+                continue;  // not intersected
+            }
+            return true;  // intersected
+        }
+    }
+    return false;
+}
+}  // namespace fusion_perception::geo_calc
