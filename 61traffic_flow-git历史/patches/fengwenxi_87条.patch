+#include "detectors/waste_time_average_detector.h"
+
+#include <iostream>
+#include <string>
+
+namespace fusion_perception::traffic_flow {
+
+WasteTimeAverageDetector::WasteTimeAverageDetector(const std::string& detector_id, const CoilInfo& coil_info,
+                                                   WasteTimeCycleStore* cycle_store)
+    : AccumulateDetector(detector_id), _coil_info(coil_info), _cycle_store(cycle_store) {
+    if (!_cycle_store) {
+        std::cerr << "[WasteTimeAverage] " << detector_id
+                  << " has no cycle store, WasteTime will always be 0" << std::endl;
+    }
+}
+
+void WasteTimeAverageDetector::update(const PerceptionResult& frame) {
+    // 不消费原始帧，只记住窗口右边界对应的帧时间戳，供 calculate_once 圈定样本范围。
+    _last_frame_ts = frame.timestamp;
+}
+
+nlohmann::json WasteTimeAverageDetector::calculate_once() {
+    WasteTimeCycleStore::Average avg;
+    if (_cycle_store) {
+        avg = _cycle_store->take_lane_average(_coil_info.tag, _last_frame_ts);
+    }
+
+    nlohmann::json entry = {
+        {"lane_tag", _coil_info.tag},
+        {"road_section_tag", _coil_info.road_section_info.tag},
+        {"lane_no", _coil_info.lane_no},
+        {"lane_id", _coil_info.lane_id},
+        {"turn_dir_no", _coil_info.turn_dir_no}};
+    entry["WasteTime"] = avg.value;
+
+    std::string detail;
+    for (size_t i = 0; i < avg.values.size(); ++i) {
+        if (i > 0) detail += ",";
+        detail += std::to_string(avg.values[i]);
+    }
+    entry["WasteTimeDetail"] = detail;
+
+    nlohmann::json result = nlohmann::json::array();
+    result.push_back(entry);
+    return result;
+}
+
+}  // namespace fusion_perception::traffic_flow
