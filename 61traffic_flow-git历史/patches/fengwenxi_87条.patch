diff --git a/src/traffic_flow/detectors/headway_detector.cpp b/src/traffic_flow/detectors/headway_detector.cpp
new file mode 100644
index 0000000..f678205
--- /dev/null
+++ b/src/traffic_flow/detectors/headway_detector.cpp
@@ -0,0 +1,144 @@
+/**
+ * @file headway_detector.cpp
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief
+ * @version 0.1
+ * @date 2024-10-16
+ *
+ * <========================================================================>
+ *                   © 2024 CICTCI. All Rights Reserved.
+ * <========================================================================>
+ *
+ */
+#include "headway_detector.h"
+
+#include <iostream>
+#include <nlohmann/json.hpp>
+
+#include "math/segment2d.hpp"
+
+namespace fusion_perception::traffic_flow {
+
+HeadwayDetector::HeadwayDetector(const DetectorConfig& detector_config)
+    : TrafficFlowDetector(detector_config),
+      _current_period_start(0),
+      _last_arrival_timestamp(0),
+      _headway_time_sum(0),
+      _arrival_count(0) {}
+
+void HeadwayDetector::update_headway() {
+    for (auto& one_object_track : _object_tracks) {
+        if (one_object_track.second.is_intersected) {
+            continue;
+        }
+        std::vector<TrackPosition> track_positions;
+        auto& one_track = one_object_track.second.track;
+        // TODO: May lead to false result because of the incontinuity of the track.
+        if ((one_track.size() < 2) || (one_track[one_track.size() - 1].timestamp < _current_period_start) ||
+            (one_track[one_track.size() - 1].timestamp >= (_current_period_start + _detector_config.detect_period))) {
+            continue;
+        }
+        for (int i = one_track.size() - 2; i < one_track.size(); ++i) {
+            track_positions.emplace_back(one_track[i]);
+        }
+        if (track_positions.size() != 2) {
+            std::cerr << "one track positions size not equal to 2." << std::endl;
+            continue;
+        }
+        math::Segment2D one_track_segment(track_positions[0].position, track_positions[1].position);
+        for (const auto& one_stop_line_segment : _detector_config.coil_info.stop_line_segments) {
+            if (one_track_segment.has_intersect(one_stop_line_segment)) {
+                one_object_track.second.is_intersected = true;
+#ifdef DEBUG
+                std::cout << "[DEBUG] HeadwayDetector " << detector_type_to_string(_detector_config.type)
+                          << " tag: " << _detector_config.tag << " calculates once, innerid: " << one_object_track.first
+                          << " from " << _current_period_start << " in " << _detector_config.detect_period << " ms."
+                          << std::endl;
+#endif
+                // update headway info
+                if (_arrival_count == 0) {
+                    _last_arrival_timestamp = one_track[one_track.size() - 1].timestamp;
+                    ++_arrival_count;
+                } else {
+                    _headway_time_sum += (one_track[one_track.size() - 1].timestamp - _last_arrival_timestamp);
+                    ++_arrival_count;
+                    _last_arrival_timestamp = one_track[one_track.size() - 1].timestamp;
+                }
+                break;
+            }
+        }
+    }
+}
+
+void HeadwayDetector::update(const PerceptionResult& new_frame_result) {
+    _current_frame_result = new_frame_result;
+    for (const auto& one_object : new_frame_result.traffic_objects) {
+        auto& object_track_info = _object_tracks[one_object.inner_id];
+        object_track_info.track.emplace_back(one_object.latitude, one_object.longitude, one_object.speed,
+                                             new_frame_result.timestamp);
+        if (object_track_info.id != one_object.inner_id) {
+            object_track_info.id = one_object.inner_id;
+        }
+        if (object_track_info.type != one_object.inner_type) {
+            object_track_info.type = one_object.inner_type;
+        }
+    }
+    // Delete old objects that are no longer exist。
+    for (auto it = _object_tracks.begin(); it != _object_tracks.end();) {
+        uint64_t elapsed_time = new_frame_result.timestamp - it->second.track.back().timestamp;
+        if (elapsed_time > OBJECT_CLEAR_TIME) {
+            it = _object_tracks.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    // Init first detect period.
+    if (!_current_period_start) {
+        _current_period_start = new_frame_result.timestamp;
+#ifdef DEBUG
+        std::cout << "[DEBUG] HeadwayDetector " << detector_type_to_string(_detector_config.type)
+                  << " tag: " << _detector_config.tag << " first update." << std::endl;
+#endif
+    }
+    update_headway();
+    if (_detector_config.working_mode != WorkingMode::ENSEMBLE) {
+        std::cerr << "Error, HeadwayDetector only support ENSEMBLE mode now.";
+        return;
+    }
+}
+
+void HeadwayDetector::calculate_once(nlohmann::json& result_j) {
+    std::vector<TrackInfo> lane_objects;
+    math::Vec2D stop_line_point1 = _detector_config.coil_info.stop_line_segments.front().start();
+    math::Vec2D stop_line_point2 = _detector_config.coil_info.stop_line_segments.back().end();
+    math::Segment2D stop_line_segment(stop_line_point1, stop_line_point2);
+    math::Vec2D stop_line_middle_point = stop_line_segment.middle_point();
+    for (const auto& one_object : _current_frame_result.traffic_objects) {
+        auto& object_track_info = _object_tracks[one_object.inner_id];
+        math::Vec2D current_position = object_track_info.track.back().position;
+        if (_detector_config.coil_info.lane_contour.is_point_in(current_position)) {
+            lane_objects.push_back(object_track_info);
+        }
+    }
+    std::sort(lane_objects.begin(), lane_objects.end(), [&](const TrackInfo& a, const TrackInfo& b) {
+        auto distance1 = a.track.back().position.geo_distance_to(stop_line_middle_point);
+        auto distance2 = b.track.back().position.geo_distance_to(stop_line_middle_point);
+        return distance1 < distance2;
+    });
+    float distance = 0.0f;
+    if (lane_objects.size() > 1) {
+        for (size_t i = 1; i < lane_objects.size(); ++i) {
+            auto pos1 = lane_objects[i - 1].track.back().position;
+            auto pos2 = lane_objects[i].track.back().position;
+            distance += pos1.geo_distance_to(pos2);
+        }
+        distance /= (lane_objects.size() - 1);
+    }
+    result_j["Headway"] = _headway_time_sum / double(_arrival_count - 1);
+    result_j["Distance"] = distance;
+    _arrival_count = 0;
+    _headway_time_sum = 0;
+    return;
+}
+
+}  // namespace fusion_perception::traffic_flow
