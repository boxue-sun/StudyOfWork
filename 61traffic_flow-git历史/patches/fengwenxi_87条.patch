+    for (size_t i = object_track_info.track.size() - QUEUE_CHECK_NUM; i < object_track_info.track.size(); ++i) {
+        if (object_track_info.track[i].speed > STATIC_SPEED_THRESH) {
+            return false;
+        }
+    }
+    return true;
 }
 
 void QueueDetector::calculate_once(nlohmann::json& result_j) {
+    std::vector<TrackInfo> queue_objects;
+    math::Vec2D stop_line_point1 = _detector_config.coil_info.stop_line_segments.front().start();
+    math::Vec2D stop_line_point2 = _detector_config.coil_info.stop_line_segments.back().end();
+    math::Segment2D stop_line_segment(stop_line_point1, stop_line_point2);
+    math::Vec2D stop_line_middle_point = stop_line_segment.middle_point();
+    for (const auto& one_object : _current_frame_result.traffic_objects) {
+        auto& object_track_info = _object_tracks[one_object.inner_id];
+        math::Vec2D current_position = object_track_info.track.back().position;
+        if (_detector_config.coil_info.lane_contour.is_point_in(current_position)) {
+            if (is_object_static(object_track_info)) {
+                queue_objects.push_back(object_track_info);
+            }
+        }
+    }
+    std::sort(queue_objects.begin(), queue_objects.end(), [&](const TrackInfo& a, const TrackInfo& b) {
+        auto distance1 = a.track.back().position.geo_distance_to(stop_line_middle_point);
+        auto distance2 = b.track.back().position.geo_distance_to(stop_line_middle_point);
+        return distance1 < distance2;
+    });
+    result_j["Number"] = queue_objects.size();
+    result_j["Queue_length"] = queue_objects.back().track.back().position.geo_distance_to(stop_line_middle_point);
     return;
 }
 
