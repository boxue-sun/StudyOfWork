+ * 
+ */
+#ifndef TRAFFIC_OBJECT_H
+#define TRAFFIC_OBJECT_H
+
+#include "nlohmann/json.hpp"
+
+#include <stdint.h>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace fusion_perception {
+
+enum class ObjectColor : uint8_t {
+    kOthers = 0,
+    kWhite = 1,
+    kBlue = 2,
+    kYellow = 3,
+    kBlack = 4,
+    kGreen = 5,
+    kRed = 6,
+    kSilver = 7,
+    kGrey = 8,
+    kPink = 9,
+    kGolden = 10,
+    kOrange = 11,
+    kPurple = 12,
+    kDefault = 255
+};
+
+static std::map<ObjectColor, std::string> s_object_color_to_string_map = {
+    {ObjectColor::kOthers, "Others"}, {ObjectColor::kWhite, "White"},
+    {ObjectColor::kBlue, "Blue"},     {ObjectColor::kYellow, "Yellow"},
+    {ObjectColor::kBlack, "Black"},   {ObjectColor::kGreen, "Green"},
+    {ObjectColor::kRed, "Red"},       {ObjectColor::kSilver, "Silver"},
+    {ObjectColor::kGrey, " Grey"},    {ObjectColor::kPink, "Pink"},
+    {ObjectColor::kGolden, "Golden"}, {ObjectColor::kOrange, "Orange"},
+    {ObjectColor::kPurple, "Purple"}, {ObjectColor::kDefault, "Default"}};
+
+inline std::string to_string(const ObjectColor& object_color) {
+    std::string color_str = "";
+    auto find_it = s_object_color_to_string_map.find(object_color);
+    if (find_it != s_object_color_to_string_map.end()) {
+        color_str = find_it->second;
+    }
+    return color_str;
+}
+
+enum class PlateType : uint8_t {
+    kOthers = 0,
+    kNormal = 1,  // blue or black plate
+    kYellow = 2,
+    kDoubleLayerYellow = 3,
+    kPolice = 4,
+    kSpecialZone = 5,  // Hong Kong & Macau
+    kCoach = 6,
+    kCustomized = 7,
+    kAgriculture = 8,
+    kEmbassy = 9,
+    kMotor = 10,
+    kTractor = 11,
+    kDefault = 255
+};
+
+static std::map<PlateType, std::string> s_plate_type_to_string_map = {
+    {PlateType::kOthers, "Others"},
+    {PlateType::kNormal, "Normal"},
+    {PlateType::kYellow, "Yellow"},
+    {PlateType::kDoubleLayerYellow, "DoubleLayerYellow"},
+    {PlateType::kPolice, "Police"},
+    {PlateType::kSpecialZone, "SpecialZone"},
+    {PlateType::kCoach, "Coach"},
+    {PlateType::kCustomized, "Customized"},
+    {PlateType::kAgriculture, "Agriculture"},
+    {PlateType::kEmbassy, "Embassy"},
+    {PlateType::kMotor, "Motor"},
+    {PlateType::kTractor, "Tractor"},
+    {PlateType::kDefault, "Default"}};
+
+inline std::string to_string(const PlateType& plate_type) {
+    std::string plate_type_str = "";
+    auto find_it = s_plate_type_to_string_map.find(plate_type);
+    if (find_it != s_plate_type_to_string_map.end()) {
+        plate_type_str = find_it->second;
+    }
+    return plate_type_str;
+}
+
+enum class PlateColor : uint8_t {
+    kOthers = 0,
+    kWhite = 1,
+    kBlue = 2,
+    kYellow = 3,
+    kBlack = 4,
+    kGreen = 5,
+    kDefault = 255
+};
+
+static std::map<PlateColor, std::string> s_plate_color_to_string_map = {
+    {PlateColor::kOthers, "Others"},  {PlateColor::kWhite, "White"},
+    {PlateColor::kBlue, "Blue"},      {PlateColor::kYellow, "Yellow"},
