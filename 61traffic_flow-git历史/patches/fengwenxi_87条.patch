+    - cd ${INTEGRATION_NAME}
+    - git checkout main
+    - mkdir -p ${CI_PROJECT_TITLE}
+    - rm -fr ${CI_PROJECT_TITLE}/*
+    - cd ${CI_PROJECT_TITLE}
+    - cp -R ${CI_PROJECT_DIR}/${PRODUCT_NAME_LINUX_X86_64} .
+    - cp -R ${CI_PROJECT_DIR}/${PRODUCT_NAME_XAVIER} .
+    - cp -R ${CI_PROJECT_DIR}/${PRODUCT_NAME_ORIN} .
