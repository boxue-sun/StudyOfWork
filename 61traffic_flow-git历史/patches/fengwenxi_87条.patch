+	if (api_version == 1) {
+		FPTrafficFlowService* api = new FPTrafficFlowService();
+		memset(api, 0, sizeof(FPTrafficFlowService));
+		api->Version = FP_VERSION;
+		api->APIVersion = FP_API_VERSION;
+		// 实现类
+		api->Params = new traffic_flow::plugin::TrafficFlowServiceImpl();
+		api->TrafficFlowService_Init = TrafficFlowService_Init;
+		api->TrafficFlowService_Release = TrafficFlowService_Release;
+		api->TrafficFlowService_OnPublish = nullptr;
+		api->TrafficFlowService_OnDiscovery = TrafficFlowService_OnDiscovery;
+		api->TrafficFlowService_OnMatched = TrafficFlowService_OnMatched;
+		api->TrafficFlowService_OnDataAvailable = TrafficFlowService_OnDataAvailable;
