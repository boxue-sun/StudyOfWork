-    def remove_last_global_point(self, group=1, lane_idx=None):
-        """
-        Delete the last added point in the specified lane (lane_idx, default to self.current_lane_idx) and group (1=left, 2=right).
-        If no points are numbered, revert to deleting the last added point based on creation_order.
-        """
-        if group not in (1, 2):
-            print("Invalid group for removal.")
-            return
-        if lane_idx is None:
-            lane_idx = getattr(self, "current_lane_idx", 0)
-
-        all_points = []
-        for label in getattr(self, "image_labels", []):
-            if not hasattr(label, "lanes") or lane_idx >= len(label.lanes):
-                continue
-            pts = label.lanes[lane_idx].get("line1_points") if group == 1 else label.lanes[lane_idx].get("line2_points")
-            for idx_in_label, pt in enumerate(pts):
-                # normalize to 6-tuple if possible
-                creation_order = pt[5] if len(pt) >= 6 else float("inf")
-                global_idx = pt[4] if len(pt) >= 5 else None
-                all_points.append({
-                    "label": label,
-                    "idx_in_label": idx_in_label,
-                    "pt": pt,
-                    "global_idx": global_idx,
-                    "creation_order": creation_order
-                })
-
-        if not all_points:
-            print(f"No points to remove in lane {lane_idx+1} group {group}.")
-            return
-
-        # Delete the last added point according to global_idx if any, otherwise delete the last added point based on creation_order
-        pts_with_idx = [p for p in all_points if p["global_idx"] is not None]
-        if pts_with_idx:
-            max_global_idx = max(p["global_idx"] for p in pts_with_idx)
-            candidates = [p for p in pts_with_idx if p["global_idx"] == max_global_idx]
-            if len(candidates) > 1:
-                to_remove = max(candidates, key=lambda x: x["creation_order"])
-            else:
-                to_remove = candidates[0]
-        else:
-            # If no points have global_idx, remove the last added point based on creation_order
-            to_remove = max(all_points, key=lambda x: x["creation_order"])
-
-        label = to_remove["label"]
-        idx_in_label = to_remove["idx_in_label"]
-        if group == 1:
-            removed = label.lanes[lane_idx]["line1_points"].pop(idx_in_label)
-        else:
-            removed = label.lanes[lane_idx]["line2_points"].pop(idx_in_label)
-
-        px, py, wx, wy = removed[0], removed[1], removed[2], removed[3]
-        removed_idx = removed[4] if len(removed) >= 5 else None
-        print(f"Removed lane {lane_idx+1} group {group} last indexed point: Pixel ({px}, {py}) → Coord ({wx:.3f}, {wy:.3f}), idx={removed_idx}")
-
-        self.reassign_global_indices()
