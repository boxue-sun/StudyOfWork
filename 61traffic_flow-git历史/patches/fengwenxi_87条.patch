+ *                   © 2024 CICTCI. All Rights Reserved.
+ * <========================================================================>
+ *
+ */
+#include "queue_length_detector.h"
+#include "common/geometry_calc.h"
+
+#include "nlohmann/json.hpp"
+#include <iostream>
+
+namespace fusion_perception {
+QueueLengthDetector::QueueLengthDetector(const DetectorConfig& detector_config)
+    : TrafficFlowDetector(detector_config), current_period_start_(0) {
+    nlohmann::json custom_config_json = detector_config.custom_config_json;
+    section_line_ = custom_config_json["section_line"];
+    custom_config_json.at("object_type").get_to(object_types_);
+    custom_config_json.at("detected_period").get_to(detect_period_);
+    for (const auto& section_line_point : custom_config_json.at("section_line")) {
+        section_line_.emplace_back(section_line_point);
+    }
+}
+
+float QueueLengthDetector::CalculateQueueLength() {
+    float queue_length = 0.0f;
+    for (auto& one_object : object_tracks_) {
+        Point2d current_location = one_object.second.track.back().position;
+        if (geometry_calc::IsLineIntersect(track_section, section_line_)) {
+        }
+    }
+#ifdef DEBUG
+    std::cout << "[DEBUG] QueueLengthDetector " << to_string(detector_type_) << " name: " << name_
+              << " calculates once, has " << volume << " cars from " << current_period_start_ << " in" << detect_period_
+              << " ms." << std::endl;
+#endif
+    return queue_length;
+}
+
+void QueueLengthDetector::Detect(const PerceptionResult& new_frame_result) {
+    for (const auto& one_object : new_frame_result.traffic_objects) {
+        auto find_it = object_types_.find(one_object.inner_type);
+        if (find_it == object_types_.end()) {
+            continue;
+        }
+        auto& object_track_info = object_tracks_[one_object.inner_id];
+        object_track_info.track.emplace_back(one_object.longitude, one_object.latitude);
+        if (object_track_info.id != one_object.inner_id) {
+            object_track_info.id = one_object.inner_id;
+        }
+        if(object_track_info.object_length != one_object.length){
+            object_track_info.object_length = one_object.length;
+        }
+    }
+    /* Delete old objects that no longer exist */
+    for (auto it = object_tracks_.begin(); it != object_tracks_.end();) {
+        uint64_t elapsed_time = new_frame_result.timestamp - it->second.track.back().timestamp;
+        if (elapsed_time > kObjectClearTime) {
+            it = object_tracks_.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    /* Init first detect period. */
+    if (!current_period_start_) {
+        current_period_start_ = new_frame_result.timestamp;
+#ifdef DEBUG
+        std::cout << "[DEBUG] QueueLengthDetector " << to_string(detector_type_) << " name: " << name_ << " first detect."
+                  << std::endl;
+#endif
+    }
+#ifdef DEBUG
+    uint8_t calc_count = 0;
+#endif
+    while ((current_period_start_ + detect_period_) < new_frame_result.timestamp) {
+        float queue_length = CalculateQueueLength();
+        /* Calc next period. */
+        current_period_start_ += detect_period_;
+        nlohmann::json result;
+        result["type"] = to_string(detector_type_);
+        result["value"] = queue_length;
+        result["timestamp"] = current_period_start_;
+        result["detect_period"] = detect_period_;
+        if (!deliver_callback_(result)) {
+            std::cerr << "Error, detector send result failed!" << std::endl;
+        }
+#ifdef DEBUG
+        ++calc_count;
+#endif
+    }
+#ifdef DEBUG
+    std::cout << "[DEBUG] QueueLengthDetector " << to_string(detector_type_) << " name: " << name_ << " calculated "
+              << calc_count << " times once." << std::endl;
+#endif
+}
+}  // namespace fusion_perception
