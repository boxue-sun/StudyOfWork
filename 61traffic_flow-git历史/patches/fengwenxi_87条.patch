+++ b/tool/FusionFlow/Trajectory_test.py
@@ -0,0 +1,139 @@
+import os
+import struct
+import csv
+import argparse
+import numpy as np
+
+
+def read_calibration_matrix(bin_file):
+    """
+    高效读取标定矩阵二进制文件
+    返回：width, height, geo_matrix(shape: [height, width, 2])
+    """
+    try:
+        with open(bin_file, 'rb') as f:
+            # 读取文件头（16字节：width+height）
+            header = f.read(16)
+            width, height = struct.unpack('dd', header)
+
+            # 一次性读取所有数据
+            data = np.frombuffer(f.read(), dtype=np.float64)
+            geo_matrix = data.reshape(int(height), int(width), 2)
+
+            return int(width), int(height), geo_matrix
+    except struct.error:
+        raise ValueError("二进制文件格式错误，请检查文件完整性")
+    except Exception as e:
+        raise RuntimeError(f"文件读取失败：{str(e)}")
+
+
+def parse_pixel_coordinates(txt_file):
+    """
+    解析像素坐标文件，支持灵活格式
+    返回：包含(x, y)元组的列表
+    """
+    coordinates = []
+    try:
+        with open(txt_file, 'r') as f:
+            for line_num, line in enumerate(f, 1):
+                line = line.strip()
+                if not line:
+                    continue
+
+                # 支持多种分隔符：逗号、空格、制表符
+                parts = line.replace(',', ' ').split()
+                if len(parts) != 2:
+                    print(f"警告：第{line_num}行格式错误，已跳过")
+                    continue
+
+                try:
+                    x = int(parts[0])
+                    y = int(parts[1])
+                    coordinates.append((x, y))
+                except ValueError:
+                    print(f"警告：第{line_num}行包含非整数值，已跳过")
+    except UnicodeDecodeError:
+        raise ValueError("输入文件编码错误，请使用UTF-8或ASCII编码")
+
+    return coordinates
+
+
+def generate_output_csv(coordinates, geo_matrix, width, height, output_file):
+    """
+    生成带地理坐标的CSV文件
+    """
+    with open(output_file, 'w', newline='', encoding='utf-8') as csvfile:
+        writer = csv.writer(csvfile)
+        # 写入带说明的列头
+        writer.writerow([
+            'index',
+            'lon',
+            'lat',
+            'x',
+            'y',
+            '坐标状态'
+        ])
+
+        for idx, (x, y) in enumerate(coordinates, 1):
+            status = "有效"
+            lat = lon = np.nan
+
+            # 坐标有效性检查
+            if 0 <= x < width and 0 <= y < height:
+                # 注意：矩阵存储为[纬度, 经度] 或 [经度, 纬度]取决于生成方式
+                # 需要与实际数据生成代码保持一致
+                lat, lon = geo_matrix[y, x, 0], geo_matrix[y, x, 1]
+            else:
+                status = f"越界（图像尺寸：{width}x{height}）"
+
+            writer.writerow([idx, lon, lat, x, y, status])
+
+
+def main(args):
+    # 参数校验
+    if not os.path.isfile(args.binary_file):
+        raise FileNotFoundError(f"标定矩阵文件不存在：{args.binary_file}")
+    if not os.path.isfile(args.txt_file):
+        raise FileNotFoundError(f"坐标文件不存在：{args.txt_file}")
+
+    # 读取标定数据
+    width, height, geo_matrix = read_calibration_matrix(args.binary_file)
+
+    # 读取输入坐标
+    coordinates = parse_pixel_coordinates(args.txt_file)
+    if not coordinates:
+        raise ValueError("输入文件中未找到有效坐标数据")
+
+    # 生成输出文件
+    generate_output_csv(
+        coordinates=coordinates,
+        geo_matrix=geo_matrix,
+        width=width,
+        height=height,
+        output_file=args.output_file
+    )
+    print(f"成功生成地理坐标文件：{os.path.abspath(args.output_file)}")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(
+        description='鱼眼相机标定测试工具 - 像素坐标转地理坐标',
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter
+    )
+    parser.add_argument('--binary-file',
+                        default='D:\\LYX\\proj\\FisheyeCalibrator_V1.1.0\\sy_fisheye\\453\\231\\test_0813.bin',
+                        help='标定矩阵二进制文件路径')
+    parser.add_argument('--txt-file',
+                        default='D:\\LYX\\proj\\FisheyeCalibrator_V1.1.0\\sy_fisheye\\453\\231\\test_0813.txt',
+                        help='包含像素坐标的文本文件路径')
+    parser.add_argument('--output-file',
+                        default='D:\\LYX\\proj\\FisheyeCalibrator_V1.1.0\\sy_fisheye\\453\\231\\test_0813.csv',
+                        help='输出CSV文件路径')
+
+    args = parser.parse_args()
+
+    try:
+        main(args)
+    except Exception as e:
+        print(f"错误：{str(e)}")
+        exit(1)
