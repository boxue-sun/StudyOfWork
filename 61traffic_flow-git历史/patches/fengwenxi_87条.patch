+#include "quality.h"
+
+#include <FusionPlugin.h>
+#include <nlohmann/json.hpp>
+#include <chrono>
+
+namespace data_fusion::plugin {
+
+    Quality* Quality::_instance = nullptr;
+
+    Quality::Quality(const std::string& name, PublishFunc func, uint8_t id, void* params)
+        : _name(name),
+        _seq(0),
+        _mutex(),
+        _id(id),
+        _func(func),
+        _params(params)
+    {
+    }
+
+    std::string& Quality::Name()
+    {
+        return _name;
+    }
+
+    Quality* Quality::GetInstance()
+    {
+        return _instance;
+    }
+
+    Quality* Quality::Create(const std::string& name, PublishFunc func, uint8_t id, void* params)
+    {
+        if (_instance == nullptr) {
+            _instance = new Quality(name, func, id, params);
+        }
+        return _instance;
+    }
+
+    void Quality::Push(uint16_t field, uint64_t start_time, uint64_t end_time)
+    {
+        if (_instance == nullptr || _instance->_func == nullptr) {
+            return;
+        }
+
+        std::lock_guard<std::mutex> lock(_instance->_mutex);
+
+        nlohmann::json j = nlohmann::json
+        {
+            {"name", _instance->_name.empty() ? "" : _instance->_name},
+            {"field", field},
+            {"end_time", end_time},
+            {"cost_time", end_time > start_time ? end_time - start_time : 0},
+            {"seq", _instance->_seq++}
+        };
+
+        std::string content = j.dump();
+        FusionMsg msg;
+		msg.version = 1;
+		msg.type = TopicType_QualityJson;
+		msg.body_size = content.size();
+		msg.body = (void*)content.c_str();
+
+        _instance->_func(_instance->_id, &msg, _instance->_params);
+
+    }
+
+    uint64_t Quality::Timestamp()
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+    }
+
+
+}
