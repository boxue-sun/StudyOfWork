+        plate_color_str = find_it->second;
+    }
+    return plate_color_str;
+}
+
+enum class InternalMessageType : uint16_t {
+    kTrafficObject = 2011,
+    kTrafficEvent = 2012,
+    kObjectAndEvent = 2015,
+    kDefault = 65535
+};
+
+enum class InnerType : uint16_t {
+    kPedestrian = 0,
+    kCar = 1,
+    kBus = 2,
+    kTruck = 3,
+    kTrafficCone = 4,
+    kBicycle = 5,
+    kTricycle = 6,
+    kPlate = 7,
+    kDefault = 65535
+};
+
+enum class ObjectType : uint8_t {
+    kUnsure = 0,
+    kMotorVehicle = 1,
+    kNonMotorVehicle = 2,
+    kPedestrian = 3,
+    kObstacle = 4,
+    kDefault = 255
+};
+
+enum class NonVehicleSubtype : uint8_t {
+    kUnsure = 0,
+    kBicycle = 1,
+    kMotorcycle = 2,
+    kTricycle = 3,
+    kDefault = 255
+};
+
+enum class VehicleSubtype : uint8_t {
+    kUnsure = 0,
+    kAmbulance = 1,
+    kFireEngine = 2,
+    kPoliceCar = 3,
+    kCar = 4,
+    kMinivan = 5,
+    kTruck = 6,
+    kBus = 7,
+    kDefault = 255
+};
+
+enum class AssociationType : uint8_t {
+    kCamera = 0,
+    kRadar = 1,
+    kLidar = 2,
+    kFusion = 9,
+    kDefault = 255
+};
+
+typedef struct TrafficObject_ {
+    std::string id;
+    uint64_t inner_id;
+    InnerType inner_type = InnerType::kDefault;
+    ObjectType object_type = ObjectType::kDefault;
+    AssociationType association_type = AssociationType::kDefault;
+    float speed = 0.0f;               // in km/h
+    float speed_confidence = 0.0f;    // range in [0,1]
+    float accel = 0.0f;               // in m/s^2
+    float accel_confidence = 0.0f;    // range in [0,1]
+    float heading = 0.0f;             // range in [0,360)
+    float heading_confidence = 0.0f;  // range in [0,1]
+    double longitude = 0.0;
+    double latitude = 0.0;
+    double elevation = 0.0;
+    NonVehicleSubtype non_vehicle_subtype = NonVehicleSubtype::kDefault;
+    VehicleSubtype vehicle_subtype = VehicleSubtype::kDefault;
+    float length = 0.0f;
+    float width = 0.0f;
+    float height = 0.0f;
+    float x_pos = 0.0f;
+    float y_pos = 0.0f;
+    uint64_t duration = 0ul;
+    uint16_t lane_no = 0;
+    ObjectColor color = ObjectColor::kDefault;
+    PlateType plate_type = PlateType::kDefault;
+    PlateColor plate_color = PlateColor::kDefault;
+    std::string plate_num;
+    float plate_confidence = 0.0f;
+    uint32_t extra_length = 0u;
+    std::string extra_params;
+} TrafficObject;
+
+/**
+ * @brief Results detected by internal algo, like VisionStream
+ *
+ */
+typedef struct InternalResult_ {
+    InternalMessageType message_type = InternalMessageType::kDefault;
+    std::string dev_no;
+    std::string radar_no;
+    std::string lidar_no;
+    std::string mec_no;
+    std::string timestamp_readable;
+    uint64_t timestamp = 0;
+    uint16_t object_count = 0;
+    std::vector<TrafficObject> traffic_objects;
+    uint16_t event_count = 0;
+} InternalResult;
+
+void to_json(nlohmann::json& j, const TrafficObject& object);
+void from_json(const nlohmann::json& j, TrafficObject& object);
+void to_json(nlohmann::json& j, const InternalResult& result);
+void from_json(const nlohmann::json& j, InternalResult& result);
+
+}  // namespace fusion_perception
+
+#endif
