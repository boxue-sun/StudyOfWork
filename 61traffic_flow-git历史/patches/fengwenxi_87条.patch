+#ifndef ACCUMULATE_WASTE_TIME_DETECTOR_H
+#define ACCUMULATE_WASTE_TIME_DETECTOR_H
+
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+#include <nlohmann/json.hpp>
+#include "traffic_flow/traffic_flow_detector.h"
+#include "traffic_flow/waste_time_cycle_store.h"
+#include "common/config.h"
+#include "traffic_flow/detectors/stop_line_crossing_helper.h"
+
+namespace fusion_perception::traffic_flow {
+
+class AccumulateWasteTimeDetector : public AccumulateDetector {
+public:
+    // cycle_store 非空时，每个完整信号周期的车道级结果会作为样本写入，供栅格通道求平均。
+    AccumulateWasteTimeDetector(const std::string& detector_id, const CoilInfo& coil_info,
+                                WasteTimeCycleStore* cycle_store = nullptr,
+                                const SignalPhaseManager* spm = nullptr);
+    ~AccumulateWasteTimeDetector() override = default;
+
+    void update(const PerceptionResult& frame) override;
+    nlohmann::json calculate_once() override;
+    void drain() override;
+    __attribute__((visibility("default")))
+    void on_signal_update(const SignalPhaseManager* spm) override;
+
+private:
+    CoilInfo _coil_info;
+    StopLineCrossingTracker _tracker;
+    WasteTimeCycleStore* _cycle_store;
+    const SignalPhaseManager* _signal_phase_manager;
+    uint64_t _last_frame_ts = 0;
+    mutable bool _current_ref_phase_passable = false;
+
+    // ---- 临时调试计数器(排查 WasteTime=0,定位后请删除) ----
+    uint64_t _dbg_frame_count = 0;   // update() 处理帧数
+    uint64_t _dbg_cross_total = 0;   // 累计检测到的越线车辆数
+    int _dbg_last_ref_light = -999;  // 上次参考相位灯色,用于变化时才打印
+
+    struct LaneWasteTimeAcc {
+        uint64_t last_tail_time = 0;       // 前车车尾通过停止线的时间
+        bool last_is_large = false;        // 前车是否大车
+        bool last_is_green = false;        // 前车通过时是否绿灯
+        double waste_time_sum = 0.0;       // 浪费时间累积（秒）
+        uint16_t pair_count = 0;           // 有效配对数
+        nlohmann::json meta;               // 车道元信息
+        std::vector<std::string> waste_details;  // 每对车的浪费时间明细
+    };
+    std::map<std::string, LaneWasteTimeAcc> _lane_acc;
+
+    // 信号灯状态历史：记录参考相位灯色变化时间戳，用于回溯查询任意时刻的灯色
+    struct SignalStateEntry {
+        uint64_t timestamp;
+        int light;  // 灯色值
+    };
+    std::vector<SignalStateEntry> _signal_history;
+    mutable std::mutex _signal_mutex;
+
+    // is_green_at(timestamp) 已废弃：当前帧灯色在 update() 里通过 _current_ref_phase_passable 直接记住。
+    bool is_green_at(uint64_t timestamp) const;
+    void reset_lane(LaneWasteTimeAcc& acc);
+    static bool is_large_vehicle(const TrafficObject& obj);
+    static double get_normal_gap(bool prev_large, bool curr_large);
+};
+
+}  // namespace fusion_perception::traffic_flow
+#endif
