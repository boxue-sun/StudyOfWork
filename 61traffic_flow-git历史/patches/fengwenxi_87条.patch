diff --git a/src/base/blocking_queue.hpp b/src/base/blocking_queue.hpp
new file mode 100644
index 0000000..82dd00a
--- /dev/null
+++ b/src/base/blocking_queue.hpp
@@ -0,0 +1,283 @@
+/**
+ * @file blocking_queue.hpp
+ * @author fengwenxi (ThorfromAsgard@outlook.com)
+ * @brief An implementation of blocking queue.
+ * @version 0.1
+ * @date 2024-10-15
+ *
+ * <==========================================================================>
+ *                   Copyright © 2024, All Rights Reserved.
+ * <==========================================================================>
+ *
+ */
+#ifndef CYBERTRON_BASE_BLOCKING_QUEUE_HPP
+#define CYBERTRON_BASE_BLOCKING_QUEUE_HPP
+
+#include "noncopyable.hpp"
+
+#include <mutex>
+#include <deque>
+#include <iostream>
+#include <condition_variable>
+
+namespace cybertron::base {
+template <typename T>
+/**
+ * @brief An implementation of blocking queue. //NOTE that the producer won't be
+ * blocked even though the queue has reached its max capacity.
+ *
+ */
+class BlockingQueue : public Noncopyable {
+public:
+    /**
+     * @brief Construct a new Blocking Queue object, use it carefully when set
+     * parameter "size" to 0
+     *
+     * @param size Again, you should be very aware of what you are doing when
+     * set it to 0, if you are not sure, then you are not aware !!!!!!
+     */
+    explicit BlockingQueue(bool push_block = false, size_t size = 0)
+        : push_block_(push_block),
+          capacity_(size),
+          mutex_(),
+          consumer_(mutex_),
+          deque_(),
+          active_(true) {
+        if (size == 0) {
+            // TODO: Find another way to warning!
+            std::cout
+                << "Warning! Blocking queue parameter size is set to 0, may "
+                   "cause memory overflow."
+                << std::endl;
+        }
+    }
+
+    ~BlockingQueue() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            deque_.clear();
+            active_ = false;
+        }
+        producer_.notify_all();
+        consumer_.notify_all();
+    }
+
+    void PushBack(const T& item) {
+        /**
+         * @brief Use unique_lock instead of lock_guard because of it allows
+         * unlock&relock temporarily while lock_guard only allows unlock after
+         * its scope
+         *
+         */
+        std::unique_lock<std::mutex> lock(mutex_);
+        if (push_block_) {
+            while (capacity_ && deque_.size() >= capacity_) {
+                producer_.wait(lock);
+            }
+        } else {
+            if (capacity_ && deque_.size() >= capacity_) {
+                deque_.pop_front();
+            }
+        }
+        if (active_) {
+            deque_.push_back(item);
+            consumer_.notify_one();
+        }
+    }
+
+    void PushBack(T&& item) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        if (push_block_) {
+            while (capacity_ && deque_.size() >= capacity_) {
+                producer_.wait(lock);
+            }
+        } else {
+            if (capacity_ && deque_.size() >= capacity_) {
+                deque_.pop_front();
+            }
+        }
+        if (active_) {
+            deque_.push_back(std::move(item));
+            consumer_.notify_one();
+        }
+    }
+
+    void PushFront(const T& item) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        if (push_block_) {
+            while (capacity_ && deque_.size() >= capacity_) {
+                producer_.wait(lock);
+            }
+        } else {
+            if (capacity_ && deque_.size() >= capacity_) {
+                deque_.pop_back();
+            }
+        }
+        if (active_) {
+            deque_.push_front(item);
+            consumer_.notify_one();
+        }
+    }
+
+    void PushFront(T&& item) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        if (push_block_) {
+            while (capacity_ && deque_.size() >= capacity_) {
+                producer_.wait(lock);
+            }
+        } else {
+            if (capacity_ && deque_.size() >= capacity_) {
+                deque_.pop_back();
+            }
+        }
+        if (active_) {
+            deque_.push_front(std::move(item));
+            consumer_.notify_one();
+        }
+    }
+
+    /**
+     * @brief Pop front element in a blocking way
+     *
+     * @param item output item
+     * @return true if the queue successfully pops one element from front
+     * @return false if the queue fails to pop one element from front
+     */
+    bool PopFront(T& item) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        while (deque_.empty()) {
+            consumer_.wait(lock);
+        }
+        if (active_) {
+            item = deque_.front();
+            deque_.pop_front();
+            if (push_block_) {
+                producer_.notify_one();
+            }
+            return true;
+        } else {
+            return false;
+        }
+    }
+
+    /**
+     * @brief Pop front element within {timeout} seconds
+     *
+     * @param item output item
+     * @param timeout in seconds
+     * @return true if the queue is not empty in {timeout} seconds and
+     * successfully pops one element from front
+     * @return false if the queue is always empty during {timeout} seconds and
+     * thus fails to pop one element from front
+     */
+    bool PopFront(T& item, int timeout) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        while (deque_.empty()) {
+            if (consumer_.wait_for(lock, std::chrono::seconds(timeout)) ==
+                std::cv_status::timeout) {
+                return false;
+            }
+        }
+        if (active_) {
+            item = deque_.front();
+            deque_.pop_front();
+            if (push_block_) {
+                producer_.notify_one();
+            }
+            return true;
+        } else {
+            return false;
+        }
+    }
+
+    /**
+     * @brief Pop back element in a blocking way
+     *
+     * @param item output item
+     * @return true if the queue successfully pops one element from back
+     * @return false if the queue fails to pop one element from back
+     */
+    bool PopBack(T& item) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        while (deque_.empty()) {
+            consumer_.wait(lock);
+        }
+        if (active_) {
+            item = deque_.back();
+            deque_.pop_back();
+            if (push_block_) {
+                producer_.notify_one();
+            }
+            return true;
+        } else {
+            return false;
+        }
+    }
+
+    /**
+     * @brief Pop back element within {timeout} seconds
+     *
+     * @param item output item
+     * @param timeout in seconds
+     * @return true if the queue is not empty in {timeout} seconds and
+     * successfully pops one element from back
+     * @return false if the queue is always empty during {timeout} seconds and
+     * thus fails to pop from back
+     */
+    bool PopBack(T& item, int timeout) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        while (deque_.empty()) {
+            if (consumer_.wait_for(lock, std::chrono::seconds(timeout)) ==
+                std::cv_status::timeout) {
+                return false;
+            }
+        }
+        if (active_) {
+            item = deque_.back();
+            deque_.pop_back();
+            if (push_block_) {
+                producer_.notify_one();
+            }
+            return true;
+        } else {
+            return false;
+        }
+    }
+
+    T Front() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return deque_.front();
+    }
+
+    T Back() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return deque_.back();
+    }
+
+    size_t Size() const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return deque_.size();
+    }
+
+    bool Empty() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return deque_.empty();
+    }
+
+    bool Full() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return (deque_.size() >= capacity_);
+    }
+
+private:
+    const bool push_block_;
+    bool active_;
+    const size_t capacity_;
+    std::mutex mutex_;
+    std::condition_variable consumer_;  // guarded by mutex_
+    std::condition_variable producer_;  // guarded by mutex_
+    std::deque<T> deque_;               // guarded by mutex_
+};
+}  // namespace cybertron::base
+
+#endif
