diff --git a/script/gen_aligned_signal.py b/script/gen_aligned_signal.py
new file mode 100644
index 0000000..df15608
--- /dev/null
+++ b/script/gen_aligned_signal.py
@@ -0,0 +1,319 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+生成与感知数据"时间对齐"的信号灯文件,用于验证 WasteTime 计算。
+
+背景:
+  原 traffic_light_selftest.txt 与 map_*.txt 不同源(相差 6.9 天),且回放速率错配,
+  导致南向车辆越线时刻与参考相位(phase 18,南向直行)的绿灯窗口随机错配,
+  AccumulateWasteTimeDetector 的配对条件(前后两车都在绿灯期越线)永不成立,WasteTime 恒为 0。
+
+做法:
+  1. 忠实复刻 StopLineCrossingTracker 的越线判定(线段相交 + 去重),扫描全部感知帧,
+     得到南向各车道的"实际越线帧号"。
+  2. 由越线帧聚类构建 phase 18 的绿灯窗口(车在绿灯时越线,物理自洽),窗口间为红灯,
+     每个 红->绿 跳变触发一次信号周期边界。
+  3. 逐帧(信号帧 i 对齐感知帧 i,两发布器都是 delay=10ms/帧)生成信号灯文件。
+
+用法:
+  python3 script/gen_aligned_signal.py            # 只统计越线,打印分布(dry-run)
+  python3 script/gen_aligned_signal.py --write    # 统计 + 生成信号灯文件
+"""
+import json
+import os
+import sys
+
+# ---------------------------------------------------------------------------
+# 路径配置
+# ---------------------------------------------------------------------------
+DEBUG_ROOT = "/data/skywalker/Work/Project/traffic_flow/Debug"
+LANE_INFO = os.path.join(DEBUG_ROOT, "config/service/lane_info_212.json")
+MAP_TXT = os.path.join(DEBUG_ROOT, "data/map_20260901163954.txt")
+OUT_TXT = os.path.join(DEBUG_ROOT, "data/traffic_light_aligned.txt")
+
+# 参考相位:南向直行 = SOUTH 基址 17 + STRAIGHT 偏移 1 = 18
+REF_PHASE = 18
+# 一起生成的南向相位组(100% 共绿),让数据更真实;参考相位仍是 18
+SOUTH_PHASES = [17, 18, 21, 22]
+
+# 可计入的 inner_type(与 classify_volume_category != NONE 对齐)
+#   PEDESTRIAN=0, CAR=1, BUS=2, TRUCK=3, BICYCLE=5, TRICYCLE=6
+COUNTABLE_INNER_TYPES = {0, 1, 2, 3, 5, 6}
+
+# tracker 常量(与 stop_line_crossing_helper.cpp 一致)
+POSITION_TTL = 10000  # ms
+
+# 绿灯窗口构建参数(单位:感知帧,1 帧 = 100ms 真实时间)
+CLUSTER_GAP = 40   # 相邻越线帧间隔 <= 此值归为同一簇(4s)
+PAD = 15           # 每个簇前后扩展的绿灯余量(1.5s),吸收发布器启动偏移
+MIN_RED = 20       # 两个绿灯窗口之间至少保留的红灯帧数(2s),确保红->绿跳变可辨
+
+
+# ---------------------------------------------------------------------------
+# 线段相交(复刻 math::Segment2D::has_intersect 的参数化判定)
+# ---------------------------------------------------------------------------
+def has_intersect(ax, ay, bx, by, cx, cy, dx, dy):
+    """线段 AB 与线段 CD 是否相交。A-B=停止线,C-D=车辆移动线段。"""
+    d = (bx - ax) * (dy - cy) - (by - ay) * (dx - cx)
+    if d == 0:
+        return False
+    r = ((ay - cy) * (dx - cx) - (ax - cx) * (dy - cy)) / d
+    s = ((ay - cy) * (bx - ax) - (ax - cx) * (by - ay)) / d
+    return 0.0 <= r <= 1.0 and 0.0 <= s <= 1.0
+
+
+def load_stop_lines():
+    """从 lane_info 读取每条车道的停止线 (P1=contour[0][0], P2=contour[1][0]),坐标为 (lat, lon)。"""
+    with open(LANE_INFO) as f:
+        data = json.load(f)
+    dir_names = {1: 'north', 2: 'east', 3: 'south', 4: 'west'}
+    type_names = {1: 'middle_road_section', 2: 'entry_section', 3: 'exit_section', 5: 'zebra_crossing'}
+    lines = []
+    for lane in data['lanes']:
+        contour = lane['contour']
+        p1 = contour[0][0]  # [lat, lon]
+        p2 = contour[1][0]  # [lat, lon]
+        lane_no = lane['LaneNo']
+        tag = "{}_{}_{}".format(
+            dir_names.get(lane_no['f_dir_8_no'], '?'),
+            type_names.get(lane_no['lane_sdtype_no'], '?'),
+            lane_no['LaneID'])
+        # Vec2D(x=lat, y=lon),与 current_pos(obj.latitude, obj.longitude) 一致
+        lines.append({'tag': tag, 'x1': p1[0], 'y1': p1[1], 'x2': p2[0], 'y2': p2[1]})
+    return lines
+
+
+def detect_crossings(stop_lines):
+    """逐帧复刻 StopLineCrossingTracker,返回 (每车道越线明细列表, 总感知帧数)。
+    每条越线明细: {frame, ts, length, speed, is_large}。"""
+    # 每条车道独立的 prev_positions{id:(x,y,ts)} 与 crossed_ids
+    prev = [dict() for _ in stop_lines]
+    crossed = [set() for _ in stop_lines]
+    cross_detail = [[] for _ in stop_lines]  # 每车道越线明细
+    n_frames = 0
+
+    with open(MAP_TXT) as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            frame = json.loads(line)
+            ts = frame.get('timestamp', 0)
+            objs = frame.get('object_result', [])
+            for li, sl in enumerate(stop_lines):
+                # TTL 清理
+                p = prev[li]
+                for oid in list(p.keys()):
+                    if ts > p[oid][2] and ts - p[oid][2] > POSITION_TTL:
+                        del p[oid]
+                for o in objs:
+                    it = o.get('inner_type')
+                    if it not in COUNTABLE_INNER_TYPES:
+                        continue
+                    oid = o.get('id')
+                    cx, cy = o.get('lat'), o.get('lon')  # x=lat, y=lon
+                    if cx is None or cy is None:
+                        continue
+                    if oid in p:
+                        px, py, _ = p[oid]
+                        # 停止线 (x1,y1)-(x2,y2) 与移动线段 (px,py)-(cx,cy) 相交
+                        if oid not in crossed[li] and has_intersect(
+                                sl['x1'], sl['y1'], sl['x2'], sl['y2'], px, py, cx, cy):
+                            crossed[li].add(oid)
+                            cross_detail[li].append({
+                                'frame': n_frames,
+                                'ts': ts,
+                                'length': o.get('length', 4.5) or 4.5,
+                                'speed': o.get('speed', 0.0) or 0.0,
+                                'is_large': it in (2, 3),  # BUS=2, TRUCK=3
+                            })
+                    p[oid] = (cx, cy, ts)
+            n_frames += 1
+    return cross_detail, n_frames
+
+
+def build_green_windows(all_cross_frames, n_frames):
+    """由越线帧号聚类构建绿灯窗口,返回长度 n_frames 的 bool 列表。"""
+    if not all_cross_frames:
+        return [False] * n_frames
+    frames = sorted(set(all_cross_frames))
+    # 聚类:间隔 <= CLUSTER_GAP 归为一簇
+    clusters = []
+    cur_start = cur_end = frames[0]
+    for fr in frames[1:]:
+        if fr - cur_end <= CLUSTER_GAP:
+            cur_end = fr
+        else:
+            clusters.append((cur_start, cur_end))
+            cur_start = cur_end = fr
+    clusters.append((cur_start, cur_end))
+    # 扩展 padding
+    windows = [(max(0, s - PAD), min(n_frames - 1, e + PAD)) for s, e in clusters]
+    # 合并间隔过小的窗口(保证窗口间有足够红灯形成红->绿跳变)
+    merged = [windows[0]]
+    for s, e in windows[1:]:
+        ls, le = merged[-1]
+        if s - le < MIN_RED:
+            merged[-1] = (ls, max(le, e))
+        else:
+            merged.append((s, e))
+    green = [False] * n_frames
+    for s, e in merged:
+        for i in range(s, e + 1):
+            green[i] = True
+    return green, merged
+
+
+def write_signal(green, n_frames):
+    """逐帧生成信号灯文件:信号帧 i 对齐感知帧 i。
+    时间戳步长用 100ms(与感知帧一致),这样无论发布器是固定 delay 还是 adaptive 按时间戳节奏,
+    信号与感知都是 1:1 逐帧对齐。"""
+    base_ts = 1788251994400  # 与感知起始 ts 一致
+    n_green = 0
+    n_boundary = 0
+    prev_green = False
+    with open(OUT_TXT, 'w') as out:
+        for i in range(n_frames):
+            is_green = green[i]
+            light = 6 if is_green else 3  # 6=PROTECTED_GREEN, 3=RED
+            if is_green:
+                n_green += 1
+            if is_green and not prev_green and i > 0:
+                n_boundary += 1
+            prev_green = is_green
+            phases = [{"phaseId": pid, "phaseStates": [{"light": light}]} for pid in SOUTH_PHASES]
+            rec = {
+                "ack": True,
+                "cityName": "shunyi",
+                "mecSn": "mec-1",
+                "msg_type": 1743,
+                "name": "signal-aligned",
+                "timeStamp": base_ts + i * 100,
+                "recvTimestamp": base_ts + i * 100,
+                "intersections": [{
+                    "crossId": "cross-1",
+                    "crossName": "cross-1",
+                    "latitude": 29.5187,
+                    "longitude": 106.3153,
+                    "elevation": 0.0,
+                    "regionId": "region-1",
+                    "phases": phases,
+                }],
+            }
+            out.write(json.dumps(rec, ensure_ascii=False) + "\n")
+    return n_green, n_boundary
+
+
+def get_normal_gap(prev_large, curr_large):
+    """与 AccumulateWasteTimeDetector::get_normal_gap 一致的正常跟车时距(秒)。"""
+    if not prev_large and not curr_large:
+        return 1.5
+    if not prev_large and curr_large:
+        return 2.5
+    if prev_large and not curr_large:
+        return 2.0
+    return 3.0
+
+
+def simulate_waste(green, cross_detail, n_frames):
+    """忠实复刻 detector 的配对+浪费计算,预测每车道 pair_count 与 waste_sum。
+    周期边界(红->绿)触发 calculate_once:输出并重置。"""
+    onsets = [i for i in range(1, n_frames) if green[i] and not green[i - 1]]
+    onset_set = set(onsets)
+    results = []
+    for details in cross_detail:
+        events = [(d['frame'], 1, d) for d in details]      # 1=越线
+        events += [(o, 0, None) for o in onsets]            # 0=周期边界(同帧时先于越线)
+        events.sort(key=lambda e: (e[0], e[1]))
+        last_tail = 0
+        last_green = False
+        last_large = False
+        pair_count = 0
+        waste_sum = 0.0
+        total_pairs = 0
+        total_waste = 0.0
+        for frame, kind, d in events:
+            if kind == 0:  # 周期边界 → calculate_once 输出并重置
+                total_pairs += pair_count
+                total_waste += waste_sum
+                pair_count = 0
+                waste_sum = 0.0
+                last_tail = 0
+                last_green = False
+                last_large = False
+            else:          # 越线
+                curr_green = bool(green[frame])
+                ts = d['ts']
+                speed_ms = d['speed'] / 3.6
+                tail = ts + int(d['length'] / speed_ms * 1000) if speed_ms > 0.1 else ts
+                if last_tail > 0 and last_green and curr_green:
+                    gap = (ts - last_tail) / 1000.0 if ts > last_tail else 0.0
+                    normal = get_normal_gap(last_large, d['is_large'])
+                    waste = gap - normal
+                    if waste > 0:
+                        waste_sum += waste
+                    pair_count += 1
+                last_tail = tail
+                last_large = d['is_large']
+                last_green = curr_green
+        total_pairs += pair_count
+        total_waste += waste_sum
+        results.append((total_pairs, total_waste))
+    return results
+
+
+def main():
+    write_mode = "--write" in sys.argv
+    print("=== 加载停止线 ===")
+    stop_lines = load_stop_lines()
+    for sl in stop_lines:
+        print("  {}: P1=({:.7f},{:.7f}) P2=({:.7f},{:.7f})".format(
+            sl['tag'], sl['x1'], sl['y1'], sl['x2'], sl['y2']))
+
+    print("\n=== 复刻 tracker 扫描全部感知帧(约 112MB,请稍候)===")
+    cross_detail, n_frames = detect_crossings(stop_lines)
+    total = 0
+    for sl, cd in zip(stop_lines, cross_detail):
+        total += len(cd)
+        rng = "{}~{}".format(cd[0]['frame'], cd[-1]['frame']) if cd else "-"
+        print("  {}: 越线 {} 次, 帧范围 {}".format(sl['tag'], len(cd), rng))
+    print("  合计越线: {} 次, 感知总帧数: {}".format(total, n_frames))
+
+    all_cross = [d['frame'] for cd in cross_detail for d in cd]
+    green, merged = build_green_windows(all_cross, n_frames)
+    print("\n=== 绿灯窗口 ===")
+    print("  窗口数(=信号周期数): {}".format(len(merged)))
+    print("  绿灯帧总数: {} ({:.1f}%)".format(sum(green), 100.0 * sum(green) / n_frames))
+    for idx, (s, e) in enumerate(merged[:15]):
+        print("    窗口{}: 帧 {}~{} ({}帧)".format(idx, s, e, e - s + 1))
+    if len(merged) > 15:
+        print("    ... 共 {} 个窗口".format(len(merged)))
+
+    # 预测配对与浪费(忠实复刻 detector 逻辑)
+    pred = simulate_waste(green, cross_detail, n_frames)
+    print("\n=== 预测 WasteTime(全量帧跑完的累计值) ===")
+    tot_pair = 0
+    tot_waste = 0.0
+    for sl, (pc, ws) in zip(stop_lines, pred):
+        tot_pair += pc
+        tot_waste += ws
+        print("  {}: pair_count={}, waste_sum={:.2f}s".format(sl['tag'], pc, ws))
+    print("  合计: pair_count={}, waste_sum={:.2f}s".format(tot_pair, tot_waste))
+    if tot_pair == 0:
+        print("  ⚠ 预测配对为 0!需调大 CLUSTER_GAP/PAD 使同车道连续越线落入同一绿灯窗口")
+    else:
+        print("  ✓ 预测能配出 {} 对, waste 非零 → 生成文件后运行时 WasteTime 应非零".format(tot_pair))
+
+    if write_mode:
+        print("\n=== 生成信号灯文件 ===")
+        n_green, n_boundary = write_signal(green, n_frames)
+        size = os.path.getsize(OUT_TXT)
+        print("  输出: {}".format(OUT_TXT))
+        print("  帧数: {}, 绿灯帧: {}, 红->绿跳变(周期边界): {}".format(n_frames, n_green, n_boundary))
+        print("  文件大小: {:.2f} MB".format(size / 1024 / 1024))
+    else:
+        print("\n(dry-run,未写文件。加 --write 生成 {})".format(OUT_TXT))
+
+
+if __name__ == "__main__":
+    main()
