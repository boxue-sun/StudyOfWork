+#ifndef TRAFFIC_FLOW_IMPL_H
+#define TRAFFIC_FLOW_IMPL_H
+
+#include "traffic_flow_service.h"
+#include "traffic_flow_core.h"
+
+#include <mutex>
+#include <map>
+
+namespace traffic_flow::plugin {
+
+/**
+ * @brief participant enum type
+ *
+ */
+enum class PartId : uint8_t {
+    RSMJsonSub = 0,
+    ExternalJsonSub = 1,
+    RSMJsonPub = 2,
+    QualityJsonPub = 253,
+    PartId_StateJsonPub = 254,
+    PartId_LogJsonPub = 255
+};
+
+class TrafficFlowServiceImpl {
+public:
+    TrafficFlowServiceImpl() {}
+
+    /**
+     * @brief Initialization
+     *
+     * @param config_path Config file path
+     * @return int init result
+     */
+    int Init(const char* config_path);
+
+    /**
+     * @brief release resources
+     */
+    void Release();
+
+    /**
+     * @brief When discover new devices
+     *
+     * @param id device id
+     * @param status device status
+     * @param guid device guid
+     */
+    void OnDiscovery(uint8_t id, DiscoveryStatus status, const char* guid);
+
+    /**
+     * @brief When match new device
+     *
+     * @param id device id
+     * @param current_count
+     * @param current_count_change
+     */
+    void OnMatched(uint8_t id, int current_count, int current_count_change);
+
+    /**
+     * @brief When publish data
+     *
+     * @param id device data
+     * @param msg message pointer
+     */
+    void OnPublish(uint8_t id, void* msg);
+
+    /**
+     * @brief When data is available
+     *
+     * @param id device_id
+     * @param msg message pointer
+     */
+    void OnDataAvailable(uint8_t id, const void* msg);
+
+    static const FSTrafficFlowService* s_fs_api_;
+
+protected:
+    uint64_t get_timestamp();
+
+private:
+    std::mutex mtx_;
+
+    /* key: camera ID, value: corresponding fusion info*/
+    std::map<std::string, core::FusionInfo> device_info_map_;
+
+    /* key: device IP, value: corresponding camera ID, not needed any more */
+    // std::map<std::string, std::string> device_map_;
+
+    /* key: camera ID, value: corresponding datafuser*/
+    std::map<std::string, std::shared_ptr<core::DataFuser>> fuser_map_;
+
+private:
+    int msg_to_external_result(const FusionMsg& msg, data_type::ExternalResult& external_result);
+    int msg_to_internal_result(const FusionMsg& msg, data_type::InternalResult& internal_result);
+    int internal_result_to_buffer(
+            const data_type::InternalResult& internal_result,
+            std::vector<uint8_t>& msg_buffer);
+};
+
+}  // namespace traffic_flow::plugin
+
