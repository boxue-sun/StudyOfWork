+# -*- coding: utf-8 -*-
+import math
+import numpy as np
+import cv2
+
+class UTM:
+    """
+    Universal Transverse Mercator (UTM) coordinate conversion.
+    This class provides methods to convert between latitude/longitude and UTM coordinates.
+    """
+    
+    # Ellipsoid model constants (actual values here are for WGS84)
+    PI = 3.14159265358979
+    sm_a = 6378137.0
+    sm_b = 6356752.314
+    sm_EccSquared = 6.69437999013e-03
+    UTMScaleFactor = 0.9996
+
+    @staticmethod
+    def deg_to_rad(deg: float) -> float:
+        """Convert degrees to radians."""
+        return deg / 180.0 * UTM.PI
+
+    @staticmethod
+    def rad_to_deg(rad: float) -> float:
+        """Convert radians to degrees."""
+        return rad / UTM.PI * 180.0
+
+    @staticmethod
+    def arc_length_of_meridian(phi: float) -> float:
+        """
+        Computes the ellipsoidal distance from the equator to a point at a given latitude.
+        
+        Args:
+            phi: Latitude of the point, in radians.
+            
+        Returns:
+            The ellipsoidal distance of the point from the equator, in meters.
+        """
+        n = (UTM.sm_a - UTM.sm_b) / (UTM.sm_a + UTM.sm_b)
+        
+        # Precalculate coefficients
+        alpha = ((UTM.sm_a + UTM.sm_b) / 2.0) * (1.0 + (n**2 / 4.0) + (n**4 / 64.0))
+        beta = (-3.0 * n / 2.0) + (9.0 * n**3 / 16.0) + (-3.0 * n**5 / 32.0)
+        gamma = (15.0 * n**2 / 16.0) + (-15.0 * n**4 / 32.0)
+        delta = (-35.0 * n**3 / 48.0) + (105.0 * n**5 / 256.0)
+        epsilon = (315.0 * n**4 / 512.0)
+        
+        # Calculate the sum of the series
+        return alpha * (phi + (beta * math.sin(2.0 * phi)) + (gamma * math.sin(4.0 * phi)) + 
+                        (delta * math.sin(6.0 * phi)) + (epsilon * math.sin(8.0 * phi)))
+
+    @staticmethod
+    def utm_central_meridian(zone: int) -> float:
+        """
+        Determines the central meridian for the given UTM zone.
+        
+        Args:
+            zone: An integer value designating the UTM zone, range [1,60].
+            
+        Returns:
+            The central meridian for the given UTM zone, in radians.
+        """
+        return UTM.deg_to_rad(-183.0 + (zone * 6.0))
+
+    @staticmethod
+    def footpoint_latitude(y: float) -> float:
+        """
+        Computes the footpoint latitude for use in converting transverse Mercator coordinates.
+        
+        Args:
+            y: The UTM northing coordinate, in meters.
+            
+        Returns:
+            The footpoint latitude, in radians.
+        """
+        n = (UTM.sm_a - UTM.sm_b) / (UTM.sm_a + UTM.sm_b)
+        
+        # Precalculate coefficients
+        alpha_ = ((UTM.sm_a + UTM.sm_b) / 2.0) * (1 + (n**2 / 4) + (n**4 / 64))
+        y_ = y / alpha_
+        beta_ = (3.0 * n / 2.0) + (-27.0 * n**3 / 32.0) + (269.0 * n**5 / 512.0)
+        gamma_ = (21.0 * n**2 / 16.0) + (-55.0 * n**4 / 32.0)
+        delta_ = (151.0 * n**3 / 96.0) + (-417.0 * n**5 / 128.0)
+        epsilon_ = (1097.0 * n**4 / 512.0)
+        
+        # Calculate the sum of the series
+        return y_ + (beta_ * math.sin(2.0 * y_)) + (gamma_ * math.sin(4.0 * y_)) + \
+               (delta_ * math.sin(6.0 * y_)) + (epsilon_ * math.sin(8.0 * y_))
+
+    @staticmethod
+    def map_lat_lon_to_xy(phi: float, lambda_: float, lambda0: float) -> tuple:
+        """
+        Converts a latitude/longitude pair to x and y coordinates in the Transverse Mercator projection.
+        
+        Args:
+            phi: Latitude of the point, in radians.
+            lambda_: Longitude of the point, in radians.
+            lambda0: Longitude of the central meridian to be used, in radians.
+            
+        Returns:
+            A tuple (x, y) containing the coordinates of the computed point.
+        """
+        # Precalculate values
+        ep2 = (UTM.sm_a**2 - UTM.sm_b**2) / UTM.sm_b**2
+        nu2 = ep2 * math.cos(phi)**2
+        N = UTM.sm_a**2 / (UTM.sm_b * math.sqrt(1 + nu2))
+        t = math.tan(phi)
+        t2 = t * t
+        l = lambda_ - lambda0
+        
+        # Precalculate coefficients for l**n terms
+        l3coef = 1.0 - t2 + nu2
+        l4coef = 5.0 - t2 + 9 * nu2 + 4.0 * (nu2 * nu2)
+        l5coef = 5.0 - 18.0 * t2 + (t2 * t2) + 14.0 * nu2 - 58.0 * t2 * nu2
+        l6coef = 61.0 - 58.0 * t2 + (t2 * t2) + 270.0 * nu2 - 330.0 * t2 * nu2
+        l7coef = 61.0 - 479.0 * t2 + 179.0 * (t2 * t2) - (t2 * t2 * t2)
+        l8coef = 1385.0 - 3111.0 * t2 + 543.0 * (t2 * t2) - (t2 * t2 * t2)
+        
+        # Calculate easting (x)
+        x = N * math.cos(phi) * l
+        x += (N / 6.0) * math.cos(phi)**3 * l3coef * l**3
+        x += (N / 120.0) * math.cos(phi)**5 * l5coef * l**5
+        x += (N / 5040.0) * math.cos(phi)**7 * l7coef * l**7
+        
+        # Calculate northing (y)
+        y = UTM.arc_length_of_meridian(phi)
+        y += (t / 2.0) * N * math.cos(phi)**2 * l**2
+        y += (t / 24.0) * N * math.cos(phi)**4 * l4coef * l**4
+        y += (t / 720.0) * N * math.cos(phi)**6 * l6coef * l**6
+        y += (t / 40320.0) * N * math.cos(phi)**8 * l8coef * l**8
+        
+        return (x, y)
+
+    @staticmethod
+    def map_xy_to_lat_lon(x: float, y: float, lambda0: float) -> tuple:
+        """
+        Converts x and y coordinates in the Transverse Mercator projection to a latitude/longitude pair.
+        
+        Args:
+            x: The easting of the point, in meters.
+            y: The northing of the point, in meters.
+            lambda0: Longitude of the central meridian to be used, in radians.
+            
+        Returns:
+            A tuple (latitude, longitude) in radians.
+        """
+        # Get the value of phif, the footpoint latitude
+        phif = UTM.footpoint_latitude(y)
+        
+        # Precalculate values
+        ep2 = (UTM.sm_a**2 - UTM.sm_b**2) / UTM.sm_b**2
+        cf = math.cos(phif)
+        nuf2 = ep2 * cf**2
+        Nf = UTM.sm_a**2 / (UTM.sm_b * math.sqrt(1 + nuf2))
+        Nfpow = Nf
+        tf = math.tan(phif)
+        tf2 = tf * tf
+        tf4 = tf2 * tf2
+        
+        # Precalculate fractional coefficients for x**n terms
+        x1frac = 1.0 / (Nfpow * cf)
+        Nfpow *= Nf  # now equals Nf**2
+        x2frac = tf / (2.0 * Nfpow)
+        Nfpow *= Nf  # now equals Nf**3
+        x3frac = 1.0 / (6.0 * Nfpow * cf)
+        Nfpow *= Nf  # now equals Nf**4
+        x4frac = tf / (24.0 * Nfpow)
+        Nfpow *= Nf  # now equals Nf**5
+        x5frac = 1.0 / (120.0 * Nfpow * cf)
+        Nfpow *= Nf  # now equals Nf**6
+        x6frac = tf / (720.0 * Nfpow)
+        Nfpow *= Nf  # now equals Nf**7
+        x7frac = 1.0 / (5040.0 * Nfpow * cf)
+        Nfpow *= Nf  # now equals Nf**8
+        x8frac = tf / (40320.0 * Nfpow)
+        
+        # Precalculate polynomial coefficients for x**n terms
+        x2poly = -1.0 - nuf2
+        x3poly = -1.0 - 2 * tf2 - nuf2
+        x4poly = 5.0 + 3.0 * tf2 + 6.0 * nuf2 - 6.0 * tf2 * nuf2 - 3.0 * (nuf2 * nuf2) - 9.0 * tf2 * (nuf2 * nuf2)
+        x5poly = 5.0 + 28.0 * tf2 + 24.0 * tf4 + 6.0 * nuf2 + 8.0 * tf2 * nuf2
+        x6poly = -61.0 - 90.0 * tf2 - 45.0 * tf4 - 107.0 * nuf2 + 162.0 * tf2 * nuf2
+        x7poly = -61.0 - 662.0 * tf2 - 1320.0 * tf4 - 720.0 * (tf4 * tf2)
+        x8poly = 1385.0 + 3633.0 * tf2 + 4095.0 * tf4 + 1575 * (tf4 * tf2)
+        
+        # Calculate latitude
+        latitude = phif + x2frac * x2poly * (x * x)
+        latitude += x4frac * x4poly * x**4
+        latitude += x6frac * x6poly * x**6
+        latitude += x8frac * x8poly * x**8
+        
+        # Calculate longitude
+        longitude = lambda0 + x1frac * x
+        longitude += x3frac * x3poly * x**3
+        longitude += x5frac * x5poly * x**5
+        longitude += x7frac * x7poly * x**7
+        
+        return (latitude, longitude)
+    
+    @staticmethod
+    def get_zone_number(lat: float, lon: float) -> int:
+        """
+        Determines the UTM zone number for a given latitude and longitude.
+        
+        Args:
+            lat: Latitude of the point, in degrees.
+            lon: Longitude of the point, in degrees.
+            
+        Returns:
+            The UTM zone number (1-60).
+        """
+        # if lat < -80.0 or lat > 84.0:
+        #     raise ValueError("Latitude out of range for UTM zones.")
+        return int((lon + 180.0) / 6) + 1
+
+    @staticmethod
+    def lat_lon_to_utm(lat: float, lon: float, zone: int = None) -> tuple:
+        """
+        Converts a latitude/longitude pair to UTM coordinates.
+        
+        Args:
+            lat: Latitude of the point, in degrees.
+            lon: Longitude of the point, in degrees.
+            
+        Returns:
+            A tuple (easting, northing, zone, southhemi) where:
+                easting: UTM easting coordinate in meters
+                northing: UTM northing coordinate in meters
+                zone: UTM zone number
+                southhemi: True if in southern hemisphere, False otherwise
+        """
+        # Determine the zone
+        if zone is None:
+            zone = int((lon + 180.0) / 6) + 1
+        southhemi = lat < 0
+        
+        # Convert to radians
+        phi = UTM.deg_to_rad(lat)
+        lambda_ = UTM.deg_to_rad(lon)
+        lambda0 = UTM.utm_central_meridian(zone)
+        
+        # Get transverse mercator coordinates
+        x, y = UTM.map_lat_lon_to_xy(phi, lambda_, lambda0)
+        
+        # Adjust for UTM system
+        easting = x * UTM.UTMScaleFactor + 500000.0
+        northing = y * UTM.UTMScaleFactor
+        
+        if northing < 0.0:
+            northing += 10000000.0
+            
+        return (easting, northing, zone, southhemi)
+
+    @staticmethod
+    def utm_to_lat_lon(easting: float, northing: float, zone: int, southhemi: bool) -> tuple:
+        """
+        Converts UTM coordinates to a latitude/longitude pair.
+        
+        Args:
+            easting: UTM easting coordinate in meters
+            northing: UTM northing coordinate in meters
+            zone: UTM zone number
+            southhemi: True if in southern hemisphere, False otherwise
+            
+        Returns:
+            A tuple (latitude, longitude) in degrees.
+        """
+        # Adjust easting and northing
+        x = easting - 500000.0
+        x /= UTM.UTMScaleFactor
+        
+        if southhemi:
+            northing -= 10000000.0
+            
+        y = northing / UTM.UTMScaleFactor
+        
+        # Get central meridian for zone
+        lambda0 = UTM.utm_central_meridian(zone)
+        
+        # Convert to lat/lon
+        lat, lon = UTM.map_xy_to_lat_lon(x, y, lambda0)
+        
+        # Convert to degrees
+        return (UTM.rad_to_deg(lat), UTM.rad_to_deg(lon))
+    
+
+
+
+class Pixel2WGS84:
+    def __init__(self, matrix):
+        self.zone = matrix[0]
+        self.southhemi = matrix[1]
+        self.retval = np.array(matrix[2:], dtype=np.float64).reshape(3,3)
+    
+    def pixel2wgs84(self, pixels):
+        src_points = np.array(pixels, dtype=np.float64)
+        src_points = src_points.reshape(-1, 1, 2)
+        dst_points = cv2.perspectiveTransform(src_points, self.retval) #shape (N, 1, 2)
+        dst_points = dst_points.reshape(-1, 2)
+        wgs84_points = []
+        for point in dst_points.tolist():
+            lat, lon = UTM.utm_to_lat_lon(point[0], point[1], self.zone, self.southhemi)
+            wgs84_points.append([lon, lat])
+        return wgs84_points
+    
