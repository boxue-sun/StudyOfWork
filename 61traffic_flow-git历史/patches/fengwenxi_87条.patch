+/**
+ * @file polygon2d.hpp
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief 2D polygon calculation
+ * @version 0.1
+ * @date 2024-10-24
+ *
+ * <========================================================================>
+ *                   © 2024 FengWenxi. All Rights Reserved.
+ * <========================================================================>
+ *
+ */
+
+#ifndef _TRAFFIC_FLOW_POLYGON2D_HPP_
+#define _TRAFFIC_FLOW_POLYGON2D_HPP_
+
+#include "math_util.hpp"
+#include "vec2d.hpp"
+#include "segment2d.hpp"
+
+#include <vector>
+#include <string>
+#include <iostream>
+
+namespace fusion_perception::math {
+class Polygon2D {
+public:
+    Polygon2D() = default;
+    explicit Polygon2D(std::vector<Vec2D> points) : _points(std::move(points)) { build_from_points(); }
+
+    const std::vector<Vec2D>& points() const { return _points; }
+    const std::vector<Segment2D>& segments() const { return _segments; }
+    int num_points() const { return _num_points; }
+    bool is_convex() const { return _is_convex; }
+    double area() const { return _area; }
+
+    bool is_point_in(const Vec2D& point) const {
+        if (_points.size() < 3u) {
+            std::cerr << "_points.size() less than 3!" << std::endl;
+            return false;
+        }
+        if (is_point_on_boundary(point)) {
+            return true;
+        }
+        int j = _num_points - 1;
+        int c = 0;
+        for (int i = 0; i < _num_points; ++i) {
+            if ((_points[i].y() > point.y()) != (_points[j].y() > point.y())) {
+                const double side = cross_product(point, _points[i], _points[j]);
+                if (_points[i].y() < _points[j].y() ? side > 0.0 : side < 0.0) {
+                    ++c;
+                }
+            }
+            j = i;
+        }
+        return c & 1;
+    }
+    bool is_point_on_boundary(const Vec2D& point) const {
+        if (_points.size() < 3u) {
+            std::cerr << "_points.size() less than 3!" << std::endl;
+            return false;
+        }
+        return std::any_of(_segments.begin(), _segments.end(),
+                           [&](const Segment2D& poly_seg) { return poly_seg.is_point_in(point); });
+    }
+
+    std::string to_string() const {
+        std::ostringstream sout;
+        sout << "polygon2d (  num_points = " << _num_points << "  points = (";
+        for (const auto& pt : _points) {
+            sout << " " << pt.to_string();
+        }
+        sout << " )  " << (_is_convex ? "convex" : "non-convex") << "  area = " << _area << " )";
+        sout.flush();
+        return sout.str();
+    }
+
+protected:
+    void build_from_points() {
+        _num_points = _points.size();
+        if (_num_points < 3) {
+            std::cerr << "_num_points less than 3!" << std::endl;
+            return;
+        }
+
+        // Make sure the points are in ccw order.
+        _area = 0.0;
+        for (int i = 1; i < _num_points; ++i) {
+            _area += cross_product(_points[0], _points[i - 1], _points[i]);
+        }
+        if (_area < 0) {
+            _area = -_area;
+            std::reverse(_points.begin(), _points.end());
+        }
+        _area /= 2.0;
+        if (_area < DOUBLE_EPSILON) {
+            std::cerr << "_area less than DOUBLE_EPSILON!" << std::endl;
+            return;
+        }
+
+        // Construct segments.
+        _segments.reserve(_num_points);
+        for (int i = 0; i < _num_points; ++i) {
+            _segments.emplace_back(_points[i], _points[next(i)]);
+        }
+
+        // Check convexity.
+        _is_convex = true;
+        for (int i = 0; i < _num_points; ++i) {
+            if (cross_product(_points[prev(i)], _points[i], _points[next(i)]) <= -DOUBLE_EPSILON) {
+                _is_convex = false;
+                break;
+            }
+        }
+
+        // Compute aabox.
+        _min_x = _points[0].x();
+        _max_x = _points[0].x();
+        _min_y = _points[0].y();
+        _max_y = _points[0].y();
+        for (const auto& point : _points) {
+            _min_x = std::min(_min_x, point.x());
+            _max_x = std::max(_max_x, point.x());
+            _min_y = std::min(_min_y, point.y());
+            _max_y = std::max(_max_y, point.y());
+        }
+    }
+
+protected:
+    int next(int at) const { return at >= _num_points - 1 ? 0 : at + 1; }
+    int prev(int at) const { return at == 0 ? _num_points - 1 : at - 1; }
+
+    std::vector<Vec2D> _points;
+    int _num_points = 0;
+    std::vector<Segment2D> _segments;
+    bool _is_convex = false;
+    double _area = 0.0;
+    double _min_x = 0.0;
+    double _max_x = 0.0;
+    double _min_y = 0.0;
+    double _max_y = 0.0;
+};
+}  // namespace fusion_perception::math
+
+#endif
