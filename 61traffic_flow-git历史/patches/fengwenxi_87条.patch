+	LogLevel_Warn,
+	LogLevel_Error,
+	LogLevel_Fatal,
+	LogLevel_Off
+};
+
+/*
+ * @brief 融合感知消息
+ */
+struct FusionMsg {
+	uint16_t      version;       // 消息版本号
+	uint16_t      type;          // 消息类型
+	uint64_t      timestamp;     // 时间戳
+	uint64_t      body_size;     // 消息体大小
+	void*         body;          // 消息体
+};
+
+/*
+ * @brief 图像类消息
+ */
+struct RawImageMsg {
+	uint16_t      version;       // 消息版本号
+	int           camera_id;     // 相机ID
+	int           frame_id;      // 帧ID
+	void*		  image_cpu;	 // 图像数据
+	int           image_type;    // 图像色彩空间类型，RGBA：0，RGB：1，BGR：2，GRAY：3，BGRA：4
+	int           height;        // 图像高度
+	int           width;         // 图像宽度
+	int           channel;       // 图像通道数
+	uint64_t      timestamp;     // 时间戳
+};
+
+/*
+ * @brief 定义主接口和结构体
+ */
+#define FP_MAIN_API(NAME)                                                                                                                       \
+		FP_STRUCT(NAME);                                                                                                                        \
+		FS_STRUCT(NAME);                                                                                                                        \
+		FP_EXPORT const FP##NAME* FP_API_CALL NAME##GetApi(int api_version) NO_EXCEPTION;                                                       \
+		FP_EXPORT void FP_API_CALL NAME##SetApi(const FS##NAME* src) NO_EXCEPTION;                                                              \
+		FP_EXPORT void FP_API_CALL NAME##ReleaseApi(const FP##NAME* api) NO_EXCEPTION;                                                          \
+		FP_EXPORT int FP_API_CALL NAME##GetVersion() NO_EXCEPTION;                                                                              \
+		struct FP##NAME {                                                                                                                       \
+			int Version;                                                                                                                        \
+			int APIVersion;                                                                                                                     \
+			void* Params;																													    \
+			FP_API_PARAMS(NAME##_Init, int, _In_ const char* config_path, _In_ void* params);                                                   \
+			FP_API_PARAMS(NAME##_Release, void, _In_ void* params);                                                                             \
+			FP_API_PARAMS(NAME##_OnPublish, void, _In_ uint8_t id, _Out_ void* msg, _In_ void* params);                                         \
+			FP_API_PARAMS(NAME##_OnDiscovery, void, _In_ uint8_t id, _In_ DiscoveryStatus status, _In_ const char* guid, _In_ void* params);    \
+			FP_API_PARAMS(NAME##_OnMatched, void, _In_ uint8_t id, _In_ int current_count, _In_ int current_count_change, _In_ void* params);   \
+			FP_API_PARAMS(NAME##_OnDataAvailable, void, _In_ uint8_t id, _In_ const void* msg, _In_ void* params);                              \
+		};                                                                                                                                      \
+		struct FS##NAME {                                                                                                                       \
+			int Version;                                                                                                                        \
+			void* Params;                                                                                                                       \
+			FP_API_PARAMS(NAME##_Publish, int, _In_ uint8_t id, _In_ const void* msg, _In_ void* params);                                       \
+			FP_API_PARAMS(NAME##_Log, void, _In_ LogLevel level, _In_ const char* fmt, _In_ ...);                                               \
+		};
+
+
+/* 用法示例
