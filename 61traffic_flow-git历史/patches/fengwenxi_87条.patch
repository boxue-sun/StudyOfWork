+/**
+ * @file math_util.hpp
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief Util for mathematical calculation
+ * @version 0.1
+ * @date 2024-10-24
+ *
+ * <========================================================================>
+ *                   © 2024 FengWenxi. All Rights Reserved.
+ * <========================================================================>
+ *
+ */
+#ifndef _TRAFFIC_FLOW_MATH_UTIL_HPP_
+#define _TRAFFIC_FLOW_MATH_UTIL_HPP_
+
+#include <algorithm>
+
+namespace fusion_perception::math {
+
+const double DOUBLE_EPSILON = std::numeric_limits<double>::epsilon();
+
+inline bool is_within(double val, double bound1, double bound2) {
+    if (bound1 > bound2) {
+        std::swap(bound1, bound2);
+    }
+    return (val >= bound1 - DOUBLE_EPSILON) && (val <= bound2 + DOUBLE_EPSILON);
+}
+
+}  // namespace fusion_perception::math
+
+#endif
