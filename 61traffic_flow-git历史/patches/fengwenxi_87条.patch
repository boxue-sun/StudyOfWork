+#include "FusionPlugin.h"
+#include "traffic_flow_service_impl.h"
+#include "log.h"
+#include "quality.h"
+
+#include <string.h>
+#include <string>
+#include <iostream>
+#include <fstream>
+#include <sstream>
+#include <chrono>
+#include <climits>
+
+namespace traffic_flow::plugin {
+
+const FSTrafficFlowService* TrafficFlowServiceImpl::s_fs_api_ = nullptr;
+
+int static_publish(uint8_t id, void* msg, void* params) {
+    if (TrafficFlowServiceImpl::s_fs_api_ == nullptr) {
+        return CC_INVALID_ARGUMENT;
+    }
+    return TrafficFlowServiceImpl::s_fs_api_->TrafficFlowService_Publish(id, msg, params);
+}
+
+int TrafficFlowServiceImpl::msg_to_external_result(
+        const FusionMsg& msg,
+        data_type::ExternalResult& external_object) {
+    std::string contents = std::string(static_cast<char*>(msg.body), msg.body_size);
+    if (contents.empty()) {
+        std::cerr << "msg to external result The json content from the FusionMsg body was empty."
+                  << std::endl;
+        return CC_FAIL;
+    }
+    nlohmann::json j;
+    try {
+        external_object = nlohmann::json::parse(contents);
+        return CC_OK;
+    } catch (std::exception& e) {
+        fprintf(stderr, "Unable to parse JSON from file: %s\n", e.what());
+        return CC_FAIL;
+    }
+}
+
+int TrafficFlowServiceImpl::msg_to_internal_result(
+        const FusionMsg& msg,
+        data_type::InternalResult& internal_result) {
+    std::string contents = std::string(static_cast<char*>(msg.body), msg.body_size);
+    if (contents.empty()) {
+        std::cerr << "msg to internal result The json content from the FusionMsg body was empty."
+                  << std::endl;
+        return CC_FAIL;
+    }
+    nlohmann::json j;
+    try {
+        internal_result = nlohmann::json::parse(contents);
+        return CC_OK;
+    } catch (std::exception& e) {
+        fprintf(stderr, "Unable to parse JSON from file: %s\n", e.what());
+        return CC_FAIL;
+    }
+}
+
+int TrafficFlowServiceImpl::internal_result_to_buffer(
+        const data_type::InternalResult& internal_result,
+        std::vector<uint8_t>& msg_buffer) {
+    try {
+        msg_buffer.clear();
+        nlohmann::json j = internal_result;
+        std::string str = j.dump();
+        if (str.empty()) {
+            return CC_OK;
+        } else {
+            msg_buffer.assign(str.begin(), str.end());
+            msg_buffer.emplace_back('\0');
+            return CC_OK;
+        }
+    } catch (std::exception& e) {
+        fprintf(stderr, "Unable to parse JSON from struct: %s\n", e.what());
+        return CC_FAIL;
+    }
+}
+
+int TrafficFlowServiceImpl::Init(const char* config_path) {
+    if (config_path == nullptr) {
+        return CC_INVALID_ARGUMENT;
+    }
+
+    /* Read config file */
+    std::ifstream ifile;
+    ifile.open(config_path, std::ios::in);
+    if (!ifile.is_open()) {
+        if (s_fs_api_ != nullptr && s_fs_api_->TrafficFlowService_Log != nullptr) {
+            s_fs_api_->TrafficFlowService_Log(
+                    LogLevel_Error, "Unable to open file: %s", config_path);
+        }
+        return CC_FAIL;
+    }
+
+    Quality::Create(
+            "TrafficFlowService",
+            static_publish,
+            static_cast<uint8_t>(PartId::QualityJsonPub),
+            s_fs_api_->Params);
+
+    std::stringstream buffer;
+    buffer << ifile.rdbuf();
+    std::string contents = buffer.str();
+    ifile.close();
+
+    if (contents.empty()) {
+        if (s_fs_api_ != nullptr && s_fs_api_->TrafficFlowService_Log != nullptr) {
+            s_fs_api_->TrafficFlowService_Log(
+                    LogLevel_Error, "The json content from the file was empty: %s", config_path);
+        }
+        return CC_FAIL;
+    }
+
+    /* Read info from config file. */
+    try {
+        nlohmann::json j = nlohmann::json::parse(contents);
+        nlohmann::json j_global_default_info = j["global_default_info"];
+
+        core::FusionInfo global_default_info;
+        global_default_info.time_thresh = j_global_default_info["time_thresh"];
+        global_default_info.pixel_thresh = j_global_default_info["pixel_thresh"];
+        global_default_info.time_compensation = j_global_default_info["time_compensation"];
+        global_default_info.object_clear_time = j_global_default_info["object_clear_time"];
+        global_default_info.internal.buffer_size = j_global_default_info["internal_buffer_size"];
+        global_default_info.internal.width = j_global_default_info["internal_width"];
+        global_default_info.internal.height = j_global_default_info["internal_height"];
+        global_default_info.external.buffer_size = j_global_default_info["external_buffer_size"];
+        global_default_info.external.normalized_width = j_global_default_info["external_normalized_width"];
+        global_default_info.external.normalized_height = j_global_default_info["external_normalized_height"];
+
+        nlohmann::json j_devices = j["devices"];
+        for (const auto& one_device_j : j_devices) {
+            std::string id = one_device_j["id"];
+            core::FusionInfo one_fusion_info = global_default_info;
+            if (one_device_j.contains("time_thresh")) {
+                one_fusion_info.time_thresh = one_device_j["time_thresh"];
+            }
+            if (one_device_j.contains("pixel_thresh")) {
+                one_fusion_info.pixel_thresh = one_device_j["pixel_thresh"];
+            }
+            if (one_device_j.contains("time_compensation")) {
+                one_fusion_info.time_compensation = one_device_j["time_compensation"];
+            }
+            if (one_device_j.contains("object_clear_time")) {
+                one_fusion_info.object_clear_time = one_device_j["object_clear_time"];
+            }
+
+            if (one_device_j.contains("internal_buffer_size")) {
+                one_fusion_info.internal.buffer_size = one_device_j["internal_buffer_size"];
+            }
+            if (one_device_j.contains("internal_buffer_size")) {
+                one_fusion_info.internal.buffer_size = one_device_j["internal_buffer_size"];
+            }
+            if (one_device_j.contains("internal_height") &&
+                one_device_j.contains("internal_width")) {
+                one_fusion_info.internal.height = one_device_j["internal_height"];
+                one_fusion_info.internal.width = one_device_j["internal_width"];
+            } else if (
+                    one_device_j.contains("internal_height") ||
+                    one_device_j.contains("internal_width")) {
+                if (s_fs_api_ != nullptr && s_fs_api_->TrafficFlowService_Log != nullptr) {
+                    s_fs_api_->TrafficFlowService_Log(
+                            LogLevel_Error,
+                            "Internal info for: %s lacks another resolution parameter(height "
+                            "or "
+                            "width).",
+                            id.c_str());
+                }
+                return CC_INVALID_ARGUMENT;
+            }
+
+            if (one_device_j.contains("external_buffer_size")) {
+                one_fusion_info.external.buffer_size = one_device_j["external_buffer_size"];
+            }
+            if (one_device_j.contains("external_normalized_height") &&
+                one_device_j.contains("external_normalized_width")) {
+                one_fusion_info.external.normalized_height = one_device_j["external_normalized_height"];
+                one_fusion_info.external.normalized_width = one_device_j["external_normalized_width"];
+            } else if (
+                    one_device_j.contains("external_normalized_height") ||
+                    one_device_j.contains("external_normalized_width")) {
+                if (s_fs_api_ != nullptr && s_fs_api_->TrafficFlowService_Log != nullptr) {
+                    s_fs_api_->TrafficFlowService_Log(
+                            LogLevel_Error,
+                            "External info for: %s lacks another resolution parameter(height "
+                            "or "
+                            "width).",
+                            id.c_str());
+                }
+                return CC_INVALID_ARGUMENT;
+            }
+            device_info_map_[id] = one_fusion_info;
+        }
+    } catch (std::exception& e) {
+        if (s_fs_api_ != nullptr && s_fs_api_->TrafficFlowService_Log != nullptr) {
+            s_fs_api_->TrafficFlowService_Log(
+                    LogLevel_Error, "Unable to parse JSON from file: %s", e.what());
+        }
+        return CC_INVALID_ARGUMENT;
+    }
+
+    /* Construct DataFuser according to device_map_ */
+    for (const auto& it : device_info_map_) {
+        if (s_fs_api_ != nullptr && s_fs_api_->TrafficFlowService_Log != nullptr) {
+            s_fs_api_->TrafficFlowService_Log(
+                    LogLevel_Info, "Adding data fuser for: ", it.first.c_str());
+        }
+        std::shared_ptr<core::DataFuser> one_data_fuser_ptr =
+                std::make_shared<core::DataFuser>(it.first, it.second);
+        fuser_map_[it.first] = one_data_fuser_ptr;
+    }
+
+    return CC_OK;
+}
+
+void TrafficFlowServiceImpl::Release() {
+    std::cout << "Releaseing TrafficFlowServiceImpl" << std::endl;
+}
+
+void TrafficFlowServiceImpl::OnDiscovery(uint8_t id, DiscoveryStatus status, const char* guid) {
+    if (guid == nullptr) {
+        return;
+    }
+    std::stringstream ss;
+    if (id == static_cast<uint8_t>(PartId::RSMJsonSub)) {
+        ss << "[RSMJsonSubscriber]";
+    } else if (id == static_cast<uint8_t>(PartId::ExternalJsonSub)) {
+        ss << "[ExternalJsonSubscriber]";
+    } else if (id == static_cast<uint8_t>(PartId::RSMJsonPub)) {
+        ss << "[RSMJsonPublisher]";
+    } else {
+        return;
+    }
+
+    if (status == DiscoveryStatus_Discovered) {
+        ss << " Discovered: ";
+    } else if (status == DiscoveryStatus_Removed) {
+        ss << " Removed: ";
+    } else if (status == DiscoveryStatus_Dropped) {
+        ss << " Dropped: ";
+    } else {
+        return;
+    }
+
+    ss << std::string(guid);
+    s_fs_api_->TrafficFlowService_Log(LogLevel_Info, ss.str().c_str());
+}
+
+void TrafficFlowServiceImpl::OnMatched(uint8_t id, int current_count, int current_count_change) {
+    std::stringstream ss;
+    if (id == static_cast<uint8_t>(PartId::RSMJsonSub)) {
+        ss << "[RSMJsonSubscriber] Matched: %d";
+    } else if (id == static_cast<uint8_t>(PartId::ExternalJsonSub)) {
+        ss << "[ExternalJsonSubscriber] Matched: %d";
+    } else if (id == static_cast<uint8_t>(PartId::RSMJsonPub)) {
+        ss << "[RSMJsonPublisher] Matched: %d";
+    } else {
+        ss << "No Matched: " << id << std::endl;
+        return;
+    }
+
+    s_fs_api_->TrafficFlowService_Log(LogLevel_Info, ss.str().c_str(), current_count);
+}
+
+void TrafficFlowServiceImpl::OnDataAvailable(uint8_t id, const void* msg) {
+    // std::cout << "Receive message id:" << id << std::endl;
+    if (msg == nullptr) {
+        s_fs_api_->TrafficFlowService_Log(
+                LogLevel_Warn, "TrafficFlowServiceImpl::OnDataAvailable() msg empty.");
+        return;
+    }
+
+    uint64_t start_ondata_time = Quality::Timestamp();
+
+    const FusionMsg* rsm_msg = static_cast<const FusionMsg*>(msg);
+    if (rsm_msg->body_size == 0 || rsm_msg->body == nullptr) {
+        std::cout << "TrajectoryFusionImpl::OnDataAvailable() rsm_msg params empty." << std::endl;
+        return;
+    }
+
+    PartId message_type = static_cast<PartId>(id);
+
+    switch (message_type) {
+    case PartId::RSMJsonSub: {
+        data_type::InternalResult one_internal;
+        int ret = msg_to_internal_result(*rsm_msg, one_internal);
+        if (ret != CC_OK) {
+            s_fs_api_->TrafficFlowService_Log(LogLevel_Warn, "Error: RSMJson to internal result.");
+            return;
+        }
+        s_fs_api_->TrafficFlowService_Log(LogLevel_Info, "Received one RSMJson.");
+        auto find_it = fuser_map_.find(one_internal.dev_no);
+        if (find_it == fuser_map_.end()) {
+            s_fs_api_->TrafficFlowService_Log(
+                    LogLevel_Fatal,
+                    "Can't find corresponding data fuser for:",
+                    one_internal.dev_no);
+            return;
+        }
+        find_it->second->match_internal_result(one_internal);
+
+        FusionMsg output_msg;
+        output_msg.version = 1;
+        output_msg.timestamp = get_timestamp();
+        output_msg.type = static_cast<uint16_t>(TopicType_RSMJson);
+        output_msg.body_size = 0;
+        output_msg.body = nullptr;
+
+        std::vector<uint8_t> msg_buffer;
+
+        if (internal_result_to_buffer(one_internal, msg_buffer) != CC_OK) {
+            s_fs_api_->TrafficFlowService_Log(LogLevel_Fatal, "Can't transfer result to RSMjson!");
+            return;
+        }
+        output_msg.body_size = msg_buffer.size();
+        output_msg.body = msg_buffer.data();
+
+        int code = s_fs_api_->TrafficFlowService_Publish(
+                static_cast<uint8_t>(PartId::RSMJsonPub), &output_msg, s_fs_api_->Params);
+        if (code != CC_OK && s_fs_api_->TrafficFlowService_Log) {
+            s_fs_api_->TrafficFlowService_Log(LogLevel_Error, "[Publish] error code: %d", code);
+        }
+
+        uint64_t end_ondata_time = Quality::Timestamp();
+        std::cout << "[INFO] publish cost time:" << (end_ondata_time - start_ondata_time) << "[ms]"
+                  << std::endl;
+        Quality::Push(0, start_ondata_time, end_ondata_time);
+
+        break;
+    }
+    case PartId::ExternalJsonSub: {
+        data_type::ExternalResult one_external;
+        int ret = msg_to_external_result(*rsm_msg, one_external);
+        if (ret != CC_OK) {
+            s_fs_api_->TrafficFlowService_Log(
+                    LogLevel_Warn, "Error: ExternalJson to external result.");
+            return;
+        }
+        s_fs_api_->TrafficFlowService_Log(LogLevel_Info, "Received one ExternalJson.");
+        auto find_it = fuser_map_.find(one_external.dev_no);
+        if (find_it == fuser_map_.end()) {
+            s_fs_api_->TrafficFlowService_Log(
+                    LogLevel_Fatal,
+                    "Can't find corresponding data fuser for:",
+                    one_external.dev_no);
+            return;
+        }
+        find_it->second->add_external_result(one_external);
+        break;
+    }
+    default: {
+        s_fs_api_->TrafficFlowService_Log(LogLevel_Warn, "Received Unknown data.");
+        break;
+    }
+    }
+    return;
+}
+
+void TrafficFlowServiceImpl::OnPublish(uint8_t id, void* msg) {
+    std::cout << "Error: this shouldn't be showing." << std::endl;
+}
+
+uint64_t TrafficFlowServiceImpl::get_timestamp() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                         std::chrono::system_clock().now().time_since_epoch())
+                                         .count());
+}
+
+}  // namespace traffic_flow::plugin
