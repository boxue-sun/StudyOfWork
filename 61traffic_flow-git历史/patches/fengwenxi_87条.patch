diff --git a/src/traffic_flow/detectors/accumulate_waste_time_detector.cpp b/src/traffic_flow/detectors/accumulate_waste_time_detector.cpp
new file mode 100644
index 0000000..29f4449
--- /dev/null
+++ b/src/traffic_flow/detectors/accumulate_waste_time_detector.cpp
@@ -0,0 +1,201 @@
+#include "detectors/accumulate_waste_time_detector.h"
+#include "traffic_flow/signal_phase_manager.h"
+#include <algorithm>
+#include <iostream>
+
+namespace fusion_perception::traffic_flow {
+
+// ---------------------------------------------------------------------------
+// 辅助函数
+// ---------------------------------------------------------------------------
+
+bool AccumulateWasteTimeDetector::is_large_vehicle(const TrafficObject& obj) {
+    return obj.inner_type == InnerType::BUS || obj.inner_type == InnerType::TRUCK;
+}
+
+double AccumulateWasteTimeDetector::get_normal_gap(bool prev_large, bool curr_large) {
+    // 前车 → 后车 的正常跟车时距（秒）
+    //          后车小   后车大
+    // 前车小    1.5      2.5
+    // 前车大    2.0      3.0
+    if (!prev_large && !curr_large) return 1.5;
+    if (!prev_large &&  curr_large) return 2.5;
+    if ( prev_large && !curr_large) return 2.0;
+    return 3.0;  // prev_large && curr_large
+}
+
+// ---------------------------------------------------------------------------
+// 信号灯状态查询
+// ---------------------------------------------------------------------------
+
+void AccumulateWasteTimeDetector::on_signal_update(const SignalPhaseManager* /*spm*/) {
+    // 已废弃：当前帧灯色在 update() 里通过 _current_ref_phase_passable 直接记住。
+}
+
+bool AccumulateWasteTimeDetector::is_green_at(uint64_t frame_timestamp) const {
+    // 直接查询 SignalPhaseManager 当前缓存的灯色（它总是最新一帧的信号）。
+    // 由于 update() 在调用 is_green_at 时会持有 PerceptionResult.timestamp，
+    // 我们只需要知道“最近一次收到的信号灯报文中该相位的灯色”。
+    // 这里由外部传入当前帧是否放行：在 update() 里查询 spm->light_of(ref_id) 并记住。
+    // 但为了简洁，我们改用另一种策略：
+    // 每次 update() 处理一帧时，先用 _current_ref_phase_passable 记住这帧参考相位的灯色，
+    // 之后的车辆配对就能直接用。
+    // 这是旧逻辑（从未记录过灯色）→ 返回 false（非绿灯）
+    return _current_ref_phase_passable;
+}
+
+// ---------------------------------------------------------------------------
+// 构造 / 更新 / 输出
+// ---------------------------------------------------------------------------
+
+AccumulateWasteTimeDetector::AccumulateWasteTimeDetector(
+    const std::string& detector_id, const CoilInfo& coil_info, WasteTimeCycleStore* cycle_store,
+    const SignalPhaseManager* spm)
+    : AccumulateDetector(detector_id), _coil_info(coil_info),
+      _tracker(coil_info.stop_line_segments), _cycle_store(cycle_store),
+      _signal_phase_manager(spm) {
+    std::string lane_tag = _coil_info.tag;
+    _lane_acc[lane_tag] = LaneWasteTimeAcc{
+        0, false, false, 0.0, 0,
+        {{"lane_tag", lane_tag},
+         {"road_section_tag", _coil_info.road_section_info.tag},
+         {"lane_no", _coil_info.lane_no},
+         {"lane_id", _coil_info.lane_id},
+         {"turn_dir_no", _coil_info.turn_dir_no}}
+    };
+}
+
+void AccumulateWasteTimeDetector::update(const PerceptionResult& frame) {
+    _last_frame_ts = frame.timestamp;
+    ++_dbg_frame_count;
+
+    // 先用当前信号状态标记这帧：查询参考相位灯色
+    _current_ref_phase_passable = false;
+    int dbg_ref_id = -1;
+    int dbg_phase_light = -1;  // PhaseLight: 0=GREEN,1=RED,2=NOT_CONTROLLED,3=NO_DATA
+    if (_signal_phase_manager) {
+        dbg_ref_id = _signal_phase_manager->reference_phase_id();
+        PhaseLight light = _signal_phase_manager->light_of(dbg_ref_id);
+        _current_ref_phase_passable = is_passable(light);
+        dbg_phase_light = static_cast<int>(light);
+    }
+    // [WasteDbg] 参考相位灯色变化时打印(低频),确认 ref_phase 是否被读到、是否出现过 GREEN
+    if (dbg_phase_light != _dbg_last_ref_light) {
+        std::cout << "[WasteDbg][" << get_detector_id() << "] LIGHT-CHANGE frame#" << _dbg_frame_count
+                  << " ts=" << frame.timestamp
+                  << " ref_phase=" << dbg_ref_id
+                  << " PhaseLight=" << dbg_phase_light
+                  << " passable=" << (_current_ref_phase_passable ? 1 : 0)
+                  << std::endl;
+        _dbg_last_ref_light = dbg_phase_light;
+    }
+
+    auto crossed = _tracker.process_frame(frame);
+    // [WasteDbg] 只在有越线时打印,确认 tracker 运行时是否真的检测到越线
+    if (!crossed.empty()) {
+        _dbg_cross_total += crossed.size();
+        std::cout << "[WasteDbg][" << get_detector_id() << "] CROSS frame#" << _dbg_frame_count
+                  << " ts=" << frame.timestamp
+                  << " crossed=" << crossed.size()
+                  << " total_cross=" << _dbg_cross_total
+                  << " ref_passable=" << (_current_ref_phase_passable ? 1 : 0)
+                  << std::endl;
+    }
+    for (const auto& obj : crossed) {
+        auto& acc = _lane_acc[_coil_info.tag];
+        uint64_t current_time = frame.timestamp;
+        // 前车车尾离开停止线的时刻 = 车头到达时刻 + 车身通过时间
+        double speed_ms = obj.speed / 3.6;
+        uint64_t tail_time = current_time;
+        if (speed_ms > 0.1) {
+            tail_time = current_time + static_cast<uint64_t>(obj.length / speed_ms * 1000);
+        }
+
+        bool curr_is_large = is_large_vehicle(obj);
+        bool curr_is_green = _current_ref_phase_passable;
+
+        if (acc.last_tail_time > 0 && acc.last_is_green && curr_is_green) {
+            // gap = 后车车头到达 - 前车车尾离开
+            double gap_sec = 0.0;
+            if (current_time > acc.last_tail_time) {
+                gap_sec = (current_time - acc.last_tail_time) / 1000.0;
+            }
+            double normal = get_normal_gap(acc.last_is_large, curr_is_large);
+            double waste = gap_sec - normal;
+            if (waste > 0) {
+                acc.waste_time_sum += waste;
+                acc.waste_details.push_back(std::to_string(waste));
+            } else {
+                acc.waste_details.push_back("0");
+            }
+            ++acc.pair_count;
+            std::cout << "[WasteDbg][" << get_detector_id() << "] PAIR-OK"
+                      << " gap=" << gap_sec << " normal=" << normal << " waste=" << waste
+                      << " pair_count=" << acc.pair_count
+                      << " waste_sum=" << acc.waste_time_sum << std::endl;
+        } else {
+            // [WasteDbg] 打印配对被跳过的确切原因:last_tail/last_green/curr_green
+            std::cout << "[WasteDbg][" << get_detector_id() << "] PAIR-SKIP"
+                      << " last_tail=" << acc.last_tail_time
+                      << " last_green=" << (acc.last_is_green ? 1 : 0)
+                      << " curr_green=" << (curr_is_green ? 1 : 0) << std::endl;
+        }
+
+        acc.last_tail_time = tail_time;
+        acc.last_is_large = curr_is_large;
+        acc.last_is_green = curr_is_green;
+    }
+}
+
+
+
+nlohmann::json AccumulateWasteTimeDetector::calculate_once() {
+    nlohmann::json result = nlohmann::json::array();
+    for (auto& [lane_tag, acc] : _lane_acc) {
+        // [WasteDbg] 每个信号周期结束时汇总:本周期配了几对、累计浪费多少秒
+        std::cout << "[WasteDbg][" << get_detector_id() << "] CYCLE-END lane=" << lane_tag
+                  << " pair_count=" << acc.pair_count
+                  << " waste_sum=" << acc.waste_time_sum
+                  << " frames=" << _dbg_frame_count
+                  << " total_cross=" << _dbg_cross_total << std::endl;
+        nlohmann::json entry = acc.meta;
+        entry["WasteTime"] = acc.waste_time_sum;
+
+        std::string detail;
+        for (size_t i = 0; i < acc.waste_details.size(); ++i) {
+            if (i > 0) detail += ",";
+            detail += acc.waste_details[i];
+        }
+        entry["WasteTimeDetail"] = detail;
+        result.push_back(entry);
+
+        // 本次结果对应一个完整信号灯周期，落成样本供栅格通道（5min）求平均。
+        if (_cycle_store) {
+            _cycle_store->add_lane_sample(lane_tag, acc.waste_time_sum, _last_frame_ts);
+        }
+
+        reset_lane(acc);
+    }
+    _tracker.clear_crossing_state();
+    return result;
+}
+
+// 开窗前的残周期不是「完整信号灯周期」，只清状态、不落样本，
+// 否则半截数据会被平均进分钟级结果。
+void AccumulateWasteTimeDetector::drain() {
+    for (auto& [lane_tag, acc] : _lane_acc) {
+        reset_lane(acc);
+    }
+    _tracker.clear_crossing_state();
+}
+
+void AccumulateWasteTimeDetector::reset_lane(LaneWasteTimeAcc& acc) {
+    acc.last_tail_time = 0;
+    acc.last_is_large = false;
+    acc.last_is_green = false;
+    acc.waste_time_sum = 0.0;
+    acc.pair_count = 0;
+    acc.waste_details.clear();
+}
+
+}  // namespace fusion_perception::traffic_flow
