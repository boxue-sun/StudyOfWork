+#ifndef _LOG_H_
+#define _LOG_H_
+
+#include <FusionPlugin.h>
+#include <string>
+#include <queue>
+#include <mutex>
+#include <cstdint>
+
+namespace data_fusion::plugin {
+
+/*
+ * @brief 日志类
+ */
+class Log {
+public:
+    /**
+     * @brief 创建日志
+     *
+     * @param name 日志名称
+     * @param level 日志级别
+     * @param queue_size 队列最大长度
+     * @return 是否创建成功
+     */
+    static bool Create(const std::string& name, const std::string& level, size_t queue_size);
+
+    /**
+     * @brief 将日志消息加入队列（线程安全）
+     *
+     * @param level 日志级别
+     * @param message 日志消息
+     */
+    static void Enqueue(LogLevel level, const std::string& message);
+
+    /**
+     * @brief 从队列中取出日志消息（线程安全）
+     *
+     * @param dst 存储日志消息的字符串
+     * @return 是否有消息被取出
+     */
+    static bool Dequeue(std::string& dst);
+
+    /**
+     * @brief 格式化字符串
+     *
+     * @param fmt 格式化字符串
+     * @param ... 可变参数
+     * @return std::string 格式化后的字符串
+     */
+    static std::string Format(const char* fmt, ...);
+
+    /**
+     * @brief 输出信息级别的日志
+     *
+     * @param fmt 格式化字符串
+     * @param args 可变参数
+     */
+    template <typename... Args>
+    static void Info(const char* fmt, const Args&... args) {
+        if (LogLevel_Info < level_) {
+            return;
+        }
+        if (sizeof...(Args) == 0) {
+            Enqueue(LogLevel_Info, std::string(fmt));
+        } else {
+            Enqueue(LogLevel_Info, Format(fmt, args...));
+        }
+    }
+
+    /**
+     * @brief 输出警告级别的日志
+     *
+     * @param fmt 格式化字符串
+     * @param args 可变参数
+     */
+    template <typename... Args>
+    static void Warn(const char* fmt, const Args&... args) {
+        if (LogLevel_Warn < level_) {
+            return;
+        }
+        if (sizeof...(Args) == 0) {
+            Enqueue(LogLevel_Warn, std::string(fmt));
+        } else {
+            Enqueue(LogLevel_Warn, Format(fmt, args...));
+        }
+    }
+
+    /**
+     * @brief 输出错误级别的日志
+     *
+     * @param fmt 格式化字符串
+     * @param args 可变参数
+     */
+    template <typename... Args>
+    static void Error(const char* fmt, const Args&... args) {
+        if (LogLevel_Error < level_) {
+            return;
+        }
+        if (sizeof...(Args) == 0) {
+            Enqueue(LogLevel_Error, std::string(fmt));
+        } else {
+            Enqueue(LogLevel_Error, Format(fmt, args...));
+        }
+    }
+
+    /**
+     * @brief 输出致命错误级别的日志
+     *
+     * @param fmt 格式化字符串
+     * @param args 可变参数
+     */
+    template <typename... Args>
+    static void Fatal(const char* fmt, const Args&... args) {
+        if (LogLevel_Fatal < level_) {
+            return;
+        }
+        if (sizeof...(Args) == 0) {
+            Enqueue(LogLevel_Fatal, std::string(fmt));
+        } else {
+            Enqueue(LogLevel_Fatal, Format(fmt, args...));
+        }
+    }
+
+    static std::queue<std::string> queue_;
+
+    static std::mutex mutex_;
+
+    static std::string name_;
+
+    static LogLevel level_;
+
+    static size_t queue_size_;
+
+protected:
+    /**
+     * @brief 获取日志级别
+     *
+     * @param level 日志级别字符串
+     * @return LogLevel 对应的日志级别枚举值
+     */
+    static LogLevel GetLevel(const std::string& level);
+
+    /**
+     * @brief 获取日志前缀
+     *
+     * @param level 日志级别
+     * @return std::string 对应的日志前缀
+     */
+    static std::string GetPrefix(LogLevel level);
+};
+
+}  // namespace data_fusion::plugin
+
+#ifndef CHECK_OK
+/**
+ * @brief 检查函数执行结果
+ * 确认返回值是否为0，如果不为0则打印错误日志并返回返回值
+ *
+ * @param code 函数执行结果
+ * @return 当函数执行结果不为0时返回函数执行结果
+ */
+#define CHECK_OK(code)                                               \
+    do {                                                             \
+        auto ret = code;                                             \
+        if (ret != 0) {                                              \
+            data_fusion::plugin::Log::Error("CHECK FAILED, code: %d", ret); \
+            return ret;                                              \
+        }                                                            \
+    } while (false);
+#endif
+
+#ifndef CHECK_OK_MSG
+/**
+ * @brief 检查函数执行结果
+ * 确认返回值是否为0，如果不为0则打印错误日志并返回返回值
+ *
+ * @param code 函数执行结果
+ * @param msg 错误信息
+ * @return 当函数执行结果不为0时返回函数执行结果
+ */
+#define CHECK_OK_MSG(code, msg)                                                    \
+    do {                                                                           \
+        auto ret = code;                                                           \
+        if (ret != 0) {                                                            \
+            data_fusion::plugin::Log::Error("CHECK FAILED, code: %d, msg: %s", ret, msg); \
+            return ret;                                                            \
+        }                                                                          \
+    } while (false);
+#endif
+
+#endif
