+    def _make_update_display(self, label):
+        # 返回一个update_display方法，绘制所有车道线与点（含当前车道高亮，非当前车道淡色/透明度20%）
+        def update_display():
+            img = label.image.copy()
+            disp_w = int(label.width * (1.0 if label.is_full_size else label.scale_factor))
+            disp_h = int(label.height * (1.0 if label.is_full_size else label.scale_factor))
+            if not label.is_full_size:
+                img = cv2.resize(img, (disp_w, disp_h), interpolation=cv2.INTER_AREA)
+
+            # 先画所有车道，非当前车道淡色（20%透明度），当前车道后面高亮
+            overlay = img.copy()
+            for lane_idx, lane in enumerate(label.lanes):
+                is_current = (lane_idx == label.current_lane_idx)
+                # 非当前车道: 线1蓝色(255,0,0)淡色, 线2红色(0,0,255)淡色
+                if is_current:
+                    continue  # 当前车道后面画
+                color1 = (255, 0, 0)  # 蓝色
+                color2 = (0, 0, 255)  # 红色
+                # 画线1点
+                for pt in lane["line1_points"]:
+                    px, py = pt[0], pt[1]
+                    disp_px = int(round(px * disp_w / label.width))
+                    disp_py = int(round(py * disp_h / label.height))
+                    cv2.circle(overlay, (disp_px, disp_py), 5, color1, -1)
+                # 画线2点
+                for pt in lane["line2_points"]:
+                    px, py = pt[0], pt[1]
+                    disp_px = int(round(px * disp_w / label.width))
+                    disp_py = int(round(py * disp_h / label.height))
+                    cv2.circle(overlay, (disp_px, disp_py), 5, color2, -1)
+                # 画线段
+                if len(lane["line1_points"]) >= 2:
+                    pts = np.array([[int(round(pt[0] * disp_w / label.width)), int(round(pt[1] * disp_h / label.height))] for pt in lane["line1_points"]], np.int32)
+                    cv2.polylines(overlay, [pts], False, color1, 2)
+                if len(lane["line2_points"]) >= 2:
+                    pts = np.array([[int(round(pt[0] * disp_w / label.width)), int(round(pt[1] * disp_h / label.height))] for pt in lane["line2_points"]], np.int32)
+                    cv2.polylines(overlay, [pts], False, color2, 2)
+            # 叠加 overlay 到 img，仅对非当前车道（透明度20%）
+            cv2.addWeighted(overlay, 0.2, img, 0.8, 0, img)
+
+            # 当前车道高亮显示（全亮，线1蓝色，线2红色）
+            if 0 <= label.current_lane_idx < len(label.lanes):
+                lane = label.lanes[label.current_lane_idx]
+                color1 = (255, 0, 0)  # 蓝色
+                color2 = (0, 0, 255)  # 红色
+                # 绘制线1点
+                for pt in lane["line1_points"]:
+                    px, py = pt[0], pt[1]
+                    disp_px = int(round(px * disp_w / label.width))
+                    disp_py = int(round(py * disp_h / label.height))
+                    cv2.circle(img, (disp_px, disp_py), 5, color1, -1)
+                # 绘制线2点
+                for pt in lane["line2_points"]:
+                    px, py = pt[0], pt[1]
+                    disp_px = int(round(px * disp_w / label.width))
+                    disp_py = int(round(py * disp_h / label.height))
+                    cv2.circle(img, (disp_px, disp_py), 5, color2, -1)
+                # 绘制线段
+                if len(lane["line1_points"]) >= 2:
+                    pts = np.array([[int(round(pt[0] * disp_w / label.width)), int(round(pt[1] * disp_h / label.height))] for pt in lane["line1_points"]], np.int32)
+                    cv2.polylines(img, [pts], False, color1, 2)
+                if len(lane["line2_points"]) >= 2:
+                    pts = np.array([[int(round(pt[0] * disp_w / label.width)), int(round(pt[1] * disp_h / label.height))] for pt in lane["line2_points"]], np.int32)
+                    cv2.polylines(img, [pts], False, color2, 2)
+                # 高亮当前车道的所有点外围画黄圈
+                for group in [1, 2]:
+                    pts = lane["line1_points"] if group == 1 else lane["line2_points"]
+                    for pt in pts:
+                        px, py = pt[0], pt[1]
+                        disp_px = int(round(px * disp_w / label.width))
+                        disp_py = int(round(py * disp_h / label.height))
+                        cv2.circle(img, (disp_px, disp_py), 7, (0, 255, 255), 1)
+            qimage = label.convert_to_qimage(img)
+            pixmap = QPixmap.fromImage(qimage)
+            label.setPixmap(pixmap)
+            label.setFixedSize(pixmap.size())
+        return update_display
+
+    def _make_mouse_press_event(self, label):
+        def mousePressEvent(event):
+            pos = event.position().toPoint()
+            mx, my = pos.x(), pos.y()
+            pixmap = label.pixmap()
+            if pixmap is not None:
+                disp_w = pixmap.width()
+                disp_h = pixmap.height()
+            else:
+                disp_w = int(label.width * (1.0 if label.is_full_size else label.scale_factor))
+                disp_h = int(label.height * (1.0 if label.is_full_size else label.scale_factor))
+            if not (0 <= mx < disp_w and 0 <= my < disp_h):
+                return
+            px = mx * label.width / disp_w
+            py = my * label.height / disp_h
+            pixel_x = round(px)
+            pixel_y = round(py)
+            pixel_x = min(max(0, pixel_x), label.width - 1)
+            pixel_y = min(max(0, pixel_y), label.height - 1)
+
+            # 如果没有任何车道，禁止添加/删除点，避免索引错误
+            if not self.lanes:
+                print("没有车道，无法添加或删除点")
+                return
+
+            # 添加点到当前车道、线组
+            if event.button() == Qt.MouseButton.LeftButton:
+                self._ensure_lane_exists()
+                lane_idx = getattr(label, "current_lane_idx", 0)
+                line_group = getattr(label, "current_line_group", 1)
+                if lane_idx >= len(label.lanes):
+                    while len(label.lanes) <= lane_idx:
+                        label.lanes.append({"lane_id": len(label.lanes)+1, "line1_points": [], "line2_points": []})
+                lane = label.lanes[lane_idx]
+                pixel_coord = [pixel_x, pixel_y]
+                # Use the label's own coord_convertor instead of self.coord_convertor
+                world_coords = label.coord_convertor.pixel2wgs84([pixel_coord])
+                lon, lat = world_coords[0]
+                global_idx = self.get_next_global_index() if hasattr(self, "get_next_global_index") else 1
+                creation_order = time.time()
+                pt_tuple = (pixel_x, pixel_y, lat, lon, global_idx, creation_order)
+                if line_group == 1:
+                    lane["line1_points"].append(pt_tuple)
+                else:
+                    lane["line2_points"].append(pt_tuple)
+                label.update_display()
+                self.update_all_points_text()
+                return
+            elif event.button() == Qt.MouseButton.RightButton:
+                # 删除所有图片中指定线组的最后一个点（全局最后添加的）
+                line_group = getattr(label, "current_line_group", 1)
+                self.remove_last_global_point(group=line_group)
+                return
+        return mousePressEvent
+
+    def _arrange_grid(self):
+        # 先更新缩略图大小
+        self._update_thumb_size()
+        # 清空布局
+        for i in reversed(range(self.grid_layout.count())):
+            widget = self.grid_layout.itemAt(i).widget()
+            if widget:
+                widget.setParent(None)
+        # 固定每行显示2列
+        n_col = self.desired_columns
+        row, col = 0, 0
+        for label in self.image_labels:
+            self.grid_layout.addWidget(label, row, col)
+            col += 1
+            if col >= n_col:
+                col = 0
+                row += 1
+        # 不再强制调整窗口大小，允许用户自由拖动调整，QScrollArea 会自动显示滚动条
+
+    def _update_thumb_size(self):
+        for label in self.image_labels:
+            if hasattr(label, "image"):
+                orig_h, orig_w = label.image.shape[:2]
+                scale = min(self.thumb_size / orig_w, self.thumb_size / orig_h)
+                disp_width = int(orig_w * scale)
+                disp_height = int(orig_h * scale)
+                label.scale_factor = scale
+                label.setFixedSize(disp_width, disp_height)
+                label.update_display()
+
+    def resizeEvent(self, event):
+        super().resizeEvent(event)
+        self._arrange_grid()
+
+    def add_roi_points_from_page(self, roi_points):
+        # 只将该 ROI 区域点追加到 all_roi_points，不改变其他 ROI 的点
+        self.all_roi_points.extend(roi_points)
+        QMessageBox.information(self, "ROI已添加", f"已添加 {len(roi_points)} 个ROI点，总计 {len(self.all_roi_points)} 个。")
+
+    # The following methods get_global_start_idx_for_label and get_all_global_indices are no longer needed
+    # as the points are managed in points_group1 and points_group2.
+
+    def remove_last_global_point(self, group=1, lane_idx=None):
+        """
+        删除指定车道 (lane_idx, 默认为 self.current_lane_idx) 与指定组 (1=左,2=右) 下全局编号最大的点。
+        如果没有任何已编号的点，则退回到按 creation_order 删除最后添加的点。
+        """
+        if group not in (1, 2):
+            print("Invalid group for removal.")
+            return
+        if lane_idx is None:
+            lane_idx = getattr(self, "current_lane_idx", 0)
+
+        all_points = []
+        for label in getattr(self, "image_labels", []):
+            if not hasattr(label, "lanes") or lane_idx >= len(label.lanes):
+                continue
+            pts = label.lanes[lane_idx].get("line1_points") if group == 1 else label.lanes[lane_idx].get("line2_points")
+            for idx_in_label, pt in enumerate(pts):
+                # normalize to 6-tuple if possible
+                creation_order = pt[5] if len(pt) >= 6 else float("inf")
+                global_idx = pt[4] if len(pt) >= 5 else None
+                all_points.append({
+                    "label": label,
+                    "idx_in_label": idx_in_label,
+                    "pt": pt,
+                    "global_idx": global_idx,
+                    "creation_order": creation_order
+                })
+
+        if not all_points:
+            print(f"No points to remove in lane {lane_idx+1} group {group}.")
+            return
+
+        # 优先基于已分配的 global_idx 删除（取最大），否则基于 creation_order 删除最后添加的点
+        pts_with_idx = [p for p in all_points if p["global_idx"] is not None]
+        if pts_with_idx:
+            max_global_idx = max(p["global_idx"] for p in pts_with_idx)
+            candidates = [p for p in pts_with_idx if p["global_idx"] == max_global_idx]
+            if len(candidates) > 1:
+                to_remove = max(candidates, key=lambda x: x["creation_order"])
+            else:
+                to_remove = candidates[0]
+        else:
+            # 没有已编号的点，直接按 creation_order 删除最后添加的点
+            to_remove = max(all_points, key=lambda x: x["creation_order"])
+
+        label = to_remove["label"]
+        idx_in_label = to_remove["idx_in_label"]
+        if group == 1:
+            removed = label.lanes[lane_idx]["line1_points"].pop(idx_in_label)
+        else:
+            removed = label.lanes[lane_idx]["line2_points"].pop(idx_in_label)
+
+        px, py, wx, wy = removed[0], removed[1], removed[2], removed[3]
+        removed_idx = removed[4] if len(removed) >= 5 else None
+        print(f"Removed lane {lane_idx+1} group {group} last indexed point: Pixel ({px}, {py}) → Coord ({wx:.3f}, {wy:.3f}), idx={removed_idx}")
+
+        # 重新分配编号，确保剩余点连续编号
+        self.reassign_global_indices()
+
+    def keyPressEvent(self, event):
+        super().keyPressEvent(event)
+
+    def sync_focus_points(self, label, points):
+        # Deprecated, not used with points_group1/points_group2
+        pass
+
+    def update_all_points_text(self):
+        if not hasattr(self, "points_text1") or not hasattr(self, "points_text2"):
+            return
+
+        lines1 = []
+        lines2 = []
+        latest1 = []
+        latest2 = []
+
+        lane_idx = getattr(self, "current_lane_idx", 0)
+
+        # 收集左边界点 across all images for current lane
+        left_entries = []
+        for label_idx, label in enumerate(self.image_labels):
+            if not hasattr(label, "lanes") or lane_idx >= len(label.lanes):
+                continue
+            for idx_in_label, pt in enumerate(label.lanes[lane_idx].get("line1_points", [])):
+                order = pt[5] if len(pt) >= 6 else float("inf")
+                left_entries.append({
+                    "label": label,
+                    "label_idx": label_idx,
+                    "pt": pt,
+                    "order": order,
+                    "idx_in_label": idx_in_label,
+                })
+        left_entries_sorted = sorted(left_entries, key=lambda x: x["order"])
+        for disp_idx, entry in enumerate(left_entries_sorted, start=1):
+            pt = entry["pt"]
+            label_idx = entry["label_idx"]
+            px, py = pt[0], pt[1]
+            lines1.append(f"车道{lane_idx+1} LP{disp_idx}: ({px}, {py}) [图片{label_idx+1}]")
+            latest1.append({
+                "label_idx": label_idx,
+                "img_label": entry["label"],
+                "pixel_x": px,
+                "pixel_y": py,
+                "global_idx": disp_idx,
+                "creation_order": entry["order"],
+                "lane_idx": lane_idx,
+                "idx_in_label": entry["idx_in_label"],
+            })
+
+        # 收集右边界点 across all images for current lane
+        right_entries = []
+        for label_idx, label in enumerate(self.image_labels):
+            if not hasattr(label, "lanes") or lane_idx >= len(label.lanes):
+                continue
+            for idx_in_label, pt in enumerate(label.lanes[lane_idx].get("line2_points", [])):
+                order = pt[5] if len(pt) >= 6 else float("inf")
+                right_entries.append({
+                    "label": label,
+                    "label_idx": label_idx,
+                    "pt": pt,
+                    "order": order,
+                    "idx_in_label": idx_in_label,
+                })
+        right_entries_sorted = sorted(right_entries, key=lambda x: x["order"])
+        for disp_idx, entry in enumerate(right_entries_sorted, start=1):
+            pt = entry["pt"]
+            label_idx = entry["label_idx"]
+            px, py = pt[0], pt[1]
+            lines2.append(f"车道{lane_idx+1} RP{disp_idx}: ({px}, {py}) [图片{label_idx+1}]")
+            latest2.append({
+                "label_idx": label_idx,
+                "img_label": entry["label"],
+                "pixel_x": px,
+                "pixel_y": py,
+                "global_idx": disp_idx,
+                "creation_order": entry["order"],
+                "lane_idx": lane_idx,
+                "idx_in_label": entry["idx_in_label"],
+            })
+
+        # 更新文本显示
+        self.points_text1.setPlainText("尚未添加车道左边界点" if not lines1 else '\n'.join(lines1))
+        self.points_text2.setPlainText("尚未添加车道右边界点" if not lines2 else '\n'.join(lines2))
+
+        # 保存用于右键菜单删除/定位的最新点信息
+        self._latest_group_points = {1: latest1, 2: latest2}
+
+    def showEvent(self, event):
+        # 保证显示时刷新
+        self.update_all_points_text()
+        return super().showEvent(event)
+
+    def _on_text1_context_menu(self, pos):
+        self._show_context_menu_for_group(self.points_text1, group=1, pos=pos)
+
+    def _on_text2_context_menu(self, pos):
+        self._show_context_menu_for_group(self.points_text2, group=2, pos=pos)
+
+    def _show_context_menu_for_group(self, text_widget, group, pos):
+        # 获取鼠标位置行号
+        cursor = text_widget.cursorForPosition(pos)
+        line_num = cursor.blockNumber()
+        # 获取当前分组点
+        group_pts = self._latest_group_points.get(group, [])
+        if line_num < 0 or line_num >= len(group_pts):
+            return
+        pt = group_pts[line_num]
+        menu = QMenu(text_widget)
+        action_del = QAction("删除该点", menu)
+        def do_delete():
+            self._delete_point_by_info(pt, group)
+        action_del.triggered.connect(do_delete)
+        menu.addAction(action_del)
+        menu.exec(text_widget.mapToGlobal(pos))
+
+    def _delete_point_by_info(self, ptinfo, group):
+        # ptinfo: dict with keys including label_idx, img_label, pixel_x, pixel_y, global_idx, creation_order
+        img_label = ptinfo["img_label"]
+        px, py = ptinfo["pixel_x"], ptinfo["pixel_y"]
+        # 在 img_label 的对应组 points_groupX 里找到完全匹配的点并删除
+        group_list = img_label.points_group1 if group == 1 else img_label.points_group2
+        idx_to_del = None
+        for idx, pt in enumerate(group_list):
+            if (pt[0], pt[1]) == (px, py):
+                idx_to_del = idx
+                break
+        if idx_to_del is not None:
+            del group_list[idx_to_del]
+            # 重新分配编号
+            self.reassign_global_indices()
+            self.update_all_points_text()
+
+    # 右键菜单事件绑定
+    def _bind_context_menu(self):
+        self.points_text1.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
+        self.points_text2.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
+        self.points_text1.customContextMenuRequested.connect(self._on_text1_context_menu)
+        self.points_text2.customContextMenuRequested.connect(self._on_text2_context_menu)
+
+    # __init__ 移至 closeEvent 之前以便 entry_window_ref 初始化
