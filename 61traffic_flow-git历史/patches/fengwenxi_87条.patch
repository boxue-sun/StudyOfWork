+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+把 TrafficFlow 的 save 报文文件按「时间戳 / 周期 / 指标 / 空间颗粒度」等维度导出为 CSV。
+
+save 文件格式(由 JsonSubscriber 落盘功能产生,如 Debug/save_*.txt):
+  - 每行一条 JSON 报文,行尾带 '\x00' 结束符;
+  - 报文外壳字段: MsgType / DevNo / MecNo / Timestamp / StartTime / StopTime / Cycle / CoilNum / Coil_List[];
+  - Cycle 是时间通道标记: -1 = 信号灯周期级(signal_cycle),正数 = 窗口秒数(1 = 秒级, 300 = 5min 级);
+  - Coil_List 每个元素是一个空间实体,SpaceType 区分空间颗粒度(见 doc/输出协议.md):
+      1 = 车道级 LANE   : Volume*/PCU/Headway/HeadTimeDiffDetail/Queue*/ClassQueue*/SpaceMeanSpeed/WasteTime...
+      2 = 道路级 BRANCH : PersonCrossCount/NonMotorCrossCount/Overflow*
+      3 = 流向级 FLOW   : FlowType/Volume*/PCU/QueueLength/WasteTime
+
+三种输出形态:
+  wide    每行 = 一条报文里的一个空间实体;列 = 维度 + 该实体携带的全部指标(该通道没配的指标留空)
+  long    每行 = 一个(时间, 周期, 颗粒度, 实体, 指标)组合,指标压成 metric/value 两列,便于透视与画曲线
+  detail  把 HeadTimeDiffDetail / WasteTimeDetail 这类逗号分隔的明细串展开成「一行一个样本」
+
+解析容错:整行 JSON、一行多条、行尾截断都能处理,坏行只计数不报错。多个输入文件会合并成一份 CSV。
+
+用法示例:
+  # 默认 wide 模式,输出到输入文件同目录的 <文件名>.wide.csv
+  python3 script/save_to_csv.py /data/skywalker/Work/Debug/save_1789286842873.txt
+
+  # 只看浪费时间:收窄指标列 + 丢掉全 0 行 + 按周期拆文件
+  python3 script/save_to_csv.py save.txt -m WasteTime,WasteTimeDetail --nonzero --split-by cycle
+
+  # 长表 + 逗号明细展开,便于导入数据库 / Excel 透视表
+  python3 script/save_to_csv.py save.txt --mode both --split-details
+
+  # 秒级通道单独看,时间窗用相对首帧的偏移
+  python3 script/save_to_csv.py save.txt --cycle 1 --start +10m --end +20m
+
+  # 只打印汇总统计(各通道报文数、各指标非零值分布),不写文件
+  python3 script/save_to_csv.py save.txt --summary-only
+"""
+
+import argparse
+import csv
+import datetime
+import fnmatch
+import glob
+import json
+import os
+import sys
+from collections import Counter
+
+# ---------------------------------------------------------------------------
+# 维度定义
+# ---------------------------------------------------------------------------
+
+# SpaceType → 空间颗粒度名称(doc/输出协议.md)
+SPACE_LEVEL = {1: "LANE", 2: "BRANCH", 3: "FLOW"}
+
+# FlowType → 流向名称(同上,仅流向级携带)
+FLOW_TYPE = {0: "None", 1: "Forward", 2: "Left", 3: "Right", 4: "TurnAround"}
+
+# 实体里已作为维度列输出的字段,不再重复当指标
+IDENTITY_KEYS = ("SpaceType", "BranchID", "FlowType", "LaneID", "LaneNo",
+                 "RegionID", "NodeID", "UpstreamCrossID")
+
+# 逗号明细串指标(以 Detail 结尾);HeadTimeDiffDetail 额外带 `类型串;数值串` 结构
+DETAIL_SUFFIX = "Detail"
+
+# float 默认保留 6 位小数(源头 C++ 用 std::to_string 也是 6 位),-1 表示按原值输出
+FLOAT_DIGITS = [6]
+
+# wide 模式的维度列,顺序即 CSV 列顺序;其后的指标列由数据自动发现
+DIM_COLUMNS = [
+    "source_file", "line_no", "msg_index", "entity_index",
+    "timestamp", "ts_ms", "start_time", "stop_time", "window_ms",
+    "cycle", "cycle_label",
+    "space_level", "space_type", "branch_id", "flow_type", "flow_name",
+    "lane_id", "lane_no", "entity",
+    "msg_type", "dev_no", "mec_no", "region_id", "node_id", "upstream_cross_id", "coil_num",
+]
+
+TS_FORMATS = ("%Y-%m-%d %H:%M:%S.%f", "%Y-%m-%d %H:%M:%S",
+              "%Y-%m-%dT%H:%M:%S.%f", "%Y-%m-%dT%H:%M:%S")
+
+LONG_HEADER = ["source_file", "line_no", "msg_index", "timestamp", "ts_ms", "start_time",
+               "stop_time", "cycle", "cycle_label", "space_level", "space_type",
+               "branch_id", "flow_type", "lane_id", "lane_no", "entity", "metric", "value"]
+LONG_DIM_KEYS = [k for k in LONG_HEADER if k not in ("metric", "value")]
+
+DETAIL_HEADER = ["source_file", "line_no", "msg_index", "timestamp", "cycle", "cycle_label",
+                 "space_level", "branch_id", "lane_id", "entity",
+                 "metric", "sample_index", "sample_type", "sample_value", "sample_count"]
+DETAIL_DIM_KEYS = DETAIL_HEADER[:10]
+
+
+def fmt_num(value):
+    """float → 字符串,按 FLOAT_DIGITS 舍入后 repr(保证最短可往返表示)。"""
+    digits = FLOAT_DIGITS[0]
+    if digits is not None and digits >= 0:
+        value = round(value, digits)
+    return repr(value)
+
+
+def fmt_part(text):
+    """明细串里的一个片段:能转数值就按统一小数位格式化,否则原样返回。"""
+    try:
+        return fmt_num(float(text))
+    except (TypeError, ValueError):
+        return text
+
+
+def cycle_label(cycle):
+    """Cycle 数值 → 可读标签:-1 是周期级标记,正数是窗口秒数。"""
+    if cycle is None:
+        return "unknown"
+    try:
+        cycle = int(cycle)
+    except (TypeError, ValueError):
+        return "unknown"
+    if cycle == -1:
+        return "signal_cycle"
+    if cycle % 60 == 0:
+        return "%dmin" % (cycle // 60)
+    return "%ds" % cycle
+
+
+# ---------------------------------------------------------------------------
+# save 文件解析
+# ---------------------------------------------------------------------------
+
+def iter_messages(path, stats):
+    """以报文结束符 '\x00' 切分整份文件,逐段容错解析。
+
+    比按行读更宽容:一行多条、多条挤一行、丢结束符都能接住;只有整段截断时废弃该段并计数。
+    行号按对象前累计的 '\n' 数算,保证能回到原文件定位。
+    """
+    decoder = json.JSONDecoder()
+    name = os.path.basename(path)
+    with open(path, "r", encoding="utf-8", errors="replace") as handle:
+        text = handle.read()
+    stats["lines"] += text.count("\n") + (0 if text.endswith("\n") or not text else 1)
+    newlines_before = 0
+    for chunk in text.split("\x00"):
+        start = chunk.find("{")
+        parsed = 0
+        while start >= 0:
+            try:
+                obj, end = decoder.raw_decode(chunk, start)
+            except ValueError:
+                break  # 本段剩下部分已损坏(通常是写盘被截断)
+            if isinstance(obj, dict):
+                parsed += 1
+                if "Coil_List" in obj:
+                    yield name, newlines_before + chunk.count("\n", 0, start) + 1, obj
+            start = chunk.find("{", end)
+        if not parsed and chunk.strip():
+            stats["bad_lines"] += 1
+        newlines_before += chunk.count("\n")
+
+
+def parse_ts_ms(text):
+    """'2026-09-01 16:39:56.000' → epoch 毫秒;也接受纯数字的秒/毫秒。失败返回 None。"""
+    if not text:
+        return None
+    for fmt in TS_FORMATS:
+        try:
+            return int(datetime.datetime.strptime(text, fmt).timestamp() * 1000)
+        except ValueError:
+            pass
+    try:
+        value = int(float(text))
+    except (TypeError, ValueError):
+        return None
+    return value if value > 10 ** 12 else value * 1000
+
+
+def second_of_day(ts_ms):
+    """epoch 毫秒 → 当天秒数(本地时区),用于 HH:MM:SS 形式的过滤。"""
+    dt = datetime.datetime.fromtimestamp(ts_ms / 1000.0)
+    return (dt.hour * 3600 + dt.minute * 60 + dt.second) * 1000 + dt.microsecond // 1000
+
+
+def parse_duration_ms(text):
+    """'90' / '90s' / '2m' / '1h30m' → 毫秒。无单位按秒。"""
+    total, num = 0, ""
+    for ch in text:
+        if ch.isdigit() or ch == ".":
+            num += ch
+            continue
+        unit = ch.lower()
+        if unit not in ("s", "m", "h") or not num:
+            raise ValueError("无法解析时长: %s" % text)
+        total += int(float(num) * {"s": 1000, "m": 60000, "h": 3600000}[unit])
+        num = ""
+    if num:
+        total += int(float(num) * 1000)
+    return total
+
+
+def parse_time_arg(text):
+    """--start/--end 取值:绝对时间 / HH:MM:SS(按当天) / +偏移(相对首帧)。"""
+    text = text.strip()
+    if text.startswith("+"):
+        return ("rel", parse_duration_ms(text[1:]))
+    ms = parse_ts_ms(text)
+    if ms is not None:  # 日期时间格式,或裸 epoch 秒/毫秒
+        return ("abs", ms)
+    for fmt in ("%H:%M:%S.%f", "%H:%M:%S", "%H:%M"):
+        try:
+            dt = datetime.datetime.strptime(text, fmt)
+            return ("day", (dt.hour * 3600 + dt.minute * 60 + dt.second) * 1000 + dt.microsecond // 1000)
+        except ValueError:
+            pass
+    raise ValueError("无法解析时间: %s" % text)
+
+
+def split_spec(spec, first_ts):
+    """把时间参数折算成 (绝对毫秒, 当天毫秒) 二元组,任一可能为 None。"""
+    if spec is None:
+        return None, None
+    kind, value = spec
+    if kind == "abs":
+        return value, None
+    if kind == "rel":
+        if first_ts is None:
+            raise SystemExit("使用 +偏移 需要报文里有可解析的 Timestamp")
+        return first_ts + value, None
+    return None, value
+
+
+# ---------------------------------------------------------------------------
+# 报文 → 扁平行
+# ---------------------------------------------------------------------------
+
+def fmt_value(value):
+    """指标值 → CSV 字符串。float 按 FLOAT_DIGITS 舍入,bool 归一为 1/0,嵌套结构转 JSON。"""
+    if value is None:
+        return ""
+    if isinstance(value, bool):
+        return "1" if value else "0"
+    if isinstance(value, float):
+        return "" if value != value else fmt_num(value)
+    if isinstance(value, (dict, list)):
+        return json.dumps(value, ensure_ascii=False)
+    return str(value)
+
+
+def entity_key(item, level):
+    """实体唯一标识,便于在 CSV 里按 entity 分组画曲线。"""
+    branch = item.get("BranchID", "")
+    if level == "LANE":
+        return "%s:%s/%s" % (level, branch, item.get("LaneID", ""))
+    if level == "FLOW":
+        return "%s:%s/%s" % (level, branch, item.get("FlowType", ""))
+    return "%s:%s" % (level, branch)
+
+
+def flatten(msg, source_file, line_no, msg_index, stats):
+    """一条报文 → 若干行 dict(每个空间实体一行),同时累加汇总计数。"""
+    timestamp = msg.get("Timestamp", "")
+    start, stop = msg.get("StartTime", ""), msg.get("StopTime", "")
+    ts_ms = parse_ts_ms(timestamp)
+    cycle = msg.get("Cycle")
+    label = cycle_label(cycle)
+    start_ms, stop_ms = parse_ts_ms(start), parse_ts_ms(stop)
+    window_ms = (stop_ms - start_ms) if (start_ms is not None and stop_ms is not None) else None
+
+    base = {
+        "source_file": source_file,
+        "line_no": line_no,
+        "msg_index": msg_index,
+        "timestamp": timestamp,
+        "ts_ms": "" if ts_ms is None else ts_ms,
+        "start_time": start,
+        "stop_time": stop,
+        "window_ms": "" if window_ms is None else window_ms,
+        "cycle": "" if cycle is None else cycle,
+        "cycle_label": label,
+        "msg_type": msg.get("MsgType", ""),
+        "dev_no": msg.get("DevNo", ""),
+        "mec_no": msg.get("MecNo", ""),
+        "coil_num": msg.get("CoilNum", ""),
+    }
+
+    rows = []
+    for entity_index, item in enumerate(msg.get("Coil_List") or []):
+        if not isinstance(item, dict):
+            continue
+        space_type = item.get("SpaceType")
+        level = SPACE_LEVEL.get(space_type, "TYPE%s" % space_type)
+        flow_type = item.get("FlowType")
+        dim = dict(base)
+        dim.update({
+            "entity_index": entity_index,
+            "space_level": level,
+            "space_type": "" if space_type is None else space_type,
+            "branch_id": item.get("BranchID", ""),
+            "flow_type": "" if flow_type is None else flow_type,
+            "flow_name": FLOW_TYPE.get(flow_type, ""),
+            "lane_id": item.get("LaneID", ""),
+            "lane_no": item.get("LaneNo", ""),
+            "entity": entity_key(item, level),
+            "region_id": item.get("RegionID", ""),
+            "node_id": item.get("NodeID", ""),
+            "upstream_cross_id": item.get("UpstreamCrossID", ""),
+        })
+        metric = {k: fmt_value(v) for k, v in item.items() if k not in IDENTITY_KEYS}
+        rows.append({"dim": dim, "metric": metric})
+
+        stats["rows"] += 1
+    # 报文数按「带实体的报文」计,空 Coil_List 不算一条有效输出
+    if rows:
+        stats["messages"] += 1
+    return rows
+
+
+# ---------------------------------------------------------------------------
+# 过滤
+# ---------------------------------------------------------------------------
+
+def parse_tokens(text):
+    """'a,b;c' → ['a','b','c'](小写,去空)。"""
+    if not text:
+        return []
+    out = []
+    for part in text.replace(";", ",").split(","):
+        part = part.strip()
+        if part:
+            out.append(part.lower())
+    return out
+
+
+def parse_cycle_tokens(text):
+    """'signal_cycle,1,5min,300' → {'-1','1','300'}"""
+    wanted = set()
+    for token in parse_tokens(text):
+        if token in ("signal_cycle", "cycle", "sc"):
+            wanted.add("-1")
+        elif token.endswith("min") and token[:-3].isdigit():
+            wanted.add(str(int(token[:-3]) * 60))
+        elif token.endswith("s") and token[:-1].isdigit():
+            wanted.add(str(int(token[:-1])))
+        elif token.lstrip("-").isdigit():
+            wanted.add(token)
+        else:
+            raise SystemExit("无法识别的周期: %s(可用 -1 / signal_cycle / 1s / 5min / 300)" % token)
+    return wanted
+
+
+def match_any(name, patterns):
+    return any(fnmatch.fnmatchcase(str(name).lower(), pat) for pat in patterns)
+
+
+def is_nonzero(value):
+    """判断指标值是否「有内容」。明细串递归看各片段;纯文本(如车型串)非空即算。"""
+    text = "" if value is None else str(value)
+    if "," in text or ";" in text:
+        return any(is_nonzero(part.strip()) for part in text.replace(";", ",").split(","))
+    try:
+        return float(text) != 0.0
+    except ValueError:
+        return text != ""
+
+
+def keep_row(row, args):
+    dim = row["dim"]
+    if args.cycles and str(dim["cycle"]) not in args.cycles:
+        return False
+    if args.levels and str(dim["space_type"]) not in args.levels:
+        return False
+    if args.branch_patterns and not match_any(dim["branch_id"], args.branch_patterns):
+        return False
+    if args.lane_patterns and not match_any(dim["lane_id"], args.lane_patterns):
+        return False
+
+    ts = parse_ts_ms(dim["timestamp"])
+    if ts is not None:
+        if args.start_abs is not None and ts < args.start_abs:
+            return False
+        if args.end_abs is not None and ts > args.end_abs:
+            return False
+        if args.start_day is not None or args.end_day is not None:
+            now = second_of_day(ts)
+            if args.start_day is not None and now < args.start_day:
+                return False
+            if args.end_day is not None and now > args.end_day:
+                return False
+
+    metric = row["metric"]
+    if args.metric_patterns:
+        names = [k for k in metric if match_any(k, args.metric_patterns)]
+        if not names and not args.keep_missing:
+            return False
+        if args.nonzero and not any(is_nonzero(metric[n]) for n in names):
+            return False
+    elif args.nonzero and not any(is_nonzero(v) for v in metric.values()):
+        return False
+    return True
+
+
+def select_metrics(rows, args):
+    """确定 wide/long 的指标列:按数据首次出现顺序;--metric 时收窄到命中的列。"""
+    order, seen = [], set()
+    for row in rows:
+        for name in row["metric"]:
+            if name in seen:
+                continue
+            if args.metric_patterns and not match_any(name, args.metric_patterns):
+                continue
+            seen.add(name)
+            order.append(name)
+    return order
+
+
+# ---------------------------------------------------------------------------
+# CSV 输出
+# ---------------------------------------------------------------------------
+
+def write_csv(path, header, rows_iter, encoding):
+    directory = os.path.dirname(os.path.abspath(path))
+    if directory and not os.path.isdir(directory):
+        os.makedirs(directory)
+    with open(path, "w", encoding=encoding, newline="") as handle:
+        writer = csv.writer(handle)
+        writer.writerow(header)
+        count = 0
+        for line in rows_iter:
+            writer.writerow(line)
+            count += 1
+    return path, count
+
+
+def wide_lines(rows, metrics):
+    for row in rows:
+        dim = row["dim"]
+        yield [dim.get(col, "") for col in DIM_COLUMNS] + \
+              [row["metric"].get(name, "") for name in metrics]
+
+
+def long_lines(rows, metrics):
+    for row in rows:
+        dim = row["dim"]
+        head = [dim.get(col, "") for col in LONG_DIM_KEYS]
+        for name in metrics:
+            if name in row["metric"]:
+                yield head + [name, row["metric"][name]]
+
+
+def detail_lines(rows, metrics):
+    """展开逗号明细串。HeadTimeDiffDetail 的形式是 `类型串;数值串`,把类型按序号对齐带出。"""
+    for row in rows:
+        dim = row["dim"]
+        head = [dim.get(col, "") for col in DETAIL_DIM_KEYS]
+        for name in metrics:
+            raw = row["metric"].get(name, "")
+            if raw == "":
+                continue
+            types = []
+            if ";" in raw:
+                type_part, raw = raw.split(";", 1)
+                types = [p.strip() for p in type_part.split(",")]
+            parts = [p.strip() for p in raw.split(",")]
+            for index, part in enumerate(parts):
+                sample_type = types[index] if index < len(types) else ""
+                yield head + [name, index, sample_type, fmt_part(part), len(parts)]
+
+
+# ---------------------------------------------------------------------------
+# 汇总统计
+# ---------------------------------------------------------------------------
+
+def metric_stats(rows, metrics):
+    """每个指标的有值行数、非零行数、非零值 sum/min/max;明细串指标只统计非空行数。"""
+    table = []
+    for name in metrics:
+        present = nonzero = 0
+        total = lo = hi = None
+        is_detail = name.endswith(DETAIL_SUFFIX)
+        for row in rows:
+            if name not in row["metric"]:
+                continue
+            value = row["metric"][name]
+            present += 1
+            if is_detail:
+                if is_nonzero(value):
+                    nonzero += 1
+                continue
+            try:
+                num = float(value)
+            except (TypeError, ValueError):
+                continue
+            if num != 0.0:
+                nonzero += 1
+                total = num if total is None else total + num
+                lo = num if lo is None else min(lo, num)
+                hi = num if hi is None else max(hi, num)
+        if nonzero:
+            table.append((name, present, nonzero, total, lo, hi))
+    table.sort(key=lambda item: -item[2])
+    return table
+
+
+def print_summary(rows, metrics, stats, inputs, out_files, limit_hit):
+    out = sys.stdout
+    # 一条报文可能包含多个实体,报文数按 (文件, 行号, 报文序号) 去重
+    msg_cycle = {}
+    for row in rows:
+        dim = row["dim"]
+        msg_cycle[(dim["source_file"], dim["line_no"], dim["msg_index"])] = dim["cycle_label"]
+    by_cycle = Counter(r["dim"]["cycle_label"] for r in rows)
+    msgs_per_cycle = Counter(msg_cycle.values())
+    by_level = Counter(r["dim"]["space_level"] for r in rows)
+
+    out.write("== save 汇总(过滤后) ==\n")
+    out.write("输入 %d 个文件: %s\n" % (len(inputs), ", ".join(os.path.basename(p) for p in inputs)))
+    out.write("物理行 %d,坏行 %d;报文 %d 条,实体行 %d(全量 %d)\n" %
+              (stats["lines"], stats["bad_lines"], len(msg_cycle), len(rows), stats["rows"]))
+    out.write("\n-- 时间通道 --\n  %-14s %8s %8s\n" % ("cycle_label", "messages", "rows"))
+    for label, count in sorted(by_cycle.items()):
+        out.write("  %-14s %8d %8d\n" % (label, msgs_per_cycle[label], count))
+    out.write("\n-- 空间颗粒度 --\n")
+    for level, count in sorted(by_level.items()):
+        out.write("  %-8s 实体行 %7d\n" % (level, count))
+
+    stamps = sorted(r["dim"]["timestamp"] for r in rows if r["dim"]["timestamp"])
+    if stamps:
+        out.write("\n-- 时间范围 --\n  %s\n  %s\n  实体 %d 个\n" %
+                  (stamps[0], stamps[-1], len(set(r["dim"]["entity"] for r in rows))))
+    out.write("\n-- 指标分布 --\n")
+    for name, present, nonzero, total, lo, hi in metric_stats(rows, metrics):
+        if total is None:  # 明细串指标
+            out.write("  %-26s %6d/%-6d 明细串(--split-details 可展开)\n" % (name, nonzero, present))
+        else:
+            out.write("  %-26s %6d/%-6d sum=%.3f [%.3f, %.3f]\n" %
+                      (name, nonzero, present, total, lo, hi))
+    out.write("  (格式: 非零行/有值行,后三列为非零值的和与区间)\n")
+    if limit_hit:
+        out.write("\n注意:已按 --limit 截断,统计只反映前 %d 行\n" % limit_hit)
+    if out_files:
+        out.write("\n-- 输出文件 --\n")
+        for path, count in out_files:
+            out.write("  %s\n      %d 行, %.1f KB\n" % (path, count, os.path.getsize(path) / 1024.0))
+
+
+# ---------------------------------------------------------------------------
+# main
+# ---------------------------------------------------------------------------
+
+def collect_inputs(tokens):
+    paths = []
+    for token in tokens:
+        matched = sorted(glob.glob(token))
+        if matched:
+            paths.extend(p for p in matched if os.path.isfile(p))
+        elif os.path.isfile(token):
+            paths.append(token)
+        else:
+            sys.stderr.write("忽略不存在的输入: %s\n" % token)
+    if not paths:
+        raise SystemExit("找不到任何 save 文件: %s" % tokens)
+    return paths
+
+
+def target_path(args, prefix, mode, suffix, multi_form):
+    """输出路径:只出一个文件时用 --out 原路径,多文件则把形态名插到扩展名前。"""
+    if args.out and not suffix and not multi_form:
+        return args.out
+    if args.out and not suffix:
+        root, ext = os.path.splitext(args.out)
+        return "%s.%s%s" % (root, mode, ext or ".csv")
+    return os.path.join(args.out_dir, "%s%s.%s.csv" % (prefix, suffix, mode))
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        description="把 TrafficFlow save 报文文件按时间戳/周期/指标等维度转成 CSV",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog=__doc__.split("用法示例:")[-1])
+    parser.add_argument("inputs", nargs="+", help="save 文件路径,支持多个与通配符")
+    parser.add_argument("--mode", choices=["wide", "long", "both"], default="wide",
+                        help="wide=一行一实体(默认);long=指标压成 metric/value;both=两个都出")
+    parser.add_argument("-o", "--out", help="输出 CSV 路径(不分文件、单形态时使用)")
+    parser.add_argument("--out-dir", help="输出目录,默认与第一个输入文件同目录")
+    parser.add_argument("--out-prefix", help="输出文件名前缀,默认取第一个输入文件名")
+    parser.add_argument("--encoding", default="utf-8-sig",
+                        help="输出编码,默认 utf-8-sig(Excel 直接打开不乱码)")
+    parser.add_argument("--cycle", help="只保留这些时间通道: signal_cycle,1,5min,300(逗号分隔)")
+    parser.add_argument("--space", help="只保留这些空间颗粒度: 1=车道 2=道路 3=流向")
+    parser.add_argument("-m", "--metric", help="只导出这些指标列,支持通配: WasteTime,Volume*")
+    parser.add_argument("--branch", help="BranchID 过滤,支持通配: south_*")
+    parser.add_argument("--lane", help="LaneID 过滤,支持通配")
+    parser.add_argument("--start", help="起始时间: 绝对时间 / HH:MM:SS / +相对首帧偏移(如 +10m)")
+    parser.add_argument("--end", help="结束时间,格式同 --start")
+    parser.add_argument("--nonzero", action="store_true", help="丢掉所有(选中)指标都为 0 或空的行")
+    parser.add_argument("--float-decimals", type=int, default=6,
+                        help="float 指标保留小数位,默认 6(与报文里 std::to_string 一致);-1 = 原值输出")
+    parser.add_argument("--keep-missing", action="store_true",
+                        help="配合 --metric:实体不含这些指标时也保留")
+    parser.add_argument("--split-by", choices=["none", "cycle", "space"], default="none",
+                        help="按维度拆成多个 CSV,默认合并成单个")
+    parser.add_argument("--split-details", action="store_true",
+                        help="额外输出 *.detail.csv,把 *Detail 逗号明细展开为一行一个样本")
+    parser.add_argument("--no-sort", action="store_true", help="保持文件原始顺序,不按时间排序")
+    parser.add_argument("--limit", type=int, default=0, help="只输出前 N 行,便于快速预览")
+    parser.add_argument("--summary-only", action="store_true", help="只打印统计,不写 CSV")
+    parser.add_argument("-q", "--quiet", action="store_true", help="不打印汇总")
+    args = parser.parse_args(argv)
+
+    args.cycles = parse_cycle_tokens(args.cycle)
+    FLOAT_DIGITS[0] = args.float_decimals
+    args.levels = set(parse_tokens(args.space))
+    args.metric_patterns = parse_tokens(args.metric)
+    args.branch_patterns = parse_tokens(args.branch)
+    args.lane_patterns = parse_tokens(args.lane)
+
+    inputs = collect_inputs(args.inputs)
+    stats = {"lines": 0, "bad_lines": 0, "messages": 0, "rows": 0}
+
+    rows, msg_index = [], 0
+    for path in inputs:
+        for source_file, line_no, msg in iter_messages(path, stats):
+            msg_index += 1
+            rows.extend(flatten(msg, source_file, line_no, msg_index, stats))
+    if not rows:
+        raise SystemExit("没有解析出任何 Coil_List 数据,请确认文件是否为 save 报文格式")
+
+    if not args.no_sort:
+        rows.sort(key=lambda r: (r["dim"]["ts_ms"] if r["dim"]["ts_ms"] != "" else 0,
+                                 r["dim"]["cycle"] if r["dim"]["cycle"] != "" else 0,
+                                 r["dim"]["space_type"], r["dim"]["branch_id"],
+                                 r["dim"]["flow_type"], r["dim"]["lane_id"],
+                                 r["dim"]["source_file"], r["dim"]["line_no"]))
+
+    first_ts = next((r["dim"]["ts_ms"] for r in rows if r["dim"]["ts_ms"] != ""), None)
+    args.start_abs, args.start_day = split_spec(parse_time_arg(args.start) if args.start else None, first_ts)
+    args.end_abs, args.end_day = split_spec(parse_time_arg(args.end) if args.end else None, first_ts)
+
+    kept = [row for row in rows if keep_row(row, args)]
+    limit_hit = 0
+    if args.limit and len(kept) > args.limit:
+        kept = kept[:args.limit]
+        limit_hit = args.limit
+    metrics = select_metrics(kept, args)
+
+    if args.summary_only:
+        print_summary(kept, metrics, stats, inputs, [], limit_hit)
+        return 0
+    if not kept:
+        sys.stderr.write("过滤后没有数据,请放宽 --cycle/--metric/--start/--end/--nonzero 条件\n")
+        return 1
+
+    if args.split_by == "none":
+        groups = [("", kept)]
+    else:
+        key = "cycle_label" if args.split_by == "cycle" else "space_level"
+        grouped = {}
+        for row in kept:
+            grouped.setdefault(row["dim"][key], []).append(row)
+        groups = [("." + name, group) for name, group in sorted(grouped.items())]
+
+    # 会产出几个文件:多于一个时,即使给了 --out 也要把形态名插进文件名,避免相互覆盖
+    multi_form = len(groups) > 1 or args.mode == "both" or (args.mode == "wide" and args.split_details)
+
+    prefix = args.out_prefix or os.path.basename(args.out if multi_form and args.out else inputs[0])
+    for tail in (".txt", ".log", ".csv"):
+        if prefix.endswith(tail):
+            prefix = prefix[:-len(tail)]
+            break
+
+    args.out_dir = args.out_dir or os.path.dirname(os.path.abspath(inputs[0]))
+    out_files = []
+    for suffix, group in groups:
+        if args.mode in ("wide", "both"):
+            out_files.append(write_csv(target_path(args, prefix, "wide", suffix, multi_form),
+                                       DIM_COLUMNS + metrics, wide_lines(group, metrics),
+                                       args.encoding))
+        if args.mode in ("long", "both"):
+            out_files.append(write_csv(target_path(args, prefix, "long", suffix, multi_form),
+                                       LONG_HEADER, long_lines(group, metrics), args.encoding))
+        if args.split_details:
+            names = [m for m in metrics if m.endswith(DETAIL_SUFFIX)]
+            if names:
+                out_files.append(write_csv(target_path(args, prefix, "detail", suffix, multi_form),
+                                           DETAIL_HEADER, detail_lines(group, names),
+                                           args.encoding))
+
+    if not args.quiet:
+        print_summary(kept, metrics, stats, inputs, out_files, limit_hit)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
