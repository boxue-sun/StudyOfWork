diff --git a/src/traffic_flow/detectors/occupancy_detector.cpp b/src/traffic_flow/detectors/occupancy_detector.cpp
new file mode 100644
index 0000000..ab02147
--- /dev/null
+++ b/src/traffic_flow/detectors/occupancy_detector.cpp
@@ -0,0 +1,148 @@
+/**
+ * @file occupancy_detector.cpp
+ * @author FengWenxi (ThorfromAsgard@outlook.com)
+ * @brief 
+ * @version 0.1
+ * @date 2024-10-21
+ * 
+ * <========================================================================>
+ *                   © 2024 CICTCI. All Rights Reserved.                
+ * <========================================================================>
+ * 
+ */
+#include "occupancy_detector.h"
+
+#include <iostream>
+
+#include <nlohmann/json.hpp>
+#include "math/segment2d.hpp"
+
+namespace fusion_perception::traffic_flow {
+OccupancyDetector::OccupancyDetector(const DetectorConfig& detector_config)
+    : TrafficFlowDetector(detector_config), _current_period_start(0) {
+    nlohmann::json custom_config_json = detector_config.custom_config_json;
+    _stop_line_points = detector_config.stop_line_points;
+    _stop_line_segments = detector_config.stop_line_segments;
+    try {
+        if (custom_config_json.contains("object_type")) {
+            _object_types = get_object_types(custom_config_json.at("object_type"));
+        } else {
+            _object_types = get_default_object_types(_detector_type);
+        }
+        if (custom_config_json.contains("detect_period")) {
+            custom_config_json.at("detect_period").get_to(_detect_period);
+        } else {
+            _detect_period = DEFAULT_DETECT_PERIOD;
+        }
+    } catch (std::exception& e) {
+        std::cerr << "volume detector construct failed: " << e.what() << std::endl;
+        assert(false);
+    }
+}
+
+void OccupancyDetector::calculate_volume() {
+    for (auto& one_object_track : _object_tracks) {
+        if (one_object_track.second.is_intersected) {
+            continue;
+        }
+        std::vector<TrackPosition> track_positions;
+        auto& one_track = one_object_track.second.track;
+        // TODO: May lead to false result because of the incontinuity of the track.
+        if (one_track.size() < 2) {
+            continue;
+        }
+        for (int i = one_track.size() - 2; i < one_track.size(); ++i) {
+            // if (one_track[i].timestamp >= _current_period_start &&
+            //     one_track[i].timestamp <= (_current_period_start + _detect_period)) {
+            track_positions.emplace_back(one_track[i]);
+            // }
+        }
+        // for (const auto& one_track_position : one_track) {
+        //     if (one_track_position.timestamp >= _current_period_start &&
+        //         one_track_position.timestamp <= (_current_period_start + _detect_period)) {
+        //         track_positions.emplace_back(one_track_position);
+        //     }
+        // }
+        if (track_positions.size() != 2) {
+            // std::cerr << "one track size not equal to 2." << std::endl;
+            continue;
+        }
+        math::Segment2D one_track_segment(track_positions[0].position, track_positions[1].position);
+        for (const auto& one_stop_line_segment : _stop_line_segments) {
+            if (one_track_segment.has_intersect(one_stop_line_segment)) {
+                one_object_track.second.is_intersected = true;
+#ifdef DEBUG
+                std::cout << "[DEBUG] OccupancyDetector " << detector_type_to_string(_detector_type) << " name: " << _name
+                          << " calculates once, innerid: " << one_object_track.first << " from "
+                          << _current_period_start << " in " << _detect_period << " ms." << std::endl;
+#endif
+                // ++_volume;
+                break;
+            }
+        }
+    }
+#ifdef DEBUG
+    // std::cout << "[DEBUG] OccupancyDetector " << detector_type_to_string(_detector_type) << " name: " << _name
+    //           << " calculates once, has " << _volume << " cars from " << _current_period_start << " in "
+    //           << _detect_period << " ms." << std::endl;
+#endif
+}
+
+void OccupancyDetector::detect(const PerceptionResult& new_frame_result) {
+    for (const auto& one_object : new_frame_result.traffic_objects) {
+        auto find_it = _object_types.find(one_object.inner_type);
+        if (find_it == _object_types.end()) {
+            continue;
+        }
+        auto& object_track_info = _object_tracks[one_object.inner_id];
+        object_track_info.track.emplace_back(one_object.longitude, one_object.latitude, one_object.speed,
+                                             new_frame_result.timestamp);
+        if (object_track_info.id != one_object.inner_id) {
+            object_track_info.id = one_object.inner_id;
+        }
+        if (object_track_info.type != one_object.inner_type) {
+            object_track_info.type = one_object.inner_type;
+        }
+    }
+    /* Delete old objects that no longer exist */
+    // for (auto it = _object_tracks.begin(); it != _object_tracks.end();) {
+    //     uint64_t elapsed_time = new_frame_result.timestamp - it->second.track.back().timestamp;
+    //     if (elapsed_time > OBJECT_CLEAR_TIME) {
+    //         it = _object_tracks.erase(it);
+    //     } else {
+    //         ++it;
+    //     }
+    // }
+    /* Init first detect period. */
+    if (!_current_period_start) {
+        _current_period_start = new_frame_result.timestamp;
+#ifdef DEBUG
+        std::cout << "[DEBUG] OccupancyDetector " << detector_type_to_string(_detector_type) << " name: " << _name
+                  << " first detect." << std::endl;
+#endif
+    }
+    calculate_volume();
+    if ((_current_period_start + _detect_period) < new_frame_result.timestamp) {
+        // Set status and calc next period.
+        _current_period_start += _detect_period;
+        nlohmann::json result;
+        result["measure_number"] = _measure_number;
+        result["lane_number"] = _lane_number;
+        result["coil_number"] = _coil_number;
+        result["type"] = detector_type_to_string(_detector_type);
+        uint16_t volume_value = 0;
+        result["value"] = volume_value;
+        result["timestamp"] = _current_period_start;
+        result["detect_period"] = _detect_period;
+        if (!_deliver_callback(result.dump())) {
+            std::cerr << "Error, detector send result failed!" << std::endl;
+        }
+        // _volume = 0;
+#ifdef DEBUG
+        std::cout << "[DEBUG] OccupancyDetector " << detector_type_to_string(_detector_type) << " name: " << _name
+                  << " calculated " << volume_value << " volume once." << std::endl;
+#endif
+    }
+}
+
+}  // namespace fusion_perception::traffic_flow
