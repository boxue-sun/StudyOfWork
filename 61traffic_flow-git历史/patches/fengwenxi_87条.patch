new file mode 100644
index 0000000..68e9ddd
--- /dev/null
+++ b/tool/FusionFlow/draw_roi_page.py
@@ -0,0 +1,1287 @@
+# -*- coding: utf-8 -*-
+import time
+import glob
+import json
+import cv2
+import numpy as np
+from PyQt6.QtCore import Qt, QSize, pyqtSignal
+from PyQt6.QtGui import QImage, QPixmap, QAction, QIcon
+from PyQt6.QtWidgets import (
+    QApplication, QToolButton, QLabel, QLineEdit, QMainWindow, QMessageBox, QWidget, QGridLayout, QPushButton, QVBoxLayout, QHBoxLayout, QTextEdit, QMenu
+)
+
+from pixel2wgs84 import Pixel2WGS84
+
+class ImageLabel(QLabel):
+    """Customized QLabel for displaying images and handling mouse events, refactored for global point management.
+    支持两组点(points_group1, points_group2)，可自由切换编辑组。
+    增加点拖动微调功能。
+    """
+    def __init__(self, image_path, parent=None):
+        super().__init__(parent)
+        self.image = cv2.imread(image_path)
+        if self.image is None:
+            raise FileNotFoundError(f"Cannot load image: {image_path}")
+        json_path = image_path.rsplit('.', 1)[0] + '.json'
+        with open(json_path, 'r') as f:
+            data = json.load(f)
+        pmatrix_data = data["PMatrix"]
+        self.coord_convertor = Pixel2WGS84(pmatrix_data)
+        self.height, self.width, _ = self.image.shape
+
+        self.points_group1 = []  # 第一组点
+        self.points_group2 = []  # 第二组点
+        self.current_group = 1   # 当前编辑组，1或2
+        self.setMouseTracking(True)
+        self.current_mouse_pos = None  # Current mouse position
+
+        self.is_full_size = False
+        self.scale_factor = 0.25  # 25% scale for thumbnail, can be dynamically changed by Ctrl+Wheel
+        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
+
+        # 拖动相关
+        self.dragging_point_idx = None  # 当前拖动点在当前组的索引
+        self.dragging_group = None      # 当前拖动点的组（1或2）
+        self.dragging = False
+        self.drag_threshold = 10  # 拖动点的判定半径（像素）
+
+        # 去除边框和 margin，确保 (0,0) 对应图像左上角
+        self.setStyleSheet("border: none; margin: 0px; padding: 0px;")
+
+        # 设置左上角对齐
+        self.setAlignment(Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
+
+        # 设置初始光标为十字
+        self.setCursor(Qt.CursorShape.CrossCursor)
+
+        self.update_display()
+
+    def enterEvent(self, event):
+        """当鼠标进入时自动获取焦点，这样不用点击也能响应键盘事件"""
+        self.setFocus()
+        super().enterEvent(event)
+
+    def convert_to_qimage(self, img_bgr):
+        rgb_image = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)
+        return QImage(rgb_image.data, img_bgr.shape[1], img_bgr.shape[0], 3 * img_bgr.shape[1], QImage.Format.Format_RGB888)
+
+    def update_display(self):
+        """Update the display with the current image and points, using local and global indices.
+        绘制两组点，分别用红色/蓝色，按 global_idx 排序后再绘制。
+        """
+        if self.is_full_size:
+            display_img = self.image.copy()
+            disp_w = self.width
+            disp_h = self.height
+        else:
+            disp_w = int(self.width * self.scale_factor)
+            disp_h = int(self.height * self.scale_factor)
+            display_img = cv2.resize(self.image, (disp_w, disp_h), interpolation=cv2.INTER_AREA)
+
+        # 合并两组点，带上组信息
+        all_points = []
+        for pt in self.points_group1:
+            all_points.append((pt, 1))
+        for pt in self.points_group2:
+            all_points.append((pt, 2))
+        # 按 global_idx 排序（若无则0）
+        points_sorted = sorted(all_points, key=lambda x: x[0][4] if len(x[0]) >= 5 else 0)
+        for idx, (point, group) in enumerate(points_sorted):
+            if len(point) == 6:
+                px, py, wx, wy, global_idx, _ = point
+            elif len(point) == 5:
+                px, py, wx, wy, global_idx = point
+            else:
+                px, py, wx, wy = point
+                global_idx = None
+            disp_px = int(round(px * disp_w / self.width))
+            disp_py = int(round(py * disp_h / self.height))
+            # 组1红色，组2蓝色
+            color = (0, 0, 255) if group == 1 else (255, 0, 0)
+            cv2.circle(display_img, (disp_px, disp_py), 5, color, -1)
+            # 高亮拖动中的点
+            if (self.dragging and self.dragging_point_idx is not None and group == self.dragging_group):
+                if self.current_group == group:
+                    group_points = self.points_group1 if group == 1 else self.points_group2
+                    if self.dragging_point_idx < len(group_points):
+                        pt_drag = group_points[self.dragging_point_idx]
+                        if pt_drag[:2] == (px, py):
+                            cv2.circle(display_img, (disp_px, disp_py), 10, (0, 255, 255), 2)
+            # Use global sequential index, prefix LP/RP
+            if global_idx is not None:
+                text = f"{'LP' if group==1 else 'RP'}{global_idx}"
+            else:
+                text = f"{'LP' if group==1 else 'RP'}?"
+            text_x = disp_px + 10
+            text_y = disp_py - 10 if disp_py > 15 else disp_py + 15
+            cv2.putText(display_img, text, (text_x, text_y),
+                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)
+
+        # Draw current mouse position (show original coordinates in text)
+        if self.current_mouse_pos is not None:
+            mx, my = self.current_mouse_pos
+            # 反向映射到原图像素坐标, 保留浮点再四舍五入
+            px = mx * self.width / disp_w
+            py = my * self.height / disp_h
+            show_px = round(px)
+            show_py = round(py)
+            cv2.putText(display_img, f"({show_px}, {show_py})", (10, disp_h - 10),
+                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
+
+        qimage = self.convert_to_qimage(display_img)
+        pixmap = QPixmap.fromImage(qimage)
+        self.setPixmap(pixmap)
+        if self.is_full_size:
+            self.setFixedSize(self.width, self.height)
+        else:
+            self.setFixedSize(pixmap.size())
