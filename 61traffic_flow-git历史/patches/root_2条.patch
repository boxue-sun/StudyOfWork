+#include "detectors/accumulate_headway_detector.h"
+
+namespace fusion_perception::traffic_flow {
+
+AccumulateHeadwayDetector::AccumulateHeadwayDetector(
+    const std::string& detector_id, const CoilInfo& coil_info)
+    : AccumulateDetector(detector_id), _coil_info(coil_info),
+      _tracker(coil_info.stop_line_segments) {
+    std::string lane_tag = _coil_info.tag;
+    _lane_acc[lane_tag] = LaneHeadwayAcc{
+        0, 0, 0, 0, 0,
+        {{"lane_tag", lane_tag},
+         {"road_section_tag", _coil_info.road_section_info.tag},
+         {"lane_no", _coil_info.lane_no},
+         {"lane_id", _coil_info.lane_id},
+         {"turn_dir_no", _coil_info.turn_dir_no}}
+    };
+}
+
+void AccumulateHeadwayDetector::update(const PerceptionResult& frame) {
+    auto crossed = _tracker.process_frame(frame);
+    for (const auto& obj : crossed) {
+        auto& acc = _lane_acc[_coil_info.tag];
+        uint64_t current_time = frame.timestamp;
+        uint64_t tail_time = current_time +
+            (uint64_t)(obj.length / (obj.speed / 3.6) * 1000);
+
+        if (acc.count == 0) {
+            acc.last_arrival = current_time;
+            acc.last_tail = tail_time;
+        } else {
+            acc.headway_sum += (current_time - acc.last_arrival);
+            if (current_time > acc.last_tail) {
+                acc.gap_sum += (current_time - acc.last_tail);
+            }
+            acc.last_arrival = current_time;
+            acc.last_tail = tail_time;
+        }
+        ++acc.count;
+    }
+}
+
+nlohmann::json AccumulateHeadwayDetector::calculate_once() {
+    nlohmann::json result = nlohmann::json::array();
+    for (auto& [lane_tag, acc] : _lane_acc) {
+        nlohmann::json entry = acc.meta;
+        if (acc.count > 1) {
+            entry["Headway"] = acc.headway_sum / double(acc.count - 1) / 1000.0;
+            entry["Gap"] = acc.gap_sum / double(acc.count - 1) / 1000.0;
+        } else {
+            entry["Headway"] = -1.0;
+            entry["Gap"] = -1.0;
+        }
+        result.push_back(entry);
+
+        acc.last_arrival = 0;
+        acc.last_tail = 0;
+        acc.headway_sum = 0;
+        acc.gap_sum = 0;
+        acc.count = 0;
+    }
+    _tracker.clear_crossing_state();
+    return result;
+}
+
+}  // namespace fusion_perception::traffic_flow
