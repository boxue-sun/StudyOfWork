+// 测试1: 正常JSON解析（模拟DDS发来的标准数据）
+// ============================================================
+void test_parse_normal_json() {
+    std::cout << "\n===== 测试1: 正常JSON解析 =====" << std::endl;
+
+    std::string test_json = R"({
+        "msg_type": 1743,
+        "timeStamp": 1724745600000,
+        "intersections": [{
+            "regionId": "region-1",
+            "crossId": "cross-1",
+            "phases": [
+                {"phaseId": 2, "phaseStates": [{"light": 6, "timing": {"counting": {"likelyEndTime": {"timeMark": 150}}}}]},
+                {"phaseId": 10, "phaseStates": [{"light": 3, "timing": {"counting": {"likelyEndTime": {"timeMark": 200}}}}]},
+                {"phaseId": 18, "phaseStates": [{"light": 3, "timing": {"counting": {"likelyEndTime": {"timeMark": 200}}}}]},
+                {"phaseId": 26, "phaseStates": [{"light": 6, "timing": {"counting": {"likelyEndTime": {"timeMark": 150}}}}]},
+                {"phaseId": 1, "phaseStates": [{"light": 3, "timing": {"counting": {"likelyEndTime": {"timeMark": 100}}}}]}
+            ]
+        }]
+    })";
+
+    auto result = parse_signal_json(test_json);
+
+    std::cout << "  [LOG] 解析出 " << result.size() << " 个相位" << std::endl;
+    CHECK(result.size() == 4, "解析出4个直行相位(左转phaseId=1被过滤)");
+
+    for (size_t i = 0; i < result.size(); i++) {
+        std::cout << "  [LOG] phase[" << i << "] direction="
+                  << direction_code_to_string(result[i].direction)
+                  << " light=" << static_cast<int>(result[i].light)
+                  << " time_remaining=" << result[i].time_remaining
+                  << " timestamp=" << result[i].timestamp << std::endl;
+    }
+
+    CHECK(result[0].direction == DirectionCode::NORTH, "phaseId=2 → 北");
+    CHECK(result[0].light == SignalLightState::PROTECTED_GREEN, "北方向是绿灯(6)");
+    CHECK(result[0].time_remaining == 150, "北方向剩余时间150(0.1s单位)");
+    CHECK(result[1].direction == DirectionCode::EAST, "phaseId=10 → 东");
+    CHECK(result[1].light == SignalLightState::RED, "东方向是红灯(3)");
+    CHECK(result[2].direction == DirectionCode::SOUTH, "phaseId=18 → 南");
+    CHECK(result[3].direction == DirectionCode::WEST, "phaseId=26 → 西");
+}
+
+// ============================================================
+// 测试2: 空字符串（DDS可能发来空消息）
+// ============================================================
+void test_parse_empty_json() {
+    std::cout << "\n===== 测试2: 空字符串输入 =====" << std::endl;
+    auto result = parse_signal_json("");
+    CHECK(result.empty(), "空输入返回空数组，不崩溃");
+}
+
+// ============================================================
+// 测试3: 损坏的JSON（DDS数据可能传输损坏）
+// ============================================================
+void test_parse_malformed_json() {
+    std::cout << "\n===== 测试3: 损坏的JSON =====" << std::endl;
+    auto result = parse_signal_json("{\"msg_type\": 1743, \"timeStamp\": broken!!!");
+    CHECK(result.empty(), "损坏JSON返回空数组，不崩溃");
+}
+
+// ============================================================
+// 测试4: 缺少字段（信号机可能不报倒计时）
+// ============================================================
+void test_parse_missing_fields() {
+    std::cout << "\n===== 测试4: 缺少timing字段 =====" << std::endl;
+    std::string test_json = R"({
+        "timeStamp": 1724745600000,
+        "intersections": [{
+            "phases": [
+                {"phaseId": 2, "phaseStates": [{"light": 6}]}
+            ]
+        }]
+    })";
+    auto result = parse_signal_json(test_json);
+    CHECK(result.size() == 1, "缺少timing也能解析出灯态");
+    CHECK(result[0].time_remaining == 0, "缺少timing时剩余时间为0");
+}
+
+// ============================================================
+// 测试5: 相位边界检测（核心逻辑）
+// ============================================================
+void test_phase_boundary() {
+    std::cout << "\n===== 测试5: 相位边界检测(绿→红→绿) =====" << std::endl;
+
+    auto& manager = SignalPhaseManager::get_instance();
+
+    // 第1帧: 北=绿
+    std::vector<SignalPhaseData> frame1 = {
+        {DirectionCode::NORTH, SignalLightState::PROTECTED_GREEN, 150, 1000}};
+    manager.update(frame1);
+    std::cout << "  [LOG] 第1帧: 北=绿" << std::endl;
+    CHECK(!manager.check_phase_boundary(DirectionCode::NORTH),
+          "第1帧后: 无边界(没有上一次状态)");
+
+    // 第2帧: 北变红 → 绿→红，应触发边界
+    std::vector<SignalPhaseData> frame2 = {
+        {DirectionCode::NORTH, SignalLightState::RED, 200, 2000}};
+    manager.update(frame2);
+    std::cout << "  [LOG] 第2帧: 北=红 (绿→红)" << std::endl;
+    CHECK(manager.check_phase_boundary(DirectionCode::NORTH),
+          "第2帧后: 检测到边界(绿→红)");
+    CHECK(!manager.check_phase_boundary(DirectionCode::NORTH),
+          "再查一次: 边界已消费，返回false");
+
+    // 第3帧: 北又变绿 → 红→绿，不应触发边界
+    std::vector<SignalPhaseData> frame3 = {
+        {DirectionCode::NORTH, SignalLightState::PROTECTED_GREEN, 150, 3000}};
+    manager.update(frame3);
+    std::cout << "  [LOG] 第3帧: 北=绿 (红→绿)" << std::endl;
+    CHECK(!manager.check_phase_boundary(DirectionCode::NORTH),
+          "第3帧后: 红→绿不触发边界");
+
+    // 第4帧: 北又变红 → 第二个周期，再次触发
+    std::vector<SignalPhaseData> frame4 = {
+        {DirectionCode::NORTH, SignalLightState::RED, 180, 4000}};
+    manager.update(frame4);
+    std::cout << "  [LOG] 第4帧: 北=红 (绿→红，第二个周期)" << std::endl;
+    CHECK(manager.check_phase_boundary(DirectionCode::NORTH),
+          "第4帧后: 第二个周期边界也能触发");
+}
+
+// ============================================================
+// 测试6: 灯态查询
+// ============================================================
+void test_get_light_state() {
+    std::cout << "\n===== 测试6: 灯态查询 =====" << std::endl;
+    auto& manager = SignalPhaseManager::get_instance();
+
+    auto state = manager.get_light_state(DirectionCode::NORTH);
+    std::cout << "  [LOG] 北方向当前灯态=" << static_cast<int>(state) << std::endl;
+    CHECK(state == SignalLightState::RED, "查询到第4帧后的红灯状态");
+
+    state = manager.get_light_state(DirectionCode::EAST);
+    CHECK(state == SignalLightState::UNAVAILABLE, "没收到过数据的方向返回UNAVAILABLE");
+}
+
+int main() {
+    std::cout << "============================================" << std::endl;
+    std::cout << "  信号灯模块自测程序 (模拟DDS数据流)" << std::endl;
+    std::cout << "============================================" << std::endl;
+
+    test_parse_normal_json();
+    test_parse_empty_json();
+    test_parse_malformed_json();
+    test_parse_missing_fields();
+    test_phase_boundary();
+    test_get_light_state();
+
+    std::cout << "\n============================================" << std::endl;
+    std::cout << "  结果: " << g_pass_count << " 通过, "
+              << g_fail_count << " 失败" << std::endl;
+    std::cout << "============================================" << std::endl;
+
+    return g_fail_count == 0 ? 0 : 1;
+}
