+    def delete_lane_by_index(self, idx):
+        if idx < 0 or idx >= len(self.lanes):
+            return
+        self.current_lane_idx = idx
+        self.delete_current_lane()
+        if not self.lanes:
+            if hasattr(self, "lane1_button"):
+                self.lane1_button.setEnabled(False)
+            if hasattr(self, "lane2_button"):
+                self.lane2_button.setEnabled(False)
+
+    def switch_lane(self, lane_idx):
+        """ Switch to the specified lane, and also switch the global input box content. """
+        if lane_idx < 0 or lane_idx >= len(self.lanes):
+            return
+        self.current_lane_idx = lane_idx
+        # Keep the previous boundary selection
+        self.current_group = getattr(self, "current_group", 1)
+        # Highlight the selected lane button
+        for idx, entry in enumerate(self.lane_entries):
+            entry[1].setChecked(idx == self.current_lane_idx)
+
+        lane = self.lanes[self.current_lane_idx]
+        self.lane_sdtype_edit.setText(lane.get("lane_sdtype_no", ""))
+        self.lane_id_edit.setText(lane.get("LaneID", ""))
+        self.turn_dir_no_edit.setText(lane.get("turn_dir_no", ""))
+
+        for label in self.image_labels:
+            label.current_lane_idx = self.current_lane_idx
+            # label.current_line_group = self.current_group
+            label.current_group = self.current_group
+            label.update_display()
+
+        self.update_all_points_text()
+        print(f"Switch to lane: {self.current_lane_idx+1}")
+
+    def delete_current_lane(self):
+        """ Delete the current lane and reindex remaining lanes and buttons """
+        if not hasattr(self, "lanes") or self.current_lane_idx < 0 or self.current_lane_idx >= len(self.lanes):
+            print("No lane to delete!")
+            return
+        # Index of lane to delete
+        del_idx = self.current_lane_idx
+        # Delete lane from lane list
+        del self.lanes[del_idx]
+
+        # Update lane entries in each image label
+        for label in getattr(self, "image_labels", []):
+            if hasattr(label, "lanes"):
+                if del_idx < len(label.lanes):
+                    del label.lanes[del_idx]
+                # Reassign lane_id for remaining lanes
+                for j, l in enumerate(label.lanes):
+                    if isinstance(l, dict):
+                        l["lane_id"] = j + 1
+
+        # Delete current lane widget
+        if hasattr(self, "lane_entries"):
+            if 0 <= del_idx < len(self.lane_entries):
+                lane_widget, btn, del_btn = self.lane_entries.pop(del_idx)
+                lane_widget.setParent(None)
+                lane_widget.deleteLater()
+            # Reset text and callbacks for remaining buttons
+            for idx, (lane_widget, btn, del_btn) in enumerate(self.lane_entries):
+                btn.setText(f"车道{idx+1}")
+                try:
+                    btn.clicked.disconnect()
+                except Exception:
+                    pass
+                btn.clicked.connect(lambda checked, idx=idx: self.switch_lane(idx))
+                try:
+                    del_btn.clicked.disconnect()
+                except Exception:
+                    pass
+                del_btn.clicked.connect(lambda checked=False, idx=idx: self.delete_lane_by_index(idx))
+
+        # Reindex lane_id for remaining lanes
+        for i, lane in enumerate(self.lanes):
+            if isinstance(lane, dict):
+                lane["lane_id"] = i + 1
+
+        # Adjust current_lane_idx: if only one lane left, index is 0; if more, min(del_idx, len-1)
+        if self.lanes:
+            self.current_lane_idx = min(del_idx, len(self.lanes) - 1)
+        else:
+            self.current_lane_idx = -1
+
+        # Synchronize current_lane_idx and current_group to all image labels
+        for label in getattr(self, "image_labels", []):
+            label.current_lane_idx = self.current_lane_idx
+            label.current_group = getattr(self, "current_group", 1)
+            label.update_display()
+
+        # Update global input fields
+        if self.lanes and self.current_lane_idx >= 0:
+            lane = self.lanes[self.current_lane_idx]
+            self.lane_sdtype_edit.setText(lane.get("lane_sdtype_no", ""))
+            self.lane_id_edit.setText(lane.get("LaneID", ""))
+            self.turn_dir_no_edit.setText(lane.get("turn_dir_no", ""))
+        else:
+            self.lane_sdtype_edit.clear()
+            self.lane_id_edit.clear()
+            self.turn_dir_no_edit.clear()
+
+        # Update lane line buttons (highlight current)
+        for idx, entry in enumerate(getattr(self, "lane_entries", [])):
+            entry[1].setChecked(idx == self.current_lane_idx)
+
+        # Update text and displays
+        if hasattr(self, "update_all_points_text"):
+            self.update_all_points_text()
+
+    def ensure_lane_exists(self):
