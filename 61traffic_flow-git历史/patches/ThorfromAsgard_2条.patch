+    def arrange_grid(self):
+        self.update_thumb_size()
+        # Clear existing widgets in the grid layout
+        for i in reversed(range(self.grid_layout.count())):
+            widget = self.grid_layout.itemAt(i).widget()
+            if widget:
+                widget.setParent(None)
+        # Re-add widgets in grid layout
+        n_col = self.desired_columns
+        row, col = 0, 0
+        for label in self.image_labels:
+            self.grid_layout.addWidget(label, row, col)
+            col += 1
+            if col >= n_col:
+                col = 0
+                row += 1
+
+    def update_thumb_size(self):
+        for label in self.image_labels:
+            if hasattr(label, "image"):
+                orig_h, orig_w = label.image.shape[:2]
+                scale = min(self.thumb_size / orig_w, self.thumb_size / orig_h)
+                disp_width = int(orig_w * scale)
+                disp_height = int(orig_h * scale)
+                label.scale_factor = scale
+                label.setFixedSize(disp_width, disp_height)
+                label.update_display()
+
+    def resizeEvent(self, event):
+        super().resizeEvent(event)
+        self.arrange_grid()
