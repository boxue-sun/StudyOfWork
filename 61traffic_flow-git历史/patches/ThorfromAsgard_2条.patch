+    def find_nearest_point(self, mx, my, group=None):
+        """
+        Find the nearest point to the mouse position (mx, my) within a given group.
+        Prefer searching in self.lanes[current_lane_idx] if available, otherwise fall back to
+        self.points_group1 / self.points_group2 for backward compatibility.
+        """
+        min_dist = float('inf')
+        min_idx = None
+        min_group = None
+        pixmap = self.pixmap()
+        if pixmap is not None:
+            disp_w = pixmap.width()
+            disp_h = pixmap.height()
+        else:
+            disp_w = int(self.width * (1.0 if self.is_full_size else self.scale_factor))
+            disp_h = int(self.height * (1.0 if self.is_full_size else self.scale_factor))
+        # Coordinate mapping
+        px = mx * self.width / disp_w
+        py = my * self.height / disp_h
+
+        # Try lanes-based storage first
+        if hasattr(self, 'lanes') and getattr(self, 'current_lane_idx', -1) >= 0 and getattr(self, 'current_lane_idx', -1) < len(self.lanes):
+            lane = self.lanes[self.current_lane_idx]
+            groups = []
+            if group is None:
+                groups = [(lane.get('line1_points', []), 1), (lane.get('line2_points', []), 2)]
+            else:
+                groups = [(lane.get('line1_points', []), 1)] if group == 1 else [(lane.get('line2_points', []), 2)]
+            for pts, g in groups:
+                for idx, pt in enumerate(pts):
+                    pt_x, pt_y = pt[0], pt[1]
+                    dist = ((pt_x - px)**2 + (pt_y - py)**2) ** 0.5
+                    if dist < min_dist:
+                        min_dist = dist
+                        min_idx = idx
+                        min_group = g
+            if min_dist <= self.drag_threshold:
+                return min_idx, min_group
+            return None, None
+
+        # Fallback to old storage
+        groups = []
+        if group is None:
+            groups = [(self.points_group1, 1), (self.points_group2, 2)]
+        else:
+            groups = [(self.points_group1, 1)] if group == 1 else [(self.points_group2, 2)]
+        for pts, g in groups:
+            for idx, pt in enumerate(pts):
+                pt_x, pt_y = pt[0], pt[1]
+                dist = ((pt_x - px)**2 + (pt_y - py)**2) ** 0.5
+                if dist < min_dist:
+                    min_dist = dist
+                    min_idx = idx
+                    min_group = g
+        if min_dist <= self.drag_threshold:
+            return min_idx, min_group
+        return None, None
+
+    def mousePressEvent(self, event):
+        self.setFocus()
+        pos = event.position().toPoint()
+        mx, my = pos.x(), pos.y()
+        # Get displayed image size
+        pixmap = self.pixmap()
+        if pixmap is not None:
+            disp_w = pixmap.width()
+            disp_h = pixmap.height()
+        else:
+            disp_w = int(self.width * (1.0 if self.is_full_size else self.scale_factor))
+            disp_h = int(self.height * (1.0 if self.is_full_size else self.scale_factor))
+        # Check whether within image bounds
+        if not (0 <= mx < disp_w and 0 <= my < disp_h):
+            return
+        # Coordinate mapping
+        px = mx * self.width / disp_w
+        py = my * self.height / disp_h
+        pixel_x = round(px)
+        pixel_y = round(py)
+        # Restrict to image bounds
+        pixel_x = min(max(0, pixel_x), self.width - 1)
+        pixel_y = min(max(0, pixel_y), self.height - 1)
+
+        top_window = self.window()
+        # Left mouse button: drag existing point or add new point
+        # Right mouse button: delete last point in current group (delegated to main window)
+        if event.button() == Qt.MouseButton.LeftButton:
+            # If there are no lanes, cannot add points
+            if not hasattr(self, 'lanes') or len(self.lanes) == 0:
+                print("No lanes exist, cannot add points.")
+                return
+
+            # try to find nearest point in lanes first
+            idx, group = self.find_nearest_point(mx, my, self.current_group)
+            if idx is not None and group == self.current_group:
+                self.dragging_point_idx = idx
+                self.dragging_group = group
+                self.dragging = True
+                return
+
+            # Add new point to current group if no nearby point found
+            pixel_coord = [pixel_x, pixel_y]
+            if getattr(self, "is_fisheye", True):
+                world_coords = self.pixel2wgs84_fisheye([pixel_coord])
+            else:
+                world_coords = self.coord_convertor.pixel2wgs84([pixel_coord])
+            lon, lat = world_coords[0]
+            creation_order = time.time()
+
+            # Prefer to store points in self.lanes if available (keeps DrawRoiPage and ImageLabel in sync)
+            if hasattr(self, 'lanes') and getattr(self, 'current_lane_idx', -1) >= 0:
+                lane_idx = self.current_lane_idx
+                if lane_idx >= len(self.lanes):
+                    while len(self.lanes) <= lane_idx:
+                        self.lanes.append({"lane_id": len(self.lanes)+1, "line1_points": [], "line2_points": []})
+                lane = self.lanes[lane_idx]
+                global_idx = None
+                if hasattr(top_window, 'get_next_global_index'):
+                    global_idx = top_window.get_next_global_index()
+                pt_tuple = (pixel_x, pixel_y, lat, lon, global_idx, creation_order)
+                if self.current_group == 1:
+                    lane['line1_points'].append(pt_tuple)
+                else:
+                    lane['line2_points'].append(pt_tuple)
+                # Notify parent to reassign indices and refresh text
+                if hasattr(top_window, 'reassign_global_indices'):
+                    top_window.reassign_global_indices()
+                if hasattr(top_window, 'update_all_points_text'):
+                    top_window.update_all_points_text()
+                self.update_display()
+                return
+
+            # Fallback (legacy): append into points_group lists
+            pt_tuple = (pixel_x, pixel_y, lat, lon, None, creation_order)
+            if self.current_group == 1:
+                self.points_group1.append(pt_tuple)
+            else:
+                self.points_group2.append(pt_tuple)
+            if hasattr(top_window, 'reassign_global_indices'):
+                top_window.reassign_global_indices()
+            return
+        elif event.button() == Qt.MouseButton.RightButton:
+            # Delete last point in current group
+            top_window = self.window()
+            line_group = self.current_group
+            if hasattr(top_window, "remove_last_global_point"):
+                top_window.remove_last_global_point(group=line_group, lane_idx=getattr(self, "current_lane_idx", 0))
+            return
+
+    def mouseMoveEvent(self, event):
+        pos = event.position().toPoint()
+        mx, my = pos.x(), pos.y()
+        pixmap = self.pixmap()
+        if pixmap is not None:
+            disp_w = pixmap.width()
+            disp_h = pixmap.height()
+        else:
+            disp_w = int(self.width * (1.0 if self.is_full_size else self.scale_factor))
+            disp_h = int(self.height * (1.0 if self.is_full_size else self.scale_factor))
+        # Drag point if in dragging state
+        if self.dragging and self.dragging_point_idx is not None and self.dragging_group is not None:
+            # Only drag within current group
+            px = mx * self.width / disp_w
+            py = my * self.height / disp_h
+            px = round(px)
+            py = round(py)
+            px = min(max(0, px), self.width - 1)
+            py = min(max(0, py), self.height - 1)
+            # Prefer lanes storage
+            if hasattr(self, 'lanes') and getattr(self, 'current_lane_idx', -1) >= 0:
+                group_points = self.lanes[self.current_lane_idx]["line1_points"] if self.dragging_group == 1 else self.lanes[self.current_lane_idx]["line2_points"]
+                if 0 <= self.dragging_point_idx < len(group_points):
+                    pt = group_points[self.dragging_point_idx]
+                    new_pt = (px, py) + pt[2:]
+                    group_points[self.dragging_point_idx] = new_pt
+                    self.update_display()
+                    top_window = self.window()
+                    if hasattr(top_window, "reassign_global_indices"):
+                        top_window.reassign_global_indices()
+                return
+            # Fallback to legacy groups
+            group_points = self.points_group1 if self.dragging_group == 1 else self.points_group2
+            if 0 <= self.dragging_point_idx < len(group_points):
+                pt = group_points[self.dragging_point_idx]
+                new_pt = (px, py) + pt[2:]
+                group_points[self.dragging_point_idx] = new_pt
+                self.update_display()
+                top_window = self.window()
+                if hasattr(top_window, "reassign_global_indices"):
+                    top_window.reassign_global_indices()
+            return
+        # Update current mouse position for display
+        if 0 <= mx < disp_w and 0 <= my < disp_h:
+            self.current_mouse_pos = (mx, my)
+            self.update_display()
+
+    def mouseReleaseEvent(self, event):
+        if self.dragging:
+            self.dragging = False
+            self.dragging_point_idx = None
+            self.dragging_group = None
+            self.setCursor(Qt.CursorShape.CrossCursor)
+            self.update_display()
+
+    def wheelEvent(self, event):
+        """
+        Ctrl + Mouse Wheel to zoom in/out the thumbnail size
+        """
+        # Only allow zooming when not in full-size mode
+        if event.modifiers() & Qt.KeyboardModifier.ControlModifier:
+            # Zoom in/out while holding Ctrl
+            num_degrees = event.angleDelta().y() / 8
+            num_steps = num_degrees / 15
+            if num_steps > 0:
+                self.scale_factor *= (1.1 ** num_steps)
+            elif num_steps < 0:
+                self.scale_factor /= (1.1 ** (-num_steps))
+            # Restrict to reasonable range
+            self.scale_factor = max(0.1, min(self.scale_factor, 3.0))
+            self.current_mouse_pos = None
+            self.update_display()
+            event.accept()  # Accept the event to prevent default behavior
+        else:
+            super().wheelEvent(event)
+
+    def keyPressEvent(self, event):
+        # Switch between groups with 1 and 2
+        if event.key() == Qt.Key.Key_1:
+            self.current_group = 1
+            print("Switch to group 1")
+            self.update_display()
+        elif event.key() == Qt.Key.Key_2:
+            self.current_group = 2
+            print("Switch to group 2")
+            self.update_display()
+        else:
+            super().keyPressEvent(event)
