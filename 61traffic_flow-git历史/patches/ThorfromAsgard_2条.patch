+    def on_set_left_boundary(self):
+        """ 
+        Switch all images' current editing line group to lane left boundary.
+        """
+        if not self.lanes:
+            print("No lanes to switch")
+            return
+        self.ensure_lane_exists()
+        self.current_group = 1
+        for label in self.image_labels:
+            label.current_lane_idx = self.current_lane_idx
+            # label.current_line_group = 1
+            label.current_group = 1
+            label.update_display()
+        print(f"Switch to lane {self.current_lane_idx+1} lane left boundary")
+
+    def on_set_right_boundary(self):
+        """ Switch all images' current editing line group to lane right boundary """
+        if not self.lanes:
+            print("No lanes to switch")
+            return
+        self.ensure_lane_exists()
+        self.current_group = 2
+        for label in self.image_labels:
+            label.current_lane_idx = self.current_lane_idx
+            # label.current_line_group = 2
+            label.current_group = 2
+            label.update_display()
+        print(f"Switch to lane {self.current_lane_idx+1} lane right boundary")
+
+    def add_new_lane(self):
+        """ Add a new lane and switch to it, also inherit the current boundary selection (left/right) and synchronize it to all labels. """
+        lane_id = len(self.lanes) + 1
+        new_lane = {
+            "lane_id": lane_id,
+            "line1_points": [],
+            "line2_points": [],
+            "lane_sdtype_no": "",
+            "LaneID": "",
+            "turn_dir_no": ""
+        }
+        self.lanes.append(new_lane)
+        # New lane index
+        self.current_lane_idx = len(self.lanes) - 1
+        # Keep current boundary selection
+        current_group = getattr(self, "current_group", 1)
+        self.current_group = current_group
+        # If currently editing right boundary, switch to left boundary when adding new lane
+        if self.current_group == 2:
+            self.current_group = 1
+            if hasattr(self, "lane1_button"):
+                self.lane1_button.setChecked(True)
+            if hasattr(self, "lane2_button"):
+                self.lane2_button.setChecked(False)
+            print("Switched to editing left boundary after adding new lane")
+        for label in self.image_labels:
+            label.current_lane_idx = self.current_lane_idx
+            # label.current_line_group = self.current_group
+            if not hasattr(label, "lanes") or label.lanes is None:
+                label.lanes = []
+            while len(label.lanes) < len(self.lanes):
+                label.lanes.append({"lane_id": len(label.lanes)+1, "line1_points": [], "line2_points": []})
+            if hasattr(label, "current_group"):
+                label.current_group = self.current_group
+
+        # Create lane button & delete button
+        lane_widget = QWidget()
+        hbox = QHBoxLayout()
+        hbox.setContentsMargins(0, 0, 0, 0)
+        hbox.setSpacing(2)
+        lane_button = QPushButton(f"车道{lane_id}")
+        lane_button.setCheckable(True)
+
+        delete_button = QToolButton()
+        delete_button.setIcon(QIcon(resource_path("material/delete.svg")))
+        delete_button.setIconSize(QSize(16, 16))
+        delete_button.setFixedSize(20, 20)
+        delete_button.setStyleSheet("border: none;")
+
+        hbox.addWidget(lane_button)
+        hbox.addWidget(delete_button)
+        lane_widget.setLayout(hbox)
+        self.lane_button_layout.addWidget(lane_widget)
+        # Store the widget for later show/hide logic
+        # (lane_widget, btn, del_btn)
+        self.lane_entries.append((lane_widget, lane_button, delete_button))
+
+        lane_idx = len(self.lanes) - 1
+        lane_button.clicked.connect(lambda checked, idx=lane_idx: self.switch_lane(idx))
+        delete_button.clicked.connect(lambda checked, idx=lane_idx: self.delete_lane_by_index(idx))
+
+        # Highlight the new lane button
+        for idx, entry in enumerate(self.lane_entries):
+            entry[1].setChecked(idx == self.current_lane_idx)
+
+        if hasattr(self, "lane1_button"):
+            self.lane1_button.setEnabled(True)
+        if hasattr(self, "lane2_button"):
+            self.lane2_button.setEnabled(True)
+
+        # Update global input fields
+        lane = self.lanes[self.current_lane_idx]
+        self.lane_sdtype_edit.setText(lane.get("lane_sdtype_no", ""))
+        self.lane_id_edit.setText(lane.get("LaneID", ""))
+        self.turn_dir_no_edit.setText(lane.get("turn_dir_no", ""))
+
+        # Update all labels
