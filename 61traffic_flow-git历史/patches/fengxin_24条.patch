index 0000000..1d6e3c0
--- /dev/null
+++ b/src/traffic_flow/detectors/accumulate_occupancy_detector.cpp
@@ -0,0 +1,110 @@
+#include "detectors/accumulate_occupancy_detector.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+
+#include "math/segment2d.hpp"
+
+namespace fusion_perception::traffic_flow {
+
+AccumulateOccupancyDetector::AccumulateOccupancyDetector(const std::string& detector_id, const CoilInfo& coil_info,
+                                                         const OccupancyRulesConfig& rules, uint64_t cycle_duration_ms)
+    : AccumulateDetector(detector_id), _coil_info(coil_info), _rules(rules),
+      _axis_frame(make_lane_axis_frame(coil_info)) {
+    // 1 秒通道的 cycle_duration_ms 是 1000，5 分钟是 300000；signal_cycle 不配该键（默认 0）但本检测器不挂它。
+    // 需求表对空间占有率的两种颗粒给了两种算法：1s 要「最新一帧」的瞬时值，5min 要窗口平均。
+    _latest_frame_only = (cycle_duration_ms <= 1000);
+
+    // math::Segment2D::length() 是经纬度欧氏距离（单位「度」），要米长得按帧里的换算自己做。
+    const math::Vec2D& section_1 = _coil_info.stop_line_points.front();
+    const math::Vec2D& section_2 = _coil_info.stop_line_points.back();
+    const double section_east = _axis_frame.east_of(section_2) - _axis_frame.east_of(section_1);
+    const double section_north = _axis_frame.north_of(section_2) - _axis_frame.north_of(section_1);
+    _half_section_m = std::hypot(section_east, section_north) / 2.0;
+
+    // 空间占有率的分母是「检测区域本身」= 车道轮廓全长，不跟着延误/停车次数的断面截断走。
+    _region_len_m = _axis_frame.far_len_m;
+
+    if (_region_len_m <= 0.0 || _half_section_m <= 0.0) {
+        std::cerr << "[Occupancy] " << _detector_id << " degenerate contour, region_len_m=" << _region_len_m
+                  << " half_section_m=" << _half_section_m << std::endl;
+    }
+}
+
+void AccumulateOccupancyDetector::update(const PerceptionResult& frame) {
+    bool occupied = false;
+    double occupied_len_m = 0.0;
+
+    if (_region_len_m > 0.0 && _half_section_m > 0.0) {
+        for (const auto& obj : frame.traffic_objects) {
+            if (!g_motor_vehicle_types.count(obj.inner_type)) {
+                continue;
+            }
+            const math::Vec2D pos(obj.latitude, obj.longitude);
+            const double along = _axis_frame.along(pos);
+            const double across = _axis_frame.across(pos);
+            const double half_len = body_length_m(obj) / 2.0;
+
+            // 断面是一条线，车身纵向跨过它就算占据；横向限制用停止线自身长度而不是轮廓宽度，
+            // 免得 212 lane1 那条画成 11.4m 宽的车道把三条邻道的车都算成自己的占有率。
+            if (std::fabs(along) <= half_len && std::fabs(across) <= _half_section_m) {
+                occupied = true;
+            }
+            // 空间占有率是「本车道」区间上的量，先把车按车道轮廓筛掉，否则邻道、对向的车
+            // 只要在纵轴上投影落进区间，就会把本车道的空间占有率顶到 100%。
+            // 轮廓是梯形，近边就是停止线，所以这个 bound 与上面时间项的停止线半长限制是同一个口径。
+            if (!_coil_info.lane_contour.is_point_in(pos)) {
+                continue;
+            }
+            // 车身落在区间内的那一段才计数：半个车身探到停止线外的部分不属于本区间。
+            const double lo = std::max(0.0, along - half_len);
+            const double hi = std::min(_region_len_m, along + half_len);
+            if (hi > lo) {
+                occupied_len_m += hi - lo;
+            }
+        }
+        // 重叠框（多相机对同一台车的重复轨迹）会把百分比顶过 100，占有率是百分数，钳住。
+        _space_last_pct = std::min(100.0, 100.0 * occupied_len_m / _region_len_m);
+        _space_sum_pct += _space_last_pct;
+        ++_space_frames;
+    }
+
+    if (_has_last_ts) {
+        const uint64_t step_ms = frame.timestamp - _last_ts;
+        // 断流/启动头段这类空档既不进分子也不进分母：分母只统计「真的在观测」的时长。
+        if (step_ms <= _rules.max_frame_gap_ms) {
+            _time_den_ms += step_ms;
+            if (_prev_occupied) {
+                _time_num_ms += step_ms;
+            }
+        }
+    }
+    _has_last_ts = true;
+    _last_ts = frame.timestamp;
+    _prev_occupied = occupied;
+}
+
+nlohmann::json AccumulateOccupancyDetector::calculate_once() {
+    nlohmann::json entry;
+    entry["lane_tag"] = _coil_info.tag;
+    entry["lane_id"] = _coil_info.lane_id;
+    entry["lane_no"] = _coil_info.lane_no;
+    entry["road_section_tag"] = _coil_info.road_section_info.tag;
+    entry["turn_dir_no"] = _coil_info.turn_dir_no;
+    // 两个占有率都是百分数，没车就是 0%，不存在「无样本」这回事，不用 -1 哨兵。
+    entry["TimeOccupancy"] = _time_den_ms > 0 ? 100.0 * _time_num_ms / _time_den_ms : 0.0;
+    entry["SpaceOccupancy"] = _latest_frame_only
+                                  ? _space_last_pct
+                                  : (_space_frames > 0 ? _space_sum_pct / _space_frames : 0.0);
+
+    _time_num_ms = 0;
+    _time_den_ms = 0;
+    _space_sum_pct = 0.0;
+    _space_last_pct = 0.0;
+    _space_frames = 0;
+    // _last_ts 与 _prev_occupied 不清：断面占用状态跟着车走，跨窗口那一拍该记给下一个窗口。
+    return entry;
+}
+
+}  // namespace fusion_perception::traffic_flow
