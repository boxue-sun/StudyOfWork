+#ifndef ACCUMULATE_OVERFLOW_DETECTOR_H
+#define ACCUMULATE_OVERFLOW_DETECTOR_H
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+#include "common/config.h"
+#include "common/track_info.h"
+#include "math/polygon2d.hpp"
+#include "traffic_flow/traffic_flow_detector.h"
+
+namespace fusion_perception::traffic_flow {
+
+// 需求表 #13~#15 的排队判定是「车速<10km/h 且持续超过 5s」，按时间而不是帧数计量，避免随帧率漂移。
+constexpr uint64_t OVERFLOW_QUEUE_HOLD_MS = 5000;
+
+class AccumulateOverflowDetector : public AccumulateDetector {
+public:
+    AccumulateOverflowDetector(const std::string& detector_id, const ExitLaneInfo& exit_lane_info);
+    ~AccumulateOverflowDetector() override = default;
+
+    void update(const PerceptionResult& frame) override;
+    nlohmann::json calculate_once() override;
+
+private:
+    bool is_queued(const TrackInfo& track_info) const;
+    static bool is_zone_overflow(const math::Polygon2D& zone, const std::vector<math::Vec2D>& queued_points);
+    void compute_overflow_state(const PerceptionResult& frame);
+
+    ExitLaneInfo _exit_lane_info;
+    std::map<std::string, TrackInfo> _object_tracks;
+    nlohmann::json _latest_result;
+};
+
+}  // namespace fusion_perception::traffic_flow
+#endif  // ACCUMULATE_OVERFLOW_DETECTOR_H
