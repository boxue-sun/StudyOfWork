new file mode 100644
index 0000000..d608812
--- /dev/null
+++ b/src/traffic_flow/detectors/snapshot_queue_detector.cpp
@@ -0,0 +1,138 @@
+#include "detectors/snapshot_queue_detector.h"
+
+#include <algorithm>
+#include <iostream>
+
+#include "math/segment2d.hpp"
+
+namespace fusion_perception::traffic_flow {
+
+const std::unordered_map<InnerType, float> SnapshotQueueDetector::s_type_to_coefficient = {
+    {InnerType::CAR, 1.0f},
+    {InnerType::BUS, 1.8f},
+    {InnerType::TRUCK, 1.8f}
+};
+
+SnapshotQueueDetector::SnapshotQueueDetector(const std::string& detector_id, const CoilInfo& coil_info)
+    : SnapshotDetector(detector_id), _coil_info(coil_info), _current_frame() {}
+
+float SnapshotQueueDetector::get_coefficient(const InnerType& type) const {
+    auto it = s_type_to_coefficient.find(type);
+    if (it == s_type_to_coefficient.end()) {
+        return 0.0f;
+    }
+    return it->second;
+}
+
+bool SnapshotQueueDetector::is_queued(const TrackInfo& track_info) const {
+    if (track_info.track.size() < QUEUE_DURATION_FRAMES) {
+        return false;
+    }
+    for (size_t i = track_info.track.size() - QUEUE_DURATION_FRAMES;
+         i < track_info.track.size(); ++i) {
+        if (track_info.track[i].speed > QUEUE_SPEED_THRESHOLD) {
+            return false;
+        }
+    }
+    return true;
+}
+
+nlohmann::json SnapshotQueueDetector::compute(const PerceptionResult& frame) {
+    _current_frame = frame;
+
+    for (const auto& obj : frame.traffic_objects) {
+        auto& track = _object_tracks[obj.id];
+        track.track.emplace_back(obj.latitude, obj.longitude, obj.speed, frame.timestamp);
+        if (track.id != obj.id) {
+            track.id = obj.id;
+        }
+        if (track.type != obj.inner_type) {
+            track.type = obj.inner_type;
+        }
+        if (track.object_length != obj.length) {
+            track.object_length = obj.length;
+        }
+    }
+
+    for (auto it = _object_tracks.begin(); it != _object_tracks.end();) {
+        uint64_t elapsed = frame.timestamp - it->second.track.back().timestamp;
+        if (elapsed > OBJECT_CLEAR_TIME) {
+            it = _object_tracks.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    math::Vec2D stop_p1 = _coil_info.stop_line_segments.front().start();
+    math::Vec2D stop_p2 = _coil_info.stop_line_segments.back().end();
+    math::Segment2D stop_segment(stop_p1, stop_p2);
+    math::Vec2D stop_mid = stop_segment.middle_point();
+
+    std::vector<TrackInfo> class_queue_objects;
+    std::vector<TrackInfo> queued_objects;
+    float class_queue_equivalent = 0.0f;
+    float queue_trans_count = 0.0f;
+
+    for (const auto& obj : frame.traffic_objects) {
+        auto& track = _object_tracks[obj.id];
+        math::Vec2D pos = track.track.back().position;
+
+        if (!_coil_info.lane_contour.is_point_in(pos)) {
+            continue;
+        }
+
+        if (g_motor_vehicle_types.count(obj.inner_type)) {
+            class_queue_objects.push_back(track);
+            class_queue_equivalent += get_coefficient(obj.inner_type);
+
+            if (is_queued(track)) {
+                queued_objects.push_back(track);
+                queue_trans_count += get_coefficient(obj.inner_type);
+            }
+        }
+    }
+
+    std::sort(class_queue_objects.begin(), class_queue_objects.end(),
+              [&](const TrackInfo& a, const TrackInfo& b) {
+                  return a.track.back().position.geo_distance_to(stop_mid)
+                       < b.track.back().position.geo_distance_to(stop_mid);
+              });
+
+    std::sort(queued_objects.begin(), queued_objects.end(),
+              [&](const TrackInfo& a, const TrackInfo& b) {
+                  return a.track.back().position.geo_distance_to(stop_mid)
+                       < b.track.back().position.geo_distance_to(stop_mid);
+              });
+
+    nlohmann::json result;
+    result["lane_tag"] = _coil_info.tag;
+    result["lane_id"] = _coil_info.lane_id;
+    result["lane_no"] = _coil_info.lane_no;
+    result["road_section_tag"] = _coil_info.road_section_info.tag;
+    result["turn_dir_no"] = _coil_info.turn_dir_no;
+    result["direction"] = static_cast<int>(_coil_info.road_section_info.direction);
+
+    result["ClassQueueNaturalNumber"] = class_queue_objects.size();
+    result["ClassQueueEquivalentNumber"] = class_queue_equivalent;
+    result["QueueCount"] = queued_objects.size();
+    result["QueueTransCount"] = queue_trans_count;
+
+    if (queued_objects.empty()) {
+        result["QueueLength"] = 0.0f;
+    } else {
+        result["QueueLength"] =
+            queued_objects.back().track.back().position.geo_distance_to(stop_mid);
+    }
+
+#ifdef DEBUG
+    std::cout << "[SnapshotQueue] " << _detector_id
+              << " class_queue=" << class_queue_objects.size()
+              << " queued=" << queued_objects.size()
+              << " queue_len=" << result["QueueLength"]
+              << " queue_trans=" << queue_trans_count << std::endl;
+#endif
+
+    return result;
+}
+
+}  // namespace fusion_perception::traffic_flow
