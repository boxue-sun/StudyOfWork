+void TrafficFlowFactory::build_detectors_from_config() {
+    auto& global_config = traffic_flow::GlobalConfig::get_instance();
+    auto cycle_configs = global_config.get_detector_cycle_configs();
+
+    for (const auto& cycle_config : cycle_configs) {
+        if (cycle_config.cycle_type == "snapshot") {
+            for (const auto& detector_item : cycle_config.detectors) {
+                if (detector_item.target != "entry_lane" && !detector_item.target.empty()) {
+                    continue;
+                }
+
+                for (const auto& so : detector_item.spatial_output) {
+                    _snapshot_spatial_output.insert(so);
+                }
+
+                auto road_sections = global_config.get_road_section_infos();
+                for (const auto& [section_tag, section_info] : road_sections) {
+                    auto coil_infos = global_config.get_coil_infos(section_tag);
+                    for (const auto& coil_info : coil_infos) {
+                        if (detector_item.type == "queue") {
+                            std::string detector_id = "snapshot_queue_" + coil_info.tag;
+                            _snapshot_detectors.push_back(
+                                std::make_unique<SnapshotQueueDetector>(detector_id, coil_info));
+                            std::cout << "[BuildDetectors] Created SnapshotQueueDetector: "
+                                      << detector_id << std::endl;
+                        } else if (detector_item.type == "volume") {
+                            std::string detector_id = "snapshot_volume_" + coil_info.tag;
+                            _snapshot_detectors.push_back(
+                                std::make_unique<SnapshotVolumeDetector>(detector_id, coil_info));
+                            std::cout << "[BuildDetectors] Created SnapshotVolumeDetector: "
+                                      << detector_id << std::endl;
+                        }
+                    }
+                }
+            }
+        } else if (cycle_config.cycle_type == "accumulate_5min") {
+            for (const auto& detector_item : cycle_config.detectors) {
+                for (const auto& so : detector_item.spatial_output) {
+                    _5min_spatial_output.insert(so);
+                }
+
+                auto road_sections = global_config.get_road_section_infos();
