+#ifndef ACCUMULATE_HEADWAY_DISTANCE_DETECTOR_H
+#define ACCUMULATE_HEADWAY_DISTANCE_DETECTOR_H
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+#include "math/vec2d.hpp"
+#include "traffic_flow/traffic_flow_detector.h"
+#include "common/config.h"
+
+namespace fusion_perception::traffic_flow {
+
+// 车头间距[m]：同一车道检测区间内，相邻两车在**同一时刻**的车头纵向距离，= 净间距 + 前车车长。
+// 每帧把中心点落在区间内的机动车沿车道行驶方向排序，相邻两两成对；窗口内全部有效车对合并取算术平均。
+// 两车等长时本量正好等于两车中心点距离（需求表允许的简化口径），不等长时差 (L_前−L_后)/2。
+// 与车头时距（AccumulateHeadwayDetector）口径不同：那个是断面级、只有过线瞬间才有样本，本项是区间内的瞬时跟驰状态。
+// 时间颗粒度只挂 1s / 5min（见 config/traffic_flow/traffic_flow_config.json）。
+class AccumulateHeadwayDistanceDetector : public AccumulateDetector {
+public:
+    AccumulateHeadwayDistanceDetector(const std::string& detector_id, const CoilInfo& coil_info);
+
+    void update(const PerceptionResult& frame) override;
+    nlohmann::json calculate_once() override;
+
+private:
+    CoilInfo _coil_info;
+    // 米制局部平面：原点取停止线中点，坐标轴取「指向车道轮廓内部」，两车坐标差即纵向距离。
+    math::Vec2D _origin;
+    double _axis_east = 0.0;
+    double _axis_north = 0.0;
+    double _east_meters_per_degree = 0.0;
+    double _dist_sum_m = 0.0;
+    uint32_t _pair_count = 0;
+};
+
+}  // namespace fusion_perception::traffic_flow
+#endif
