+/**
+ * @file spatial_aggregator.h
+ * @brief Post-processing: aggregates lane-level results to flow-direction and branch level.
+ */
+#ifndef SPATIAL_AGGREGATOR_H
+#define SPATIAL_AGGREGATOR_H
+
+#include <string>
+#include <vector>
+#include <nlohmann/json.hpp>
+#include "common/config.h"
+
+namespace fusion_perception::traffic_flow {
+
+enum class FlowType : uint8_t {
+    FORWARD = 1,
+    LEFT = 2,
+    RIGHT = 3
+};
+
+struct FlowSplit {
+    FlowType flow_type;
+    float ratio;
+};
+
+class SpatialAggregator {
+public:
+    static std::vector<FlowSplit> get_flow_splits(const std::string& turn_dir_no);
+
+    static nlohmann::json aggregate_to_flow(
+        const std::vector<nlohmann::json>& lane_results);
+
+    static nlohmann::json aggregate_to_branch(
+        const std::vector<nlohmann::json>& lane_results);
+
+private:
+    static float get_split_ratio(const std::string& turn_dir_no, FlowType flow_type);
+};
+
+}  // namespace fusion_perception::traffic_flow
+#endif  // SPATIAL_AGGREGATOR_H
