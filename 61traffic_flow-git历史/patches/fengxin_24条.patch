+
+#include <nlohmann/json.hpp>
+#include "traffic_flow/traffic_flow_detector.h"
+#include "common/config.h"
+#include "traffic_flow/detectors/stop_line_crossing_helper.h"
+
+namespace fusion_perception::traffic_flow {
+
+// 平均停车次数[次/辆]：分子=本窗口内过线车辆各自在本车道累计的停车次数，分母=本车道过线车辆数。
+class AccumulateAvgStopTimesDetector : public AccumulateDetector {
+public:
+    AccumulateAvgStopTimesDetector(const std::string& detector_id, const CoilInfo& coil_info,
+                                  const StopRulesConfig& rules);
+
+    void update(const PerceptionResult& frame) override;
+    nlohmann::json calculate_once() override;
+
+private:
+    struct VehicleStopState {
+        bool stopped = false;
+        // 当前速度条件（慢速/起速）的起始时间，条件一中断就复位；持续时长按时间计量，不随帧率漂移。
+        uint64_t condition_since = 0;
+        // 已累计但还没过线结算的停车次数。
+        uint16_t pending_stops = 0;
+        uint64_t last_seen = 0;
+    };
+
+    void feed_speed(const TrafficObject& object, uint64_t timestamp);
+
+    CoilInfo _coil_info;
+    StopRulesConfig _rules;
+    StopLineCrossingTracker _tracker;
+    // 跨窗口保留：停车次数跟着车走，过线才结算，否则 1 秒窗口会把跨窗口的排队车算成 0/0。
+    std::map<std::string, VehicleStopState> _states;
+    uint32_t _settled_stops = 0;
+    uint32_t _settled_vehicles = 0;
+};
+
+}  // namespace fusion_perception::traffic_flow
+#endif
