new file mode 100644
index 0000000..b57d4f1
--- /dev/null
+++ b/src/traffic_flow/detectors/accumulate_overflow_detector.cpp
@@ -0,0 +1,89 @@
+#include "detectors/accumulate_overflow_detector.h"
+
+#include <iostream>
+
+namespace fusion_perception::traffic_flow {
+
+AccumulateOverflowDetector::AccumulateOverflowDetector(const std::string& detector_id,
+                                                       const ExitLaneInfo& exit_lane_info)
+    : AccumulateDetector(detector_id), _exit_lane_info(exit_lane_info), _latest_result(nlohmann::json::object()) {}
+
+bool AccumulateOverflowDetector::is_queued(const TrackInfo& track_info) const {
+    const auto& track = track_info.track;
+    if (track.size() < 2u) {
+        return false;
+    }
+    size_t first = track.size() - 1u;
+    while (first > 0u && track[first - 1u].speed < QUEUE_SPEED_THRESHOLD) {
+        --first;
+    }
+    if (track[first].speed >= QUEUE_SPEED_THRESHOLD) {
+        return false;
+    }
+    return track.back().timestamp - track[first].timestamp >= OVERFLOW_QUEUE_HOLD_MS;
+}
+
+bool AccumulateOverflowDetector::is_zone_overflow(const math::Polygon2D& zone,
+                                                  const std::vector<math::Vec2D>& queued_points) {
+    if (zone.points().size() < 3u) {
+        return false;
+    }
+    for (const auto& point : queued_points) {
+        if (zone.is_point_in(point)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void AccumulateOverflowDetector::compute_overflow_state(const PerceptionResult& frame) {
+    std::vector<math::Vec2D> queued_points;
+    for (const auto& obj : frame.traffic_objects) {
+        auto it = _object_tracks.find(obj.id);
+        if (it == _object_tracks.end() || !is_queued(it->second)) {
+            continue;
+        }
+        queued_points.push_back(it->second.track.back().position);
+    }
+
+    _latest_result["_spatial"] = "BRANCH";
+    _latest_result["road_section_tag"] = _exit_lane_info.road_section_info.tag;
+    _latest_result["OverflowOccur"] = is_zone_overflow(_exit_lane_info.overflow_zone_near, queued_points) ? 1 : 0;
+    _latest_result["OverflowForecast"] = is_zone_overflow(_exit_lane_info.overflow_zone_far, queued_points) ? 1 : 0;
+    _latest_result["OverflowGridlock"] =
+        is_zone_overflow(_exit_lane_info.overflow_zone_upstream, queued_points) ? 1 : 0;
+
+#ifdef DEBUG
+    std::cout << "[AccumulateOverflow] " << _detector_id << " queued=" << queued_points.size()
+              << " occur=" << _latest_result["OverflowOccur"] << " forecast=" << _latest_result["OverflowForecast"]
+              << " gridlock=" << _latest_result["OverflowGridlock"] << std::endl;
+#endif
+}
+
+void AccumulateOverflowDetector::update(const PerceptionResult& frame) {
+    for (const auto& obj : frame.traffic_objects) {
+        if (!g_motor_vehicle_types.count(obj.inner_type)) {
+            continue;
+        }
+        auto& track = _object_tracks[obj.id];
+        track.track.emplace_back(obj.latitude, obj.longitude, obj.speed, frame.timestamp);
+    }
+
+    for (auto it = _object_tracks.begin(); it != _object_tracks.end();) {
+        if (frame.timestamp - it->second.track.back().timestamp > OBJECT_CLEAR_TIME) {
+            it = _object_tracks.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    compute_overflow_state(frame);
+}
+
+nlohmann::json AccumulateOverflowDetector::calculate_once() {
+    nlohmann::json result = _latest_result;
+    _latest_result = nlohmann::json::object();
+    return result;
+}
+
+}  // namespace fusion_perception::traffic_flow
