@@ -0,0 +1,49 @@
+#include "detectors/accumulate_speed_detector.h"
+
+#include <iostream>
+
+#include "common/perception_data.h"
+
+namespace fusion_perception::traffic_flow {
+
+AccumulateSpeedDetector::AccumulateSpeedDetector(const std::string& detector_id, const CoilInfo& coil_info)
+    : AccumulateDetector(detector_id), _coil_info(coil_info) {}
+
+void AccumulateSpeedDetector::update(const PerceptionResult& frame) {
+    float speed_sum = 0.0f;
+    int count = 0;
+
+    for (const auto& obj : frame.traffic_objects) {
+        if (!g_motor_vehicle_types.count(obj.inner_type)) {
+            continue;
+        }
+
+        math::Vec2D pos(obj.latitude, obj.longitude);
+        if (!_coil_info.lane_contour.is_point_in(pos)) {
+            continue;
+        }
+
+        speed_sum += obj.speed;
+        count++;
+    }
+
+    _latest_avg_speed = (count > 0) ? (speed_sum / count) : 0.0f;
+}
+
+nlohmann::json AccumulateSpeedDetector::calculate_once() {
+    nlohmann::json result;
+    result["lane_tag"] = _coil_info.tag;
+    result["road_section_tag"] = _coil_info.road_section_info.tag;
+    result["lane_no"] = _coil_info.lane_no;
+    result["lane_id"] = _coil_info.lane_id;
+    result["SpaceMeanSpeed"] = _latest_avg_speed;
+
+#ifdef DEBUG
+    std::cout << "[Speed] " << _detector_id
+              << " avg_speed=" << _latest_avg_speed << " km/h" << std::endl;
+#endif
+
+    return result;
+}
+
+}  // namespace fusion_perception::traffic_flow
