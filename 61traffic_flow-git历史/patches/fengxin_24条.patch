+#include "detectors/accumulate_avg_stop_times_detector.h"
+
+#include <iostream>
+
+namespace fusion_perception::traffic_flow {
+
+AccumulateAvgStopTimesDetector::AccumulateAvgStopTimesDetector(
+    const std::string& detector_id, const CoilInfo& coil_info, const StopRulesConfig& rules)
+    : AccumulateDetector(detector_id), _coil_info(coil_info), _rules(rules),
+      _tracker(coil_info.stop_line_segments) {}
+
+void AccumulateAvgStopTimesDetector::feed_speed(const TrafficObject& object, uint64_t timestamp) {
+    auto& state = _states[object.id];
+    state.last_seen = timestamp;
+
+    // 「在本车道内停的才算」：车不在本线圈车道面内时不推进状态机，只把慢速计时打断，
+    // 免得在上游路段或相邻车道的停车被记到这条车道的账上，也避免回到车道内时拿窗口外的时长凑够门限。
+    if (!_coil_info.lane_contour.is_point_in(math::Vec2D(object.latitude, object.longitude))) {
+        state.condition_since = 0;
+        return;
+    }
+
+    if (!state.stopped) {
+        if (object.speed > _rules.stop_speed_kmh) {
+            state.condition_since = 0;
+            return;
+        }
+        if (state.condition_since == 0) {
+            state.condition_since = timestamp;
+        }
+        if (timestamp - state.condition_since >= _rules.stop_hold_ms) {
+            state.stopped = true;
+            state.condition_since = 0;
+            ++state.pending_stops;
+        }
+        return;
+    }
+
+    // 已停车：必须重新起速并保持一段时间，才允许下一次停车计数（迟滞，防止堵停抖动重复计数）。
+    if (object.speed < _rules.resume_speed_kmh) {
+        state.condition_since = 0;
+        return;
+    }
+    if (state.condition_since == 0) {
+        state.condition_since = timestamp;
+    }
+    if (timestamp - state.condition_since >= _rules.resume_hold_ms) {
+        state.stopped = false;
+        state.condition_since = 0;
+    }
+}
+
+void AccumulateAvgStopTimesDetector::update(const PerceptionResult& frame) {
+    for (const auto& obj : frame.traffic_objects) {
+        if (g_motor_vehicle_types.count(obj.inner_type)) {
+            feed_speed(obj, frame.timestamp);
+        }
+    }
+
+    for (auto it = _states.begin(); it != _states.end();) {
+        if (frame.timestamp - it->second.last_seen > OBJECT_CLEAR_TIME) {
+            it = _states.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    const auto crossed = _tracker.process_frame(frame);
+    for (const auto& obj : crossed) {
+        if (!g_motor_vehicle_types.count(obj.inner_type)) {
+            continue;
+        }
+        auto it = _states.find(obj.id);
+        if (it == _states.end()) {
+            continue;
+        }
+        // 过线即结算：这辆车后续的停车记给下一个窗口，不再属于本窗口的分母。
+        _settled_stops += it->second.pending_stops;
+        it->second.pending_stops = 0;
+        ++_settled_vehicles;
+
+#ifdef DEBUG
+        std::cout << "[AvgStopTimes] " << _detector_id << " id=" << obj.id
+                  << " settled_stops=" << _settled_stops << " settled_vehicles=" << _settled_vehicles
+                  << std::endl;
+#endif
+    }
+}
+
+nlohmann::json AccumulateAvgStopTimesDetector::calculate_once() {
+    nlohmann::json entry;
+    entry["lane_tag"] = _coil_info.tag;
+    entry["lane_id"] = _coil_info.lane_id;
+    entry["lane_no"] = _coil_info.lane_no;
+    entry["road_section_tag"] = _coil_info.road_section_info.tag;
+    entry["turn_dir_no"] = _coil_info.turn_dir_no;
+    // 无过线车辆时写 -1，不能写 0：0 表示「一辆车都没停过」，和「没车过线」是两回事。
+    entry["AvgStopTimes"] = _settled_vehicles > 0
+                                ? static_cast<double>(_settled_stops) / _settled_vehicles
+                                : -1.0;
+
+    _settled_stops = 0;
+    _settled_vehicles = 0;
+    _tracker.clear_crossing_state();
+    // _states 不清空：停车次数跟着车跨窗口累计，未到线的排队车递延到它过线的那个窗口。
+    return entry;
+}
+
+}  // namespace fusion_perception::traffic_flow
