+namespace fusion_perception::traffic_flow {
+
+SnapshotVolumeDetector::SnapshotVolumeDetector(const std::string& detector_id, const CoilInfo& coil_info)
+    : SnapshotDetector(detector_id), _coil_info(coil_info), _tracker(coil_info.stop_line_segments) {}
+
+float SnapshotVolumeDetector::get_pcu_coefficient(const TrafficObject& obj) const {
+    if (obj.inner_type == InnerType::BUS || obj.inner_type == InnerType::TRUCK) {
+        return 1.8f;
+    }
+    if (obj.inner_type == InnerType::CAR) {
+        if (obj.vehicle_subtype == VehicleSubtype::MINIVAN) {
+            return 1.25f;
+        }
+        return 1.0f;
+    }
+    return 0.0f;
+}
+
+nlohmann::json SnapshotVolumeDetector::compute(const PerceptionResult& frame) {
+    auto crossed = _tracker.process_frame(frame);
+    for (const auto& obj : crossed) {
+        _volume_count++;
+        _pcu_count += get_pcu_coefficient(obj);
+    }
+
+    nlohmann::json result;
+    result["lane_tag"] = _coil_info.tag;
+    result["lane_id"] = _coil_info.lane_id;
+    result["lane_no"] = _coil_info.lane_no;
+    result["road_section_tag"] = _coil_info.road_section_info.tag;
+    result["turn_dir_no"] = _coil_info.turn_dir_no;
+    result["direction"] = static_cast<int>(_coil_info.road_section_info.direction);
+    result["Volume"] = _volume_count;
+    result["PCU"] = _pcu_count;
+
+    return result;
+}
+
+void SnapshotVolumeDetector::reset() {
+    _tracker.reset();
+    _volume_count = 0;
+    _pcu_count = 0.0f;
+}
+
+}  // namespace fusion_perception::traffic_flow
