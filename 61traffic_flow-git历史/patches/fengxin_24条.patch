+#include "detectors/accumulate_delay_detector.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+
+#include "detectors/lane_axis_frame.h"
+#include "math/segment2d.hpp"
+
+namespace fusion_perception::traffic_flow {
+
+namespace {
+
+// 位序从左到右是 掉头|右转|直行|左转（0001=左转、0010=直行、0100=右转、1000=掉头），
+// 与 SpatialAggregator::get_flow_splits、SignalPhaseManager::phases_for_lane 用的同一套位序。
+// 复合转向取最大值：基准取小会把该慢的方向也当成快方向，延误只可能记少不会记多。
+double free_flow_base_s(const std::string& turn_dir_no, const DelayRulesConfig& rules) {
+    double base = 0.0;
+    if (turn_dir_no.size() > 2 && turn_dir_no[2] == '1') {
+        base = std::max(base, static_cast<double>(rules.straight_s));
+    }
+    if (turn_dir_no.size() > 3 && turn_dir_no[3] == '1') {
+        base = std::max(base, static_cast<double>(rules.left_s));
+    }
+    if (turn_dir_no.size() > 1 && turn_dir_no[1] == '1') {
+        base = std::max(base, static_cast<double>(rules.right_s));
+    }
+    if (turn_dir_no.size() > 0 && turn_dir_no[0] == '1') {
+        base = std::max(base, static_cast<double>(rules.uturn_s));
+    }
+    // 没配转向的车道按直行兜底：整条车道恒 -1 比给一个偏乐观的基准更难排查。
+    return base > 0.0 ? base : static_cast<double>(rules.straight_s);
+}
+
+}  // namespace
+
+AccumulateDelayDetector::AccumulateDelayDetector(const std::string& detector_id, const CoilInfo& coil_info,
+                                                 const DelayRulesConfig& rules)
+    : AccumulateDetector(detector_id), _coil_info(coil_info) {
+    // 米制局部帧与上游断面的画法全模块共用一份（见 lane_axis_frame.h），占有率与停车次数用的是同一套。
+    const LaneAxisFrame frame = make_lane_axis_frame(coil_info);
+    const math::Segment2D section = upstream_section(coil_info, frame, rules.upstream_section_m);
+
+    _upstream_tracker = StopLineCrossingTracker({section});
+    _stop_tracker = StopLineCrossingTracker(coil_info.stop_line_segments);
+    _region_len_m = frame.along(section.middle_point());
+
+    // 自由流按「实测的同一段区间」换算，所以必须用本车道的区间长度，不能一律按 50m 查表。
+    if (rules.reference_length_m > 0.0f && _region_len_m > 0.0) {
+        _free_flow_s = free_flow_base_s(_coil_info.turn_dir_no, rules) * _region_len_m / rules.reference_length_m;
+    }
+    if (_free_flow_s <= 0.0) {
+        std::cerr << "[Delay] " << _detector_id << " unusable region, len_m=" << _region_len_m
+                  << " turn_dir_no=" << _coil_info.turn_dir_no << ", DelayTime will stay -1" << std::endl;
+    }
+}
+
+void AccumulateDelayDetector::update(const PerceptionResult& frame) {
+    for (const auto& obj : frame.traffic_objects) {
+        if (g_motor_vehicle_types.count(obj.inner_type)) {
+            _states[obj.id].last_seen = frame.timestamp;
+        }
+    }
+
+    for (auto it = _states.begin(); it != _states.end();) {
+        if (frame.timestamp - it->second.last_seen > OBJECT_CLEAR_TIME) {
+            it = _states.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    const auto armed = _upstream_tracker.process_frame(frame);
+    for (const auto& obj : armed) {
+        if (!g_motor_vehicle_types.count(obj.inner_type)) {
+            continue;
+        }
+        auto& transit = _states[obj.id];
+        if (transit.enter_ts == 0) {
+            transit.enter_ts = frame.timestamp;
+        }
+    }
+
+    const auto crossed = _stop_tracker.process_frame(frame);
+    for (const auto& obj : crossed) {
+        if (!g_motor_vehicle_types.count(obj.inner_type)) {
+            continue;
+        }
+        auto it = _states.find(obj.id);
+        // 没见过上游断面的车不算完整通过：它的行程时间量不出来，硬算会把「只跑了几米」当成整段延误。
+        if (it == _states.end() || it->second.enter_ts == 0) {
+            continue;
+        }
+        double delay_s = (frame.timestamp - it->second.enter_ts) / 1000.0 - _free_flow_s;
+        if (delay_s < 0.0) {
+            delay_s = 0.0;
+        }
+        _delay_sum_s += delay_s;
+        ++_settled_vehicles;
+        _states.erase(it);
+
+#ifdef DEBUG
+        std::cout << "[Delay] " << _detector_id << " id=" << obj.id << " delay=" << delay_s
+                  << " settled=" << _settled_vehicles << std::endl;
+#endif
+    }
+}
+
+nlohmann::json AccumulateDelayDetector::calculate_once() {
+    nlohmann::json entry;
+    entry["lane_tag"] = _coil_info.tag;
+    entry["lane_id"] = _coil_info.lane_id;
+    entry["lane_no"] = _coil_info.lane_no;
+    entry["road_section_tag"] = _coil_info.road_section_info.tag;
+    entry["turn_dir_no"] = _coil_info.turn_dir_no;
+    // 无完整通过的车辆时写 -1，不能写 0：0 表示「一辆车都没延误」，和「没车可测」是两回事。
+    entry["DelayTime"] = _settled_vehicles > 0 ? _delay_sum_s / _settled_vehicles : -1.0;
+
+    _delay_sum_s = 0.0;
+    _settled_vehicles = 0;
+    // 两个 tracker 一起清：长线轨迹允许在下一个窗口重新加热、重新结算。
+    _upstream_tracker.clear_crossing_state();
+    _stop_tracker.clear_crossing_state();
+    // _states 不清空：上一个窗口加热、这个窗口才过线的车，延误记在本窗口。
+    return entry;
+}
+
+}  // namespace fusion_perception::traffic_flow
