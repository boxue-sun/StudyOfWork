diff --git a/src/traffic_flow/detectors/accumulate_headway_distance_detector.cpp b/src/traffic_flow/detectors/accumulate_headway_distance_detector.cpp
new file mode 100644
index 0000000..04c09fc
--- /dev/null
+++ b/src/traffic_flow/detectors/accumulate_headway_distance_detector.cpp
@@ -0,0 +1,135 @@
+#include "detectors/accumulate_headway_distance_detector.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+
+#include "math/segment2d.hpp"
+
+namespace fusion_perception::traffic_flow {
+
+namespace {
+
+// 与排队检测器同一口径：上游 length 缺失按 4.5m 兜底，按 0 算会把车头间距少算掉半个车身。
+constexpr float kFallbackBodyLengthM = 4.5f;
+
+constexpr double kMetersPerDegreeLat = 111319.5;
+constexpr double kMetersPerDegreeLon = 111320.0;
+constexpr double kDegToRad = M_PI / 180.0;
+
+double body_length(const TrafficObject& object) {
+    return object.length > 0.0f ? object.length : kFallbackBodyLengthM;
+}
+
+struct LaneObject {
+    std::string id;
+    double upstream_m = 0.0;       // 沿坐标轴正方向的投影，判方向后即为「离停止线有多上游」，越大越靠后
+    double body_length_m = 0.0;
+};
+
+}  // namespace
+
+AccumulateHeadwayDistanceDetector::AccumulateHeadwayDistanceDetector(
+    const std::string& detector_id, const CoilInfo& coil_info)
+    : AccumulateDetector(detector_id), _coil_info(coil_info) {
+    // lat/lon 是度，1° 经线和 1° 纬线不等长，先落到以停止线中点为原点的米制局部平面才谈得上「纵向距离」。
+    const math::Segment2D stop_segment(_coil_info.stop_line_segments.front().start(),
+                                       _coil_info.stop_line_segments.back().end());
+    _origin = stop_segment.middle_point();
+    _east_meters_per_degree = kMetersPerDegreeLon * std::cos(_origin.x() * kDegToRad);
+
+    const auto& contour_points = _coil_info.lane_contour.points();
+    double east = 0.0;
+    double north = 0.0;
+    for (const auto& point : contour_points) {
+        east += (point.y() - _origin.y()) * _east_meters_per_degree;
+        north += (point.x() - _origin.x()) * kMetersPerDegreeLat;
+    }
+    if (!contour_points.empty()) {
+        east /= contour_points.size();
+        north /= contour_points.size();
+    }
+    // 轮廓退化（重合点）时留零向量，投影恒为 0，车对会全部落到「净距为负」而被丢弃，输出 -1。
+    const double norm = std::hypot(east, north);
+    if (norm > 0.0) {
+        _axis_east = east / norm;
+        _axis_north = north / norm;
+    }
+}
+
+void AccumulateHeadwayDistanceDetector::update(const PerceptionResult& frame) {
+    std::vector<LaneObject> lane_objects;
+    lane_objects.reserve(frame.traffic_objects.size());
+    double heading_vote = 0.0;
+    for (const auto& obj : frame.traffic_objects) {
+        if (!g_motor_vehicle_types.count(obj.inner_type)) {
+            continue;
+        }
+        // 检测区间 = 车道轮廓，与排队/车速检测器同一个 bound；中心点在外面的车不参与成对。
+        if (!_coil_info.lane_contour.is_point_in(math::Vec2D(obj.latitude, obj.longitude))) {
+            continue;
+        }
+        const double east = (obj.longitude - _origin.y()) * _east_meters_per_degree;
+        const double north = (obj.latitude - _origin.x()) * kMetersPerDegreeLat;
+        // heading 是「0=北、顺时针」的罗盘角，其单位向量在 (东, 北) 下是 (sin, cos)。
+        const double heading_rad = obj.heading * kDegToRad;
+        const double heading_axis_cos =
+            std::sin(heading_rad) * _axis_east + std::cos(heading_rad) * _axis_north;
+        LaneObject item;
+        item.id = obj.id;
+        item.upstream_m = east * _axis_east + north * _axis_north;
+        item.body_length_m = body_length(obj);
+        heading_vote += heading_axis_cos;
+        lane_objects.push_back(std::move(item));
+    }
+    if (lane_objects.size() < 2u) {
+        return;
+    }
+
+    // 轮廓是从停止线往上画的，进口道车流逆着坐标轴走（cos<0），此时坐标轴本身就是上游方向；
+    // 出口道那类车流顺着坐标轴走的车道要翻过来，否则「前车/后车」会整个颠倒。
+    const double sign = heading_vote >= 0.0 ? -1.0 : 1.0;
+    for (auto& item : lane_objects) {
+        item.upstream_m *= sign;
+    }
+    std::sort(lane_objects.begin(), lane_objects.end(),
+              [](const LaneObject& a, const LaneObject& b) { return a.upstream_m < b.upstream_m; });
+
+    for (size_t i = 1; i < lane_objects.size(); ++i) {
+        const LaneObject& front = lane_objects[i - 1];
+        const LaneObject& rear = lane_objects[i];
+        // upstream_m 是中心点投影，减掉两个半长才是前车车尾—后车车头的净距。
+        const double net_m =
+            rear.upstream_m - front.upstream_m - (front.body_length_m + rear.body_length_m) / 2.0;
+        // 净距为负 = 两个框重叠，是多相机/雷达对同一台车的重复轨迹，不是真实的跟驰间距。
+        if (net_m < 0.0) {
+            continue;
+        }
+        // 车头纵向距离 = 净间距 + 前车车长（后车车头量到前车车头）。
+        const double headway_m = net_m + front.body_length_m;
+        _dist_sum_m += headway_m;
+        ++_pair_count;
+
+#ifdef DEBUG
+        std::cout << "[HeadwayDistance] " << _detector_id << " front=" << front.id << " rear=" << rear.id
+                  << " headway=" << headway_m << " pairs=" << _pair_count << std::endl;
+#endif
+    }
+}
+
+nlohmann::json AccumulateHeadwayDistanceDetector::calculate_once() {
+    nlohmann::json entry;
+    entry["lane_tag"] = _coil_info.tag;
+    entry["lane_id"] = _coil_info.lane_id;
+    entry["lane_no"] = _coil_info.lane_no;
+    entry["road_section_tag"] = _coil_info.road_section_info.tag;
+    entry["turn_dir_no"] = _coil_info.turn_dir_no;
+    // 无样本写 -1 而不是 0：0 表示车头贴车尾，是有物理含义的极端值。
+    entry["HeadwayDistance"] = _pair_count > 0 ? _dist_sum_m / _pair_count : -1.0;
+
+    _dist_sum_m = 0.0;
+    _pair_count = 0;
+    return entry;
+}
+
+}  // namespace fusion_perception::traffic_flow
