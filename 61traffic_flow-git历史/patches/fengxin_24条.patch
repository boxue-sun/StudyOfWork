+    if (!ifile.is_open()) {
+        std::cerr << "Error, unable to open file: " << _config_path << std::endl;
+        return false;
+    }
+    std::stringstream buffer;
+    buffer << ifile.rdbuf();
+    std::string contents = buffer.str();
+    ifile.close();
+    if (contents.empty()) {
+        return false;
+    }
+
+    try {
+        nlohmann::json config_json = nlohmann::json::parse(contents);
+        if (config_json.contains("detector_cycles")) {
+            config_json.at("detector_cycles").get_to(_detector_cycle_configs);
+        }
+    } catch (std::exception& e) {
+        std::cerr << "Error loading detector cycle config: " << e.what() << std::endl;
+        return false;
+    }
+    return true;
+}
