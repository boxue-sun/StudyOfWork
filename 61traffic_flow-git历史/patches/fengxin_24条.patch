+#ifndef ACCUMULATE_OCCUPANCY_DETECTOR_H
+#define ACCUMULATE_OCCUPANCY_DETECTOR_H
+
+#include <cstdint>
+#include <string>
+
+#include <nlohmann/json.hpp>
+#include "math/vec2d.hpp"
+#include "traffic_flow/traffic_flow_detector.h"
+#include "common/config.h"
+#include "detectors/lane_axis_frame.h"
+
+namespace fusion_perception::traffic_flow {
+
+// 占有率[%]，两个字段一套几何帧：
+// TimeOccupancy —— 检测断面（停止线）被车辆占有的时间 ÷ 观测到的时长，逐帧时间积分；
+// SpaceOccupancy —— 某一帧上区间内车辆占用长度 ÷ 区间长度，瞬时值。
+// 时间颗粒度 1s + 5min：1s 的占有率取「该秒内的积分/平均」，与 5min 同一套累加器，不需要特殊分支；
+// 只有空间占有率按需求表的「1s 取最新一帧、5min 取窗口平均」分岔（见 _latest_frame_only）。
+class AccumulateOccupancyDetector : public AccumulateDetector {
+public:
+    AccumulateOccupancyDetector(const std::string& detector_id, const CoilInfo& coil_info,
+                                const OccupancyRulesConfig& rules, uint64_t cycle_duration_ms);
+
+    void update(const PerceptionResult& frame) override;
+    nlohmann::json calculate_once() override;
+
+private:
+    CoilInfo _coil_info;
+    OccupancyRulesConfig _rules;
+
+    // 米制局部平面：原点取停止线中点，纵轴指向车道轮廓内部，与延误/停车次数检测器共用同一套画法。
+    LaneAxisFrame _axis_frame;
+    double _region_len_m = 0.0;       // 停止线 → 轮廓远端 的纵向距离，空间占有率的分母
+    double _half_section_m = 0.0;     // 停止线半长，横向落在这之内才算「压在本车道的断面上」
+    bool _latest_frame_only = false;
+
+    bool _has_last_ts = false;
+    uint64_t _last_ts = 0;
+    bool _prev_occupied = false;
+    uint64_t _time_num_ms = 0;
+    uint64_t _time_den_ms = 0;
+    double _space_sum_pct = 0.0;
+    double _space_last_pct = 0.0;
+    uint32_t _space_frames = 0;
+};
+
+}  // namespace fusion_perception::traffic_flow
+#endif
diff --git a/src/traffic_flow/detectors/lane_axis_frame.h b/src/traffic_flow/detectors/lane_axis_frame.h
new file mode 100644
index 0000000..8ecc089
--- /dev/null
+++ b/src/traffic_flow/detectors/lane_axis_frame.h
@@ -0,0 +1,87 @@
+#ifndef LANE_AXIS_FRAME_H
+#define LANE_AXIS_FRAME_H
+
+#include <cmath>
+
+#include "common/config.h"
+#include "math/segment2d.hpp"
+#include "math/vec2d.hpp"
+
+namespace fusion_perception::traffic_flow {
+
+// 度不是各向同性的长度单位：1° 纬线约 111.3km，1° 经线还要乘 cos(纬度)。而 math::Segment2D::length()
+// 量的是经纬度坐标下的欧氏距离（单位「度」），拿它当米数会差十万八千倍。所有「按纵向量」的车道级指标
+// （延误时间、占有率、停车次数、车头间距）都必须先落到本文件这个米制局部帧里再算距离。
+constexpr double kMetersPerDegreeLat = 111319.5;
+constexpr double kMetersPerDegreeLon = 111320.0;
+constexpr double kDegToRad = M_PI / 180.0;
+
+// 以停止线中点为原点、纵轴指向车道轮廓内部的米制帧。纵轴取轮廓顶点的平均方向：车道轮廓是「停止线→远端」
+// 围成的四边形，其形心相对停止线中点的方向就是「往里」的方向，比用某条边的法向稳。
+struct LaneAxisFrame {
+    math::Vec2D origin;                    // 停止线中点（经纬度）
+    double east_meters_per_degree = 0.0;   // 该纬度上 1° 经线等于多少米
+    double axis_east = 0.0;                // 纵轴单位向量
+    double axis_north = 0.0;
+    double far_len_m = 0.0;                // 停止线 → 轮廓远端 的纵向距离，0 = 轮廓退化
+
+    double east_of(const math::Vec2D& p) const { return (p.y() - origin.y()) * east_meters_per_degree; }
+    double north_of(const math::Vec2D& p) const { return (p.x() - origin.x()) * kMetersPerDegreeLat; }
+    // along > 0 表示在停止线上游（轮廓那一侧）；across 的正负即左右，绝对值是偏离纵轴多少米。
+    double along(const math::Vec2D& p) const { return east_of(p) * axis_east + north_of(p) * axis_north; }
+    double across(const math::Vec2D& p) const { return -east_of(p) * axis_north + north_of(p) * axis_east; }
+};
+
+inline LaneAxisFrame make_lane_axis_frame(const CoilInfo& coil_info) {
+    LaneAxisFrame frame;
+    const math::Segment2D stop_segment(coil_info.stop_line_segments.front().start(),
+                                       coil_info.stop_line_segments.back().end());
+    frame.origin = stop_segment.middle_point();
+    frame.east_meters_per_degree = kMetersPerDegreeLon * std::cos(frame.origin.x() * kDegToRad);
+
+    double east = 0.0;
+    double north = 0.0;
+    const auto& contour_points = coil_info.lane_contour.points();
+    for (const auto& point : contour_points) {
+        east += frame.east_of(point);
+        north += frame.north_of(point);
+    }
+    if (!contour_points.empty()) {
+        east /= contour_points.size();
+        north /= contour_points.size();
+    }
+    // 轮廓退化（顶点重合）时留下零向量：所有投影恒为 0，依赖它的指标只会得到「量不出来」，不做无意义的除法。
+    const double norm = std::hypot(east, north);
+    if (norm > 0.0) {
+        frame.axis_east = east / norm;
+        frame.axis_north = north / norm;
+    }
+
+    const math::Vec2D& far_1 = coil_info.contour_segment_1.back();
+    const math::Vec2D& far_2 = coil_info.contour_segment_2.back();
+    const math::Vec2D far_mid((far_1.x() + far_2.x()) / 2.0, (far_1.y() + far_2.y()) / 2.0);
+    frame.far_len_m = frame.along(far_mid);
+    return frame;
+}
+
+// 「上游固定检测断面」：停止线上游 meters 米处横跨车道的断面，在两条纵向边上线性插值得到。
+// meters <= 0 或轮廓退化时用远端那条边；配得比轮廓还长也钳到远端，不把断面画到 ROI 之外。
+// 插值放在经纬度里做是安全的：轴向投影是线性函数，插值点的投影就是同比例的米数。
+inline math::Segment2D upstream_section(const CoilInfo& coil_info, const LaneAxisFrame& frame, double meters) {
+    const math::Vec2D& near_1 = coil_info.contour_segment_1.front();
+    const math::Vec2D& near_2 = coil_info.contour_segment_2.front();
+    const math::Vec2D& far_1 = coil_info.contour_segment_1.back();
+    const math::Vec2D& far_2 = coil_info.contour_segment_2.back();
+
+    double ratio = 1.0;
+    if (meters > 0.0 && frame.far_len_m > 0.0) {
+        ratio = std::min(1.0, meters / frame.far_len_m);
+    }
+    const auto lerp = [ratio](const math::Vec2D& a, const math::Vec2D& b) {
+        return math::Vec2D(a.x() + (b.x() - a.x()) * ratio, a.y() + (b.y() - a.y()) * ratio);
+    };
+    return math::Segment2D(lerp(near_1, far_1), lerp(near_2, far_2));
+}
+
+}  // namespace fusion_perception::traffic_flow
+#endif
