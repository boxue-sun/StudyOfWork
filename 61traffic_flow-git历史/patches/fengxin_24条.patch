+#ifndef ACCUMULATE_DELAY_DETECTOR_H
+#define ACCUMULATE_DELAY_DETECTOR_H
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+#include "math/vec2d.hpp"
+#include "traffic_flow/traffic_flow_detector.h"
+#include "traffic_flow/detectors/stop_line_crossing_helper.h"
+#include "common/config.h"
+
+namespace fusion_perception::traffic_flow {
+
+// 车均延误[s]：窗口内通过本进口车道停止线的车，在「上游固定检测断面 → 停止线」区间的实际行程时间
+// 与同区间自由流行程时间之差的平均值。上游断面默认取车道轮廓远端那条边，可配 `upstream_section_m`
+// 往里截：轮廓常被画到传感器实际覆盖之外（212 进口道 36~44m，轨迹只观到 30~36m），断面够不到就恒 -1。
+// 只有「先穿越上游断面、再穿越停止线」的车才算一次完整通过：起点就落在区间里的车没有可测的上游断面，
+// 不计入。变道车同样自动出局——加热用的是本车道的上游断面线段、结算用的是本车道的停止线线段，
+// 中途并到邻道就再也不会与本车道的停止线相交，两端配不上对，不需要额外的变道检测。
+// 实际行程快于自由流时差值为负，按 0 计而不是丢样本：那是「没延误」，不是「没测到」。
+// 时间颗粒度只挂 5min（见 config/traffic_flow/traffic_flow_config.json），且只对进口道线圈建实例。
+class AccumulateDelayDetector : public AccumulateDetector {
+public:
+    AccumulateDelayDetector(const std::string& detector_id, const CoilInfo& coil_info, const DelayRulesConfig& rules);
+
+    void update(const PerceptionResult& frame) override;
+    nlohmann::json calculate_once() override;
+
+private:
+    struct Transit {
+        uint64_t enter_ts = 0;      // 0 = 还没穿越上游断面，过线时不计
+        uint64_t last_seen = 0;
+    };
+
+    CoilInfo _coil_info;
+    // 检测区间长度（停止线 → 上游固定断面 的纵向距离），构造期由 LaneAxisFrame 量好；
+    // 自由流换算与「区间是否可用」的判断都只看它。
+    double _region_len_m = 0.0;
+    // 自由流行程时间：按本车道转向在构造期一次性换算好，区间长度对一条车道是常量。
+    double _free_flow_s = 0.0;
+
+    StopLineCrossingTracker _upstream_tracker;
+    StopLineCrossingTracker _stop_tracker;
+    // 跨窗口保留：加热与结算可能落在相邻的两个 5min 窗口里，递延到结算那个窗口，与 AvgStopTimes 一致。
+    std::map<std::string, Transit> _states;
+    double _delay_sum_s = 0.0;
+    uint32_t _settled_vehicles = 0;
+};
+
+}  // namespace fusion_perception::traffic_flow
+#endif
