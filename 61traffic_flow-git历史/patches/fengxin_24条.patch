+/**
+ * @file spatial_aggregator.cpp
+ * @brief Implementation of SpatialAggregator.
+ */
+#include "spatial_aggregator.h"
+#include <unordered_map>
+
+namespace fusion_perception::traffic_flow {
+
+std::vector<FlowSplit> SpatialAggregator::get_flow_splits(const std::string& turn_dir_no) {
+    std::vector<FlowSplit> splits;
+
+    bool has_forward = (turn_dir_no.size() >= 3 && turn_dir_no[2] == '1');
+    bool has_left = (turn_dir_no.size() >= 2 && turn_dir_no[1] == '1');
+    bool has_right = (turn_dir_no.size() >= 4 && turn_dir_no[3] == '1');
+
+    int count = 0;
+    if (has_forward) count++;
+    if (has_left) count++;
+    if (has_right) count++;
+
+    if (count == 0) {
+        return splits;
+    }
+
+    float ratio = 1.0f / count;
+
+    if (has_forward) {
+        splits.push_back({FlowType::FORWARD, ratio});
+    }
+    if (has_left) {
+        splits.push_back({FlowType::LEFT, ratio});
+    }
+    if (has_right) {
+        splits.push_back({FlowType::RIGHT, ratio});
+    }
+
+    return splits;
+}
+
+float SpatialAggregator::get_split_ratio(const std::string& turn_dir_no, FlowType flow_type) {
+    auto splits = get_flow_splits(turn_dir_no);
+    for (const auto& split : splits) {
+        if (split.flow_type == flow_type) {
+            return split.ratio;
+        }
+    }
+    return 0.0f;
+}
+
+nlohmann::json SpatialAggregator::aggregate_to_flow(
+    const std::vector<nlohmann::json>& lane_results) {
+
+    std::unordered_map<std::string, nlohmann::json> flow_accumulators;
+
+    for (const auto& lane_result : lane_results) {
+        std::string branch_id = lane_result.value("road_section_tag", "");
+        std::string turn_dir_no = lane_result.value("turn_dir_no", "");
+
+        auto splits = get_flow_splits(turn_dir_no);
+
+        for (const auto& split : splits) {
+            std::string flow_key = branch_id + "_" +
+                                   std::to_string(static_cast<uint8_t>(split.flow_type));
+
+            if (!flow_accumulators.count(flow_key)) {
+                nlohmann::json entry;
+                entry["BranchID"] = branch_id;
+                entry["FlowType"] = static_cast<int>(split.flow_type);
+                entry["Volume"] = 0;
+                entry["PCU"] = 0.0f;
+                entry["QueueLength"] = 0.0f;
+                entry["QueueCount"] = 0;
+                entry["QueueTransCount"] = 0.0f;
+                flow_accumulators[flow_key] = entry;
+            }
+
+            auto& acc = flow_accumulators[flow_key];
+
+            if (lane_result.contains("Volume")) {
+                acc["Volume"] = acc["Volume"].get<float>() + lane_result["Volume"].get<float>() * split.ratio;
+            }
+            if (lane_result.contains("PCU")) {
+                acc["PCU"] = acc["PCU"].get<float>() + lane_result["PCU"].get<float>() * split.ratio;
+            }
+            if (lane_result.contains("QueueLength")) {
+                float lane_queue_len = lane_result["QueueLength"].get<float>();
+                if (lane_queue_len > acc["QueueLength"].get<float>()) {
+                    acc["QueueLength"] = lane_queue_len;
+                }
+            }
+            if (lane_result.contains("QueueCount")) {
+                acc["QueueCount"] = acc["QueueCount"].get<int>() + lane_result["QueueCount"].get<int>();
+            }
+            if (lane_result.contains("QueueTransCount")) {
+                acc["QueueTransCount"] = acc["QueueTransCount"].get<float>() + lane_result["QueueTransCount"].get<float>();
+            }
+        }
+    }
+
+    nlohmann::json result = nlohmann::json::array();
+    for (const auto& [key, value] : flow_accumulators) {
+        result.push_back(value);
+    }
+    return result;
+}
+
+nlohmann::json SpatialAggregator::aggregate_to_branch(
+    const std::vector<nlohmann::json>& lane_results) {
+
+    std::unordered_map<std::string, nlohmann::json> branch_accumulators;
+
+    for (const auto& lane_result : lane_results) {
+        std::string branch_key = lane_result.value("road_section_tag", "");
+
+        if (!branch_accumulators.count(branch_key)) {
+            nlohmann::json entry;
+            entry["BranchID"] = branch_key;
+            entry["Volume"] = 0;
+            entry["PCU"] = 0.0f;
+            entry["QueueLength"] = 0.0f;
+            entry["QueueCount"] = 0;
+            entry["QueueTransCount"] = 0.0f;
+            branch_accumulators[branch_key] = entry;
+        }
+
+        auto& acc = branch_accumulators[branch_key];
+
+        if (lane_result.contains("Volume")) {
+            acc["Volume"] = acc["Volume"].get<int>() + lane_result["Volume"].get<int>();
+        }
+        if (lane_result.contains("PCU")) {
+            acc["PCU"] = acc["PCU"].get<float>() + lane_result["PCU"].get<float>();
+        }
+        if (lane_result.contains("QueueLength")) {
+            float val = lane_result["QueueLength"].get<float>();
+            if (val > acc["QueueLength"].get<float>()) {
+                acc["QueueLength"] = val;
+            }
+        }
+        if (lane_result.contains("QueueCount")) {
+            acc["QueueCount"] = acc["QueueCount"].get<int>() + lane_result["QueueCount"].get<int>();
+        }
+        if (lane_result.contains("QueueTransCount")) {
+            acc["QueueTransCount"] = acc["QueueTransCount"].get<float>() + lane_result["QueueTransCount"].get<float>();
+        }
+    }
+
+    nlohmann::json result = nlohmann::json::array();
+    for (const auto& [key, value] : branch_accumulators) {
+        result.push_back(value);
+    }
+    return result;
+}
+
+}  // namespace fusion_perception::traffic_flow
