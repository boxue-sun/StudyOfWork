diff --git a/package.sh b/package.sh
new file mode 100755
index 0000000..1406976
--- /dev/null
+++ b/package.sh
@@ -0,0 +1,142 @@
+#!/bin/bash
+# 流量模块一键出包
+#
+#   ./package.sh                  编译 + 安装 + 出 SDK 包：dist/traffic_flow_<程序版本>_<平台>_<日期>.tar.gz
+#   ./package.sh --image          在上面基础上再出一个交付整包：
+#                                 dist/traffic_flow_service_<程序版本>_<平台>_<日期>.tar
+#                                 （内含 traffic_flow_service_<程序版本>_<平台>_<日期>.tar.gz + config + docker-compose.yaml + 部署说明.txt）
+#   ./package.sh --debug          以 debug 编译（发布包不要带 --debug）
+#
+# 镜像 tag 用 <imagename.txt>:<程序版本>，和 docker-compose.yaml 里引用的 tag 一致；
+# 交付包里的 compose 由脚本把 tag 改成本次构建的版本，所以升版本不需要手动同步 compose 文件。
+#
+# 程序版本取 CMakeLists.txt 里的 TRAFFIC_FLOW_VERSION_*，配置里的 sdk_path 用不带版本号的软链，
+# 所以升程序版本只需要改 CMakeLists.txt 一处。
+
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "$ROOT_DIR"
+
+BUILD_DEBUG=OFF
+WITH_IMAGE=OFF
+for arg in "$@"; do
+    case "$arg" in
+        --debug) BUILD_DEBUG=ON ;;
+        --image) WITH_IMAGE=ON ;;
+        *) echo "[ERROR] 未知参数: $arg（支持 --debug / --image）" >&2; exit 1 ;;
+    esac
+done
+
+version_part() {
+    sed -n "s/.*TRAFFIC_FLOW_VERSION_$1[[:space:]]*\([0-9][0-9]*\)).*/\1/p" CMakeLists.txt | head -1
+}
+VERSION="$(version_part MAJOR).$(version_part MINOR).$(version_part PATCH).$(version_part BUILD)"
+if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
+    echo "[ERROR] 解析 CMakeLists.txt 程序版本号失败，得到: '$VERSION'" >&2
+    exit 1
+fi
+
+if [ "$(uname -m)" == "x86_64" ]; then PLATFORM_TAG="x86_64"; else PLATFORM_TAG="orin"; fi
+BUILD_DATE="$(date +%Y%m%d)"
+DIST_DIR="$ROOT_DIR/dist"
+PKG="traffic_flow_${VERSION}_${PLATFORM_TAG}_${BUILD_DATE}"
+PKG_DIR="$DIST_DIR/$PKG"
+
+echo "[INFO] 程序版本 $VERSION / 模式 BUILD_DEBUG=$BUILD_DEBUG"
+
+echo "[INFO] 清理并编译..."
+rm -rf build release "$DIST_DIR"
+mkdir -p build
+cd build
+BUILD_LOG="$ROOT_DIR/build/build.log"
+if ! cmake -DBUILD_DEBUG="$BUILD_DEBUG" "$ROOT_DIR" > "$BUILD_LOG" 2>&1 \
+    || ! make -j"$(nproc)" >> "$BUILD_LOG" 2>&1 \
+    || ! make install >> "$BUILD_LOG" 2>&1; then
+    echo "[ERROR] 编译失败，完整日志: build/build.log" >&2
+    tail -30 "$BUILD_LOG" >&2
+    exit 1
+fi
+cd "$ROOT_DIR"
+
+if [ ! -e "release/lib/libTrafficFlowService.so.$VERSION" ]; then
+    echo "[ERROR] 未生成 release/lib/libTrafficFlowService.so.$VERSION，实际产物：" >&2
+    ls release/lib >&2
+    exit 1
+fi
+
+# 配置里的 sdk_path 是 lib/libTrafficFlowService.so：容器内 lib 打在镜像里，
+# 在仓库根目录直接跑时靠这个软链解析
+ln -sfn release/lib "$ROOT_DIR/lib"
+
+echo "[INFO] 组装 SDK 包 $PKG ..."
+mkdir -p "$PKG_DIR"
+cp -a release/lib release/include release/doc "$PKG_DIR"/
+cp -a release/config "$PKG_DIR/config"
+
+# 包内 lib 与 config 同级，都是相对运行目录的路径
+find "$PKG_DIR/config" -name 'traffic_flow_service*.json' \
+    -exec sed -i -E 's#("sdk_path"[[:space:]]*:[[:space:]]*")[^"]*"#\1lib/libTrafficFlowService.so"#' {} +
+
+tar -czf "$DIST_DIR/$PKG.tar.gz" -C "$DIST_DIR" "$PKG"
+echo "[INFO] SDK 包: dist/$PKG.tar.gz ($(du -h "$DIST_DIR/$PKG.tar.gz" | cut -f1))"
+
+if [ "$WITH_IMAGE" == "ON" ]; then
+    command -v docker > /dev/null || { echo "[ERROR] 找不到 docker" >&2; exit 1; }
+    if [ -f FusionService ]; then
+        HOST_BIN="FusionService"
+    elif [ -f dependency/FusionService ]; then
+        HOST_BIN="dependency/FusionService"
+    else
+        echo "[ERROR] 仓库根目录和 dependency/ 下都没有 FusionService" >&2; exit 1
+    fi
+
+    IMAGE_NAME="$(tr -d '[:space:]' < imagename.txt)"
+    echo "[INFO] 宿主程序 $HOST_BIN / 构建镜像 $IMAGE_NAME:$VERSION ..."
+
+    CTX="$(mktemp -d)"
+    trap 'rm -rf "$CTX"' EXIT
+    cp Dockerfile "$CTX"/
+    cp "$HOST_BIN" "$CTX/FusionService"
+    cp -a "$PKG_DIR/lib" "$CTX/lib"
+    docker build -t "$IMAGE_NAME:$VERSION" "$CTX" > /dev/null
+
+    DEPLOY="traffic_flow_service_${VERSION}_${PLATFORM_TAG}_${BUILD_DATE}"
+    DEPLOY_DIR="$DIST_DIR/$DEPLOY"
+    IMAGE_FILE="traffic_flow_service_${VERSION}_${PLATFORM_TAG}_${BUILD_DATE}.tar.gz"
+    mkdir -p "$DEPLOY_DIR"
+    docker save "$IMAGE_NAME:$VERSION" | gzip > "$DEPLOY_DIR/$IMAGE_FILE"
+    cp -a "$PKG_DIR/config" "$DEPLOY_DIR/config"
+
+    # 包内 compose 的 image tag 对齐本次构建的镜像，现场 load 完直接 up 就能命中
+    cp docker-compose.yaml "$DEPLOY_DIR/"
+    sed -i -E "s#^([[:space:]]*image:[[:space:]]*)${IMAGE_NAME}:.*#\1${IMAGE_NAME}:${VERSION}#" \
+        "$DEPLOY_DIR/docker-compose.yaml"
+    if ! grep -q "image: ${IMAGE_NAME}:${VERSION}" "$DEPLOY_DIR/docker-compose.yaml"; then
+        echo "[ERROR] 交付包 compose 里找不到 ${IMAGE_NAME} 的 image 行，无法对齐 tag" >&2
+        exit 1
+    fi
+    grep -q "image: ${IMAGE_NAME}:${VERSION}$" docker-compose.yaml \
+        || echo "[WARN] 仓库 docker-compose.yaml 的 tag 不是 $VERSION，本机自测按仓库那份引用，记得改" >&2
+
+    cat > "$DEPLOY_DIR/部署说明.txt" << EOF
+流量服务交付包    镜像 tag: $IMAGE_NAME:$VERSION
+程序版本: $VERSION    构建日期: $BUILD_DATE
+
+1) docker load -i $IMAGE_FILE
+2) 核对 config/traffic_flow_service.json 的 domain_id / topic 是否与现场上游一致，
+   以及 traffic_flow_config.json 里 lane_info_path 指向的路口标定是否正确
+3) cd 到本目录后 docker-compose up -d
+   查看日志 docker logs -f traffic_flow
+
+升级：装新的交付包后重复上面三步。tag 带版本号，compose 里的引用也跟着换了版本，
+docker-compose 会自己重建容器；旧镜像不会被自动删除，确认新容器正常后用
+docker rmi $IMAGE_NAME:<旧版本> 清理。
+EOF
+
+    # 镜像已经 gzip 过，外层不再压缩
+    tar -cf "$DIST_DIR/$DEPLOY.tar" -C "$DIST_DIR" "$DEPLOY"
+    rm -rf "$DEPLOY_DIR"
+    echo "[INFO] 交付整包: dist/$DEPLOY.tar ($(du -h "$DIST_DIR/$DEPLOY.tar" | cut -f1))"
+    echo "[INFO] 目标机器: tar -xf $DEPLOY.tar && cd $DEPLOY && docker load -i $IMAGE_FILE && docker-compose up -d"
+fi

