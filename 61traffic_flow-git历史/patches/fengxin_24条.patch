@@ -0,0 +1,50 @@
+#include "detectors/accumulate_crosswalk_detector.h"
+
+#include <iostream>
+
+#include "common/perception_data.h"
+
+namespace fusion_perception::traffic_flow {
+
+AccumulateCrosswalkDetector::AccumulateCrosswalkDetector(const std::string& detector_id,
+                                                         const CrosswalkInfo& crosswalk_info)
+    : AccumulateDetector(detector_id), _crosswalk_info(crosswalk_info) {}
+
+void AccumulateCrosswalkDetector::update(const PerceptionResult& frame) {
+    for (const auto& obj : frame.traffic_objects) {
+        math::Vec2D pos(obj.latitude, obj.longitude);
+
+        if (!_crosswalk_info.pedestrian_zone.is_point_in(pos)) {
+            continue;
+        }
+
+        if (obj.inner_type == InnerType::PEDESTRIAN) {
+            _pedestrian_ids.insert(obj.id);
+        } else if (obj.inner_type == InnerType::BICYCLE ||
+                   obj.inner_type == InnerType::TRICYCLE) {
+            _non_motor_ids.insert(obj.id);
+        }
+    }
+}
+
+nlohmann::json AccumulateCrosswalkDetector::calculate_once() {
+    nlohmann::json result;
+    result["_result_type"] = "crosswalk";
+    result["road_section_tag"] = _crosswalk_info.road_section_info.tag;
+    result["direction"] = static_cast<int>(_crosswalk_info.road_section_info.direction);
+    result["PersonCrossCount"] = static_cast<int>(_pedestrian_ids.size());
+    result["NonMotorCrossCount"] = static_cast<int>(_non_motor_ids.size());
+
+#ifdef DEBUG
+    std::cout << "[Crosswalk] " << _detector_id
+              << " pedestrian=" << _pedestrian_ids.size()
+              << " non_motor=" << _non_motor_ids.size() << std::endl;
+#endif
+
+    _pedestrian_ids.clear();
+    _non_motor_ids.clear();
+
+    return result;
+}
+
+}  // namespace fusion_perception::traffic_flow
