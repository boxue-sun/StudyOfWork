# 第八课：导览状态机——自己串起两站导航与讲解

前面你已经会创建节点、收发话题、调用服务、发送导航 Action。这一课把它们放到一个简单导览流程里。

有两个模式：**公司终端用 mock 模式**，模拟到达；**家里虚拟机用真实模式**，接入已有 Nav2。两种模式使用同一份业务代码。

## 0．先知道要做的流程

```text
INIT → WAIT_VISITOR → NAVIGATE → GUIDE → NEXT
                                      │       │
                                      │       ├─ 还有站点：NAVIGATE
                                      │       └─ 没有站点：FINISH
                                      └─ 展示讲解文本

导航拒绝/失败 → FAILED，不自动跳到下一站
请求停止 → STOPPED，真实导航中先请求取消
```

模拟游客出现、模拟到达、展示讲解文本都用简化逻辑。**本课没有接入摄像头、TTS 或真实语音问答。** GUIDE 发文本并等待两秒，不是等待音频播放完成。

| 文件 | 用途 |
|---|---|
| `points.yaml` | 存两站坐标、名字和讲解内容 |
| `simple_tour.py` | 根据状态安排下一步，发导航目标，发布状态和讲解 |
| `cancel_tour.py` | 通过服务请求停止导览 |

## 1．创建包和展点文件

```bash
source /opt/ros/jazzy/setup.bash
mkdir -p ~/ros2_lesson8_ws/src
cd ~/ros2_lesson8_ws/src
ros2 pkg create lesson_tour_demo --build-type ament_python \
  --license Apache-2.0 \
  --dependencies rclpy nav2_msgs action_msgs std_msgs std_srvs python3-yaml
cd ~/ros2_lesson8_ws
nano points.yaml
```

复制完整配置：

```yaml
points:
  - name: Reception
    x: 0.0
    y: -3.0
    yaw: 0.0
    speech: "This is the reception area. Welcome to the tour."
  - name: Technology
    x: 4.5
    y: 3.0
    yaw: 3.14159
    speech: "This area explains localization, planning and robot control."
```

这里的坐标对应你的原项目地图。在 mock 模式中不会真的使用坐标驱动车，配置只是让业务知道有哪些站点。

如果 `import yaml` 报错，说明当前 Python 环境缺 PyYAML；在已配置的软件环境中安装 `python3-yaml`，或先联系服务器环境维护者确认。不要用 Windows 的 Python 运行 ROS2 Ubuntu 节点。

## 2．自己建立导览节点文件

```bash
nano ~/ros2_lesson8_ws/src/lesson_tour_demo/lesson_tour_demo/simple_tour.py
```

复制保存：

```python
import math
import time
from pathlib import Path

import yaml
import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
from action_msgs.msg import GoalStatus
from nav2_msgs.action import NavigateToPose
from std_msgs.msg import String
from std_srvs.srv import Trigger


class SimpleTour(Node):
    def __init__(self):
        super().__init__('learning_simple_tour')
        self.mock = self.declare_parameter('mock', True).value
        filename = self.declare_parameter('points_file', '').value
        data = yaml.safe_load(Path(filename).expanduser().read_text(encoding='utf-8'))
        self.points = data['points']
        if not isinstance(self.points, list) or not self.points:
            raise ValueError('points must be a nonempty list')
        for point in self.points:
            for key in ['name', 'speech']:
                if not isinstance(point[key], str):
                    raise ValueError(key + ' must be a string')
            for key in ['x', 'y', 'yaw']:
                if not math.isfinite(float(point[key])):
                    raise ValueError(key + ' must be finite')
        self.nav = ActionClient(self, NavigateToPose, '/navigate_to_pose')
        self.state_publisher = self.create_publisher(String, '/lesson8/state', 10)
        self.speech_publisher = self.create_publisher(String, '/lesson8/speech', 10)
        self.cancel_service = self.create_service(Trigger, '/lesson8/cancel', self.on_cancel)
        self.index = 0
        self.goal_handle = None
        self.state = 'INIT'
        self.changed_at = time.monotonic()
        self.timer = self.create_timer(0.2, self.step)
        self.get_logger().info(f'TOUR_READY: mock={self.mock}; state=INIT')

    def change_state(self, state):
        self.state = state
        self.changed_at = time.monotonic()
        msg = String()
        msg.data = state
        self.state_publisher.publish(msg)
        self.get_logger().info('STATE: ' + state)

    def step(self):
        elapsed = time.monotonic() - self.changed_at
        if self.state == 'INIT':
            if self.mock or self.nav.server_is_ready():
                self.change_state('WAIT_VISITOR')
            elif elapsed > 10.0:
                self.fail('Nav2 server not ready')
        elif self.state == 'WAIT_VISITOR' and elapsed >= 1.0:
            # 本课模拟游客出现，真实项目由 visitor_detector 提供事件。
            self.start_navigation()
        elif self.state == 'NAVIGATE' and self.mock and elapsed >= 1.5:
            self.begin_guide()
        elif self.state == 'GUIDE' and elapsed >= 2.0:
            # 仅等待讲解展示时间；没有 TTS 播放完成确认。
            self.change_state('NEXT')
        elif self.state == 'NEXT':
            self.index += 1
            if self.index == len(self.points):
                self.change_state('FINISH')
            else:
                self.start_navigation()

    def start_navigation(self):
        self.change_state('NAVIGATE')
        point = self.points[self.index]
        self.get_logger().info('GO_TO: ' + point['name'])
        if self.mock:
            return
        goal = NavigateToPose.Goal()
        goal.pose.header.frame_id = 'map'
        goal.pose.header.stamp = self.get_clock().now().to_msg()
        goal.pose.pose.position.x = float(point['x'])
        goal.pose.pose.position.y = float(point['y'])
        goal.pose.pose.orientation.z = math.sin(float(point['yaw']) / 2.0)
        goal.pose.pose.orientation.w = math.cos(float(point['yaw']) / 2.0)
        future = self.nav.send_goal_async(goal)
        future.add_done_callback(self.on_goal_response)

    def on_goal_response(self, future):
        self.goal_handle = future.result()
        if not self.goal_handle.accepted:
            self.fail('Navigation goal rejected')
            return
        result = self.goal_handle.get_result_async()
        result.add_done_callback(self.on_result)
        if self.state == 'CANCELING':
            self.goal_handle.cancel_goal_async()

    def on_result(self, future):
        response = future.result()
        self.goal_handle = None
        if response.status == GoalStatus.STATUS_CANCELED:
            self.change_state('STOPPED')
        elif self.state == 'CANCELING':
            self.change_state('STOPPED')
        elif response.status == GoalStatus.STATUS_SUCCEEDED:
            self.begin_guide()
        else:
            self.fail('Navigation failed, status=' + str(response.status))

    def begin_guide(self):
        self.change_state('GUIDE')
        msg = String()
        msg.data = self.points[self.index]['speech']
        self.speech_publisher.publish(msg)
        self.get_logger().info('GUIDE_TEXT: ' + msg.data)

    def on_cancel(self, request, response):
        response.success = True
        response.message = 'Stop requested; observe final state and robot motion'
        if self.state in ['FINISH', 'FAILED', 'STOPPED']:
            return response
        if not self.mock and self.state == 'NAVIGATE':
            self.change_state('CANCELING')
            if self.goal_handle is not None:
                self.goal_handle.cancel_goal_async()
        else:
            self.change_state('STOPPED')
        return response

    def fail(self, reason):
        self.get_logger().error('TOUR_FAILED: ' + reason)
        self.change_state('FAILED')


def main(args=None):
    rclpy.init(args=args)
    node = SimpleTour()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        print('Client closed; an accepted real Nav2 task may still be running.')
    finally:
        node.nav.destroy()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
```

本课代码比前几课长，先复制跑通，之后只读第 6 步指定的函数。

## 3．创建停止请求客户端

```bash
nano ~/ros2_lesson8_ws/src/lesson_tour_demo/lesson_tour_demo/cancel_tour.py
```

复制保存：

```python
import sys

import rclpy
from rclpy.node import Node
from std_srvs.srv import Trigger


def main(args=None):
    rclpy.init(args=args)
    node = Node('learning_cancel_tour')
    client = node.create_client(Trigger, '/lesson8/cancel')
    try:
        if not client.wait_for_service(timeout_sec=5.0):
            print('Tour service not found')
            return 1
        future = client.call_async(Trigger.Request())
        rclpy.spin_until_future_complete(node, future, timeout_sec=5.0)
        if not future.done():
            print('No reply; do not assume navigation stopped')
            return 1
        response = future.result()
        print(response.message)
        return 0 if response.success else 1
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    sys.exit(main())
```

这里复用第三课的服务通信：发请求、等答复。答复只确认业务节点收到停止请求，实际导航最终结束要看状态和运动。

