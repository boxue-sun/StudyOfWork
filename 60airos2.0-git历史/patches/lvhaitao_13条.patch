+def is_valid_device_type(device_type):
+    # 假设设备类型必须是整数，且在特定范围内
+    return isinstance(device_type, int) and 0 <= device_type <= 10
+
+
+def is_valid_device_sn(device_sn):
+    # 假设设备序列号是字母数字组合，长度在8到20之间
+    return isinstance(device_sn, str) and 8 <= len(device_sn) <= 22 and device_sn.isalnum()
+
+
+def is_valid_ip(ip):
+    # 使用正则表达式验证IP地址
+    ip_pattern = r'^(\d{1,3}\.){3}\d{1,3}$'
+    if not isinstance(ip, str) or not re.match(ip_pattern, ip):
+        return False
+    return all(0 <= int(num) <= 255 for num in ip.split('.'))
+
+
+def is_valid_port(port):
+    # 端口号应该是0到65535之间的整数
+    return isinstance(port, int) and 0 <= port <= 65535
+
+
+def validate_device_fields(device):
+    fields = {
+        'C_deviceType': 'Device Type',
+        'F_deviceEsn': 'Device Serial Number',
+        'G_deviceIp': 'Device IP',
+        'L_radarPort': 'Radar Port'
+    }
+
+    missing_fields = []
+
+    for key, name in fields.items():
+        if device.get(key) is None:
+            missing_fields.append(name)
+
+    if missing_fields:
+        return False, f"Missing fields: {', '.join(missing_fields)}"
+
+    device_type = device['C_deviceType']
+    device_sn = device['F_deviceEsn']
+    device_ip = device['G_deviceIp']
+    device_port = device['L_radarPort']
+
+    if not is_valid_device_type(device_type):
+        return False, f"Invalid device type:{device_type}"
+
+    if not is_valid_device_sn(device_sn):
+        return False, f"Invalid device serial number:{device_sn}"
+
+    if not is_valid_ip(device_ip):
+        return False, f"Invalid IP address:{device_ip}"
+
+    if not is_valid_port(device_port):
+        return False, f"Invalid port number:{device_port}"
+
+    return True, "All fields are valid"
+
