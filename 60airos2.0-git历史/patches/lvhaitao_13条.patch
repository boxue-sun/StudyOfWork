+        self.port = port
+        self.tcp_socket = None
+        self.save_path = save_path
+        self.sn = sn
+        self.type = type
+        self.upload_period = upload_period
+        self.logger = logger
+        self.buffer = b''
+        self.handle = None
+        self.save_fime = ""
+        self.fs_time = int(time.time())
+        self.thread = None
+        self.running = False
+
+    def start(self):
+        self.running = True
+        self.thread = threading.Thread(target=self.run)
+        self.thread.daemon = True  # 设置为守护线程,这样不会阻止程序退出
+        self.thread.start()
+
+    def stop(self):
+        self.running = False
+        if self.tcp_socket:
+            self.tcp_socket.close()
+        if self.thread:
+            self.thread.join()
+
+    def run(self):
+        while self.running:
+            try:
+                self.connect()
+                self.receive_data()
+            except Exception as e:
+                self.logger.error(f"TCPReceiver 出错: {e}")
+                time.sleep(5)  # 等待一段时间后尝试重新连接
+
+    def connect(self):
+        while self.running:
+            try:
+                self.tcp_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+                self.tcp_socket.connect((self.host, self.port))
+                self.logger.info('已连接到 TCP 服务器')
+                return
+            except Exception as e:
+                self.logger.error(f'TCP 连接错误: {e}')
+                self.logger.info('5秒后尝试重新连接到 TCP 服务器...')
+                time.sleep(5)
+
+    def receive_data(self):
+        while self.running:
+            try:
+                data = self.tcp_socket.recv(4096)
+                if not data:
+                    self.logger.info('TCP connection closed by remote server')
+                    if self.handle:
+                        self.handle.flush()
+                        self.handle.close()
+                        self.handle = None
+                    break
+                # 处理数据...
+                # 这里可以根据需要对接收到的雷达点云数据进行处理
+                self.buffer += data
+                # self.logger.debug(f"received from peer:{binascii.hexlify(self.buffer).decode()}")
+                self.process_data()
+            except(socket.error, socket.timeout) as e:
+                self.logger.error(f'TCP 接收数据错误: {e}')
+                if self.handle:
+                    self.handle.flush()
+                    self.handle.close()
+                    self.handle = None
+                break
+
+    def process_data(self):
+        # 帧头（4 字节）+ 帧长（除帧头、帧长度外所有字节, 4字节）+ 帧内容（80*N+72 字节）+ 帧校验（2字节）
+        while len(self.buffer) >= 82:
+            frame_header = self.buffer[:4]
+            # 帧头为 TRAB 时，代表点云数据，帧头为 TRAC 时，代表过滤后的点云结构化数据
+            if frame_header not in [b'TRAB', b'TRAC']:
+                # 非法帧头，丢弃当前帧
+                self.buffer = self.buffer[1:]
+                continue
+            frame_length = struct.unpack('>I', self.buffer[4:8])[0]
+            total_length = frame_length + 4 + 4
+
+            # self.logger.debug(f"received frame len:{frame_length}, total len:{total_length}")
+            if len(self.buffer) >= total_length:
+                payload = self.buffer[8:total_length - 2]
+                frame_checksum = struct.unpack('>H', self.buffer[total_length - 2:total_length])[0]
+
+                if self.verify_checksum(payload, frame_checksum):
+                    # 校验和通过，处理帧内容
+                    self.process_frame(self.buffer[0:total_length])
+                else:
+                    # 校验和不通过，丢弃当前帧
+                    self.buffer = self.buffer[total_length:]
+                    continue
+                # 从缓冲区中移除已处理的帧
+                self.buffer = self.buffer[total_length:]
+            else:
+                break
+
+    def verify_checksum(self, frame_content, frame_checksum):
+        desired = tsCRC16(frame_content)
+        if desired != frame_checksum:
+            self.logger.error(f"checksum failed, need:{desired}, received:{frame_checksum}")
+            return False
+        else:
+            return True
+
+    def process_frame(self, frame):
+        try:
+            if not self.handle:
+                self.save_fime = f'{self.save_path}/{self.type}_{self.sn}_{generate_filename(self.upload_period)}'  # 替换为实际的文件名
+                self.handle = open(self.save_fime, 'ab')
+                self.fs_time = int(time.time())
+                # 将字节数据转换为十六进制字符串
+                # hex_data = binascii.hexlify(frame).decode()
+                self.logger.debug(f"begin write to {self.save_fime}, now:{self.fs_time}")
+                self.handle.write(frame)
+                self.handle.flush()  # 刷新文件缓冲区
+            else:
+                # 将字节数据转换为十六进制字符串
+                # hex_data = binascii.hexlify(frame).decode()
+                # self.logger.info(f"begin write :{hex_data}")
+                self.handle.write(frame)
+                self.handle.flush()  # 刷新文件缓冲区
+                now = int(time.time())
+                if now - self.fs_time > self.upload_period:
+                    self.logger.info("write 5 minutes, so close the file...")
+                    self.handle.close()
+                    self.handle = None
+                    # 替换文件名
+                    new_filename = self.save_fime.replace(".tmp", ".data")
+                    # 执行文件重命名
+                    os.rename(self.save_fime, new_filename)
+                # else:
+                #     self.logger.info(f"file not yet, begin time:{self.fs_time}, delta:{now - self.fs_time}")
+        except IOError as e:
+            self.logger.debug(f"write backup data error：{e}")
+
+
+class FTPUploader:
+    def __init__(self, host, port, username, password, logger):
+        self.host = host
+        self.port = port
+        self.username = username
+        self.password = password
+        self.ftp = FTP(self.host)
+        self.logger = logger
+        self.connected = False
+
+    def connect(self):
+        while True:
+            try:
+                self.ftp.connect(self.host, self.port)
+                self.logger.info(f"Connected to FTP server: {self.host}")
+                self.connected = True
+                break
+            except ConnectionRefusedError as e:
+                self.logger.warning(f'Connection failed: {str(e)}')
+                self.logger.warning('Retrying connection...')
+                self.connected = False
+                time.sleep(1)  # 可选的延迟等待时间，避免频繁重试导致连接问题
+
+    def login(self):
+        while True:
+            try:
+                self.ftp.login(user=self.username, passwd=self.password)
+                self.logger.info('Login in to FTP server')
+                self.connected = True
+                break
+            except error_perm as e:
+                self.logger.warning(f'Login failed: {str(e)}')
+                self.logger.warning('Retrying login...')
+                self.connected = False
+                time.sleep(1)  # 可选的延迟等待时间，避免频繁重试导致连接问题
+
+    def reconnect(self):
+        self.disconnect()
+        self.connect()
+        self.login()
+
+    def upload_file(self, local_path, remote_path):
+        while True:
+            try:
+                with open(local_path, 'rb') as file:
+                    self.ftp.storbinary(f'STOR {remote_path}', file)
+                    self.logger.info(f'Uploaded file to FTP server: {remote_path}')
+                    return True
+            except (ConnectionResetError, error_perm) as e:
+                self.logger.warning(f'Upload failed due to connection error: {str(e)}')
+                self.logger.warning('Reconnecting and retrying...')
+                self.reconnect()
+                time.sleep(1)  # 可选的延迟等待时间，避免频繁重连导致连接问题
+                return False
+
+    def rename_file(self, old_filename, new_filename):
+        self.ftp.rename(old_filename, new_filename)
+
+    def disconnect(self):
+        self.ftp.quit()
+        self.logger.info('Disconnected from FTP server')
+        self.connected = False
+
+
+def upload_files_periodically(ftp_server, ftp_port, ftp_user, ftp_passwd, ftp_pasv, data_path, upload_period, logger):
+    global ftp_uploader
+    while True:
+        # 创建 FTPUploader 实例并启动上传文件线程
+        ftp_initok = False
+        while not ftp_initok:
+            try:
+                ftp_uploader = FTPUploader(ftp_server, ftp_port, ftp_user, ftp_passwd, logger)  # 替换为实际的 FTP 服务器地址、用户名和密码
+                ftp_uploader.login()
+                ftp_uploader.ftp.set_pasv(ftp_pasv)
+                ftp_initok = True
+            except Exception as e:
+                logger.warning(f"ftp init failed:{e}")
+                time.sleep(5)
+        try:
+            # 遍历目录下的文件
+            for root, dirs, files in os.walk(data_path):
+                for file in files:
+                    if file.endswith(".data"):
+                        file_path = os.path.join(root, file)
+                        remote_file = os.path.basename(file_path)
+                        # 上传文件到 FTP 服务器
+                        if ftp_uploader.connected:
+                            tmp_file = remote_file + ".tmp"  # 传输中用临时文件
+                            logger.info(f"begin to upload {tmp_file}...")
+                            if ftp_uploader.upload_file(file_path, tmp_file):
+                                logger.info(f"upload {tmp_file} success...")
+                                time.sleep(1)
+                                ftp_uploader.rename_file(tmp_file, remote_file)
+                                logger.info(f"rename {tmp_file} to {remote_file} success...")
+                                os.remove(file_path)
+                            else:
+                                logger.warning(f"upload {file_path} to {remote_file} failed...")
+                        else:
+                            logger.warning(f"ftp_uploader is not connected...")
+            ftp_uploader.disconnect()
+            time.sleep(upload_period)  # 5分钟
+        except Exception as e:
+            logger.warning(f"ftp upload exception:{e}")
+            ftp_uploader.disconnect()
+            time.sleep(upload_period)
+
+
+def clear_directory(directory):
+    # 删除目录下的所有文件和子目录
+    shutil.rmtree(directory)
+    # 重新创建空的目录
+    os.makedirs(directory)
+
+
+def check_directory_size(directory, max_size, logger):
+    while True:
+        # 获取目录的当前大小
+        total_size = get_directory_size(directory)
+        # 判断目录大小是否达到阈值
+        if total_size >= max_size:
+            logger.info(f"目录 {directory} 的大小已达到阈值 {max_size} bytes！")
+            # 删除最老的文件
+            delete_oldest_file(directory, logger)
+
+        # 暂停一段时间后再次检查目录大小
+        time.sleep(60)  # 暂停60秒后继续下一次检查
+
+
+def get_directory_size(directory):
+    # 获取目录的当前大小
+    total_size = 0
+    for dirpath, dirnames, filenames in os.walk(directory):
+        for filename in filenames:
+            file_path = os.path.join(dirpath, filename)
+            total_size += os.path.getsize(file_path)
+    return total_size
+
+
+def delete_oldest_file(directory, logger):
+    # 获取目录中所有文件的创建时间
+    file_times = []
+    for dirpath, dirnames, filenames in os.walk(directory):
+        for filename in filenames:
+            file_path = os.path.join(dirpath, filename)
+            file_stat = os.stat(file_path)
+            file_times.append((file_path, file_stat.st_ctime))
+
+    # 根据创建时间对文件进行排序
+    sorted_files = sorted(file_times, key=lambda x: x[1])
+
+    # 删除最老的文件
+    oldest_file = sorted_files[0][0]
+    os.remove(oldest_file)
+    logger.info(f"已删除最老的文件：{oldest_file}")
+
+
+def setup_logger(logpath):
+    logger = logging.getLogger()
+    logger.setLevel(logging.DEBUG)
+    formatter = logging.Formatter('[%(asctime)s|%(levelname)s|%(filename)s(%(lineno)d)]:%(message)s')
+
+    # 日志输出到控制台
+    console_handler = logging.StreamHandler()
+    console_handler.setFormatter(formatter)
+    logger.addHandler(console_handler)
+
+    # 日志写入文件
+    file_handler = TimedRotatingFileHandler(logpath + '/ftp_upload.log', when='midnight', backupCount=7)
+    file_handler.setFormatter(formatter)
+    logger.addHandler(file_handler)
+
+    return logger
+
