+def main():
+    # 检查是否提供了必要的参数数量
+    if len(sys.argv) != 2:
+        # 打印用法信息
+        print("用法: python DianYunRecorder.py configFilePath")
+        sys.exit(1)  # 以非零状态码退出，表示错误
+
+    config_file = sys.argv[1]
+    script_dir = os.path.dirname(os.path.abspath(__file__))
+    log_path = script_dir + '/logs'
+    backup_data_path = script_dir + '/backupDatas'
+    upload_period = 300
+    backup_data_max = 2 * 1024 * 1024 * 1024  # 数据保存目录阈值大小，防止一直写磁盘，例如2GB
+
+    # 检查目录是否存在
+    if not os.path.exists(backup_data_path):
+        # 目录不存在，创建目录
+        os.makedirs(backup_data_path)
+        print(f"Directory '{backup_data_path}' was created.")
+    else:
+        # 目录已存在
+        print(f"Directory '{backup_data_path}' already exists.")
+
+    if not os.path.exists(log_path):
+        # 目录不存在，创建目录
+        os.makedirs(log_path)
+        print(f"Directory '{log_path}' was created.")
+    else:
+        # 目录已存在
+        print(f"Directory '{log_path}' already exists.")
+
+    # 配置日志记录器
+    logger = setup_logger(log_path)
+
+    # 读取并解析JSON配置文件
+    with open(config_file, 'r') as file:
+        config = json.load(file)
+
+    ftp_server = None
+    ftp_user = None
+    ftp_passwd = None
+    ftp_pasv = False
+    mec_device_config = config.get('B_mecDeviceWorkParam')
+    if mec_device_config:
+        ftp_server = mec_device_config.get('h_radarPointCloudFtpIp')
+        ftp_port = mec_device_config.get('t_radarPointCloudFtpPort')
+        ftp_user = mec_device_config.get('i_radarPointCloudFtpUser')
+        ftp_passwd = mec_device_config.get('j_radarPointCloudFtpPasswd')
+        ftp_pasv = False
+
+    if not all([ftp_server, ftp_user, ftp_passwd]):
+        logger.error(f"ftp config is not valid...")
+        return
+
+    if not is_valid_ip(ftp_server):
+        logger.error(f"ftp server ip:{ftp_server} is not valid...")
+        return
+
+    devices = config.get('D_sensorDeviceWorkParamList')
+    if devices:
+        # 初始化并启动 TCPReceivers
+        tcp_receivers = {}
+        for i, device in enumerate(devices, start=1):
+            is_valid, message = validate_device_fields(device)
+            if is_valid:
+                device_type = device.get('C_deviceType')
+                device_sn = device.get('F_deviceEsn')
+                device_ip = device.get('G_deviceIp')
+                device_port = device.get('L_radarPort')
+                if device_type == 2:  # radar
+                    # 创建 TCPReceiver 实例并启动接收数据线程
+                    receiver_name = f"tcp_receiver_{i}"
+                    logger.info(f"begin to start receive from {device_sn}, ip:{device_ip}, port:{device_port}")
+                    tcp_receivers[receiver_name] = TCPReceiver(device_ip, device_port, backup_data_path, device_sn,
+                                                               'WAVE', upload_period, logger)
+                    tcp_receivers[receiver_name].start()
+            else:
+                logger.error(f"Config error: {message}, ignore...")
+    else:
+        logger.error('config error..., not found D_sensorDeviceWorkParamList')
+
+    # 创建监测目录线程，防止磁盘被写满
+    logger.info(f"begin to start check_thread...")
+    check_thread = threading.Thread(target=check_directory_size, args=(backup_data_path, backup_data_max, logger))
+    check_thread.start()
+
+    # 创建定时上传线程
+    logger.info(f"begin to start ftp...ip:{ftp_server}, port:{ftp_port}, username:{ftp_user}, passwd:{ftp_passwd}")
+    upload_thread = threading.Thread(target=upload_files_periodically, args=(
+        ftp_server, ftp_port, ftp_user, ftp_passwd, ftp_pasv, backup_data_path, upload_period, logger))
+    upload_thread.start()
+
+    check_thread.join()
+    upload_thread.join()
+
+    logger.info('Program terminated.')
+
+
+if __name__ == '__main__':
+    main()

