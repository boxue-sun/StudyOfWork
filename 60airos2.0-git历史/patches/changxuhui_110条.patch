+
+/**
+ * @brief 信号机监控类
+ * @note 监控和信号机的通信是否正常
+ */
+class GatMonitor {
+ public:
+  GatMonitor();
+  ~GatMonitor();
+
+  bool Init();
+
+  void IncRecvFrameCounter();
+
+  void IncGatPacketCounter();
+  void IncGatBadPacketCounter();
