+V2xMapServiceComponent::V2xMapServiceComponent() 
+    : asn_type_(EnAsnType::YDT_3709_2020_EXT),
+      cloud_map_file_path_("/home/airos/common_config/cloud_map.xml") {}
+
+V2xMapServiceComponent::~V2xMapServiceComponent() {}
+
+bool V2xMapServiceComponent::Init() {
+  // 创建地图服务
+  map_server_ = node_->CreateService<V2xMapServiceRequest, v2xpb::asn::MessageFrame>(
+      "v2x_map_server",
+      std::bind(&V2xMapServiceComponent::HandleMapRequest, this, std::placeholders::_1, std::placeholders::_2));
+
+  if (map_server_ == nullptr) {
+    V2X_MAP_SERVICE_LOG_ERROR << "Failed to create map service";
+    return false;
+  }
+
+  // 初始化地图配置
+  if (!InitMapConfig()) {
+    V2X_MAP_SERVICE_LOG_ERROR << "Failed to initialize map config";
+    return false;
+  }
+
+  // 创建测试客户端
+  map_client_ = node_->CreateClient<V2xMapServiceRequest, v2xpb::asn::MessageFrame>("v2x_map_server");
+  if (map_client_ == nullptr) {
+    V2X_MAP_SERVICE_LOG_ERROR << "Failed to create map client";
+    return false;
+  }
+
+  // 初始化 HTTP 客户端
+  map_http_client_ = std::make_unique<MapHttpClient>();
+  if (!map_http_client_->Init(cloud_server_url_)) {
+    V2X_MAP_SERVICE_LOG_ERROR << "Failed to initialize map HTTP client";
+    return false;
+  }
+
+  V2X_MAP_SERVICE_LOG_INFO << "Map service and clients created successfully";
+  return true;
+}
+
+bool V2xMapServiceComponent::InitMapConfig() {
+  // 获取地图文件路径
+  auto omWorkParamConfiger = airos::base::workparam::WorkParam::getWorkParamFromFile();
+  if (!omWorkParamConfiger.mecDeviceWorkParam.xmlMapFile.empty()) {
+    xml_map_file_ = "/home/airos/common_config/" + omWorkParamConfiger.mecDeviceWorkParam.xmlMapFile;
+  } else {
+    V2X_MAP_SERVICE_LOG_ERROR << "XmlMapFile is empty";
+    // return false;
+  }
+
+  // 设置默认的云端服务器地址
+  cloud_server_url_ = "172.20.65.193:8080";  // 默认云服务器地址
+
+  // 从配置文件读取路口ID
+  try {
+    YAML::Node config = YAML::LoadFile("/home/airos/common_config/v2x_map_service.yaml");
+    intersection_ids_ = config["intersection_ids"].as<std::vector<int>>();
+  } catch (const std::exception& e) {
+    V2X_MAP_SERVICE_LOG_ERROR << "Failed to load intersection IDs from config file";
+  }
+
+  return true;
+}
+
+bool V2xMapServiceComponent::LoadCloudMapFromLocal() {
+  std::string content;
+  {
+    std::lock_guard<std::mutex> file_lock(file_mutex_);
+    std::fstream cloud_fs(cloud_map_file_path_, std::fstream::in);
+    if (!cloud_fs.good()) {
+      V2X_MAP_SERVICE_LOG_WARN << "Cloud map file not found: " << cloud_map_file_path_;
+      return false;
+    }
+
+    V2X_MAP_SERVICE_LOG_INFO << "Loading cloud map from local file: " << cloud_map_file_path_;
+    std::stringstream ss;
+    ss << cloud_fs.rdbuf();
+    cloud_fs.close();
+    content = ss.str();
+  }
+
+  if (content.empty()) {
+    V2X_MAP_SERVICE_LOG_WARN << "Cloud map content is empty";
+    return false;
+  }
+
+  // 解析地图数据
+  std::string str_asn;
+  if (message_frame_map_xml2uper_adapter(content, &str_asn, asn_type_) > 0) {
+    V2X_MAP_SERVICE_LOG_INFO << "Cloud map xml to uper: true, using airos xml2uper";
+  } else if (message_frame_xer2uper_adapter(content, &str_asn, asn_type_) > 0) {
+    V2X_MAP_SERVICE_LOG_INFO << "Cloud map xml to uper: true, using xer2uper";
+  } else {
+    V2X_MAP_SERVICE_LOG_WARN << "Cloud map xml to uper: false";
+    return false;
+  }
+
+  // 转换地图格式
+  std::string str_pb;
+  if (0 >= message_frame_uper2pbstr_adapter(str_asn, &str_pb, asn_type_)) {
+    V2X_MAP_SERVICE_LOG_WARN << "ASN to PB conversion failed";
+    return false;
+  }
+
+  // 更新地图数据
+  std::lock_guard<std::mutex> lock(map_mutex_);
+  pb_map_ = std::make_shared<v2xpb::asn::MessageFrame>();
+  if (pb_map_) {
+    pb_map_->ParsePartialFromString(str_pb);
+    V2X_MAP_SERVICE_LOG_INFO << "Map data updated successfully from local cloud map";
+    return true;
+  }
+
+  V2X_MAP_SERVICE_LOG_WARN << "Failed to create map PB object from cloud map";
+  return false;
+}
+
+bool V2xMapServiceComponent::LoadMapFromConfig() {
+  // 读取地图文件
+  std::fstream fs(xml_map_file_.data(), std::fstream::in);
+  if (!fs.good()) {
+    V2X_MAP_SERVICE_LOG_WARN << "Failed to open config map file: " << xml_map_file_;
+    return false;
+  }
+
+  std::stringstream ss;
+  ss << fs.rdbuf();
+  fs.close();
+  std::string content(ss.str());
+
+  if (content.empty()) {
+    V2X_MAP_SERVICE_LOG_WARN << "Config map content is empty";
+    return false;
+  }
+
+  // 解析地图数据
+  std::string str_asn;
+  if (message_frame_map_xml2uper_adapter(content, &str_asn, asn_type_) > 0) {
+    V2X_MAP_SERVICE_LOG_INFO << "Config map xml to uper: true, using airos xml2uper";
+  } else if (message_frame_xer2uper_adapter(content, &str_asn, asn_type_) > 0) {
+    V2X_MAP_SERVICE_LOG_INFO << "Config map xml to uper: true, using xer2uper";
+  } else {
+    V2X_MAP_SERVICE_LOG_WARN << "Config map xml to uper: false";
+    return false;
+  }
+
+  // 转换地图格式
+  std::string str_pb;
+  if (0 >= message_frame_uper2pbstr_adapter(str_asn, &str_pb, asn_type_)) {
+    V2X_MAP_SERVICE_LOG_WARN << "ASN to PB conversion failed";
+    return false;
+  }
+
+  // 更新地图数据
+  std::lock_guard<std::mutex> lock(map_mutex_);
+  pb_map_ = std::make_shared<v2xpb::asn::MessageFrame>();
+  if (pb_map_) {
+    pb_map_->ParsePartialFromString(str_pb);
+    V2X_MAP_SERVICE_LOG_INFO << "Map data updated successfully from config file";
+    return true;
+  }
+
+  V2X_MAP_SERVICE_LOG_WARN << "Failed to create map PB object from config";
+  return false;
+}
+
+bool V2xMapServiceComponent::ProcessMapData() {
+    // 首先尝试从云端获取地图数据
+    if (GetMapFromCloud()) {
+        V2X_MAP_SERVICE_LOG_INFO << "Successfully got map data from cloud";
+        return true;
+    }
+
+    // 如果云端获取失败，则尝试加载本地云端地图
+    if (LoadCloudMapFromLocal()) {
+        return true;
+    }
+
+    // 如果本地云端地图不存在或加载失败，则从本地配置文件读取
+    V2X_MAP_SERVICE_LOG_INFO << "Failed to load cloud map, trying local config file";
+    if (LoadMapFromConfig()) {
+        return true;
+    }
+    return false;
+}
+
+bool V2xMapServiceComponent::GetMapFromCloud() {
+  if (!map_http_client_) {
+    V2X_MAP_SERVICE_LOG_ERROR << "Map HTTP client not initialized";
+    return false;
+  }
+
+  if (intersection_ids_.empty()) {
+    V2X_MAP_SERVICE_LOG_ERROR << "No intersection IDs available";
+    return false;
+  }
+
+  std::shared_ptr<v2xpb::asn::MessageFrame> cloud_map_data;
+  if (!map_http_client_->GetMapFromCloud(intersection_ids_[0], cloud_map_data)) {
+    V2X_MAP_SERVICE_LOG_ERROR << "Failed to get map data from cloud for intersection ID: " << intersection_ids_[0];
+    return false;
+  }
+
+  std::string str_pb("");
+  if (!cloud_map_data->SerializeToString(&str_pb)) {
+    V2X_MAP_SERVICE_LOG_ERROR << "SerializeToString fail";
+    return false;
+  }
+
+  std::string str_asn("");
+  if (0 >= message_frame_pbstr2uper_adapter(str_pb, &str_asn, asn_type_)) {
+    V2X_MAP_SERVICE_LOG_ERROR << "message_frame_pbstr2uper_adapter fail";
+    return false;
+  }
+
+  std::string str_xml("");
+  if (0 >= message_frame_uper2xer_adapter(str_asn, &str_xml, asn_type_)) {
+    V2X_MAP_SERVICE_LOG_ERROR << "message_frame_uper2xer_adapter fail";
+    return false;
+  }
+
+  // 更新本地存储的xml文件
+  {
+    std::lock_guard<std::mutex> file_lock(file_mutex_);
+    std::ofstream map_file(cloud_map_file_path_);
+    if (!map_file.is_open()) {
+      V2X_MAP_SERVICE_LOG_ERROR << "Failed to open map file: " << cloud_map_file_path_;
+      return false;
+    }
+    map_file << str_xml;
+    map_file.close();
+  }
+
+  std::lock_guard<std::mutex> lock(map_mutex_);
+  pb_map_ = cloud_map_data;
+  V2X_MAP_SERVICE_LOG_INFO << "Map data updated successfully from cloud for intersection ID: " << intersection_ids_[0];
+  return true;
+}
+
+void V2xMapServiceComponent::HandleMapRequest(
+    const std::shared_ptr<V2xMapServiceRequest>& request,
+    std::shared_ptr<v2xpb::asn::MessageFrame>& response) {
+  V2X_MAP_SERVICE_LOG_INFO << "Received map request, request_id: " << request->request_id()
+        << ", map_id: " << request->map_id();
+  
+  std::lock_guard<std::mutex> lock(map_mutex_);
+  if (pb_map_) {
+    response = pb_map_;
+    V2X_MAP_SERVICE_LOG_INFO << "Map data sent successfully";
+  } else {
+    V2X_MAP_SERVICE_LOG_ERROR << "No map data available";
+  }
+}
+
+bool V2xMapServiceComponent::TestMapRequest() {
+  static uint64_t request_id = 0;
+  auto request = std::make_shared<V2xMapServiceRequest>();
+  request->set_request_id(++request_id);
+  request->set_timestamp(apollo::cyber::Time::Now().ToNanosecond());
+  request->set_map_id("test_map");
+
+  auto response = map_client_->SendRequest(request);
+  if (response != nullptr) {
+    V2X_MAP_SERVICE_LOG_INFO << "Client received map data, request_id: " << request_id;
+    V2X_MAP_SERVICE_LOG_INFO << "Map data: " << response->DebugString();
+    return true;
+  } else {
+    V2X_MAP_SERVICE_LOG_WARN << "Client: service may not ready";
+    return false;
+  }
+}
+
+bool V2xMapServiceComponent::Proc() {
+  // 处理地图数据
+  if (!ProcessMapData()) {
+    return true;
+  }
+
+  // 测试客户端请求
+  // TestMapRequest();
+
+  return true;
+}
+}  // namespace protocol
+}  // namespace v2x
+}  // namespace airos
