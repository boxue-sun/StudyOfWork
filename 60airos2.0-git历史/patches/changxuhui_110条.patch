+void PointLabel2Rgb(uint8_t label, GLfloat rgb[]) {
+  switch (label) {
+    case 0:  // unknown
+      rgb[0] = rgb[1] = rgb[2] = 0.7f;
+      break;
+    case 1:  // roi
+      rgb[0] = 1.0f, rgb[1] = 0, rgb[2] = 0.0f;
+      break;
+    case 2:  // ground
+      rgb[0] = 0, rgb[1] = 1.0f, rgb[2] = 0.0f;
+      break;
+    case 3:  // object
+      rgb[0] = 0.0f, rgb[1] = 0.0f, rgb[2] = 1.0f;
+      break;
+    default:
+      rgb[0] = rgb[1] = rgb[2] = 0.7f;
+      break;
+  }
+}
