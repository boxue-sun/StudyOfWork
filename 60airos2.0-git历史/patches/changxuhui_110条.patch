+/*
+ * @Author: cs
+ * @Date: 2024-01-22 20:39:41
+ * @LastEditors: zhangenwei
+ * @LastEditTime: 2024-01-22 20:39:41
+ * @Description:
+ * @FilePath: /airos-edge/base/common/serilizable_data.h
+ */
+#ifndef BASE_COMMON_SERIALIZABLE_DATA_H_
+#define BASE_COMMON_SERIALIZABLE_DATA_H_
+
+#include "json.h"
+#include "define.h"
+#include "glog/logging.h"
+namespace afl{
+namespace base{
+
+using json = nlohmann::json;
+class SerializableData
+{
+public:
+    SerializableData() {}
+    virtual ~SerializableData() {}
+
+    virtual void serialize(json& j) = 0;
+    virtual void deserialize(const json& j) = 0;
+};
+
+extern void to_json(json& j, const SerializableData& csd);
+extern void from_json(const json& j, SerializableData& sd);
+extern void to_json(json& j, const SerializableData* csd);
+/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+#define PUBLIC_JSON_EXCEPTION(jsonKey) \
+		catch (json::exception& e){\
+			        int64_t step;\
+			    	struct timeval tv;\
+			    	struct timezone tz;\
+			    	gettimeofday(&tv, &tz);\
+			    	step = ((int64_t)tv.tv_sec) * 1000 * 1000 + tv.tv_usec;\
+			        struct tm tm_time;\
+			        time_t seconds = static_cast<time_t>(step / (1000 * 1000));\
+			        int microseconds = step % (1000 * 1000);\
+			        localtime_r(&seconds, &tm_time);\
+			    	char buffer[32] = {0};\
+			    	snprintf(buffer, sizeof(buffer), "%4d-%02d-%02d %02d:%02d:%02d:%06d", tm_time.tm_year + 1900, tm_time.tm_mon + 1, tm_time.tm_mday, tm_time.tm_hour, tm_time.tm_min, tm_time.tm_sec, microseconds);\
+			        const char* file = __FILE__;\
+			        file = basename(file);\
+			        assert(file);               \
+			        printf("\033[1;31m[%s][%20s(%6d)][jsonkey]%s [what]%s [json-exception-id]%d \033[0m\n", buffer, file, __LINE__, jsonKey.c_str(), e.what(),  e.id);\
+			}
+
+extern bool g_flag_empty_novalid;
+template<typename T1>
+inline void JsonSerialize(T1 &classKey, std::string key, afl::base::json &j, bool classkeyIsEmptyFlag)
+{
+    try{
+        if(!classkeyIsEmptyFlag)
+        {
+            j[key] = classKey;
+        }
+    }
+    PUBLIC_JSON_EXCEPTION(key)
+}
+template<typename T1>
+extern inline void JsonSerialize(T1 &classKey, std::string key,  afl::base::json &j, bool classkeyIsEmptyFlag);
+/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+
+template<typename T1>
+inline void JsonDeserialize(T1 &classKey, std::string key, const afl::base::json &j, bool &classkeyIsEmptyFlag)
+{
+    if (j.find(key) != j.end())
+    {
+        if (!j.at(key).empty())
+        {
+            classKey = j.at(key).get<T1>();
+            classkeyIsEmptyFlag = false;
+        }
+        else
+        {
+            classkeyIsEmptyFlag = true;
+        }
+    }
+    else
+    {
+        classkeyIsEmptyFlag = true;
+    }
+}
+
+template<typename T1>
+extern inline void JsonDeserialize(T1 &classKey, std::string key, const afl::base::json &j, bool &classkeyIsEmptyFlag);
+/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+
+}
+}
+
+#endif /* BASE_SERIALIZABLE_DATA_H_ */

