+    optional float direction_filter_ratio = 27 [default = 0.7];
+    optional float displacement_theta_var = 28 [default = 0.25];
+    optional float velocity_theta_var = 29 [default = 0.5];
+    optional int32 reserve_age = 30 [default = 3];
+    optional int32 average_velocity_interval = 31 [default = 10];
+    optional float stable_moving_speed = 32 [default = 2.0];
+    optional float top_lef_stable_thresh = 33 [default = 2.0];
+    optional float br_const_measure_noise = 34 [default = 900.0];
