+
+const double Utils::kPI_ = 3.14159265358979323846;
+
+bool Utils::IsFileExists(const std::string& strPath) {
+  return access(strPath.c_str(), 0) == 0;
+}
+
+double Utils::Str2Double(const std::string& str) {
+  std::stringstream ss(str);
+  double data;
+  ss >> data;
+
+  return data;
+}
+int Utils::Str2Int(const std::string& str) {
+  std::stringstream ss(str);
