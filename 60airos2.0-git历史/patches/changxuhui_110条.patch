+ * @param[in]  key 注册的Cloud连接协议名字
+ */
+#define V2XOS_CLOUD_REG_FACTORY(T, key) \
+  static CloudDeviceFactory::Register_t<T> V2XOS_CLOUD_REG(T)(key);
+
