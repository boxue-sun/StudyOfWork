+  RSU_BSM = 1;
+  RSU_RSM = 2;
+  RSU_SPAT = 3;
+  RSU_MAP = 4;
+  RSU_RSI = 5;
+  RSU_PERCEPTION = 6;
+  RSU_UNKNOWN = 0xFF;
+}
+
+enum MessageVersion {
+  CSAE_53_2017 = 0;   // 三跨
