diff --git a/app/modules/v2x_application/rsi_generator/rsi_generator.cc b/app/modules/v2x_application/rsi_generator/rsi_generator.cc
index b716262..1cf43f5 100644
--- a/app/modules/v2x_application/rsi_generator/rsi_generator.cc
+++ b/app/modules/v2x_application/rsi_generator/rsi_generator.cc
@@ -142,7 +142,7 @@ bool RsiGenerator::Init(
   
   std::string map_path;
   
-  // map_path 和 rsu_intersection_id 从工参表中获取 
+  // map_path 和 rsu_intersection_id rsi_config_file从工参表中获取 
   auto omWorkParamConfiger =
       airos::base::workparam::WorkParam::getWorkParamFromFile();
   rsu_intersection_id_ = omWorkParamConfiger.mecDeviceWorkParam.crossID;
@@ -161,22 +161,25 @@ bool RsiGenerator::Init(
   }
   zone_                = 31 + cross_lon_ / 6;
 
-  // 读取配置文件配置rsi下发
-  std::string rsi_config_file = app_conf_path + "/v2x_rsi_config.pb";
-  if (!airos::base::ParseProtobufFromFile<v2xpb::rsi::config::RSIConfig>(
-          rsi_config_file, &rsi_conf_)) {
-    LOG_ERROR << "parse protobuf from file failed. File path: " << rsi_config_file;
-    return false;
-  } else {
-    LOG_INFO << "parse protobuf from file succeed. File path: " << rsi_config_file;
-  }
-  LOG_INFO << "conf: " << rsi_conf_.DebugString();
+  if (!omWorkParamConfiger.mecDeviceWorkParam.rsiConfigFile.empty()) {
+    std::string rsi_config_file = "/home/airos/common_config/" +
+      omWorkParamConfiger.mecDeviceWorkParam.rsiConfigFile;
 
-  // 单独起一个线程，发送配置文件中配置的rsi
-  rsi_conf_transmit_ = std::make_shared<std::thread>(
-      std::bind(&RsiGenerator::RsiConfTransmit, this));
+    if (!airos::base::ParseProtobufFromFile<v2xpb::rsi::config::RSIConfig>(
+            rsi_config_file, &rsi_conf_)) {
+      LOG_ERROR << "parse protobuf from file failed. File path: "
+                << rsi_config_file;
+    } else {
+      LOG_INFO << "parse protobuf from file succeed. File path: "
+               << rsi_config_file;
 
+      LOG_INFO << "conf: " << rsi_conf_.DebugString();
 
+      // 单独起一个线程，发送配置文件中配置的rsi
+      rsi_conf_transmit_ = std::make_shared<std::thread>(
+          std::bind(&RsiGenerator::RsiConfTransmit, this));
+    }
+  }
   return true;
 }
 
