+  void *user_data = glfwGetWindowUserPointer(window);
+  if (user_data == nullptr) {
+    return;
+  }
+
+  GLFWFusionViewer *vis = static_cast<GLFWFusionViewer *>(user_data);
+  vis->resize_window(width, height);
+}
