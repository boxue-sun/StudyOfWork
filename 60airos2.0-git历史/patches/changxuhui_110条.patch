-        virtual void ParseValue(const std::vector<std::string>& values_) override
-        {
-            const std::string& value_ = values_.at(0);
-
-#ifdef ARGS_NOEXCEPT
-            if (!reader(name, value_, this->value))
-            {
-                error = Error::Parse;
-            }
-#else
-            reader(name, value_, this->value);
-#endif
-        }
