+void image(cvui_block_t& theBlock, int theX, int theY, cv::Mat& theImage) {
+  cv::Rect aRect(theX, theY, theImage.cols, theImage.rows);
+
+  // TODO: check for render outside the frame area
+  render::image(theBlock, aRect, theImage);
