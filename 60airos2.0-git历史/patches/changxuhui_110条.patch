+++ b/middleware/protocol/v2x_map_service/map_http_client.cc
@@ -0,0 +1,330 @@
+#include "map_http_client.h"
+#include <sstream>
+
+namespace airos {
+namespace v2x {
+namespace protocol {
+
+MapHttpClient::MapHttpClient() : initialized_(false) {
+}
+
+MapHttpClient::~MapHttpClient() = default;
+
+bool MapHttpClient::Init(const std::string& server_url) {
+    if (initialized_) {
+        return true;
+    }
+
+    server_url_ = server_url;
+    initialized_ = true;
+    return true;
+}
+
+bool MapHttpClient::GetMapFromCloud(int intersection_id, std::shared_ptr<v2xpb::asn::MessageFrame>& map_data) {
+    if (!initialized_) {
+        V2X_MAP_SERVICE_LOG_ERROR << "MapHttpClient not initialized";
+        return false;
+    }
+
+    // 创建局部 httpClient 实例
+    std::unique_ptr<httpClient> http_client(new httpClient());
+
+    std::string url = server_url_ + "/map/GetMap?id=" + std::to_string(intersection_id);
+    http_client->setUrl(url);
+
+    // 设置请求头
+    http_client->setHeaders("Content-Type: application/json");
+    http_client->setHeaders("Accept: application/json");
+
+    // 发送 GET 请求
+    int res = http_client->getMethod();
+    if (res != CURLE_OK) {
+        V2X_MAP_SERVICE_LOG_ERROR << "Failed to perform HTTP request: " << res;
+        return false;
+    }
+
+    // 获取响应数据
+    std::string response_data = http_client->getResponse();
+    if (response_data.empty()) {
+        V2X_MAP_SERVICE_LOG_ERROR << "Empty response from server";
+        return false;
+    }
+
+    return ConvertJsonToMessageFrame(response_data, map_data);
+}
+
+bool MapHttpClient::ConvertJsonToMessageFrame(const std::string& json_data, std::shared_ptr<v2xpb::asn::MessageFrame>& map_data) {
+    V2X_MAP_SERVICE_LOG_INFO << "json_data: " << json_data;
+    try {
+        // 检查 JSON 数据是否为空
+        if (json_data.empty()) {
+            V2X_MAP_SERVICE_LOG_ERROR << "Empty JSON data";
+            return false;
+        }
+
+        // 尝试解析 JSON 数据
+        json j;
+        try {
+            j = json::parse(json_data);
+        } catch (const json::parse_error& e) {
+            V2X_MAP_SERVICE_LOG_ERROR << "JSON parse error: " << e.what() << ", id: " << e.id;
+            return false;
+        }
+        
+        // 解析到 MapData 结构
+        MapData map_data_struct;
+        try {
+            map_data_struct.deserialize(j);
+        } catch (const std::exception& e) {
+            V2X_MAP_SERVICE_LOG_ERROR << "Failed to deserialize MapData: " << e.what();
+            return false;
+        }
+
+        // 如果 map_data 不存在，创建新实例
+        if (!map_data) {
+            map_data = std::make_shared<v2xpb::asn::MessageFrame>();
+        } else {
+            // 如果已存在，清空现有数据
+            map_data->Clear();
+        }
+
+        return ConvertMapDataToMessageFrame(map_data_struct, map_data);
+    } catch (const std::exception& e) {
+        V2X_MAP_SERVICE_LOG_ERROR << "Failed to parse JSON data: " << e.what();
+        return false;
+    }
+}
+
+bool MapHttpClient::ConvertMapDataToMessageFrame(const MapData& map_data, std::shared_ptr<v2xpb::asn::MessageFrame>& map_frame) {
+    if (!map_frame) {
+        V2X_MAP_SERVICE_LOG_ERROR << "Invalid map frame pointer";
+        return false;
+    }
+
+    auto map = map_frame->mutable_mapframe();
+    map->set_message_count(1);
+
+    // 转换节点数据
+    for (const auto& node : map_data.nodes) {
+        auto map_node = map->add_nodes();
+        
+        // 设置 ID
+        auto node_id = map_node->mutable_id();
+        node_id->set_region(node.nodeId.regionId);  // 从 nodeId 结构体中获取 regionId
+        node_id->set_id(node.nodeId.nodeId);        // 从 nodeId 结构体中获取 nodeId
+        map_node->set_name(node.nodeName);  // 使用 nodeName（asn 只支持ASCII, 中文asn会编码失败）
+
+        // 设置位置信息
+        auto position = map_node->mutable_position();
+        auto pos_llh = position->mutable_llh();
+        pos_llh->set_longitude(node.refPos[0]);    // refPos 是数组 [lng, lat, elevation]
+        pos_llh->set_latitude(node.refPos[1]);
+        pos_llh->set_elevation(node.refPos[2]);
+
+        for (const auto& inLink : node.inLinks) {
+            auto link = map_node->add_links();
+            // 设置上游节点ID
+            auto upstream_node_id = link->mutable_upstream_node_id();
+            upstream_node_id->set_region(inLink.upstreamNodeId.regionId);
+            upstream_node_id->set_id(inLink.upstreamNodeId.nodeId);
+            
+            // 设置道路名称和宽度
+            link->set_name(inLink.linkName);
+            // 将道路宽度从厘米转换为米
+            link->set_width(inLink.linkWidth / 100.0);
+            for (const auto& lane : inLink.lanes) {
+                auto map_lane = link->add_lanes();
+                map_lane->set_id(lane.laneId);
+                // 将车道宽度从厘米转换为米
+                map_lane->set_width(lane.laneWidth / 100.0);
+                
+                // 转换 maneuvers
+                if (!lane.maneuvers.empty()) {
+                    // 确保字符串长度为12位
+                    std::string maneuvers = lane.maneuvers;
+                    if (maneuvers.length() < 12) {
+                        maneuvers = std::string(12 - maneuvers.length(), '0') + maneuvers;
+                    }
+                    
+                    // 从右到左解析每一位
+                    for (int i = 0; i < 12; ++i) {
+                        if (maneuvers[11 - i] == '1') {
+                            switch (i) {
+                                case 0:  // bit0 - 允许直行
+                                    map_lane->add_maneuvers(v2xpb::asn::MapLane::STRAIGHT);
+                                    break;
+                                case 1:  // bit1 - 允许左转
+                                    map_lane->add_maneuvers(v2xpb::asn::MapLane::LEFT);
+                                    break;
+                                case 2:  // bit2 - 允许右转
+                                    map_lane->add_maneuvers(v2xpb::asn::MapLane::RIGHT);
+                                    break;
+                                case 3:  // bit3 - 允许掉头
+                                    map_lane->add_maneuvers(v2xpb::asn::MapLane::U_TURN);
+                                    break;
+                                case 6:  // bit6 - 允许转弯或者直行时换道
+                                    map_lane->add_maneuvers(v2xpb::asn::MapLane::LANE_CHANGE);
+                                    break;
+                                case 9:  // bit9 - 停车，不允许行进
+                                    map_lane->add_maneuvers(v2xpb::asn::MapLane::GO_WITH_HALT);
+                                    break;
+                                case 10: // bit10 - 慢行
+                                    map_lane->add_maneuvers(v2xpb::asn::MapLane::CAUTION);
+                                    break;
+                                case 11: // bit11 - reserved
+                                    map_lane->add_maneuvers(v2xpb::asn::MapLane::RESERVED);
+                                    break;
+                                default:
+                                    break;
+                            }
+                        }
+                    }
+                }
+
+#if 0           // 加上这个属性，asn编码失败，后续看看如何发下去
+                // 设置车道属性
+                auto lane_attrs = map_lane->mutable_lane_attributes();
+                
+                // 设置车道类型
+                if (!lane.laneAttributes.laneType.empty()) {
+                    lane_attrs->set_value(lane.laneAttributes.laneType);
+                }
+                
+                // 设置车道共享属性
+                if (lane.laneAttributes.shareWith > 0) {
+                    std::string share_with;
+                    int share_value = lane.laneAttributes.shareWith;
+                    
+                    // 从右到左解析每一位
+                    if (share_value & (1 << 2)) {  // bit2 - 非摩托类车辆
+                        if (!share_with.empty()) share_with += ",";
+                        share_with += "non_motor";
+                    }
+                    if (share_value & (1 << 3)) {  // bit3 - 摩托类车辆
+                        if (!share_with.empty()) share_with += ",";
+                        share_with += "motorcycle";
+                    }
+                    if (share_value & (1 << 4)) {  // bit4 - bus
+                        if (!share_with.empty()) share_with += ",";
+                        share_with += "bus";
+                    }
+                    if (share_value & (1 << 5)) {  // bit5 - taxi
+                        if (!share_with.empty()) share_with += ",";
+                        share_with += "taxi";
+                    }
+                    if (share_value & (1 << 6)) {  // bit6 - 行人
+                        if (!share_with.empty()) share_with += ",";
+                        share_with += "pedestrian";
+                    }
+                    if (share_value & (1 << 7)) {  // bit7 - 自行车
+                        if (!share_with.empty()) share_with += ",";
+                        share_with += "bicycle";
+                    }
+                    if (share_value & (1 << 8)) {  // bit8 - 履带车
+                        if (!share_with.empty()) share_with += ",";
+                        share_with += "tracked_vehicle";
+                    }
+                    
+                    // lane_attrs->set_share_with(share_with);
+                }
+#endif
+                // 设置车道限速
+                for (const auto& speed_limit : lane.laneSpeedLimits) {
+                    auto limit = map_lane->add_speed_limits();
+                    limit->set_speed_limit_type(speed_limit.speedLimitType);
+                    // 将限速值从 0.02m/s 分辨率的整数转换为 m/s 的 double 值
+                    limit->set_speed(speed_limit.speedLimit * 0.02);
+                }
+
+                // 设置车道连接信息
+                for (const auto& connects : lane.connectsTo) {
+                    auto connect = map_lane->add_connections();
+                    
+                    // 设置远程节点ID
+                    auto remote_node_id = connect->mutable_remote_node_id();
+                    remote_node_id->set_region(connects.remoteIntersection.regionId);
+                    remote_node_id->set_id(connects.remoteIntersection.nodeId);
+                    
+                    // 设置相位ID
+                    connect->set_phase_id(connects.connectionPhaseId);
+                    
+                    // 设置车道ID
+                    connect->set_lane_id(connects.connectingLane.connectionLaneId);
+                    
+                    // 设置转向信息
+                    if (!connects.connectingLane.connectionManeuver.empty()) {
+                        std::string maneuvers = connects.connectingLane.connectionManeuver;
+                        // 确保字符串长度至少为4位
+                        if (maneuvers.length() < 4) {
+                            maneuvers = std::string(4 - maneuvers.length(), '0') + maneuvers;
+                        }
+                        
+                        // 从右往左取4位
+                        std::string last_four_bits = maneuvers.substr(maneuvers.length() - 4);
+                        bool found_maneuver = false;
+                        // 从右到左解析每一位
+                        for (int i = 0; i < 4 && !found_maneuver; ++i) {
+                            if (last_four_bits[3 - i] == '1') {
+                                found_maneuver = true;
+                                switch (i) {
+                                    case 0:  // bit0 - 允许直行
+                                        connect->add_maneuvers(v2xpb::asn::MapLane::STRAIGHT);
+                                        break;
+                                    case 1:  // bit1 - 允许左转
+                                        connect->add_maneuvers(v2xpb::asn::MapLane::LEFT);
+                                        break;
+                                    case 2:  // bit2 - 允许右转
+                                        connect->add_maneuvers(v2xpb::asn::MapLane::RIGHT);
+                                        break;
+                                    case 3:  // bit3 - 允许掉头
+                                        connect->add_maneuvers(v2xpb::asn::MapLane::U_TURN);
+                                        break;
+                                    default:
+                                        break;
+                                }
+                            }
+                        }
+                    }
+                }
+
+                // 设置车道点
+                for (const auto& point : lane.lanePoints) {
+                    auto pos = map_lane->add_positions();
+                    auto llh = pos->mutable_llh();
+                    llh->set_longitude(point[0]);  // 经度
+                    llh->set_latitude(point[1]);   // 纬度
+                    llh->set_elevation(point[2]);  // 高程
+                }
+            }
+
+            // 设置道路限速
+            for (const auto& speed_limit : inLink.linkSpeedLimits) {
+                auto limit = link->add_speed_limits();
+                limit->set_speed_limit_type(speed_limit.speedLimitType);
+                limit->set_speed(speed_limit.speedLimit * 0.02);
+            }
+
+            // 设置道路点
+            for (const auto& point : inLink.linkPoints) {
+                auto pos = link->add_positions();
+                auto llh = pos->mutable_llh();
+                llh->set_longitude(point[0]);  // 经度
+                llh->set_latitude(point[1]);   // 纬度
+                llh->set_elevation(point[2]);  // 高程
+            }
+
+            // 设置道路的movement
+            for (const auto& movement : inLink.movements) {
+                auto move = link->add_movements();
+                move->set_phase_id(movement.phaseId);
+                move->set_region(movement.remoteIntersection.regionId);
+                move->set_id(movement.remoteIntersection.nodeId);
+            }
+        }
+    }
+
+    return true;
+}
