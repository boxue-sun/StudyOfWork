diff --git a/middleware/protocol/v2x_codec/v2x_codec_component.cc b/middleware/protocol/v2x_codec/v2x_codec_component.cc
index f2768bb..235aff1 100644
--- a/middleware/protocol/v2x_codec/v2x_codec_component.cc
+++ b/middleware/protocol/v2x_codec/v2x_codec_component.cc
@@ -61,6 +61,111 @@ bool CODEC_COMPONENT::Init() {
   if (reader == nullptr) {
     return false;
   }
+
+  // 初始化消息处理线程
+  m_MessageProcessRunning = true;
+  m_MessageProcessThread.reset(new std::thread(&CODEC_COMPONENT::messageProcessThread, this));
+  
+  return true;
+}
+
+CODEC_COMPONENT::~CODEC_COMPONENT() {
+  // 停止消息处理线程
+  m_MessageProcessRunning = false;
+  m_MessageQueueCond.notify_one();
+  if (m_MessageProcessThread && m_MessageProcessThread->joinable()) {
+    m_MessageProcessThread->join();
+  }
+}
+
+void CODEC_COMPONENT::messageProcessThread() {
+  while (m_MessageProcessRunning) {
+    std::unique_lock<std::mutex> lock(m_MessageQueueMutex);
+    m_MessageQueueCond.wait(lock, [this]() { 
+      return !m_MessageProcessRunning || !m_MessageQueue.empty(); 
+    });
+    
+    if (!m_MessageProcessRunning) {
+      break;
+    }
+    
+    if (!m_MessageQueue.empty()) {
+      auto frame = std::move(m_MessageQueue.front());
+      m_MessageQueue.pop();
+      lock.unlock();
+      
+      processMessageFrame(frame);
+    }
+  }
+}
+
+void CODEC_COMPONENT::processMessageFrame(const std::shared_ptr<const v2xpb::asn::MessageFrame>& frame) {
+  if (!frame) {
+    V2X_CODEC_LOG_WARN << "frame is nullptr";
+    return;
+  }
+  
+  auto encode_pb = std::make_shared<os::v2x::device::RSUData>();
+
+  if (!MessageFrame2RsuPb(frame, encode_pb)) {
+    V2X_CODEC_LOG_WARN << "message frame to rsupb failed, total fail num "
+          << ++message_frame_to_rsupb_failed_num;
+    return;
+  }
+
+  V2X_CODEC_LOG_INFO << "[summary] message frame to rsupb failed, total fail num "
+         << message_frame_to_rsupb_failed_num;
+
+  // 统计丢包率，延迟
+  if (v2xpb::asn::MessageFrame::PayloadCase::kRsmFrame ==
+      frame->payload_case()) {
+    const v2xpb::asn::Rsm& rsmframe = frame->rsmframe();
+    encode_pb->set_obj_num(rsmframe.participants_size());
+
+    recv_total_obj_num += rsmframe.participants_size();
+    if (rsmframe.has_end_flag() && true == rsmframe.end_flag()) {
+        encode_pb->set_end_flag(true);
+        encode_pb->set_total_obj_num(rsmframe.total_obj_num());
+        encode_pb->set_message_timestamp(rsmframe.message_timestamp());
+
+        V2X_CODEC_LOG_INFO << "sumarry: Expected recv total obj num: " << rsmframe.total_obj_num()
+                           << ", Actual recv obj num: " << recv_total_obj_num
+                           << ", Obj loss rate: " << std::fixed
+                           << (rsmframe.total_obj_num() - recv_total_obj_num) * 1.0 /
+                                  rsmframe.total_obj_num();
+    }
+  }
+
+  // 控制发送间隔
+  static auto last_send_time = std::chrono::steady_clock::now();
+  const std::chrono::microseconds min_interval(1200); // 最小写入间隔1.2ms
+  
+  auto current_time = std::chrono::steady_clock::now();
+  auto time_since_last = current_time - last_send_time;
+  
+  if (time_since_last < min_interval) {
+    // 如果距离上次发送时间不足1ms,则等待剩余时间
+    std::this_thread::sleep_for(min_interval - time_since_last);
+  }
+  
+  Send("/airos/device/rsu_in", encode_pb);
+  last_send_time = std::chrono::steady_clock::now();
+}
+
+bool CODEC_COMPONENT::Proc(
+    const std::shared_ptr<const v2xpb::asn::MessageFrame>& frame) {
+  if (!frame) {
+    V2X_CODEC_LOG_WARN << "frame is nullptr";
+    return false;
+  }
+  
+  // 将消息放入队列
+  {
+    std::lock_guard<std::mutex> lock(m_MessageQueueMutex);
+    m_MessageQueue.push(frame);
+  }
+  m_MessageQueueCond.notify_one();
+  
   return true;
 }
 
