+
+message ReferenceLinkList {
+  repeated RsiReferenceLink refLinkList = 1;
+}
+
+enum ReqStatus {
+    ReqStatus_unknown	= 0;
+    ReqStatus_request	= 1;
+    ReqStatus_comfirmed	= 2;
+    ReqStatus_cancel	= 3;
+    ReqStatus_complete	= 4;
+		ReqStatus_execute = 5;
+		ReqStatus_accept = 6;
+		ReqStatus_reject = 7;
+		ReqStatus_revoke = 8;
