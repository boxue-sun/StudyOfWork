+      const base::device::CameraImageData &camera_data,
+      PerceptionObstacles *result, TrafficLightDetection *traffic_light) = 0;
+  virtual std::string Name() const                                       = 0;
+};
+
+PERCEPTION_REGISTER_REGISTERER(BaseCameraPerception);
