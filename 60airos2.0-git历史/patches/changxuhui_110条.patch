+int StringToBytes(const std::string &in_str, uint8_t *out_bytes) {
+  int offset = 0;
+  int inter  = 0;
+  for (size_t i = 0; i < in_str.size(); i += 2) {
+    sscanf(&in_str.at(i), "%02x", &inter);
+    out_bytes[offset++] = uint8_t(inter);
+  }
+
+  return offset;
+}
