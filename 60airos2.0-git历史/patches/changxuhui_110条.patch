+    return right_bottom.y - left_top.y;
+  }
+
+  Point2f left_top;
+  Point2f right_bottom;
+};
+
+struct SizeShape {
+  float length = 0;
+  float width  = 0;
+  float height = 0;
+};
+
+struct CubeBox2f {
