-#include <iostream>
-#include <fstream>
-#include "Authenticator/Authenticator.h"
-#include "args.h"
-#include <json/json.h>
-
-int main(int argc, char* argv[]) {
-
-    args::ArgumentParser parser("License Generator\nThis program is used to generate the authorization information for FusionService. \
-        Please prepare a configuration file first, complete the fields of project, expired, limit_period, and limit_hardware, and then call this program.");
-    args::HelpFlag help(parser, "Help", "Help message.", { 'h', "help" });
-    args::ValueFlag<std::string> config_path(parser, "Json config path", "Pass in the path to the JSON configuration file used by FusionService", { 'c' }, "", args::Options::Required);
-
-    try {
-        parser.ParseCLI(argc, argv);
-    }
-    catch (args::Help) {
-        std::cout << parser;
-        return 0;
-    }
-    catch (args::ParseError e) {
-        std::cerr << e.what() << std::endl;
-        std::cerr << parser;
-        return -1;
-    }
-    catch (args::ValidationError e) {
-        std::cerr << e.what() << std::endl;
-        std::cerr << parser;
-        return -1;
-    }
-
-    FusionService::FusionServiceConfig config;
-
-    // 调用生成授权信息函数
-    FusionService::Authenticator::GetInstance().Generate(config);
-
-    // 将生成的授权信息写入到配置文件
-    Json::Value root;  // 创建 JSON 对象
-    root["project"] = config.project;
-    
-    // 修正 expired 为 uint64_t 类型问题
-    root["expired"] = Json::UInt64(config.expired);  // 使用 Json::UInt64 来强制转换
-    
-    root["limit_period"] = config.limit_period;
-    root["limit_hardware"] = config.limit_hardware;
-    root["license_key"] = config.license_key;
-    root["verify_code"] = config.verify_code;
-    root["license"] = config.license;
-
-    printf("@@@@@@@@: %s\n", config.license_key.c_str());
-
-    // 打开文件并写入 JSON
-    std::ofstream config_file(args::get(config_path));
-    if (!config_file.is_open()) {
-        std::cerr << "Unable to open config file for writing: " << args::get(config_path) << std::endl;
-        return -3;
-    }
-
-    // 使用 Json::StreamWriterBuilder 确保 JSON 格式正确
-    Json::StreamWriterBuilder writer;
-    config_file << Json::writeString(writer, root);  // 使用 writeString 来将 JSON 对象转换成字符串
-    config_file.close();
-
-    std::cout << "Authorization information has been written to the config file." << std::endl;
-
-    return 0;
-}
