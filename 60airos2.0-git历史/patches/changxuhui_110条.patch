+      config.camera_name,
+      config.gpu_id,
+      config.img_mode,
+      "hikvision",
+      config.stream_num,
+      config.channel_num,
+      "",
+      "",
+      image_sender_);
+  return res;
+}
+
+AIROS_CAMERA_REG_FACTORY(SimulationCamera, "simulation_camera");
+
+}  // namespace device
+}  // namespace base
+}  // namespace airos
