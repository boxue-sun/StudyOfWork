-# ###################################################################
-
-
-#设置C++ 编译的参数(根据需要自己设置) PS：可以参考esclipse中编译配置的选项
-set(CMAKE_CXX_FLAGS "-std=c++11 -pthread -Wall -O0 -s -Wall -fmessage-length=0 -fPIC")
-set(CMAKE_C_FLAGS "-std=c99 -Wall -O0 -Wall -fmessage-length=0")
-# -DCCSA_2020 : 设置宏 CCSA_2020。 另一种添加宏的方式可以直接使用 add_definitions(-D CCSA_2020) 添加
-# -Wall       : 编译时显示警告信息
-# -O          ：选择编译器优化的级别，-O0 不优化  -O1 -O2 -O3 不同程度的优化
-# -g          : 生成调试信息,debug会用到。调试信息的级别。-g3 尽可能的生成gdb的可以使用的调试信息。默认为-g2
-# -std=c++11  ：编译所按照C++的标准
-# -fmessage-length=0 ：输出信息会根据控制台的宽度自动换行，这样就能看全输出信息了
-# -fPIC       ： 作用于编译阶段，告诉编译器产生与位置无关代码(Position-Independent Code)。加载到任意位置都能执行
-
