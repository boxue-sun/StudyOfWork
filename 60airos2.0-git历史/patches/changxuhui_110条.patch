+  void AddEvent(EventInfo&& evet) {
+    std::lock_guard<std::mutex> lk(mutex_);
+    all_events_.push_back(std::forward<EventInfo>(evet));
+  }
+  std::vector<EventInfo> GetEvent() {
+    std::lock_guard<std::mutex> lk(mutex_);
+    return all_events_;
