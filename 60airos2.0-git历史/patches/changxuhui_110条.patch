diff --git a/middleware/protocol/rtsp_tool/rtsp_tool.cc b/middleware/protocol/rtsp_tool/rtsp_tool.cc
new file mode 100644
index 0000000..a4a40a6
--- /dev/null
+++ b/middleware/protocol/rtsp_tool/rtsp_tool.cc
@@ -0,0 +1,181 @@
+
+#include "base/device_connect/proto/ipcamera.pb.h"
+#include "cyber/cyber.h"
+#include "middleware/protocol/rtsp_tool/rtsp_pusher.h"
+
+#include <iostream>
+#include <memory>
+#include <string>
+#include <map>
+#include <chrono>
+#include <iomanip>
+
+// 全局RTSP推流器
+std::unique_ptr<RTSPPusher> g_rtsp_pusher;
+
+// 序号检测相关变量
+std::map<std::string, uint64_t> g_last_frame_ids;  // 每路流的最后帧ID
+std::map<std::string, int64_t> g_total_frames;     // 每路流的总帧数
+std::map<std::string, int64_t> g_dropped_frames;   // 每路流的丢包数
+std::map<std::string, int64_t> g_out_of_order_frames; // 每路流的乱序帧数
+
+void ImageCallback(const std::shared_ptr<const os::v2x::device::ipcamera::CompressedImage>& msg) {
+    if (!msg) {
+        return;
+    }
+    
+    // 获取当前时间戳
+    auto now = std::chrono::system_clock::now();
+    auto now_c = std::chrono::system_clock::to_time_t(now);
+    std::tm tm_now = *std::localtime(&now_c);
+    
+    // 解析帧ID
+    uint64_t current_frame_id = 0;
+    try {
+        current_frame_id = std::stoull(msg->frame_id());
+    } catch (const std::exception& e) {
+        std::cout << "Failed to parse frame ID: " << msg->frame_id() << std::endl;
+        current_frame_id = 0;
+    }
+    
+    // 获取流标识（使用话题名称作为流ID）
+    std::string stream_id = "default";
+    if (msg->has_header() && msg->header().has_module_name()) {
+        stream_id = msg->header().module_name();
+    }
+    
+    // 序号检测和丢包判断
+    std::string status = "正常";
+    if (g_total_frames[stream_id] == 0) {
+        // 第一帧
+        g_last_frame_ids[stream_id] = current_frame_id;
+        status = "首帧";
+    } else {
+        uint64_t last_frame_id = g_last_frame_ids[stream_id];
+        uint64_t expected_next = last_frame_id + 1;  // 64位递增
+        
+        if (current_frame_id == expected_next) {
+            // 正常情况：序号连续
+            status = "正常";
+        } else if (current_frame_id == last_frame_id) {
+            // 重复帧
+            status = "重复";
+        } else if (current_frame_id > last_frame_id) {
+            // 丢包情况
+            uint64_t diff = current_frame_id - last_frame_id;
+            if (diff > 1) {
+                g_dropped_frames[stream_id] += (diff - 1);
+                status = "丢包(" + std::to_string(diff - 1) + "帧)";
+            }
+        } else {
+            // 乱序情况（当前帧ID小于上一帧ID）
+            g_out_of_order_frames[stream_id]++;
+            status = "乱序";
+        }
+        
+        g_last_frame_ids[stream_id] = current_frame_id;
+    }
+    
+    g_total_frames[stream_id]++;
+    
+    // 打印详细信息
+    std::cout << "[" << std::put_time(&tm_now, "%H:%M:%S") << "] "
+              << "流[" << stream_id << "] "
+              << "帧ID: " << current_frame_id << " "
+              << "状态: " << status << " "
+              << "大小: " << msg->data().size() << "字节 "
+              << "格式: " << msg->format() << " "
+              << "类型: " << (msg->frame_type() == 1 ? "关键帧" : "普通帧") << std::endl;
+    
+    // 每100帧打印一次统计信息
+    if (g_total_frames[stream_id] % 100 == 0) {
+        std::cout << "=== 流[" << stream_id << "] 统计信息 ===" << std::endl;
+        std::cout << "总帧数: " << g_total_frames[stream_id] << std::endl;
+        std::cout << "丢包数: " << g_dropped_frames[stream_id] << std::endl;
+        std::cout << "乱序数: " << g_out_of_order_frames[stream_id] << std::endl;
+        if (g_total_frames[stream_id] > 0) {
+            double drop_rate = (g_dropped_frames[stream_id] * 100.0) / g_total_frames[stream_id];
+            double out_of_order_rate = (g_out_of_order_frames[stream_id] * 100.0) / g_total_frames[stream_id];
+            std::cout << "丢包率: " << std::fixed << std::setprecision(2) << drop_rate << "%" << std::endl;
+            std::cout << "乱序率: " << std::fixed << std::setprecision(2) << out_of_order_rate << "%" << std::endl;
+        }
+        std::cout << "================================" << std::endl;
+    }
+    
+    // 推送到RTSP
+    if (g_rtsp_pusher) {
+        const uint8_t* frame_data = reinterpret_cast<const uint8_t*>(msg->data().data());
+        int frame_size = msg->data().size();
+        
+        if (!g_rtsp_pusher->PushFrame(frame_data, frame_size)) {
+            std::cout << "Failed to push frame to RTSP" << std::endl;
+        }
+    }
+}
+
+int main(int argc, char* argv[]) {
+    // 初始化Cyber RT
+    apollo::cyber::Init(argv[0]);
+    
+    // 创建监听节点
+    auto listener_node = apollo::cyber::CreateNode("rtsp_tool_node");
+    
+    // 使用 ReaderConfig 设置缓存队列
+    apollo::cyber::ReaderConfig config;
+    config.channel_name = "/sensor/ipcamera/h264/172_20_65_193";
+    config.pending_queue_size = 10;  // 设置缓存队列大小
+
+    // 创建监听器
+    auto listener = listener_node->CreateReader<os::v2x::device::ipcamera::CompressedImage>(
+        config, ImageCallback);
+    
+    // 初始化RTSP推流器
+    std::string rtsp_url = "rtsp://localhost:8554/live/stream";
+    if (argc > 1) {
+        rtsp_url = argv[1];
+    }
+    
+    g_rtsp_pusher = std::make_unique<RTSPPusher>(rtsp_url, 25);
+    if (!g_rtsp_pusher->Start()) {
+        std::cerr << "Failed to start RTSP pusher" << std::endl;
+        return -1;
+    }
+    
+    std::cout << "RTSP Tool Node started" << std::endl;
+    std::cout << "Listening on channel: /sensor/ipcamera/h264/172_20_65_193" << std::endl;
+    std::cout << "Pushing to RTSP: " << rtsp_url << std::endl;
+    std::cout << "Press Ctrl+C to stop" << std::endl;
+    
+    // 等待关闭信号
+    apollo::cyber::WaitForShutdown();
+    
+    // 停止RTSP推流器
+    if (g_rtsp_pusher) {
+        g_rtsp_pusher->Stop();
+    }
+    
+    // 打印最终统计信息
+    std::cout << "\n=== 最终统计信息 ===" << std::endl;
+    for (const auto& stream : g_total_frames) {
+        const std::string& stream_id = stream.first;
+        int64_t total = stream.second;
+        int64_t dropped = g_dropped_frames[stream_id];
+        int64_t out_of_order = g_out_of_order_frames[stream_id];
+        
+        std::cout << "流[" << stream_id << "]:" << std::endl;
+        std::cout << "  总帧数: " << total << std::endl;
+        std::cout << "  丢包数: " << dropped << std::endl;
+        std::cout << "  乱序数: " << out_of_order << std::endl;
+        if (total > 0) {
+            double drop_rate = (dropped * 100.0) / total;
+            double out_of_order_rate = (out_of_order * 100.0) / total;
+            std::cout << "  丢包率: " << std::fixed << std::setprecision(2) << drop_rate << "%" << std::endl;
+            std::cout << "  乱序率: " << std::fixed << std::setprecision(2) << out_of_order_rate << "%" << std::endl;
+        }
+        std::cout << "  最后帧ID: " << g_last_frame_ids[stream_id] << std::endl;
+        std::cout << std::endl;
+    }
+    std::cout << "===================" << std::endl;
+    
+    return 0;
+}
