-                }
-                else if (!terminated && ParseOption(chunk) == OptionType::LongFlag)
-                {
-                    if (!ParseLong(it, end))
-                    {
-                        return it;
-                    }
-                }
-                else if (!terminated && ParseOption(chunk) == OptionType::ShortFlag)
