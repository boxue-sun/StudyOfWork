+AVCodecCtxManager *AVCodecCtxManagerArm::getInstance() {
+    if (!_S_instance) {
+        std::lock_guard<std::mutex> g(_S_lock_instance);
+        if (!_S_instance) {
+            _S_instance = new AVCodecCtxManagerArm();
+        }
+    }
+    return _S_instance;
