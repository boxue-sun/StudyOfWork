+size_t GatParser::MakePacketQueryColorState(
+    uint8_t *packet_buf, int packet_len) {
+  if (packet_len < 35) {
+    return 0;
+  }
+  return this->MakeQueryPacket(packet_buf, 0x0103);
+}
