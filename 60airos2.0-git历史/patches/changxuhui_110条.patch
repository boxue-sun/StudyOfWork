+template <typename Dtype>
+inline Dtype sigmoid(Dtype x) {
+  return 1.0 / (1.0 + exp(-x));
+}
+template <typename Dtype>
+inline Dtype gaussian(Dtype x, Dtype mu, Dtype sigma) {
+  return std::exp(-(x - mu) * (x - mu) / (2 * sigma * sigma));
+}
+template <typename Dtype>
+Dtype sqr(Dtype x) {
+  return x * x;
+}
