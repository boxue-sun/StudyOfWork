+enum PtcType
+{
+    Ptc_unknown     = 0,
+    Ptc_motor       = 1,
+    Ptc_non_motor   = 2,
+    Ptc_pedestrian  = 3,
+    Ptc_rsu         = 4,
+};
+struct cictci_object_detail : public afl::base::SerializableData
+{
+public:
+    string m_ID;
+    int m_PtcType;
+    double m_VehL;
+    double m_VehW;
+    bool m_VehW_Empty = true;
