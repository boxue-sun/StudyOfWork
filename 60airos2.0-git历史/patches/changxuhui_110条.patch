+
+enum class EnAsnType : int32_t {
+  CASE_53_2020,
+  YDT_3709_2020,
+  YDT_3709_2020_EXT
+};
+
+inline ssize_t message_frame_uper2xer_adapter(const std::string& str_in,
+                                              std::string* str_out,
+                                              const EnAsnType& type,
+                                              std::string* asn_json_out = nullptr) {
+  if (!str_out) {
+    return -1;
+  }
+  ssize_t res = -1;
+  switch (type) {
+    case EnAsnType::CASE_53_2020:
+      res = v2x_asn_msg_asn_2_message_frame_uper2xer(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020:
+      res = v2x_asn_msg_asn_3_message_frame_uper2xer(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020_EXT:
+      res = v2x_asn_msg_asn_3_1_message_frame_uper2xer(str_in, str_out, asn_json_out);
+      return res;
+    default : break;
+  }
+
+  return res;
+}
+
+inline ssize_t message_frame_xer2uper_adapter(const std::string& str_in,
+                                              std::string* str_out,
+                                              const EnAsnType& type,
+                                              std::string* asn_json_out = nullptr) {
+  if (!str_out) {
+    return -1;
+  }
+  ssize_t res = -1;
+  switch (type) {
+    case EnAsnType::CASE_53_2020:
+      res = v2x_asn_msg_asn_2_message_frame_xer2uper(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020:
+      res = v2x_asn_msg_asn_3_message_frame_xer2uper(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020_EXT:
+      res = v2x_asn_msg_asn_3_1_message_frame_xer2uper(str_in, str_out, asn_json_out);
+      return res;
+    default:
+      break;
+  }
+
+  return res;
+}
+
+inline ssize_t message_frame_uper2pbstr_adapter(const std::string& str_in,
+                                                std::string* str_out,
+                                                const EnAsnType& type,
+                                                std::string* asn_json_out = nullptr) {
+  if (!str_out) {
+    return -1;
+  }
+  ssize_t res = -1;
+  switch (type) {
+    case EnAsnType::CASE_53_2020:
+      res = v2x_asn_msg_asn_2_message_frame_uper2pbstr(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020:
+      res = v2x_asn_msg_asn_3_message_frame_uper2pbstr(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020_EXT:
+      res = v2x_asn_msg_asn_3_1_message_frame_uper2pbstr(str_in, str_out, asn_json_out);
+      return res;
+    default:
+      break;
+  }
+
+  return res;
+}
+
+inline ssize_t message_frame_pbstr2uper_adapter(const std::string& str_in,
+                                                std::string* str_out,
+                                                const EnAsnType& type, 
+                                                std::string* asn_json_out = nullptr) {
+  if (!str_out) {
+    return -1;
+  }
+  ssize_t res = -1;
+  switch (type) {
+    case EnAsnType::CASE_53_2020:
+      res = v2x_asn_msg_asn_2_message_frame_pbstr2uper(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020:
+      res = v2x_asn_msg_asn_3_message_frame_pbstr2uper(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020_EXT:
+      res = v2x_asn_msg_asn_3_1_message_frame_pbstr2uper(str_in, str_out, asn_json_out);
+      return res;
+    default:
+      break;
+  }
+
+  return res;
+}
+
+inline ssize_t message_frame_map_xml2uper_adapter(const std::string& str_in,
+                                                std::string* str_out,
+                                                const EnAsnType& type,
+                                                std::string* asn_json_out = nullptr) {
+  if (!str_out) {
+    return -1;
+  }
+  ssize_t res = -1;
+  switch (type) {
+    case EnAsnType::CASE_53_2020:
+      res = v2x_asn_msg_asn_2_message_frame_map_xml2uper(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020:
+      res = v2x_asn_msg_asn_3_message_frame_map_xml2uper(str_in, str_out, asn_json_out);
+      return res;
+    case EnAsnType::YDT_3709_2020_EXT:
+      res = v2x_asn_msg_asn_3_1_message_frame_map_xml2uper(str_in, str_out, asn_json_out);
+      return res;
+    default:
+      break;
+  }
+
+  return res;
+}
+
+
+#endif
+
