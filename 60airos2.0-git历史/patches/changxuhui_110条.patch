+  LOG_INFO << STR(stop_speed_thre) << STR(stop_speed_cnt_thre)
+           << STR(stop_shift_cnt_thre) << STR(tracked_life);
+  LOG_INFO << LINE_DASH << LINE_DASH;
+}
