+
+template <typename num_type>
+bool trackbar(
+    int theWidth, num_type* theValue, const TrackbarParams& theParams) {
+  cvui_block_t& aBlock = internal::topBlock();
+
+  long double aValueAsDouble = static_cast<long double>(*theValue);
+  bool aResult               = internal::trackbar(
+      aBlock, aBlock.anchor.x, aBlock.anchor.y, theWidth, &aValueAsDouble,
+      theParams);
+  *theValue = static_cast<num_type>(aValueAsDouble);
+
+  return aResult;
+}
+
+template <typename num_type>
+bool trackbar(
+    cv::Mat& theWhere, int theX, int theY, int theWidth, num_type* theValue,
+    const TrackbarParams& theParams) {
+  gScreen.where = theWhere;
+
+  long double aValueAsDouble = static_cast<long double>(*theValue);
+  bool aResult               = internal::trackbar(
+      gScreen, theX, theY, theWidth, &aValueAsDouble, theParams);
+  *theValue = static_cast<num_type>(aValueAsDouble);
+
+  return aResult;
+}
