new file mode 100755
index 0000000..0570113
--- /dev/null
+++ b/script/airos_keep_alive_deqing.sh
@@ -0,0 +1,122 @@
+#!/usr/bin/env bash
+set -e
+
+# 定义日志路径变量
+LOG_PATH="/home/airos/log/airos_keep_alive.log"
+
+# 创建日志目录（如果不存在）
+mkdir -p "$(dirname "$LOG_PATH")"
+
+return_info() {
+  local DATE_N=$(date "+%Y-%m-%d %H:%M:%S")
+  [[ $# -eq 0 ]] && return
+  echo -e "\033[1;32m [INFO]--- ${DATE_N} $* \033[0m" >> $LOG_PATH
+}
+
+function check_run() {
+  local command_line="$1"
+  if [[ -n ${command_line} ]]; then
+    launch_cmd="${command_line} > /dev/null 2>&1 &"
+    eval ${launch_cmd}
+    return_info "${launch_cmd} , run successfully! "
+  fi
+}
+
+function is_running() {
+    local process_name="$1"
+    if pgrep -f "$process_name" > /dev/null; then
+        return 0  # 进程正在运行
+    else
+        return 1  # 进程未运行
+    fi
+}
+
+function keep_alive() {
+  declare -A processes=(
+    # ["mec_service"]="mainboard -d dag/mec_service.dag"
+    # ["traffic_light_service"]="mainboard -d dag/traffic_light_service.dag"
+    # ["v2x_codec"]="mainboard -d dag/v2x_codec.dag"
+    # ["rsu_service"]="mainboard -d dag/rsu_service.dag"
+    # ["airos_app_framework"]="./bin/airos_app_framework conf/airos_v2x_app.pb"
+    # ["rsap"]="mainboard -d dag/rsap.dag"
+    # ["ccindex"]="mainboard -d dag/ccindex.dag"
+    ["om_camera"]="mainboard -d dag/om_camera.dag"
+    ["om_radar"]="mainboard -d dag/om_radar.dag"
+    ["om_cloud"]="mainboard -d dag/om_cloud.dag"
+    ["om_device_status"]="mainboard -d dag/om_device_status.dag"
+    ["bs_angle_offset"]="mainboard -d dag/bs_angle_offset.dag"
+    ["bs_spat_src_data"]="mainboard -d dag/bs_spat_src_data.dag"
+    ["bs_v2x_data"]="mainboard -d dag/bs_v2x_data.dag"
+    ["bs_v2x_bsm_data"]="mainboard -d dag/bs_v2x_bsm_data.dag"
+    ["om_mec"]="mainboard -d dag/om_mec.dag"
+#    ["DianYunRecorder"]="python3 /home/airos/protocol/radar_point_cloud/DianYunRecorder.py /home/airos/common_config/work_param_config.flag"
+#    ["PTPpartlog"] = "python3 /home/airos/protocol/mec/PTPpartlog.py /home/airos/common_config/work_param_config.flag"
+  )
+
+  cd /home/airos/os
+
+  while true; do
+    for process in "${!processes[@]}"; do
+      if ! is_running "$process"; then
+        return_info "$process is not running. Restarting..."
+        check_run "${processes[$process]}"
+      fi
+    done
+    sleep 30  # Check 30s
+  done
+}
+
+# add by lht for dianyun
+TARGET="DianYunRecorder"
+
+function dian_yun_keep_alive(){
+  while true;do
+	is_live=$(ps -ef | grep "$TARGET" | grep -v 'grep' | awk '{print $1}')
+	if [ -z "$is_live" ]; then
+      	    return_info "start $TARGET..."
+	    python3 /home/airos/protocol/radar_point_cloud/DianYunRecorder.py /home/airos/common_config/work_param_config.flag &
+	    sleep 5
+	else
+	  return_info "$TARGET is running..."
+	  sleep 30
+	fi
+  done
+}
+# end add 
+PTP_PROCESS_NAME="PTPpartlog"
+function ptp_keep_alive() {
+  while true; do
+    is_live=$(ps -ef | grep "$PTP_PROCESS_NAME" | grep -v 'grep' | awk '{print $1}')
+    if [ -z "$is_live" ]; then
+      return_info "start $PTP_PROCESS_NAME..."
+      python3 /home/airos/protocol/mec/PTPpartlog.py /home/airos/common_config/work_param_config.flag > /dev/null 2>&1 &
+      sleep 5
+    else
+      return_info "$PTP_PROCESS_NAME is running..."
+      sleep 30
+    fi
+  done
+}
+
+# SSH keep-alive function
+function ssh_keep_alive() {
+  while true; do
+    if ! service ssh status > /dev/null; then
+      return_info "SSH service has stopped, restarting..."
+      # Restart the SSH service
+      service ssh start
+    else
+      return_info "SSH service is running"
+    fi
+    sleep 30  # 每30秒检查一次
+  done
+}
+
+function main() {
+  keep_alive >>  $LOG_PATH 2>&1 &
+  # dian_yun_keep_alive >>  $LOG_PATH 2>&1 &
+  ptp_keep_alive >>  $LOG_PATH 2>&1 &
+  ssh_keep_alive >>  $LOG_PATH 2>&1 &
+}
+
+main "$@"
