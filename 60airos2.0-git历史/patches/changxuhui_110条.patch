+
+ApplicationFactory& ApplicationFactory::Instance() {
+  static ApplicationFactory instance_;
+  return instance_;
+}
+
+std::unique_ptr<AirOSApplication> ApplicationFactory::GetUnique(
+    const std::string& key, const ApplicationCallBack& cb) {
+  return std::unique_ptr<AirOSApplication>(Produce(key, cb));
+}
+
+std::shared_ptr<AirOSApplication> ApplicationFactory::GetShared(
+    const std::string& key, const ApplicationCallBack& cb) {
+  return std::shared_ptr<AirOSApplication>(Produce(key, cb));
+}
+
+AirOSApplication* ApplicationFactory::Produce(
+    const std::string& key, const ApplicationCallBack& cb) {
+  if (map_.find(key) == map_.end()) {
+    return nullptr;
+  }
+  return map_[key](cb);
+}
