+      lane_direction.push_back(pt);
+    }
+    std::string lane_id = lane_roi.lane_id();
+    if (lane_polygon.size() != 0 || lane_direction.size() != 0) {
+      lane_polygon_from_cyber_.push_back({lane_polygon, lane_direction});
+    }
+  }
