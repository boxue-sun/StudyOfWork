+void WindowWrapper::Drag(int x, int y) {
+  std::lock_guard<std::mutex> lck(border_mutex_);
+  border_x_max_ -= x / scale_;
+  border_y_max_ += y / scale_;
+  border_x_min_ -= x / scale_;
+  border_y_min_ += y / scale_;
+}
