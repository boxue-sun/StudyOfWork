-
-            static bool AtLeastOne(const Group& group)
-            {
-                return group.MatchedChildren() >= 1;
-            }
-
-            static bool AtMostOne(const Group& group)
-            {
-                return group.MatchedChildren() <= 1;
-            }
-
-            static bool All(const Group& group)
-            {
