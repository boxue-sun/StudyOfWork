-#ifndef ARGS_NOEXCEPT
-                        throw ParseError(errorMessage);
-#else
-                        error = Error::Parse;
-                        errorMsg = errorMessage;
-                        return false;
-#endif
-                    }
-
-                    if (!readCompletion)
-                    {
-                        flag->ParseValue(values);
-                    }
-
-                    if (flag->KickOut())
-                    {
-                        ++it;
-                        return false;
-                    }
-
-                    if (!values.empty())
-                    {
-                        break;
-                    }
-                }
-                else
-                {
-                    const std::string errorMessage("Flag could not be matched: '" + std::string(1, arg) + "'");
-#ifndef ARGS_NOEXCEPT
-                    throw ParseError(errorMessage);
-#else
-                    error = Error::Parse;
-                    errorMsg = errorMessage;
-                    return false;
-#endif
-                }
-            }
-
-            return true;
-        }
