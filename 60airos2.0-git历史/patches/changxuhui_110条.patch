+/**
+ * @brief  红绿灯采集设备注册工厂
+ */
+class TrafficLightDeviceFactory {
+ public:
+  using CONSTRUCT =
+      std::function<TrafficLightDevice*(const TrafficLightCallBack& cb)>;
+
+  template <typename Inherit>
+  class Register_t {
+   public:
+    Register_t(const std::string& key) {
+      TrafficLightDeviceFactory::Instance().map_.emplace(
+          key, [](const TrafficLightCallBack& cb) {
+            return new Inherit(cb);
+          });
+    }
+  };
+  /**
+   * @brief      用于获取指定红绿灯采集设备实例的unique指针
+   * @param[in]  key 指定红绿灯采集设备名
+   * @retval     指定红绿灯采集设备实例的unique指针
+   */
+  std::unique_ptr<TrafficLightDevice> GetUnique(
+      const std::string& key, const TrafficLightCallBack& cb);
+  /**
+   * @brief      用于获取指定红绿灯采集设备实例的shared指针
+   * @param[in]  key 指定红绿灯采集设备名
+   * @retval     指定红绿灯采集设备实例的shared指针
+   */
+  std::shared_ptr<TrafficLightDevice> GetShared(
+      const std::string& key, const TrafficLightCallBack& cb);
+  /**
+   * @brief      用于获取红绿灯采集设备工厂实例（单例）
+   * @retval     红绿灯采集设备工厂实例
+   */
+  static TrafficLightDeviceFactory& Instance();
+
+ private:
+  TrafficLightDevice* Produce(
+      const std::string& key, const TrafficLightCallBack& cb);
+
+  TrafficLightDeviceFactory(){};
+  TrafficLightDeviceFactory(const TrafficLightDeviceFactory&) = delete;
+  TrafficLightDeviceFactory(TrafficLightDeviceFactory&&)      = delete;
+
+ private:
+  std::map<std::string, CONSTRUCT> map_;
+};
+
+#define V2XOS_TRAFFIC_LIGHT_REG(T) v2xos_reg_func_str_##T##_
+/**
