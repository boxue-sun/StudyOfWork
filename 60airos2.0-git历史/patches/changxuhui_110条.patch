+    const Eigen::Vector3d &color_rgb) {
+  assert(points.size() == 8);
+
+  int indices[16] = {0, 1, 2, 3, 4, 5, 6, 7, 4, 3, 0, 5, 6, 1, 2, 7};
+
+  glColor3ub(color_rgb[0], color_rgb[1], color_rgb[2]);
+  glLineWidth(line_width);
+
+  glBegin(GL_LINE_STRIP);
+  int j = 0;
