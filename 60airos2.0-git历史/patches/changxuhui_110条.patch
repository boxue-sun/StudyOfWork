+inline void GPUAssert(
+    cudaError_t code, const char *file, int line, bool abort = true) {
+  if (code != cudaSuccess) {
+    fprintf(
+        stderr, "GPUassert: %s %s %d\n", cudaGetErrorString(code), file, line);
