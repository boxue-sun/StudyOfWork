+
+    ~AVCodecCtxManagerArm();
+
+    bool __rebuild_ctx(int devid, int ctx_idx);
+
+public: // FUNCTIONS
+    /**
+     * 获取驱动单例，线程安全
+     * @return Instance
+     */
+    static AVCodecCtxManager *getInstance();
+
+    virtual int create_avctx(int devid = 0) override;
+
+    virtual void decode_and_convert(
+            int ctx_idx,
