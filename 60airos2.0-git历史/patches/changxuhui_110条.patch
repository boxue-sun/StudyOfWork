-    namespace detail
-    {
-        template <typename T>
-        std::string Join(const T& array, const std::string& delimiter)
-        {
-            std::string res;
-            for (auto& element : array)
-            {
-                if (!res.empty())
-                {
-                    res += delimiter;
-                }
-
-                res += element;
-            }
-
-            return res;
-        }
-    }
