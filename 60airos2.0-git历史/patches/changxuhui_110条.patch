+        JsonSerialize(msgType, "msgType", j, false);
+        JsonSerialize(timeStamp, "timeStamp", j, false);
+        JsonSerialize(uuid, "uuid", j, false);
+        JsonSerialize(nodes, "nodes", j, false);
+        JsonSerialize(code, "code", j, false);
+    }
+
+    void deserialize(const json& j) override {
+        JsonDeserialize(msgCnt, "msgCnt", j, noUse_isEmptyFlag);
+        JsonDeserialize(msgType, "msgType", j, noUse_isEmptyFlag);
+        JsonDeserialize(timeStamp, "timeStamp", j, noUse_isEmptyFlag);
+        JsonDeserialize(uuid, "uuid", j, noUse_isEmptyFlag);
+        JsonDeserialize(nodes, "nodes", j, noUse_isEmptyFlag);
+        JsonDeserialize(code, "code", j, noUse_isEmptyFlag);
+    }
+};
+
+class MapHttpClient {
+public:
+    MapHttpClient();
+    ~MapHttpClient();
+
+    // 初始化 HTTP 客户端
+    bool Init(const std::string& server_url);
+
+    // 从云端获取地图数据
+    bool GetMapFromCloud(int intersection_id, std::shared_ptr<v2xpb::asn::MessageFrame>& map_data);
+
+private:
+    // 将 JSON 数据转换为 MessageFrame
+    bool ConvertJsonToMessageFrame(const std::string& json_data, std::shared_ptr<v2xpb::asn::MessageFrame>& map_data);
+
+    // 将 MapData 转换为 MessageFrame
+    bool ConvertMapDataToMessageFrame(const MapData& map_data, std::shared_ptr<v2xpb::asn::MessageFrame>& map_frame);
+
+private:
+    std::string server_url_;
+    bool initialized_;
+    httpClient client_;  // 添加 httpClient 成员变量
+};
+
+}  // namespace protocol
+}  // namespace v2x
+}  // namespace airos
