+
+#include "base/common/timer.h"
+
+#include <sys/time.h>
+
+#include "base/common/log.h"
+
+namespace airos {
+namespace base {
+
+using std::string;
+
+void Timer::Start() {
+  struct timeval tv;
+  gettimeofday(&tv, NULL);
+
+  start_time_ = tv.tv_sec * 1000 + tv.tv_usec / 1000;
+}
+
+uint64_t Timer::End(const string &msg) {
+  struct timeval tv;
+  gettimeofday(&tv, NULL);
+  end_time_             = tv.tv_sec * 1000 + tv.tv_usec / 1000;
+  uint64_t elapsed_time = end_time_ - start_time_;
+
+  LOG_INFO << "TIMER " << msg << " elapsed_time: " << elapsed_time << " ms";
+
+  // start new timer.
+  start_time_ = end_time_;
+  return elapsed_time;
+}
+
+}  // namespace base
+}  // namespace airos
