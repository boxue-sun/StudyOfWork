+bool OM_MONITOR_COMPONENT::period_query_airos_modules_status()
+{
+    AirosStatus airosStatus;
+    airosStatus.tag = QUERY_MSG_TAG::QUARY_TAG_AIROS_STA;
+    airosStatus.seqnum = "test";
+    airosStatus.timestamp =  afl::util::TimeStamp::now(true).millSeconds();;
+    airosStatus.device_esn = getConfiger().rscuEsn;
+    std::string command = "ps aux --sort=-%mem | grep -E 'mainboard|python' | head -n 10";
+    std::vector<ProcessInfo> airosProcessInfos;
+    int maxRetries = 3;
+    int retryCount = 0;  // 当前重试次数
+    bool cmdExecFlag = false;
+    while (retryCount < maxRetries)
+    {
+        if (getProcessInfo(command, airosProcessInfos))
+        {
+            // 成功执行，直接返回 true
+            cmdExecFlag = true;
+            break;
+        }
+
+        OM_MONITOR_ERROR_PRINT << "[error] get airos-moduoles failure! Attempt " << (retryCount + 1) << " failed.\n";
+        retryCount++;
+    }
+
+    if(!cmdExecFlag)
+    {
+        OM_MONITOR_ERROR_PRINT << "[error]reboot device failure!";
+        return false;
+    }
+    else
+    {
+        for (const auto &processInfo : airosProcessInfos)
+        {
+
+            OM_MONITOR_DEBUG_PRINT << "[pid]" << processInfo.pid
+                                << "[cpu]" << processInfo.cpu
+                                << "[mem]" << processInfo.mem
+                                << "[moudle_name]" << processInfo.moudle_name;
+
+            AirosMoudlesData airosMoudlesData;
+            airosMoudlesData.moudle_pid = std::to_string(processInfo.pid);
+            airosMoudlesData.module_cpu = processInfo.cpu;
+            airosMoudlesData.module_mem = processInfo.mem;
+            airosMoudlesData.module_name = processInfo.moudle_name;
+            airosStatus.data.modules_head.push_back(airosMoudlesData);
+        }
+        std::string commandLaunchPs = "launch ps";
+        std::vector<ProcessMoudlesNeedInfo> airosProcessMoudlesNeedInfos = getModulesNeedInfo(commandLaunchPs);
+        std::vector<string> airosNowRunningModules;
+        for(auto nowModule:airosProcessMoudlesNeedInfos)
+        {
+            airosNowRunningModules.push_back(nowModule.moudle_name);
+        }
+        for(auto module: m_AirosNeedRunModules)
+        {
+            airosStatus.data.moudles_need_run.append(module);
+            airosStatus.data.moudles_need_run.append("|");
+            if(contains(airosNowRunningModules, module))
+            {
+                airosStatus.data.modules_now_run.append(module);
+                airosStatus.data.modules_now_run.append("|");
+            }
+            else
+            {
+                airosStatus.data.modules_no_run.append(module);
+                airosStatus.data.modules_no_run.append("|");
+            }
+        }
+
+        afl::base::json publishJson;
+        try{
+            publishJson = airosStatus;
+            if(getConfiger().enableDebugPrint) {
+                OM_MONITOR_DEBUG_PRINT << "[airosStatus]" << airosStatus.to_string();
+            }
+            m_QueueAirosModulesStatus.push(publishJson);
+        }
+        catch (json::exception &e)
+        {
+            OM_MONITOR_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+            return false;
+        }
+    }
+
+    return true;
+}
