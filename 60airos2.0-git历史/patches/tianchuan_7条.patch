+std::mutex OM_MONITOR_COMPONENT::m_MapMutex;
+std::map<std::string,std::pair<long,std::string>> OM_MONITOR_COMPONENT::m_RadarDynamicDataMap;
+std::atomic<bool> OM_MONITOR_COMPONENT::m_RradarsV2xInFlag{false};
+int OM_MONITOR_COMPONENT::mqttSubscribeMsgArrvd(void *context, char *topicName, int topicLen, MQTTAsync_message *message)
+{
+    int ret = 1;
+    auto thiz = (OM_MONITOR_COMPONENT *) context;
+    if (message->payloadlen)
+    {
+        std::string topic(topicName, topicLen);
+        std::string topicProfix = topic.substr(0, topic.find("/"));
+        if(thiz->getConfiger().enableDebugPrint)
+        {
+            OM_MONITOR_DEBUG_PRINT << "radar >>>>>>> om_monitor[topic=" << topicName << "]" << " [payloadlen=" << message->payloadlen << "]";
+        }
+
+        if(topicProfix == "upload")
+        {
+            std::string topic(topicName, topicLen);
+            if (topic.size() <= 0)
+            {
+                OM_MONITOR_ERROR_PRINT << "[Inter][error]topic empty!";
+            }
+            else
+            {
+                m_RradarsV2xInFlag.store(true);
+            }
+        }
+        else if(topicProfix == "trafficMetrics")
+        {
+            std::string topic(topicName, topicLen);
+            if (topic.size() <= 0)
+            {
+                OM_MONITOR_ERROR_PRINT << "[Inter][error]topic empty!";
+            }
+            else
+            {
+                std::string msg((char*)message->payload, message->payloadlen);
+                auto now = std::chrono::system_clock::now();
+                std::time_t now_time_t = std::chrono::system_clock::to_time_t(now);
+                std::lock_guard<std::mutex> lock(m_MapMutex);
+                m_RadarDynamicDataMap[topic] = std::make_pair(now_time_t, msg);
+            }
+        }
+        else
+        {
+
+        }
+    }
+
+    MQTTAsync_freeMessage(&message);
+    MQTTAsync_free(topicName);
+
+    return ret;
+}
