+bool OM_MONITOR_COMPONENT::process_query_radar_cloud_data_status(struct sockaddr_in clientAddr,json& j)
+{
+    QueryData queryData;
+    try
+    {
+        queryData  = j;
+    }
+    catch(json::exception &e)
+    {
+        OM_MONITOR_ERROR_PRINT << "json par error " << e.what();
+        return false;
+    }
+    if(getConfiger().enableDebugPrint) {
+        OM_MONITOR_DEBUG_PRINT << "[rece-data]" << queryData.to_string();
+    }
+    if(queryData.tag != QUERY_MSG_TAG::QUARY_TAG_RADAR_CLOUD_DATA_STA)
+    {
+        OM_MONITOR_ERROR_PRINT << "tag error ";
+        return false;
+    }
+    if(queryData.device_esn != getConfiger().rscuEsn)
+    {
+        OM_MONITOR_ERROR_PRINT << "device-esn error! [query-esn]" << queryData.device_esn << "[rscuEsn]" << getConfiger().rscuEsn;
+        return false;
+    }
+
+    m_MecRadarCloudStatus.data.mec_radars_dynamic_data.clear();
+    m_MecRadarCloudStatus.tag = QUERY_MSG_TAG::QUARY_TAG_RADAR_CLOUD_DATA_STA;
+    m_MecRadarCloudStatus.seqnum = queryData.seqnum;
+    m_MecRadarCloudStatus.timestamp = afl::util::TimeStamp::now(true).millSeconds();
+    m_MecRadarCloudStatus.device_esn = getConfiger().rscuEsn;
+    auto tmp_MecCloudStatusData = m_MecCloudStatusData;
+    m_MecRadarCloudStatus.data.mec_cloud_status.con_flag = tmp_MecCloudStatusData.mec_cloud_status.con_flag;
+    m_MecRadarCloudStatus.data.mec_cloud_status.dynamic_up_flag = tmp_MecCloudStatusData.mec_cloud_status.dynamic_up_flag;
+    m_MecRadarCloudStatus.data.mec_cloud_status.v2x_up_flag = tmp_MecCloudStatusData.mec_cloud_status.v2x_up_flag;
+
+    m_MecRadarCloudStatus.data.mec_radars_v2x_in_flag = m_RradarsV2xInFlag.load();
+
+    auto tmp = m_RadarDynamicDataMap;
+    for(const auto& data : tmp)
+    {
+        struct MecRadarDynamicData dynamicData;
+        std::string fullPath = data.first;
+        OM_MONITOR_ERROR_PRINT << "111:"<<fullPath;
+        std::string esn = (fullPath.find_last_of('/') != std::string::npos && fullPath.find_last_of('/') + 1 < fullPath.size()) ? fullPath.substr(fullPath.find_last_of('/') + 1) : "";
+        dynamicData.device_id = esn;
+        dynamicData.dynamic_up_flag = true;
+        m_MecRadarCloudStatus.data.mec_radars_dynamic_data.push_back(dynamicData);
+    }
+
+    afl::base::json publishJson;
+    try{
+        publishJson = m_MecRadarCloudStatus;
+    }
+    catch (json::exception &e)
+    {
+        OM_MONITOR_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+        return false;
+    }
+
+    std::string msg = publishJson.dump();
+    if(getConfiger().enableDebugPrint) {
+        OM_MONITOR_DEBUG_PRINT << "[mec_radar_cloud][response]" << msg;
+    }
+    size_t slen = sendto(m_Udpfd, msg.c_str(), msg.size(), 0,
+                         (struct sockaddr*)&clientAddr, sizeof(clientAddr));
+    if (slen != msg.size())
+    {
+        OM_MONITOR_ERROR_PRINT << "[error]send mec_radar_cloud msg error, reason:" << strerror(errno);
+        return false;
+    }
+    return true;
+}
