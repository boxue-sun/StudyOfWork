+bool OM_MONITOR_COMPONENT::period_discard_radar_cloud_data_status()
+{
+    m_RradarsV2xInFlag.store(false);
+    std::time_t currentTime = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+    std::time_t fiveSecondsAgo = currentTime - 5;
+ 
+    std::lock_guard<std::mutex> lock(m_MapMutex);
+    auto it = m_RadarDynamicDataMap.begin();
+    while (it != m_RadarDynamicDataMap.end())
+    {
+        if (it->second.first < fiveSecondsAgo)
+        {
+            it = m_RadarDynamicDataMap.erase(it); // 删除过时元素
+        } 
+        else 
+        {
+            ++it; // 继续检查下一个元素
+        }
+    }
+
+    return true;
+}
