+struct MecCloudStatus: public afl::base::SerializableData
+{
+    bool con_flag;                            //信控上云模块连接云控是否正常，true：连接正常，false：连接不正常
+    bool dynamic_up_flag;                     //是否有动态数据发送给云控，true：是，false：否
+    bool v2x_up_flag;                        //是否有V2X指标数据发送给云控，true：是，false：否
+
+    // 序列化函数
+    void serialize(json &j) override {
+        JsonSerialize(con_flag,              "con_flag",              j, false);
+        JsonSerialize(dynamic_up_flag,       "dynamic_up_flag",       j, false);
+        JsonSerialize(v2x_up_flag,           "v2x_up_flag",           j, false);
+
+    }
+
+    // 反序列化函数
+    void deserialize(const json &j) override {
+        JsonDeserialize(con_flag,              "con_flag",                     j, noUse_isEmptyFlag);
+        JsonDeserialize(dynamic_up_flag,       "dynamic_up_flag",              j, noUse_isEmptyFlag);
+        JsonDeserialize(v2x_up_flag,           "v2x_up_flag",                  j, noUse_isEmptyFlag);
+    }
+
+    // 转换为字符串
+    std::string to_string() const {
+        std::stringstream ss;
+        ss << std::left << std::setw(40) << "con_flag: "         << (con_flag ? "true" : "false") << std::endl;
+        ss << std::left << std::setw(40) << "dynamic_up_flag: "         << (dynamic_up_flag ? "true" : "false") << std::endl;
+        ss << std::left << std::setw(40) << "v2x_up_flag: "         << (v2x_up_flag ? "true" : "false") << std::endl;
+        return ss.str();
+    }
+};
+
+struct MecRadarDynamicData : public afl::base::SerializableData {
+    std::string device_id;                           // 雷达设备esn
+    bool dynamic_up_flag;                            // MEC接收雷达动态信控数据是否成功，true:成功，false：失败
+
+    // 序列化函数
+    virtual void serialize(json &j) override {
