+std::string CCINDEX_COMPONENT::fixHeadtimediffdetial(std::string head_time_diff_detial, int count)
+{
+    std::string fix_head_time_diff_detial;
+    size_t semicolon_pos = head_time_diff_detial.find(';');
+    std::string vehicle_part = head_time_diff_detial.substr(0, semicolon_pos);
+    std::string time_part = head_time_diff_detial.substr(semicolon_pos);
+
+    // 分割车辆列表
+    std::vector<std::string> vehicles;
+    std::vector<std::string> times;
+    std::stringstream ss_vp(vehicle_part);
+    std::stringstream ss_tp(time_part);
 
-void CCINDEX_COMPONENT::send_5m_level_radardata()
+    std::string item;
+    while (std::getline(ss_vp, item, ',')) 
+    {
+        vehicles.push_back(item);
+    }
+    while (std::getline(ss_tp, item, ',')) 
+    {
+        times.push_back(item);
+    }
+
+    std::string fix_vehicle_part = "";
+    std::string fix_time_part = "";
+    
+    if(vehicles.size() < count)
+    {
+        fix_head_time_diff_detial = head_time_diff_detial;
+        RADAR_TC_DEBUG_PRINT << "head_time_diff_detial fix count error";
+    }
+    else
+    {
+        for(int i = 0; i < count; i++)
+        {
+            if(i == 0)
+            {
+                fix_vehicle_part = vehicles[0];
+                fix_time_part = times[0];
+            }
+            else
+            {
+                fix_vehicle_part = fix_vehicle_part + "," + vehicles[i];
+                fix_time_part = fix_time_part + "," + times[i];
+            }
+        }
+        fix_head_time_diff_detial = fix_vehicle_part + ";" + fix_time_part;
+    }
+
+
+    return fix_head_time_diff_detial;
+}
