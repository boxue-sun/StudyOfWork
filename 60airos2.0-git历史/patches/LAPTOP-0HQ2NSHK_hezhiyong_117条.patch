+        {
+            CCINDEX_INTER_ERROR_PRINT << "[error]mqtt-inter push " << hint.c_str() << " failure!";
+            return false;
+        }
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
+}
+bool CCINDEX_COMPONENT::mqttPushJsonMsg2Broker(string topic, json info, string hint)
+{
+    std::string pData;
+    try{
+        pData = info.dump();
+    }
+    catch (json::exception& e)
+    {
