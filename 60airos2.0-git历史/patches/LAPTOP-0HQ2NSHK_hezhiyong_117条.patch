+            }
+            else if (hint == "tc")
+            {
+                RADAR_TC_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+            }
+            else if (hint == "trafficMetrics")
+            {
+                RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+            }
+            else
+            {
+
+            }
+
+            return false;
+        }
+
