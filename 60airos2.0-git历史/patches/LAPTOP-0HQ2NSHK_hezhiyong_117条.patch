diff --git a/middleware/protocol/spill_reporter/spill_reporter.cc b/middleware/protocol/spill_reporter/spill_reporter.cc
new file mode 100644
index 0000000..c28deda
--- /dev/null
+++ b/middleware/protocol/spill_reporter/spill_reporter.cc
@@ -0,0 +1,162 @@
+#include "spill_reporter.h"
+#include "base/common/math_util.h"
+
+SpillReporterComponentAdapter::SpillReporterComponentAdapter()
+    : Configurable<SpillReporterConfiger>("SpillReporterComponentAdapter", "/home/airos/protocol", "SpillReporterComponentAdapter.flag")
+{
+
+}
+
+SpillReporterComponentAdapter::~SpillReporterComponentAdapter()
+{
+
+}
+
+bool SpillReporterComponentAdapter::Init()
+{
+    return true;
+}
+
+bool SpillReporterComponentAdapter::Proc(const std::shared_ptr<const airos::usecase::EventOutputResult> &mecDeviceData)
+{
+    uint64_t now = afl::util::TimeStamp::now(true).millSeconds();
+    if(now % (24*60*60*1000) <= 20*1000)//00:00:00-00:00:20清空map
+    {
+        m_SpillMap.clear();
+    }
+    if(mecDeviceData == nullptr 
+        || mecDeviceData->events().empty() 
+        || !mecDeviceData->has_header())
+    {
+        LOG_INFO_IF << "not recv events";
+        return false;
+    }
+
+    for(int i = 0; i < mecDeviceData->events_size(); i++)
+    {
+        auto event_info = mecDeviceData->events(i);
+        if(event_info.event_type_mec() != 3
+            || !event_info.has_position_gcs()
+            || !event_info.has_event_video()
+            || !event_info.has_event_picture())
+        {
+            LOG_INFO_IF << "current event is not spill or do not have position";
+            continue;
+        }
+
+        SingleCloudSpillEvent scpe;
+        scpe.DevNo = mecDeviceData->header().dev_no();
+        scpe.MecNo = mecDeviceData->header().mec_no();
+        scpe.Timestamp = utc2string(mecDeviceData->header().timestamp_millisecond());
+        scpe.ID = event_info.id_str();
+        scpe.EvtType = 3;
+        scpe.Lon = event_info.position_gcs().lon();
+        scpe.Lat = event_info.position_gcs().lat();
+        scpe.Ele = event_info.position_gcs().ele();
+        scpe.EvtV = event_info.event_video();
+        scpe.EvtP = event_info.event_picture();
+
+        if(m_SpillMap.find(scpe.ID) == m_SpillMap.end())//未找到
+        {
+            std::string repeatID = "";
+            for(auto& iter : m_SpillMap)
+            {
+                uint64_t temp_time = iter.second.utctime;
+                if(now - temp_time > getConfiger().GapTime)
+                {
+                    LOG_INFO_IF << "pass 10s since last spill";
+                    continue;
+                }
+                double temp_distance = airos::base::MathUtil::getDistance(scpe.Lat, scpe.Lon, iter.second.Lat, iter.second.Lon);
+                if(temp_distance > getConfiger().GapDistance)
+                {
+                    LOG_INFO_IF << "distance more than 10m";   
+                    continue;                 
+                }
+                //与已有遗洒事件重复，合并EvtV和EvtP到已有遗洒事件json文件中
+                LOG_INFO_IF << "distance less than 10m";
+                updateEvtVEvtP(iter.second.EvtV, scpe.EvtV, mecDeviceData->header().dev_no(), true);
+                updateEvtVEvtP(iter.second.EvtP, scpe.EvtP, mecDeviceData->header().dev_no(), false);
+                repeatID = iter.first;
+                break;                            
+            }
+            if(repeatID == "")
+            {
+                afl::base::json jspill = scpe;
+                std::ofstream jfile(getConfiger().Dir + "/" + scpe.ID + ".json");
+                jfile << jspill.dump(4);
+
+                m_SpillMap[scpe.ID] = scpe;
+            }
+            else
+            {
+                afl::base::json jspill = m_SpillMap[repeatID];
+                std::ofstream jfile(getConfiger().Dir + "/" + repeatID + ".json");
+                jfile << jspill.dump(4);
+            }
+        }
+        else//找到相同ID遗洒事件，更新json文件
+        {
+            updateEvtVEvtP(m_SpillMap[scpe.ID].EvtV, scpe.EvtV, mecDeviceData->header().dev_no(), true);
+            updateEvtVEvtP(m_SpillMap[scpe.ID].EvtP, scpe.EvtP, mecDeviceData->header().dev_no(), false);
+
+            afl::base::json jspill = m_SpillMap[scpe.ID];
+            std::ofstream jfile(getConfiger().Dir + "/" + scpe.ID + ".json");
+            jfile << jspill.dump(4);
+        }
+    }
+}
+
+std::string SpillReporterComponentAdapter::utc2string(uint64_t utctime)
+{
+    char buf[32] = { 0 };
+    struct tm tm_time;
+
+    time_t seconds = static_cast<time_t>(utctime/1000);
+    int millseconds = utctime % (1000);
+
+    localtime_r(&seconds, &tm_time);
+
+    snprintf(buf, sizeof(buf), "%4d-%02d-%02d %02d:%02d:%02d:%03d", tm_time.tm_year + 1900,
+                 tm_time.tm_mon + 1, tm_time.tm_mday, tm_time.tm_hour, tm_time.tm_min, tm_time.tm_sec, millseconds);
+    return buf;
+}
+
+void SpillReporterComponentAdapter::updateEvtVEvtP(std::string& totalEvtVP, std::string singleEvtVP, std::string devNo, bool isVideo)
+{
+    size_t pos_dev_no = totalEvtVP.find(devNo);
+    if(pos_dev_no == std::string::npos)
+    {
+        totalEvtVP = totalEvtVP + ", " + singleEvtVP;
+    }
+    else
+    {
+        size_t pos_mp4jpg;
+        if(isVideo)
+        {
+            pos_mp4jpg = totalEvtVP.find(".mp4", pos_dev_no);
+        }
+        else
+        {
+            pos_mp4jpg = totalEvtVP.find(".jpg", pos_dev_no);
+        }
+
+        if (pos_mp4jpg == std::string::npos) 
+        {
+            LOG_INFO_IF << ".mp4 or .jpg not found after target!";
+            return;
+        }
+        pos_mp4jpg += 4; // 包含".mp4"的长度
+        
+        // 向前查找链接开始位置（ftp://）
+        size_t pos_ftp = totalEvtVP.rfind("ftp://", pos_dev_no);
+        if (pos_ftp == std::string::npos) 
+        {
+            LOG_INFO_IF << "ftp:// not found before target!";
+            return;
+        }
+        // 替换整个链接
+        totalEvtVP.replace(pos_ftp, pos_mp4jpg - pos_ftp, singleEvtVP);
+    }
+ 
+}
