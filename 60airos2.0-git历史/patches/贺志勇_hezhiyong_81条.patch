+void zk_DTUParser::transform2Gat1743(std::map<uint8_t, zk_DTULightState> new_color_state)
+{
+    TRAFFIC_LIFGT_SERVICE_LOG_INFO << "transform DTU to gat 1743";
+    uint8_t gat1743_buff[1024] = {0};
+    size_t offset = 0;
+    // 1. 包头1B
+    gat1743_buff[offset++] = 0xC0;
+    // 2 链路码2B: 除信号机以外的其他路侧交通管控设备
+    gat1743_buff[offset++] = 0x04;
+    gat1743_buff[offset++] = 0x00;
+    // 3.1 发送方标识 - 行政区代码3B
+    gat1743_buff[offset++] = (uint8_t)(kAdministrativeCode & 0xFF);
+    gat1743_buff[offset++] = (uint8_t)((kAdministrativeCode >> 8) & 0xFF);
+    gat1743_buff[offset++] = (uint8_t)((kAdministrativeCode >> 16) & 0xFF);
+    // 3.2 发送方标识 - 类型2B: 除信号机以外的其他路侧交通管控设备
+    gat1743_buff[offset++] = 0x00;
+    gat1743_buff[offset++] = 0x20;
+    // 3.3 发送方标识 - 编号2B: 暂定为路口号
+    gat1743_buff[offset++] = 0x01;  //(uint8_t)(FLAGS_rsu_intersection_id & 0xFF);
+    gat1743_buff[offset++] = 0x00;  // (uint8_t)((FLAGS_rsu_intersection_id >> 8) & 0xFF);
+    // 4.1 接收方标识 - 行政区代码3B
+    gat1743_buff[offset++] = (uint8_t)(kAdministrativeCode & 0xFF);
+    gat1743_buff[offset++] = (uint8_t)((kAdministrativeCode >> 8) & 0xFF);
+    gat1743_buff[offset++] = (uint8_t)((kAdministrativeCode >> 16) & 0xFF);
+    // 4.2 发送方标识 - 类型2B: 信号机
+    gat1743_buff[offset++] = 0x00;
+    gat1743_buff[offset++] = 0x10;
+    // 4.3 发送方标识 - 编号2B: 广播
+    gat1743_buff[offset++] = 0xFF;
+    gat1743_buff[offset++] = 0xFF;
+    // 5. 时间戳6B：单位秒
+    const uint32_t cur_time_stamp = uint32_t(zk_DTUUtil::GetCurTimestampMsec() / 1000);
+    gat1743_buff[offset++] = (uint8_t)(cur_time_stamp & 0xFF);
+    gat1743_buff[offset++] = (uint8_t)((cur_time_stamp >> 8) & 0xFF);
+    gat1743_buff[offset++] = (uint8_t)((cur_time_stamp >> 16) & 0xFF);
+    gat1743_buff[offset++] = (uint8_t)((cur_time_stamp >> 24) & 0xFF);
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    // 6. 生存时间1B
+    gat1743_buff[offset++] = 0x01;
+    // 7. 协议版本1B
+    gat1743_buff[offset++] = 0x10;
+    // 8. 操作类型1B : 查询请求
+    gat1743_buff[offset++] = 0x82;
+    // 9. 对象标识2B :
+    gat1743_buff[offset++] = 0x03;
+    gat1743_buff[offset++] = 0x01;
+    // 10. 签名标识1B
+    gat1743_buff[offset++] = 0;
+    // 11. 保留未使用3B
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+
+    //12.1 数据长度固定为87 2B
+    gat1743_buff[offset++] = 0x57;
+    gat1743_buff[offset++] = 0x00;
+
+    //12.2 经度 4B
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    //12.3 纬度 4B
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    //12.4 海拔高度 2B
+    gat1743_buff[offset++] = 0;
+    gat1743_buff[offset++] = 0;
+    //12.5 路口进口数量 1B
+    gat1743_buff[offset++] = 0x04;
+    //12.6.1 东进口灯态填充 19B
+    gat1743_buff[offset++] = 0x5A;
+    gat1743_buff[offset++] = 0x00;//进口方向90
+    gat1743_buff[offset++] = 0x04;
+    gat1743_buff[offset++] = 0x01;
+    gat1743_buff[offset++] = new_color_state[1].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[1].color);
+    gat1743_buff[offset++] =  new_color_state[1].countdown;
+    gat1743_buff[offset++] = 0x02;
+    gat1743_buff[offset++] = new_color_state[2].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[2].color);
+    gat1743_buff[offset++] =  new_color_state[2].countdown;
+    gat1743_buff[offset++] = 0x03;
+    gat1743_buff[offset++] = new_color_state[3].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[3].color);
+    gat1743_buff[offset++] =  new_color_state[3].countdown;
+    gat1743_buff[offset++] = 0x04;
+    gat1743_buff[offset++] = new_color_state[4].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[4].color);
+    gat1743_buff[offset++] =  new_color_state[4].countdown;    
+    //12.6.2 南进口灯态填充 19B
+    gat1743_buff[offset++] = 0xB4;
+    gat1743_buff[offset++] = 0x00;//进口方向180
+    gat1743_buff[offset++] = 0x04;
+    gat1743_buff[offset++] = 0x05;
+    gat1743_buff[offset++] = new_color_state[5].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[5].color);
+    gat1743_buff[offset++] =  new_color_state[5].countdown;
+    gat1743_buff[offset++] = 0x06;
+    gat1743_buff[offset++] = new_color_state[6].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[6].color);
+    gat1743_buff[offset++] =  new_color_state[6].countdown;
+    gat1743_buff[offset++] = 0x07;
+    gat1743_buff[offset++] = new_color_state[7].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[7].color);
+    gat1743_buff[offset++] =  new_color_state[7].countdown;
+    gat1743_buff[offset++] = 0x08;
+    gat1743_buff[offset++] = new_color_state[8].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[8].color);
+    gat1743_buff[offset++] =  new_color_state[8].countdown; 
+    //12.6.3 西进口灯态填充 19B
+    gat1743_buff[offset++] = 0x0E;
+    gat1743_buff[offset++] = 0x01;//进口方向270
+    gat1743_buff[offset++] = 0x04;
+    gat1743_buff[offset++] = 0x09;
+    gat1743_buff[offset++] = new_color_state[9].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[9].color);
+    gat1743_buff[offset++] =  new_color_state[9].countdown;
+    gat1743_buff[offset++] = 0x0A;
+    gat1743_buff[offset++] = new_color_state[10].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[10].color);
+    gat1743_buff[offset++] =  new_color_state[10].countdown;
+    gat1743_buff[offset++] = 0x0B;
+    gat1743_buff[offset++] = new_color_state[11].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[11].color);
+    gat1743_buff[offset++] =  new_color_state[11].countdown;
+    gat1743_buff[offset++] = 0x0C;
+    gat1743_buff[offset++] = new_color_state[12].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[12].color);
+    gat1743_buff[offset++] =  new_color_state[12].countdown; 
+    //12.6.4 北进口灯态填充 19B
+    gat1743_buff[offset++] = 0x00;
+    gat1743_buff[offset++] = 0x00;//进口方向0
+    gat1743_buff[offset++] = 0x04;
+    gat1743_buff[offset++] = 0x0D;
+    gat1743_buff[offset++] = new_color_state[13].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[13].color);
+    gat1743_buff[offset++] =  new_color_state[13].countdown;
+    gat1743_buff[offset++] = 0x0E;
+    gat1743_buff[offset++] = new_color_state[14].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[14].color);
+    gat1743_buff[offset++] =  new_color_state[14].countdown;
+    gat1743_buff[offset++] = 0x0F;
+    gat1743_buff[offset++] = new_color_state[15].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[15].color);
+    gat1743_buff[offset++] =  new_color_state[15].countdown;
+    gat1743_buff[offset++] = 0x10;
+    gat1743_buff[offset++] = new_color_state[16].type;
+    gat1743_buff[offset++] = transformlightColor(new_color_state[16].color);
+    gat1743_buff[offset++] =  new_color_state[16].countdown;
+
+    //13 crc16校验 2B
+    uint16_t crc16 = zk_DTUCrc16(gat1743_buff + 1, offset - 1);
+    gat1743_buff[offset++] = (uint8_t)(crc16 & 0xFF);
+    gat1743_buff[offset++] = (uint8_t)((crc16 >> 8) & 0xFF);
+    //包尾 1B
+    gat1743_buff[offset++] = 0xC0;
+    // 数据转义处理
+    for (size_t i = 1; i < (offset - 1); i++) 
+    {
+        if (gat1743_buff[i] == 0xC0) 
+        {
+            memmove(gat1743_buff + i + 2, gat1743_buff + i + 1, offset - i - 1);
+            offset++;
+
+            gat1743_buff[i]     = 0xDB;
+            gat1743_buff[i + 1] = 0xDC;
+        } 
+        else if (gat1743_buff[i] == 0xDB) 
+        {
+            memmove(gat1743_buff + i + 2, gat1743_buff + i + 1, offset - i - 1);
+            offset++;
+
+            gat1743_buff[i]     = 0xDB;
+            gat1743_buff[i + 1] = 0xDD;
+        }
+    }
+
+    sendSourceDataToCloud(gat1743_buff, offset);
+    
+}
+
+void zk_DTUParser::sendSourceDataToCloud(uint8_t *data, const int len)
+{
+	if(socket_fd_ > 0)
+	{
+        TRAFFIC_LIFGT_SERVICE_LOG_INFO << "[success]send gat1743 traffic light data success!";
+		for(int i = 0; i < outlist.size(); i++)
+		{
+			struct sockaddr_in peer_addr_;
+			peer_addr_.sin_family      = AF_INET;
+			peer_addr_.sin_addr.s_addr = inet_addr(outlist[i].peerip.c_str());
+			peer_addr_.sin_port        = htons(outlist[i].peerport);
+			sendto(socket_fd_, data, len, 0, (struct sockaddr *)&peer_addr_, sizeof(peer_addr_));
+		}
+
+        struct sockaddr_in peer_addr_;
+        peer_addr_.sin_addr.s_addr = inet_addr("127.0.0.1");
+        
+        peer_addr_.sin_port        = htons(50500);
+        sendto(socket_fd_, data, len, 0, (struct sockaddr *)&peer_addr_, sizeof(peer_addr_));
+	}
+    else
+    {
+        TRAFFIC_LIFGT_SERVICE_LOG_ERROR << "[failed]send gat1743 traffic light data failed!";
+    }
+
+}
