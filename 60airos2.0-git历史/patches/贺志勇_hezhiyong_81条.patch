+bool CAMERAEVENT_COMPONENT::mqttPublishMsg(const std::string &topic, const std::string &msg)
+{
+    if (!m_MqttConnected)
+    {
+        LOG_ERROR << "[error]mqtt has not connected!";
+        return false;
+    }
+
+    if (msg.size() <= 0 || topic.empty())
+    {
+        LOG_ERROR << "[error]len < 0 or topic empty!";
+        return false;
+    }
+
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    MQTTAsync_message pubmsg = MQTTAsync_message_initializer;
+    int rc;
+
+    opts.context = m_MqttClient;
+    pubmsg.payload = (void *) msg.c_str();
+    pubmsg.payloadlen = msg.length();
+    pubmsg.qos = m_Configer.configerMqtt.mqttSendQos;
+    pubmsg.retained = 0;
+
+    if ((rc = MQTTAsync_sendMessage(m_MqttClient, topic.c_str(), &pubmsg, &opts)) != MQTTASYNC_SUCCESS)
+    {
+        if (rc == MQTTASYNC_DISCONNECTED)
+        {
+            LOG_ERROR << "[error]Async Connect failure，will connect!";
+            if (m_MqttConnected)
+            {
+                m_MqttConnected = false;
+                mqttReconnect();
+            }
+        } else
+        {
+            LOG_ERROR << "[error]push msg error，[error-code]" << rc;
+        }
+
+        return false;
+    }
+
+    return true;
+}
