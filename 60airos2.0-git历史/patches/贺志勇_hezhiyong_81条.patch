+bool CAMERAEVENT_COMPONENT::mqttInit()
+{
+    m_MqttClient = nullptr;
+    m_MqttConnected = false;
+    mqttInitConnOpts();
+
+    std::string clientIdTemp = m_Configer.mqttClientId + ":" + std::to_string(afl::util::TimeStamp::now(true).microSeconds());
+    LOG_ERROR << "[mqttBroker-Url]" << m_Configer.configerMqtt.mqttBrokerUrl.c_str()
+                << " [client-id]" << clientIdTemp.c_str()
+                << " [username]" << m_Configer.configerMqtt.mqttUserName.c_str()
+                << " [passwd]" << m_Configer.configerMqtt.mqttPassword.c_str();
+    if (MQTTASYNC_SUCCESS != MQTTAsync_create(&m_MqttClient, m_Configer.configerMqtt.mqttBrokerUrl.c_str(), clientIdTemp.c_str(), MQTTCLIENT_PERSISTENCE_NONE, NULL))
+    {
+        LOG_ERROR << "[error]create connectiont failure!";
+        return false;
+    }
+
+    MQTTAsync_setCallbacks(m_MqttClient, this, mqttConnlost, mqttSubscribeMsgArrvd, NULL);
+
+    if (!mqttConnect())
+    {
+        LOG_ERROR << "[error]Connect Failure!";
+        return false;
+    }
+
+    return true;
+}
