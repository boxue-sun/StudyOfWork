+void zk_DTUParser::ParseColorState(uint8_t *packet_addr, int packet_len)
+{
+    monitor_->Inczk_DTUPacketCounter();
+    // TODO: for debug
+    zk_DTUUtil::DbgPrintBinary(packet_addr, packet_len, std::string("parse DTU frame : "));
+
+    memcpy(packet_buff_, packet_addr, packet_len);
+
+    uint8_t crc8 = zk_DTUCrc8(packet_buff_  + 8, packet_len - 8);
+    if(packet_buff_[7] != crc8)
+    {
+        TRAFFIC_LIFGT_SERVICE_LOG_ERROR << "crc8 failed!(" << packet_buff_[7] << "/" << crc8 << ")";
+        return;
+    }
+
+    std::map<uint8_t, zk_DTULightState> new_light_state_map;
+    std::map<uint8_t, std::vector<zk_DTULightStep>> new_all_period_map;
+    for(int i = 0; i < 16; i++)
+    {
+        DTUphaseInfo* dpi = (DTUphaseInfo*)(&packet_buff_[8 + 15 + 7*i]);//第0-22字节为头部信息，第23字节开始为灯组信息，每个灯组7字节
+        zk_DTULightState temp_phase;
+        std::vector<zk_DTULightStep> temp_phase_plan;
+        
+        //当前灯态填充
+        if(dpi->phaseid != i + 1)
+        {
+            TRAFFIC_LIFGT_SERVICE_LOG_ERROR << "phase id error :" << dpi->phaseid;
+            return;
+        }
+
+        if(dpi->phasestate > 0x03)
+        {
+            TRAFFIC_LIFGT_SERVICE_LOG_ERROR << "phase state error :" << dpi->phasestate;
+            return;
+        }
+
+        temp_phase.color = dpi->phasestate;
+        temp_phase.type = transformzk_DTULightType(dpi->phaseid);
+        temp_phase.countdown = dpi->timecount;
+        temp_phase.entry_direction = transformzk_DTUDirection(dpi->phaseid);
+        temp_phase.timestamp = zk_DTUUtil::GetCurTimestampMsec();
+        TRAFFIC_LIFGT_SERVICE_LOG_INFO << "phase info,color:" << temp_phase.color << "type"<< temp_phase.type << "countdown" << temp_phase.countdown << "entry_direction" << temp_phase.entry_direction;
+        TRAFFIC_LIFGT_SERVICE_LOG_INFO << "phase info,type:"<< temp_phase.type;
+        TRAFFIC_LIFGT_SERVICE_LOG_INFO << "phase info,countdown:" << temp_phase.countdown;
+        TRAFFIC_LIFGT_SERVICE_LOG_INFO << "phase info,entry_direction:" << temp_phase.entry_direction;
+
+        new_light_state_map[i + 1] = std::move(temp_phase);
+
+        //当前灯态配时填充        
+        if(dpi->greentime != 0)
+        {
+            zk_DTULightStep green_plan;
+            green_plan.color = temp_phase.color;
+            green_plan.type = temp_phase.type;
+            green_plan.duration = dpi->greentime;
+            temp_phase_plan.push_back(green_plan);
+        }
+        if(dpi->redtime != 0)
+        {
+            zk_DTULightStep red_plan;
+            red_plan.color = temp_phase.color;
+            red_plan.type = temp_phase.type;
+            red_plan.duration = dpi->redtime;
+            temp_phase_plan.push_back(red_plan);
+        }
+        if(dpi->yellowtime != 0)
+        {
+            zk_DTULightStep yellow_plan;
+            yellow_plan.color = temp_phase.color;
+            yellow_plan.type = temp_phase.type;
+            yellow_plan.duration = dpi->yellowtime;
+            temp_phase_plan.push_back(yellow_plan);
+        }
+
+        if(temp_phase_plan.size() > 0)
+        {
+            new_all_period_map[i + 1] = temp_phase_plan;
+        }
+    } 
+
+    TRAFFIC_LIFGT_SERVICE_LOG_INFO << "get phase info";
+    if(new_light_state_map.size() > 0)
+    {
+        this->transform2Gat1743(new_light_state_map);
+        this->ResetAllColorState(new_light_state_map);
+
+    }
+
+    if(new_all_period_map.size() > 0)
+    {
+        TRAFFIC_LIFGT_SERVICE_LOG_INFO << "get plane info";
+        this->ResetAllCurrPlanStep(new_all_period_map);
+    }
+}
