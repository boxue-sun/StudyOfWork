+/**
+ * @brief 信号机监控类
+ * @note 监控和信号机的通信是否正常
+ */
+class zk_DTUMonitor {
+ public:
+  zk_DTUMonitor();
+  ~zk_DTUMonitor();
+
+  bool Init();
+
+  void IncRecvFrameCounter();
+
+  void Inczk_DTUPacketCounter();
