+void CAMERAEVENT_COMPONENT::mqttOnConnect(void *context, MQTTAsync_successData *response)
+{
+    LOG_ERROR << "[sucess]connect sucess!";
+    auto thiz = (CAMERAEVENT_COMPONENT *) context;
+    thiz->m_MqttConnected = true;
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    opts.onSuccess = mqttOnSubscribe;
+    opts.onFailure = mqttOnSubscribeFailure;
+    opts.context = thiz;
+
+    if(thiz->m_Configer.configerMqtt.mqttRealSubscribeTopicNum > 0)
+    {
+        if (MQTTAsync_subscribeMany(thiz->m_MqttClient, thiz->m_Configer.configerMqtt.mqttRealSubscribeTopicNum,
+                                    thiz->m_Configer.configerMqtt.mqttSubscribeTopics,
+                                    thiz->m_Configer.configerMqtt.mqttSubscribeQoss,
+                                    &opts) != MQTTASYNC_SUCCESS)
+        {
+            LOG_ERROR << "[error]subscribe error";
+        }
+    }
+}
