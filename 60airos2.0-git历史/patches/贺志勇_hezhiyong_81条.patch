+uint8_t zk_DTUParser::transformlightColor(uint8_t color)
+{
+    uint8_t temp_color = 0;
+    if(color == 1)
+    {
+        temp_color = 0x16;
+    }
+    else if(color == 2)
+    {
+        temp_color = 0x19;
+    }
+    else if(color == 3)
+    {
+        temp_color = 0x25;
+    }
+
+    return temp_color;
+}
