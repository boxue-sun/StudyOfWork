+zk_DTUParser::zk_DTUParser()
+{
+    recv_cache_ = new uint8_t[kRecvCacheCapacity];
+    memset(recv_cache_, 0, kRecvCacheCapacity);
+    cache_size_ = 0;
+
+    packet_buff_ = new uint8_t[kPacketBuffCapacity];
