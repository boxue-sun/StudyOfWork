+void zk_DTUParser::ProcessFrames(uint8_t *package_buf, const int package_len)
+{
+    monitor_->IncRecvFrameCounter();
+    if (cache_size_ + package_len > kRecvCacheCapacity) 
+    {
+        cache_size_ = 0;  // clean cache
+        zk_DTUUtil::DbgPrintBinary(recv_cache_, cache_size_, "clean cache");
+        for (int i = 0; i < package_len; i++) 
+        {
+            if ((package_buf[i] == 0x41) && (package_buf[i + 1] != 0x56) && (package_buf[i + 1] != 0x49) && (package_buf[i + 1] != 0x53))
+            {
+                // find the FrameHead
+                if ((package_len - i) <= kRecvCacheCapacity)
+                {
+                    memcpy(recv_cache_, &package_buf[i], package_len - i);
+                    cache_size_ = package_len - i;
+                } 
+                else 
+                {
+                    zk_DTUUtil::DbgPrintBinary(package_buf, package_len, "drop the headless frame: ");
+                }
+            }
+        }
+    }
+    else
+    {
+        memcpy(recv_cache_ + cache_size_, package_buf, package_len);
+        cache_size_ += package_len;
+    }
+    zk_DTUUtil::DbgPrintBinary(package_buf, package_len, "trasform frame: ");
+    if (cache_size_ == 0)
+    {
+        return;
+    }
+
+    std::map<uint8_t *, int> zk_DTU_packet_map;
+    int shear_len = 0;
+    const int max_end = cache_size_;
+    uint8_t *frame_head = nullptr;
+
+    for (int offset = 0; offset < max_end - 8; offset++)
+    {
+        if(recv_cache_[offset] == 0x41 && recv_cache_[offset + 1] == 0x56 && recv_cache_[offset + 2] == 0x49 && recv_cache_[offset + 3] == 0x53)
+        {
+            shear_len = offset;
+            int type = recv_cache_[offset + 4];
+            int data_src = recv_cache_[offset + 5];
+            int datalen = recv_cache_[offset + 6];
+            int check = recv_cache_[offset + 7];
+            TRAFFIC_LIFGT_SERVICE_LOG_INFO << "totallen:" << max_end << ", offset:" << offset << ", type:" << type << ", datalen:" << datalen;
+
+            if(type == 0x01 && (max_end - offset - 8 >= datalen))//数据类型为0x01且剩余长度大于datalen
+            {
+                std::unique_lock <std::mutex> guard(zk_DTU_packet_mutex_);
+                zk_DTU_packet_.push(std::string((char *)(&recv_cache_[offset]), datalen + 8));
+                frame_head = &recv_cache_[offset];
+
+                zk_DTU_packet_map[frame_head] = datalen + 8;
+                shear_len = offset + datalen + 8;
+                offset = shear_len;
+                TRAFFIC_LIFGT_SERVICE_LOG_INFO << "get trafficlight data";
+            }
+
+        }
+        else
+        {
+            shear_len = offset;
+        }
+    }
+
+    if(zk_DTU_packet_map.size() == 0)
+    {
+        TRAFFIC_LIFGT_SERVICE_LOG_ERROR << "recv invalid overlay package, can't parse any valid frame.";
+        return;
+    }
+
+    for(auto &item : zk_DTU_packet_map)
+    {
+        this->ParseColorState(item.first, item.second);
+    }
+
+    memcpy(recv_cache_, recv_cache_ + shear_len, cache_size_ - shear_len);
+    cache_size_ -= shear_len;
+}
+
+uint16_t zk_DTUParser::zk_DTUCrc16(uint8_t *data, uint32_t data_len)
+{
+    uint16_t crc_in   = 0xFFFF;
+    uint16_t crc_poly = 0x8005;
+    uint8_t one_char  = 0;
+
+    while(data_len--) 
+    {
+        one_char = *(data++);
+        crc_in ^= (one_char << 8);
+
+        for (int i = 0; i < 8; i++) {
+        if (crc_in & 0x8000) 
+        {
+            crc_in = (crc_in << 1) ^ crc_poly;
+        } else 
+        {
+            crc_in = crc_in << 1;
+        }
+        }
+    }
+
+    return crc_in;
+}
+
+uint8_t zk_DTUParser::zk_DTUCrc8(uint8_t *data, uint32_t data_len)
+{
+
+    uint8_t crc = 0; // 初始 CRC 值
+    for (size_t i = 0; i < data_len; i++) 
+    {
+        crc ^= data[i]; // 当前字节与CRC值进行异或
+        for (uint8_t j = 0; j < 8; j++)
+        { // 处理每一个比特
+            if (crc & 0x80) 
+            { // 检查最高位
+                crc = (crc << 1) ^ 0x31; // 左移一位并与多项式异或
+            } else 
+            {
+                crc = crc << 1; // 仅左移一位
+            }
+        }
+    }
+
+    return crc;
+}
