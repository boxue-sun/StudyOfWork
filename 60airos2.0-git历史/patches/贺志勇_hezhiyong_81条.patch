+std::string zk_DTUUtil::Bin2Str(const void *data, const ssize_t len) {
+  std::ostringstream oss;
+  char tmp_hex[3] = {0};
+  uint8_t *p_data = (uint8_t *)data;
+  ssize_t i       = 0;
+  while (i < len) {
+    sprintf(tmp_hex, "%02X", p_data[i++]);
+    oss << tmp_hex;
+  }
+  return oss.str();
+}
+
+void zk_DTUUtil::DbgPrintBinary(
+    const void *data, const ssize_t len, std::string prefix) {
+  TRAFFIC_LIFGT_SERVICE_LOG_WARN << prefix << "(" << len << ")" << zk_DTUUtil::Bin2Str(data, len);
+}
+
+uint64_t zk_DTUUtil::GetCurTimestampMsec() {
+  struct timeval tv;
+  gettimeofday(&tv, NULL);
+
+  return uint64_t(tv.tv_sec * 1000 + tv.tv_usec / 1000);
+}
