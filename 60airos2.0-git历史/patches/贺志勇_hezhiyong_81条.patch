+bool CAMERAEVENT_COMPONENT::tcpinit()
+{
+    afl::net::InetAddress addrUp("0.0.0.0", 40414);
+
+    if (!m_TcpClient)
+    {
+        m_TcpClient = std::unique_ptr<afl::net::TcpClient>(new afl::net::TcpClient(m_Eventloop.get(), addrUp));
+    }
+    m_TcpClient->setConnectionCallback(
+            std::bind(&CAMERAEVENT_COMPONENT::onTcpConnected, this, std::placeholders::_1));
+    m_TcpClient->setMessageCallback(
+            std::bind(&CAMERAEVENT_COMPONENT::onTcpMessage, this, std::placeholders::_2));
+    m_TcpClient->connect();
+    m_TcpClient->enableRetry();
+    return true;
