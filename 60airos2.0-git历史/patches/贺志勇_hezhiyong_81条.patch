+import paramiko
+import time
+
+def ssh_command(host, username, password, command):
+    try:
+        ssh = paramiko.SSHClient()
+        ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
+        ssh.connect(host, username=username, password=password)
+
+        stdin, stdout, stderr = ssh.exec_command(command)
+        result = stdout.read().decode()
+
+        ssh.close()
+    except paramiko.AuthenticationException:
+        print("Authentication failed, please verify your credentials.")
+    except paramiko.SSHException as ssh_exception:
+        print(f"SSH connection failed: {ssh_exception}")
+    except Exception as e:
+        print(f"An unexpected error occurred: {e}")
+
+def download_file(host, username, password, remote_file_path, local_save_path):
+    try:
+        ssh = paramiko.Transport((host, 22))
+        ssh.connect(username=username, password=password)
+
+        sftp = paramiko.SFTPClient.from_transport(ssh)
+        sftp.get(remote_file_path, local_save_path)
+        ssh.close()
+    except paramiko.AuthenticationException:
+        print("Authentication failed, please verify your credentials.")
+    except Exception as e:
+        print(f"An unexpected error occurred: {e}")
+
+if __name__ == "__main__":
+
+    interval = 1
+    host = '127.0.0.1'
+    username = 'root'
+    password = 'cictci@2024'
+    command = 'sudo journalctl -u phc2sys -r -n 10 > /var/ptppartlog.txt'
+
+    while True:
+        ssh_command(host, username, password, command)
+        remote_file_path = '/var/ptppartlog.txt'
+        local_save_path = '/var/ptppartlog.txt'
+        download_file(host, username, password, remote_file_path, local_save_path)
+        time.sleep(interval)
