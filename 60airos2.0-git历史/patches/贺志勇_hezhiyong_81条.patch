+uint8_t zk_DTUParser::transformzk_DTULightType(uint8_t light_type)
+{
+    uint8_t type = 0;
+    switch(light_type)
+    {
+    case 1://左转指示灯
+    case 5: 
+    case 9: 
+    case 13:
+        type = 2;
+        break;
+    case 2://直行指示灯
+    case 6: 
+    case 10: 
+    case 14:
+        type = 1;
+        break;   
+    case 3://右转指示灯
+    case 7: 
+    case 11: 
+    case 15:
+        type = 3;
+        break; 
+    case 4://行人指示灯
+    case 8: 
+    case 12: 
+    case 16:
+        type = 8;
+        break;
+    default:
+        break;   
+    }
+    return type;
+}
+
+uint16_t zk_DTUParser::transformzk_DTUDirection(uint8_t phase_id)
+{
+    uint16_t dir = 0;
+    switch(phase_id)
+    {
+    case 1://进口东
+    case 2: 
+    case 3: 
+    case 4:
+        dir = 90;
+        break;
+    case 5://进口南
+    case 6: 
+    case 7: 
+    case 8:
+        dir = 180;
+        break;   
+    case 9://进口西
+    case 10: 
+    case 11: 
+    case 12:
+        dir = 270;
+        break; 
+    case 13://进口北
+    case 14: 
+    case 15: 
+    case 16:
+        dir = 0;
+        break;
+    default:
+        break;   
+    }
+    return dir;
+}
