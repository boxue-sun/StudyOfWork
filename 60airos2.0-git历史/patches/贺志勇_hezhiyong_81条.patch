+void zk_DTUParser::GetAllCurrPlanStep(std::map<uint8_t, std::vector<zk_DTULightStep>> &curr_plan_step) 
+{
+    std::unique_lock<std::mutex> guard(all_curr_plan_step_mutex_);
+    curr_plan_step.clear();
+    curr_plan_step = all_curr_plan_step_;
+}
+
+void zk_DTUParser::SetAllCurrPlanStep( std::map<uint8_t, std::vector<zk_DTULightStep>> &curr_plan_step)
+{
+    std::unique_lock<std::mutex> guard(all_curr_plan_step_mutex_);
+    all_curr_plan_step_.clear();
+    all_curr_plan_step_ = curr_plan_step;
+}
+
+size_t zk_DTUParser::GetAllCurrPlanStepSize() 
+{
+    std::unique_lock<std::mutex> guard(all_curr_plan_step_mutex_);
+    return all_curr_plan_step_.size();
+}
