+airos::usecase::EventInformation_EventType CICTCIMec::EventTypeTransform(const int type)
+{
+  airos::usecase::EventInformation_EventType event_type;
+
+  switch (type)
+  {
+  case 1:
+    // 交通逆行
+    event_type = airos::usecase::EventInformation_EventType_ANTIDROMIC;
+    break;
+  case 2:
+    // 交通拥堵
+    event_type = airos::usecase::EventInformation_EventType_LANE_CONGESTION;
+    break;
+  case 3:
+    // 道路遗撒
+    event_type = airos::usecase::EventInformation_EventType_FRAGMENT;
+    break;
+  case 4:
+    // 停车
+    event_type = airos::usecase::EventInformation_EventType_ZOMBIES_CAR;
+    break;
+  case 10:
+    // 道路施工
+    event_type = airos::usecase::EventInformation_EventType_REGIONAL_CONSTRUCTION;
+    break;
+  case 11:
+    // 车辆慢行 
+    event_type = airos::usecase::EventInformation_EventType_LOWSPEED;
+    break;
+  case 13:
+    // 异常变道
+    event_type = airos::usecase::EventInformation_EventType_CROSS_SOLID_LINE;
+    break;
+  case 14:
+    // 超速
+    event_type = airos::usecase::EventInformation_EventType_OVERSPEED;
+    break;
+  case 15:
+    // 占用应急车道
+    event_type = airos::usecase::EventInformation_EventType_EMERGENCY_LANE_OCCUPY;
+    break;
+  case 16:
+    // 闯入事件
+    event_type = airos::usecase::EventInformation_EventType_PEOPLE_ENTER;
+    break;
+  case 18:
+    // 行人横穿（弱势交通参与者）
+    event_type = airos::usecase::EventInformation_EventType_PEOPLE_ENTER;
+    break;
+  case 20:
+    // 连续变多道
+    event_type = airos::usecase::EventInformation_EventType_CONTINUOUS_CHANGE_LANE;
+    break;
+  default:
+    // 其他
+    event_type = airos::usecase::EventInformation_EventType_NONE;
+    break;
+  }
+}
