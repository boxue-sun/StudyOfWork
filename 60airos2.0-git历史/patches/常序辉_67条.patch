new file mode 100755
index 0000000..48bba94
--- /dev/null
+++ b/script/log_cycle_script.sh
@@ -0,0 +1,45 @@
+#!/bin/bash
+
+# Check if correct number of arguments are provided
+if [ $# -ne 2 ]; then
+    echo "Usage: $0 <directory_path> <max_files>"
+    exit 1
+fi
+
+TARGET_DIR="$1"
+MAX_FILES="$2"
+
+# Check if the provided directory exists
+if [ ! -d "$TARGET_DIR" ]; then
+    echo "Directory $TARGET_DIR does not exist."
+    exit 1
+fi
+
+# Infinite loop to check and delete old log files
+while true; do
+    # Get all symlink names in the directory
+    symlinks=$(ls -l "$TARGET_DIR" | grep "^l" | awk '{print $9}')
+
+    for symlink in $symlinks; do
+        # Construct the log filename pattern
+        name="${symlink%.INFO}"
+        pattern="${TARGET_DIR}/${name}.log.INFO.*"
+        
+        # Count the number of matching files
+        file_count=$(find "$TARGET_DIR" -maxdepth 1 -name "${name}.log.INFO.*" | wc -l)
+
+        # If file count exceeds the max limit, delete the oldest files
+        if [ "$file_count" -gt "$MAX_FILES" ]; then
+            echo "File count for pattern ${pattern} is $file_count, exceeding the max limit of $MAX_FILES."
+            files_to_delete=$((file_count - MAX_FILES))
+            for file in $(ls -t "$TARGET_DIR/${name}.log.INFO."* | tail -n "$files_to_delete"); do
+                echo "Deleting file: $file"
+                rm "$file"
+            done
+        fi
+    done
+
+    # Sleep for 1 second before checking again
+    sleep 1
+done
+
diff --git a/setup.bash b/setup.bash
