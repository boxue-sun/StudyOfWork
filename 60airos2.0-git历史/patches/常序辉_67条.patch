 mkdir -p ${GLOG_log_dir}
 export GLOG_alsologtostderr=1
 export GLOG_colorlogtostderr=1
-export GLOG_minloglevel=0
+export GLOG_minloglevel=1
+export GLOG_max_log_size=512
+MAX_FILES=5
+
+# start log cycle script
+SCRIPT_NAME="$OUT_DIR/script/log_cycle_script.sh"
+
+# Check if the script file exists
+if [ ! -f "$SCRIPT_NAME" ]; then
+  echo "Script $SCRIPT_NAME does not exist."
+  exit 1
+fi
+
+# Find running instances of log_cycle_script.sh
+pids=$(pgrep -f "$SCRIPT_NAME")
+# Terminate running instances if any
+if [ -n "$pids" ]; then
+    echo "Found running $SCRIPT_NAME with PIDs: $pids"
+    echo "Terminating $SCRIPT_NAME ..."
+    kill $pids
+    echo "$SCRIPT_NAME terminated."
+fi
+# Start a new instance of log_cycle_script.sh
+echo "Starting  $SCRIPT_NAME ..."
+nohup "./$SCRIPT_NAME" "$GLOG_log_dir" "$MAX_FILES" > /dev/null 2>&1 &
+
+echo "$SCRIPT_NAME started."
+
 
 export LD_LIBRARY_PATH=${OUT_DIR}/3rd:$LD_LIBRARY_PATH
 

