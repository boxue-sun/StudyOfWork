+          point_start->mutable_xyz()->set_z(0.0);
+          point_start->mutable_xyz()->set_zone(zone_);
+          info.set_radius(lane.width());
+          affect_paths->emplace_back(info);
+        }
+      }
+    }
+    return true;
+  }
