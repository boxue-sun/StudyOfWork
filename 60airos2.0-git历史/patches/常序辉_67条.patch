+
+        MapFlag(Group& group_, const std::string& name_, const std::string& help_, Matcher&& matcher_, const Map<K, T>& map_, Options options_) : MapFlag(group_, name_, help_, std::move(matcher_), map_, T(), options_)
+        {
+        }
