+import sys
+import time
+
+sys.path.append('/opt/local/cyber-rt/python/cyber/python/cyber_py3')
+sys.path.append('/home/airos/test_tools/proto')
+
+import cyber
+from v2xpb_asn_message_frame_pb2 import MessageFrame
+
+def message_callback(msg):
+    print("=" * 80)
+    print("Message Content (Raw):")
+    print(msg)
+    print("=" * 80)
+
+    msg_obj = MessageFrame()
+    try:
+        msg_obj.ParseFromString(msg)
+        print(msg_obj)
+    except Exception as e:
+        print(f"Failed to parse message: {e}")
+
+
+def subscribe_channel(channel_name):
+    # 初始化 Cyber
+    cyber.init()
+    # 创建节点
+    node = cyber.Node("listener")
+    # 订阅指定频道
+    node.create_rawdata_reader(channel_name, message_callback)
+    # 运行 Cyber
+    node.spin()
+    cyber.shutdown()
+
+if __name__ == '__main__':
+    channel_name = '/airos/message/generated'  # 替换为实际的频道名称
+    subscribe_channel(channel_name)
diff --git a/test_tools/parsed_local.py b/test_tools/parsed_local.py
new file mode 100644
index 0000000..91a017b
--- /dev/null
+++ b/test_tools/parsed_local.py
@@ -0,0 +1,40 @@
+import time
+import sys
+
+sys.path.append('/opt/local/cyber-rt/python/cyber/python/cyber_py3')
+sys.path.append('/home/airos/test_tools/proto')
+
+from record import RecordReader
+from v2xpb_asn_message_frame_pb2 import MessageFrame
+
+def print_message_info(channel_name, msg, datatype, timestamp):
+    print("=" * 80)
+    print(f"Channel Name: {channel_name}")
+    print(f"Timestamp: {timestamp}")
+    print(f"Message Type: {datatype}")
+    print("Message Content (Raw):")
+    print(msg)
+    print("=" * 80)
+
+    # 解析proto部分的内容
+    if datatype == "v2xpb.asn.MessageFrame":
+        msg_obj = MessageFrame()
+        try:
+            msg_obj.ParseFromString(msg)
+            print(msg_obj)
+        except Exception as e:
+            print(f"Failed to parse message: {e}")
+    else:
+        print("Unknown message type")
+
+def read_record_file(file_path):
+
+    reader = RecordReader(file_path)
+
+    print("Starting to read messages...")
+    for channel_name, msg, datatype, timestamp in reader.read_messages():
+        print_message_info(channel_name, msg, datatype, timestamp)
+
+if __name__ == '__main__':
+    record_file_path = '123.record.00000'  # 替换为实际的文件路径
+    read_record_file(record_file_path)
