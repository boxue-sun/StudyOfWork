+  ss << "|cp -rf " << dir_tpe_ << "/perception/perception-camera/.bazel* "
+     << dir;
+  if (system(ss.str().data()) < 0) {
+    std::cout << "cmd false: " << __LINE__;
+    return false;
+  }
+
+  return true;
+}
+bool CreateTemplate::template_lidar_perception(
