+from proto_out.sensor_image_pb2 import CompressedImage #adu.common.sensor.CompressedImage
+from test_data_dicts import *
+
+frame_count = 0
+
+def get_nested_keys(data, parent_key=''):
+    items = {}
+    if isinstance(data, dict):
+        for k, v in data.items():
+            full_key = f"{parent_key}.{k}" if parent_key else k
+            items[full_key] = v
+            items.update(get_nested_keys(v, full_key))  # 递归获取嵌套键
+    elif isinstance(data, list) and data:
+        first_item = data[0]
+        if isinstance(first_item, dict):
+            full_key = f"{parent_key}" if parent_key else ""
+            items.update(get_nested_keys(first_item, full_key))
+        if isinstance(first_item, str):
+            full_key = f"{parent_key}" if parent_key else ""
+            items.update(get_nested_keys(first_item, full_key))
+
+    return items
+
+
+def are_dict_keys_equal(dict1, dict2):
+    items1 = get_nested_keys(dict1)
+    items2 = get_nested_keys(dict2)
+    keys1 = set(items1.keys())
+    keys2 = set(items2.keys())
+    return keys1 == keys2, keys1, keys2
+
+
+def is_sub_set(dict1, dict2):
+    items1 = get_nested_keys(dict1)
+    items2 = get_nested_keys(dict2)
+    set1 = set(items1.keys())
+    set2 = set(items2.keys())
+    if set2.issubset(set1):
+        return True, set1, dict()
+    else:
+        missing_elements = set2 - set1
+        return False, set1, missing_elements
+
+
+def print_message_info(channel_name, msg, datatype, timestamp):
+    print("=" * 80)
+    print(f"Channel Name: {channel_name}")
+    print(f"Timestamp: {timestamp}")
+    print(f"Message Type: {datatype}")
+    print("Message Content (Raw):")
+    print(msg)
+    print("=" * 80)
+
+    # 解析proto部分的内容
+    if datatype == "os.v2x.device.TrafficLightBaseData":
+        msg_obj = TrafficLightBaseData()
+        try:
+            msg_obj.ParseFromString(msg)
+            print(msg_obj)
+        except Exception as e:
+            print(f"Failed to parse message: {e}")
+    else:
+        print("Unknown message type")
+
+def verify_spat(msg):
+    msg_obj = TrafficLightBaseData()
+    try:
+        msg_obj.ParseFromString(msg)
+        # print(msg_obj)
+        tl_dict = MessageToDict(msg_obj)
+        checked_ok, keys1, missingkeys = is_sub_set(tl_dict, spat_check_dict)
+
+        if checked_ok:
+            print("\033[92mspat通过\033[0m")
+        else:
+            print("\033[91mspat缺少：", missingkeys, "\033[0m")
+        return msg_obj
+    except Exception as e:
+        print(f"Failed to parse message: {e}")
+        return str(e)
+    
+
+def verify_rsu_in_out(msg):
+    msg_obj = RSUData()
+    try:
+        msg_obj.ParseFromString(msg)
+        # print(msg_obj)
+        rsu_dict = MessageToDict(msg_obj)
+        checked_ok, keys1, missingkeys = is_sub_set(rsu_dict, rsu_data_check_dict)
+
+        if checked_ok:
+            print("\033[92mrsu data通过\033[0m")
+        else:
+            print("\033[91mrsu data缺少：", missingkeys, "\033[0m")
+        return msg_obj
+    except Exception as e:
+        print(f"Failed to parse message: {e}")
+        return str(e)
+
+def verify_usecase(msg):
+    msg_obj = EventOutputResult()
+    try:
+        msg_obj.ParseFromString(msg)
+        # print(msg_obj)
+        usecase_dict = MessageToDict(msg_obj)
+        checked_ok, keys1, missingkeys = is_sub_set(usecase_dict, use_case_check_dict)
+
+        if checked_ok:
+            print("\033[92musecase 通过，EventType :", usecase_dict["events"][0].get("eventType"),"\033[0m")
+        else:
+            print("\033[91musecase缺少：", missingkeys, "\033[0m")
+        return msg_obj
+    except Exception as e:
+        print(f"Failed to parse message: {e}")
+        return str(e)
+
+def verify_obstacles(msg):
+    msg_obj = PerceptionObstacles()
+    try:
+        msg_obj.ParseFromString(msg)
+        # print(msg_obj)
+        obstacles_dict = MessageToDict(msg_obj)
