+        return msg_obj
+    except Exception as e:
+        print(f"Failed to parse message: {e}")
+        return str(e)
+
+def verify_image(msg):
+    msg_obj = CompressedImage()
+    try:
+        msg_obj.ParseFromString(msg)
+        # print(msg_obj)
+        image_dict = MessageToDict(msg_obj)
+        checked_ok, keys1, missingkeys = is_sub_set(image_dict, image_check_dict)
+
+        if checked_ok:
+            print("\033[92mImage 通过\033[0m")
+        else:
+            print("\033[91mimage缺少：", missingkeys, "\033[0m")
+        return msg_obj
+    except Exception as e:
+        print(f"Failed to parse message: {e}")
+        return str(e)
+
+def read_record_file(file_path, ip:str, channels:list):
+
+    reader = RecordReader(file_path)
+
+    print("Starting to read messages...")
+    for channel_name, msg, datatype, timestamp in reader.read_messages():
+        # print_message_info(channel_name, msg, datatype, timestamp)
+        print("=" * 80)
+        print(f"Channel Name: {channel_name}")
+        print(f"Timestamp: {timestamp}")
+        print(f"Message Type: {datatype}")
+        print("=" * 80)
+        out = ""
+        if channel_name == "/airos/device/rsu_out" and channel_name in channels:
+            if datatype == "os.v2x.device.RSUData":
+                out = verify_rsu_in_out(msg)
+        elif channel_name == '/airos/device/rsu_in'and channel_name in channels:
+            if datatype == "os.v2x.device.RSUData":
+                out = verify_rsu_in_out(msg)
+        elif channel_name == '/v2x/usecase'and channel_name in channels:
+            if datatype == "airos.usecase.EventOutputResult":
+                out = verify_usecase(msg)
+        elif channel_name == '/airos/perception/obstacles'and channel_name in channels:
+            if datatype == "airos.perception.PerceptionObstacles":
+                out = verify_obstacles(msg)
+        elif channel_name == '/v2x/device/radar_out'and channel_name in channels:
+            if datatype == "os.v2x.device.RadarObstacles":
+                out = verify_radar(msg)
+        elif channel_name == '/sensor/ipcamera/h264/' + ip and channel_name in channels:
+            if datatype == "adu.common.sensor.CompressedImage":
+                out = verify_image(msg)
+        elif channel_name == '/airos/device/traffic_light/data'and channel_name in channels:
+            if datatype == "os.v2x.device.TrafficLightBaseData":
+                out = verify_spat(msg)
+
+        # Write tl_dict to a text file
+        with open( record_file_path+'.txt', 'a') as f:
+            if isinstance(out, dict):
+                _dict = MessageToDict(out)
+                f.write("====================================\n")
+                f.write(f"Channel Name: {channel_name}\n")
+                f.write(f"Timestamp: {timestamp}\n")
+                f.write(f"Message Type: {datatype}\n")
+                f.write(f"{_dict}\n")  # Write the dictionary in a readable format
+                f.write("====================================\n")
+            else:
+                f.write("====================================\n")
+                f.write(f"Channel Name: {channel_name}\n")
+                f.write(f"Timestamp: {timestamp}\n")
+                f.write(f"Message Type: {datatype}\n")
+                f.write(f"{out}\n")
+                f.write("====================================\n")
+
+
+        
+
+if __name__ == '__main__':
+    record_file_path = input("请输入record路径:")
+    json_path = "config.json"
+
+    with open(json_path, 'r') as f:
+        item = json.load(f)
+    ip_address  = item['ip']
+    ip = ip_address.replace(".", "_")
+    channel_names = item["channel_name"]
+
+    read_record_file(record_file_path, ip, channel_names)
