diff --git a/test_tools/air_service_proto/airos_perception_obstacle.proto b/test_tools/air_service_proto/airos_perception_obstacle.proto
new file mode 100644
index 0000000..248b125
--- /dev/null
+++ b/test_tools/air_service_proto/airos_perception_obstacle.proto
@@ -0,0 +1,249 @@
+syntax = "proto2";
+package airos.perception;
+
+import "airos_header.proto";
+import "airos_perception_common.proto";
+
+enum PerceptionErrorCode {
+    ERROR_NONE = 0;         // no error
+    ERROR_TF = 1;           // return result error
+    ERROR_PROCESS = 2;      // process error 
+    ERROR_UNKNOWN = 3;      // unknow error
+}
+
+message Point {
+    optional double x = 1;  // in meters.
+    optional double y = 2;  // in meters.
+    optional double z = 3;  // height in meters.
+    optional int32 zone = 4; // UTM zone 
+}
+
+enum SubType {
+    UNKNOWN = 0;
+    UNKNOWN_MOVABLE = 1;
+    UNKNOWN_UNMOVABLE = 2;
+    CAR = 3;
+    VAN = 4;
+    TRUCK = 5;
+    BUS = 6;
+    CYCLIST = 7;
+    MOTORCYCLIST = 8;
+    TRICYCLIST = 9;
+    PEDESTRIAN = 10;
+    TRAFFICCONE = 11;
+    SAFETY_TRIANGLE = 12;
+    BARRIER_DELINEATOR = 13;
+    BARRIER_WATER = 14;
+    MAX_OBJECT_TYPE = 15;
+}
+
+enum OcclusionState {
+    OCC_UNKNOWN = 0;            
+    OCC_NONE_OCCLUDED = 1;          // 无拥堵
+    OCC_PARTIAL_OCCLUDED = 2;       // 部分拥堵
+    OCC_COMPLETE_OCCLUDED = 3;      // 完全拥堵
+}
+
+enum TruncationState {
+    TRUNC_UNKNOWN = 0;
+    TRUNC_TRUE = 1;                 // 有截断
+    TRUNC_FALSE = 2;                // 无阶段
+}
+
+message SensorMeasurement {
+    optional string sensor_id = 1;
+    optional int32 id = 2;
+
+    optional Point position = 3;
+    optional double theta = 4;
+    optional double length = 5;
+    optional double width = 6;
+    optional double height = 7;
+
+    optional Point velocity = 8;
+
+    enum Type {
+        UNKNOWN = 0;
+        UNKNOWN_MOVABLE = 1;
+        UNKNOWN_UNMOVABLE = 2;
+        PEDESTRIAN = 3;  // Pedestrian, usually determined by moving behaviour.
+        BICYCLE = 4;  // bike, motor bike
+        VEHICLE = 5;  // Passenger car or truck.
+    };
+    optional Type type = 9;
+    optional SubType sub_type = 10;
+    optional double timestamp = 11;
+    optional BBox2D box = 12; // only for camera measurements
+    optional bool velocity_converged = 13;
+    optional OcclusionState occ_state_2d = 14 [default = OCC_UNKNOWN];
+    // existance confidence, range [0, 1], default 1.
+    optional float confidence = 15 [default = 1];
+    // whether obj is a parse obj
+    optional bool is_parse_obj = 16 [default = false]; 
+}
+enum MecSourceType
+{
+    MEC_UNKNOWN          =   0;
+    MEC_RSU              =   1;
+    MEC_V2X              =   2;
+    MEC_VIDEO            =   3;
+    MEC_RADAR            =   4;
+    MEC_LOOP             =   5;
+    MEC_LIDAR            =   6;
+    MEC_INTEGRATED       =   7;
+    MEC_MEC              =   8;
+    MEC_BUS_BOARD        =   9;
+    MEC_ATMOSPHERE       =  10;
+}
+enum MecPtcType
+{
+    MEC_PTC_UNKNOWN     = 0;
+    MEC_PTC_MOTOR       = 1;
+    MEC_PTC_NON_MOTOR   = 2;
+    MEC_PTC_PEDESTRIAN  = 3;
+    MEC_PTC_RSU         = 4;
+}
+enum MecVehicleType
+{
+    VEHICLE_TYPE_UNKONWN = 0;
+    VEHICLE_TYPE_AMBULANCE = 1;
+    VEHICLE_TYPE_FIRE_TRUCK = 2;
+    VEHICLE_TYPE_POLICE_CAR = 3;
+    VEHICLE_TYPE_SEDAN = 4;
+    VEHICLE_TYPE_VAN = 5;
+    VEHICLE_TYPE_TRUCK = 6;
+    VEHICLE_TYPE_BUS = 7;
+}
+
+enum MecNonVehicleType
+{
+    NON_VEHICLE_TYPE_UNKONWN = 0;
+    NON_VEHICLE_TYPE_BICYCLE = 1;
+    NON_VEHICLE_TYPE_MOTORCYCLE = 2;
+    NON_VEHICLE_TYPE_TRICYCLE = 3;
+}
+enum MecPlateColorType
+{
+    PLATE_COLOR_TYPE_OTHER = 0;
+    PLATE_COLOR_TYPE_WHITE = 1;
+    PLATE_COLOR_TYPE_BLUE = 2;
+    PLATE_COLOR_TYPE_YELLOW = 3;
+    PLATE_COLOR_TYPE_BLACK = 4;
+    PLATE_COLOR_TYPE_GREEN = 5;
+}
+enum MecObjColorType
+{
+    OBJ_COLOR_TYPE_OTHER = 0;       // 其他
+    OBJ_COLOR_TYPE_WHITE = 1;       // 白色
+    OBJ_COLOR_TYPE_BLUE = 2;        // 蓝色
+    OBJ_COLOR_TYPE_YELLOW = 3;      // 黄色
+    OBJ_COLOR_TYPE_BLACK = 4;       // 黑色
+    OBJ_COLOR_TYPE_GREEN = 5;       // 绿色
+    OBJ_COLOR_TYPE_RED = 6;         // 红色
+    OBJ_COLOR_TYPE_SILVER = 7;      // 银色
+    OBJ_COLOR_TYPE_GRAY = 8;        // 灰色
+    OBJ_COLOR_TYPE_PINK = 9;        // 粉色
+    OBJ_COLOR_TYPE_GOLD = 10;       // 金色
+    OBJ_COLOR_TYPE_ORANGE = 11;     // 橙色
+    OBJ_COLOR_TYPE_PURPLE = 12;     // 紫色
+};
+//地理坐标系
+message MecGCSPoint {
+    optional double lon = 1; // in meters.
+    optional double lat = 2; // in meters.
+    optional double ele = 3; // height in meters.
+}
+
+message PerceptionObstacle {
+    optional int32 id = 1;  // obstacle ID.
+    optional Point position = 2;  // obstacle position in the world coordinate system.
+    optional double theta = 3;  // heading in the world coordinate system.
+    optional double theta_variance = 4;
+    optional Point velocity = 5;  // obstacle velocity.
+
+    // Size of obstacle bounding box.
+    optional double length = 6 [default = 0];  // obstacle length.
+    optional double width = 7 [default = 0];  // obstacle width.
+    optional double height = 8 [default = 0];  // obstacle height.
+
+    repeated Point polygon_point = 9;  // obstacle corner points.
+    optional double tracking_time = 10;  // duration of an obstacle since detection in s.
+
+    enum Type {
+        UNKNOWN = 0;
+        UNKNOWN_MOVABLE = 1;
+        UNKNOWN_UNMOVABLE = 2;
+        PEDESTRIAN = 3;  // Pedestrian, usually determined by moving behaviour.
+        BICYCLE = 4;  // bike, motor bike
+        VEHICLE = 5;  // Passenger car or truck.
+    };
+    optional Type type = 11;  // obstacle type
+
+    optional double timestamp = 12;  // GPS time in seconds.
+
+    // Just for offline debuging, onboard will not fill this field.
+    // Format like : [x0, y0, z0, x1, y1, z1...]
+    repeated double point_cloud = 13 [packed = true];
+
+    // a stable obstacle point in the world coordinate system
+    // position defined above is the obstacle boundingbox ground center
+    optional Point anchor_point = 14;
+
+    // position covariance which is a row-majored 3x3 matrix
+    repeated double position_covariance = 15 [packed = true];
+
+    optional BBox2D bbox2d = 16;                  // 2D 检测框
+    repeated Point  cube_pts8 = 17;               // 8点 3D框
+    optional SubType sub_type = 18;               // 障碍物子类型
+    repeated SensorMeasurement measurements = 19; // sensor measurements
+
+    optional Point acceleration = 20;  // obstacle acceleration.
+    // acceleration covariance which is a row-majored 3x3 matrix
+
+    optional OcclusionState occ_state = 21 [default = OCC_UNKNOWN];
+    optional TruncationState trunc_state = 22 [default = TRUNC_UNKNOWN];
+
+    optional bool velocity_converged = 23 [default = true];
+
+    message TypeProb {
+        optional Type type = 1;
+        optional float prob = 2;
+    }
+
+    message SubTypeProb {
+        optional SubType sub_type = 1;
+        optional float prob = 2;
+    }
+    
+    repeated TypeProb type_probs = 24;
+    repeated SubTypeProb sub_type_probs = 25;
+    optional int32 sub_type_id = 26; // obstacle type id
+    optional double sub_type_id_confidence = 27;
+    ///////////////////////////////////////////////////
+    // add zhangenwei 2024-3-15
+    optional double ptc_speed = 28; //传感器坐标系内车辆速度，单位km/h
+    optional double ptc_heading = 29; //交通参与者航向角，范围为0-360度，正北为0度，顺时针旋转
+    optional MecGCSPoint position_gcs = 30; // obstacle position in the Geographic Coordinate System.
+    optional MecSourceType  source_type = 31;  //SourceType
+    optional MecPtcType     ptc_type = 32;  //ptctype
+    optional string         plate_num = 33;
+    optional MecPlateColorType plate_color  = 34;
+    optional MecObjColorType   obj_color  = 35;
+    optional MecVehicleType    vehicle_type  = 36;
+    optional MecNonVehicleType non_vehicle_type  = 37;
+    optional int32 tracking = 38;
+    optional string id_str = 39;
+    optional int32 lane_no = 40;
+}
+
+enum ShadowType {
+    SHADOW_DYNAMIC = 0;
+    SHADOW_STATIC = 1;
+}
+
+message PerceptionObstacles {
+    repeated PerceptionObstacle perception_obstacle = 1;  // An array of obstacles
+    optional airos.header.Header header = 2;         // Header
+    optional PerceptionErrorCode error_code = 3 [default = ERROR_NONE]; //Error code
+    repeated PerceptionObstacle unobserved_obstacle = 4;
+}
\ No newline at end of file
diff --git a/test_tools/air_service_proto/airos_traffic_light.proto b/test_tools/air_service_proto/airos_traffic_light.proto
new file mode 100644
index 0000000..614b538
--- /dev/null
+++ b/test_tools/air_service_proto/airos_traffic_light.proto
@@ -0,0 +1,117 @@
+syntax = "proto2";
+
+package airos.trafficlight;
+
+enum ControlMode {
+  CTRL_UNKNOWN = 0;           // 未知
+  CENTER = 0x10;              // 中心控制模式
+  CENTER_TIME_TABLE = 0x11;   // 中心日计划控制
+  CENTER_OPTIMIZATION = 0x12; // 中心优化控制
+  CENTER_COORDINATION = 0x13; // 中心协调控制
+  CENTER_ADAPTIVE = 0x14;     // 中心自适应控制
+  CENTER_MANUAL = 0x15;       // 中心手动控制
+  LOCAL = 0x20;               // 本地控制模式
+  LOCAL_FIX_CYCLE = 0x21;     // 本地定周期控制
+  LOCAL_VA = 0x22;            // 本地感应控制
+  LOCAL_COORDINATION = 0x23;  // 本地协调控制
+  LOCAL_ADAPTIVE = 0x24;      // 本地自适应控制
+  LOCAL_MANUAL = 0x25;        // 本地手动控制
+  SPECIAL = 0x30;             // 特殊控制
+  FLASH = 0x31;               // 黄闪控制
+  ALL_RED = 0x32;             // 全红控制
+  ALL_OFF = 0x33;             // 关灯控制
+}
+
+// 灯组类型
+enum LightType {
+  LIGHT_TYPE_UNKNOWN = 0;
+  // 机动车灯组
+  STRAIGHT_DIRECTION = 1; //直行方向指示信号灯（如：箭头灯）
+  LEFT_DIRECTION = 2;     //左转方向指示信号灯（如：箭头灯）
+  RIGHT_DIRECTION = 3;    //右转方向指示信号灯（如：箭头灯）
+  TURN_DIRECTION = 4;     //掉头指示信号灯
+  MOTOR_VEHICLE = 5;      //机动车信号灯（如：圆盘灯）
+  // 非机动车灯组
+  NON_MOTOR_VEHICLE_LEFT = 6;  //左转非机动车信号灯
+  NON_MOTOR_VEHICLE_RIGHT = 7; //右转非机动车信号灯
+  NON_MOTOR_VEHICLE = 8;       //非机动车信号灯
+  // 行人灯组
+  CROSSWALK = 9; //人行横道信号灯
+  // 车道灯组
+  LANE = 10;             //车道信号灯
+  CROSSING = 11;         //道口信号灯
+  FLASHING_WARNING = 12; //闪光警告信号灯
+  // 有轨电车灯组
+  TRAMCAR_STRAIGHT = 13; //有轨电车专用信号灯（直行）
+  TRAMCAR_LEFT = 14;     //有轨电车专用信号灯（左转）
+  TRAMCAR_RIGHT = 15;    //有轨电车专用信号灯（右转）
+}
+
+// 灯组状态
+enum LightState {
+  UNAVAILABLE = 0;
+  DARK = 1;            // 灭灯
+  RED = 2;             // 红灯
+  FLASHING_RED = 3;    // 红闪
+  GREEN = 5;           // 绿灯
+  FLASHING_GREEN = 4;  // 绿闪
+  YELLOW = 6;          // 黄灯
+  FLASHING_YELLOW = 7; // 黄闪
+}
+
+// 信号灯数据源
+enum DataSource {
+  DATA_SRC_UNKNOWN = 0; //未知
+  CCU = 1;              //采集卡
+  SIGNAL = 2;           //信号机
+  VISUAL = 3;           //视觉
+}
+
+enum DeviceWorkState {
+  DEV_NORMAL = 0;  // 正常
+  DEV_OFFLINE = 1; // 离线
+  DEV_FAULT = 2;   // 故障
+}
+
+message OneStepInfo {
+  required LightState light_status = 1; // 灯组状态
+  optional int32 duration = 2;          // 当前步色完整时长
+};
+
+message TrafficLightDeviceInfo {
+  optional string vendor = 1;               // 信号机厂商
+  optional string model = 2;                // 信号机型号
+  optional string software_version = 3;     // 信号机软件/固件版本
+  required DeviceWorkState work_status = 4; // 信号机运行状态
+  required ControlMode control_mode = 5;    // 信号机控制模式
+};
+
+message TrafficLightPhase {
+  required int32 light_id = 1;          // 灯组编号
+  required LightType light_type = 2;    // 灯组类型
+  required LightState light_status = 3; // 灯组当前状态
+  optional int32 count_down = 4;        // 灯组当前状态结束倒计时
+  required bool light_unchanged = 5;    // 灯组当前常亮
+  repeated OneStepInfo step_info_list =
+      6; // 灯组的步色信息（最少3个元素，第1个为当前步色、第2个为下一个步色、第3个为下下个步色）
+  optional int32 right_way_time = 7; // 获得路权时长（周期内可通行时长，周期时长
+                                     // = 路权获得时长 + 路权丢失时长）
+};
+
+message TrafficLightIntersection {
+  repeated TrafficLightPhase phase = 1; // 信号灯上所有灯组的步色信息列表
+  required uint64 time_stamp = 2;      // UNIX时间戳，精确到ms
+  optional int32 period = 3;           // 红绿灯方案总周期（秒数）
+  required DataSource data_source = 4; // 信号灯数据源
+  optional double confidence =
+      5; // 置信度，取值为0和1之间的小数，0代表红绿灯信息完全不准确，1代表红绿灯信息完全准确
+  required TrafficLightDeviceInfo device_info = 6; // 信号灯设备信息
+  repeated bytes original_data_list = 7; // 信号机原始报文帧数据
+}
+
+message TrafficLightServiceData {
+  optional bytes city_code = 1;                        // 城市id
+  optional int32 region_id = 2;                        // 区域id，可选
+  optional int32 cross_id = 3;                         // 路口id
+  optional TrafficLightIntersection traffic_light = 5; // 路口对应的红绿灯信息
+};
\ No newline at end of file
diff --git a/test_tools/air_service_proto/airos_usecase.proto b/test_tools/air_service_proto/airos_usecase.proto
new file mode 100644
index 0000000..4953c3b
--- /dev/null
+++ b/test_tools/air_service_proto/airos_usecase.proto
@@ -0,0 +1,164 @@
+syntax = "proto2";
+package airos.usecase;
+
+// import "air_service/modules/proto/header.proto";
+// import "air_service/modules/proto/perception_obstacle.proto";
+import "airos_header.proto";
+import "airos_perception_obstacle.proto";
+
+message Point {
+    optional double x = 1;  // in meters.
+    optional double y = 2;  // in meters.
+    optional double z = 3;  // height in meters.
+    optional int32 zone = 4; // UTM zone
+}
+
+message Box2D {
+    optional int32 x = 1;  //左上角坐标
+    optional int32 y = 2;
+    optional int32 width = 3;
+    optional int32 height = 4;
+}
+
+
+// 拥堵信息
+message CongestionInfo {
+    // 拥堵类型
+    enum CongestionLevelType { 
+        NONE = 0; 
+        CONGESTION_HEAVY = 1;
+        CONGESTION_MID = 2;
+        CONGESTION_LIGHT = 3;
+        CONGESTION_NONE = 4;
+    }    
+    optional string lane_id = 1;                       // 车道ID
+    optional double congestion_coeff = 2;              // 拥堵系数
+    optional CongestionLevelType congestion_level = 3; // 拥堵等级
+}
+//地理坐标系
+message MecEventGCSPoint {
+    optional double lon = 1; // in meters.
+    optional double lat = 2; // in meters.
+    optional double ele = 3; // height in meters.
+}
+message EventInformation {
+    // 事件类型枚举
+    enum EventType {
+        NONE = 0;                             // 非use_case，防止不使用has判断
+        LANE_CONGESTION = 1;                  // 车道级拥堵
+        ANTIDROMIC = 2;                       // 机动车逆行
+        OVERSPEED = 3;                        // 机动车超速
+        LOWSPEED = 4;                         // 低速
+        REGIONAL_CONSTRUCTION = 5;            // 施工区域
+        TRAFFIC_ACCIDENT = 6;                 // 交通事故
+        ZOMBIES_CAR = 7;                      // 停车占道
+        EMERGENCY_LANE_OCCUPY = 8;            // 应急车道占用
+        CONTINUOUS_CHANGE_LANE = 9;           // 连续车辆变道
+        PEOPLE_ENTER = 10;                    // 行人闯入
+        NONVEHICLE_ENTER = 11;                // 非机动车闯入
+        VEHICLE_RUN_RED_LIGHT = 12;           // 车辆闯红灯
+        VEHICLE_CATCH_RED_LIGHT = 13;         // 车辆抢红灯
+        ILLEGAL_TURN = 14;                    // 不按导向车道行驶
+        PEOPLE_RUN_RED_LIGHT = 15;            // 行人闯红灯
+        NONVEHICLE_RUN_RED_LIGHT = 16;        // 非机动车闯红灯
+        RAMP_ENTER_AFFLUX_MASTER = 17;        // 车在主道汇入
+        RAMP_ENTER_AFFLUX_BRANCH = 18;        // 车在匝道汇入
+        CROSS_SOLID_LINE = 19;                // 实线变道
+        DISRESPECT_PEOPLE = 20;               // 不礼让行人
+        NONVEHICLE_LANE_OCCUPY = 21;          // 占用非机动车道
+        BUS_LANE_OCCUPY = 22;                 // 占用公交车道
+        NONVEHICLE_ANTIDROMIC = 23;           // 非机动车逆行
+        VEHICLE_CATCH_YELLOW_RIGHT = 24;      // 机动车抢黄灯
+        RIGHT_NO_STOP = 25;                   // 右转未停车
+        NONVEHICLE_CARRY_PEOPLE = 26;         // 非机动车载人
+        TAKEOUT_WITHOUT_HEMLT = 27;           // 外卖不带头盔
+        NONVEHICLE_OCCUPY_VEHICLE_LANE = 28;  // 非机动车占用机动车道
+        NO_PLATE = 29;                        // 无车牌
+        PLATE_OCCLUSION = 30;                 // 车牌遮挡
+        VEHICLE_RUN_GREEN_LIGHT = 31;         // 机动车闯绿灯
+        SMALL_TURN = 32;                      // 大弯小转
+        FRAGMENT = 33;                        // 抛洒物
+
+        //车端提醒事件
+        PEOPLE_RUN_RED_C = 101;               // 行人闯红灯(车端提醒)
+        NONVEHICLE_RUN_RED_C = 102;           // 非机动车闯红灯(车端提醒)
+        VEHICLE_RUN_RED_C = 103;              // 机动车闯红灯(车端提醒)
+    };
+    optional EventType event_type = 1;              // 事件类型
+    optional int32 id = 2;                          // 事件ID
+    optional bool stop_flag = 3 [default = false];  // 事件停止标志
+    optional double timestamp = 4;                  // 事件时间戳
+    optional Point location_point = 5;              // 事件发生位置点
+    repeated string sensor_id = 6;                  // 传感器ID
+    optional double start_time = 7;                 // 事件开始时间
+    repeated int32 obstacle_id = 8;                 // 事件对应的感知障碍物集合
+    optional airos.perception.SubType obstacle_type = 9;                   // 事件对应的感知障碍物子类别
+    repeated string lane_id = 10;                   // 事件发生的车道ID
+    optional CongestionInfo congestion_info = 11;   // 拥堵信息
+    repeated Point polygon_point = 12;              // 事件发生区域
+    optional string proof_time = 13;                // 取证时间戳
+    optional int32 event_type_mec = 14 [default = 0]; // MEC的事件类型
+
+    ///////////////////
+    //add zhangenwei
+    optional MecEventGCSPoint position_gcs = 15; // obstacle position in the Geographic Coordinate System.
+    optional double vehicle_length = 16;  // obstacle length.
+    optional double vehicle_width = 17;  // obstacle width.
+    optional double vehicle_height = 18;  // obstacle height.
+    optional string  event_video = 19;  // 事件视频名称，ts格式
+    optional string  event_picture = 20;  // 事件图片名称，jpg格式
+    optional string  plate_num = 21;  // 车牌
+    optional int32  region_no = 22;  // 区域编号，当区域编号为非0时，经纬度位置上报的是区域中心点位置
+    optional string  id_str = 23;  // 事件编号*，ASCII字符串，长度41
+    optional string  obj_id_str = 24;  // 事件触发的交通参与者ID
+}
+//////////////////////////////////////////////////////////////////
+//add zhangenwei 2024-3-15
+enum MecHeartBeatDeviceType
+{
+    HEART_BEAT_TYPE_MEC = 0;
+    HEART_BEAT_TYPE_CAMRA = 1;
+    HEART_BEAT_TYPE_MW_RADAR = 2;
+    HEART_BEAT_TYPE_RADAR = 3;
+};
+enum MecHeartBeatDeviceStatus
+{
+    HEART_BEAT_STATUS_UNKOWN = 0;
+    HEART_BEAT_STATUS_ON = 1;
+    HEART_BEAT_STATUS_OFF = 2;
+};
+message MecDeviceStatusInfo{
+    optional MecHeartBeatDeviceType device_type = 1;
+    optional string device_id = 2;
+    optional MecHeartBeatDeviceStatus status = 3;
+}
+message MecHeartBeat{
+    optional int32 msg_type = 1;
+    optional uint64 time_stamp = 2;
+    repeated MecDeviceStatusInfo device_status_info = 3;
+}
+
+message MecAlarmInfo{
+    optional int32 alarm_level = 1;
+    optional int32 alarm_status = 2;
+    optional uint64 alarm_raised_time = 3;
+    optional uint64 alarm_changed_time = 4;
+    optional string device_id = 5;
+    optional int32 horizontal_offset = 6;
+    optional int32 vertical_offsetset = 7;
+}
+
+message MecAngleOffset{
+    optional int32 msg_type = 1;
+    optional uint64 time_stamp = 2;
+    repeated MecAlarmInfo alarm_info = 3;
+}
+//////////////////////////////////////////////////////////////////
+message EventOutputResult {
+    repeated EventInformation events = 1;                                  // 事件集合
+    repeated airos.perception.PerceptionObstacle perception_obstacle = 2;  // 全量障碍物集合
+    optional airos.header.Header header = 3;                               // 信息头，包括时间戳、帧ID等信息，上游透传
+    optional airos.perception.PerceptionErrorCode perception_error_code = 4 [default = ERROR_NONE]; // 感知错误代码，上游透传
+    optional MecHeartBeat mec_heart_beat = 5;  //add zhangenwei 2024-3-15
+    optional MecAngleOffset mec_angle_offset = 6;  //add zhangenwei 2024-5-15
+}
\ No newline at end of file
diff --git a/test_tools/air_service_proto/airos_visual_traffic_light.proto b/test_tools/air_service_proto/airos_visual_traffic_light.proto
new file mode 100644
index 0000000..a053bfd
--- /dev/null
+++ b/test_tools/air_service_proto/airos_visual_traffic_light.proto
@@ -0,0 +1,178 @@
+syntax = "proto2";
+
+package airos.perception;
+option cc_enable_arenas = true;
+
+import "airos_header.proto";
+import "airos_perception_obstacle.proto";
+
+// 标注
+enum TLTowards {
+    East = 1;   // 该红绿灯位于路口东侧
+    West = 2;
+    North = 3;
+    South = 4;
+    EastNorth = 5;
+    WestNorth = 6;
+    EastSouth = 7;
+    WestSouth = 8;
+}
+message TrafficLight {
+
+    // 标注
+    enum Color {
+        UNKNOWN = 0;
+        RED = 1;
+        YELLOW = 2;
+        GREEN = 3;
+        BLACK = 4;
+    };
+    
+    // 标注
+    enum Direction {
+        NO_TURN = 1;
+        LEFT_TURN = 2;
+        RIGHT_TURN = 3;
+        U_TURN = 4;
+    };
+    
+    // 标注
+    enum Type {
+        LIGHT = 1;
+        DIGITAL = 2;
+        ARROW = 3;
+    };
+
+    enum UseType {
+        UNKN = 0;
+        NORMAL_USE = 1;
+        NO_DRIVE_WAY_USE = 2;
+        PEDESTRIAN_USE = 3;
+    };
+
+    enum OcclusionDegree {
+        NO_OCCLUSION = 0;
+        SLIGHT_OCCLUSION = 1;
+        MEDIUM_OCCLUSION = 2;
+        HIGH_OCCLUSION = 3;
+    };
+
+    enum LightStatusInMap {
+        NORMAL = 0;
+        BROKEN = 1;
+    };
+
+    enum LightSource {
+        FROMLABEL = 0;
+        FROMHDMAP = 1;
+        FROMDET   = 2; 
+    };
+    
+    enum CameraError {
+        NOERR = 0;
+        MOVE = 1;
+        EXTERR = 2;
+    };
+
+    enum TrafficLightType {
+        UNKNOWN_LIGHT = 0;
+        VEHICLE_LIGHT = 1;
+        PED_LIGHT = 2;
+        NONVEHICLE_LIGHT = 3;
+    }
+
+    enum ArrowType {
+        NO_ARROW = 0;
+        LEFT_ARROW = 1;
+        RIGHT_ARROW = 2;
+        UP_ARROW = 3;
+    }
+
+    // Traffic light ID.
+    // 交付
+    optional string trafficlight_id = 1;
+    // 标注
+    optional Type type = 2;
+    // 标注
+    optional Color color = 3;
+    // 标注
+    repeated Direction control_direction = 4;
+    // How confidence about the detected results, between 0 and 1.
+    // 模型
+    optional double confidence = 5 [default = 1.0];
+    // Duration of the traffic light since detected.
+    // 后处理
+    optional double tracking_time = 6;
+    // Is traffic blinking
+    // 后处理
+    optional bool blink = 7;
+    // 待开发
+    optional int32 count_down = 8;
+
+    // 红绿灯框位置
+    optional int32 x = 9;
+    optional int32 y = 10;
+    optional int32 width = 11;
+    optional int32 height = 12;
+
+    // 红绿灯跟踪后灯色
+    optional Color color_tracked = 13;
+
+    // 红绿灯的平均亮度
+    optional int32 mean_bright = 14;
+
+    // 红绿灯遮挡属性及置信度
+    optional OcclusionDegree occlusion_degree = 15;
+    optional double occlusion_confidence = 16 [default = 0.0];
+
+    // 灯框来源
+    optional LightSource source = 17;
+
+    // 相机稳像报警
+    optional CameraError cam_error = 18;
+
+    // 故障属性
+    optional LightStatusInMap is_broken = 19;
+
+    // SN & 相机id
+    optional string sn_cameraid = 20;
+
+    // 灯框在utm坐标系中的3d位置坐标
+    optional Point utm_tlp = 21; //左上角坐标
+    optional Point utm_brp = 22; //右下角坐标     
+
+    // 灯框在camera坐标系中的3d位置坐标
+    optional Point cam_tlp = 23; //左上角坐标
+    optional Point cam_brp = 24; //右下角坐标
+    
+    // 红绿灯在高精地图中的id
+    optional string trafficlightid_inmap = 25;
+
+    // 红绿灯的使用类型
+    optional UseType tl_usetype = 26;
+
+    // 预测的红绿灯类型
+    optional TrafficLightType trafficlight_type = 27;
+
+    // 预测的方向灯的方向
+    optional ArrowType arrow = 28;
+
+    // 预测的红绿灯类型的置信度
+    optional float trafficlight_type_confidence = 29 [default = 0.0];
+
+    // 预测的方向置信度
+    optional float arrow_confidence = 30 [default = 0.0];
+
+}
+
+message TrafficLightByDirection {
+    optional airos.header.Header header = 1;
+    optional TLTowards towards = 2;
+    repeated TrafficLight traffic_light= 3;
+}
+
+message TrafficLightDetection {
+    repeated TrafficLightByDirection traffic_light_by_direction = 1;
+    repeated TrafficLightByDirection traffic_light_by_projection = 2;
+    repeated TrafficLightByDirection traffic_light_by_detection = 3;
+}
diff --git a/test_tools/air_service_proto/header.proto b/test_tools/air_service_proto/header.proto
new file mode 100644
index 0000000..ae9493a
--- /dev/null
+++ b/test_tools/air_service_proto/header.proto
@@ -0,0 +1,44 @@
+package adu.common.header;
+
+message Header {
+  // Message publishing time in seconds. It is recommended to obtain timestamp_sec from
+  // ros::Time::now(), right before calling SerializeToString() and publish().
+  optional double timestamp_sec = 1;
+
+  // Module name.
+  optional string module_name = 2;
+
+  // Sequence number for each message. Each module maintains its own counter for sequence_num,
+  // always starting from 0 on boot.
+  optional uint32 sequence_num = 3;
+
+  // Lidar Sensor timestamp for nano-second.
+  optional uint64 lidar_timestamp = 4;
+
+  // Camera Sensor timestamp for nano-second.
+  optional uint64 camera_timestamp = 5;
+
+  // Radar Sensor timestamp for nano-second.
+  optional uint64 radar_timestamp = 6;
+
+  // Module Start timestamp, shall be consistant with finish timestamp
+  optional double start_time = 7;
+
+  // Module Finish timestamp
+  optional double finish_time = 8;
+
+  // Depended Module ID
+  repeated Module depended_modules = 9;
+
+  // The frame id of message
+  optional string frame_id = 10;
+
+  // The stamp when message is publishing
+  optional uint64 stamp = 11;
+
+}
+
+message Module {
+  optional string module_name = 1;
+  optional uint32 sequence_num = 2;
+}
diff --git a/test_tools/air_service_proto/sensor_image.proto b/test_tools/air_service_proto/sensor_image.proto
new file mode 100644
index 0000000..ca2ab20
--- /dev/null
+++ b/test_tools/air_service_proto/sensor_image.proto
@@ -0,0 +1,92 @@
+syntax = "proto2";
+
+package adu.common.sensor;
+
+import "header.proto"; 
+
+// Encoding of pixels -- channel meaning, ordering, size
+enum PixelFormat {
+    RGB8    = 1001;
+    RGBA8   = 1002;
+    RGB16   = 1003;
+    RGBA16  = 1004;
+    BGR8    = 1005;
+    BGRA8   = 1006;
+    BGR16   = 1007;
+    BGRA16  = 1008;
+    MONO8   = 1009;
+    MONO16  = 1010;
+
