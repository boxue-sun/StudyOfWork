@@ -0,0 +1,69 @@
+import time
+import sys
+
+from proto_out.traffic_light_data_pb2 import TrafficLightBaseData
+
+sys.path.append('/opt/local/cyber-rt/python/cyber/python/cyber_py3')
+from google.protobuf.json_format import MessageToDict
+
+from record import RecordReader
+
+
+def cur_second(time_stamp):
+    import time
+    timestamp_s = time_stamp / 1000
+    current_time = time.localtime(timestamp_s)
+    current_second = current_time.tm_sec
+    current_millisecond = time_stamp % 1000
+
+    return  current_second + current_millisecond / 1000
+
+def traffic_light_callback(msg):
+
+    tl_object = TrafficLightBaseData()
+    try:
+        tl_object.ParseFromString(msg)
+        tl_dict = MessageToDict(tl_object)
+
+        lightInfoList = tl_dict.get("lightInfoList")
+        time_stamp = cur_second(int(tl_dict.get("timeStamp")))
+
+        onelightInfo = str(time_stamp) + " "
+        for li in lightInfoList:
+            _status = "UNAVAILABLE"
+            cur_state = str(li.get("lightStatus"))
+            if cur_state == "DARK":
+                _status = "D"
+            elif cur_state == "RED" or cur_state == "FLASHING_RED":
+                _status = "R"
+            elif cur_state == "GREEN" or cur_state == "FLASHING_GREEN":
+                _status = "G"
+            elif cur_state == "YELLOW" or cur_state == "FLASHING_YELLOW":
+                _status = "Y"
+
+            curInfo = str(li.get("lightId")) + ":" + _status + " " + str(li.get("countDown")) + " "
+            onelightInfo = onelightInfo + curInfo
+
+        print(onelightInfo)
+
+        # Write tl_dict to a text file
+        with open(record_file_path.replace(".record.00000", "")+'traffic_light_data.txt', 'a') as f:
+            f.write(f"{lightInfoList}\n")  # Write the dictionary in a readable format
+
+    except Exception as e:
+        print(f"Failed to parse message: {e}")
+
+def read_record_file(file_path):
+
+    reader = RecordReader(file_path)
+
+    print("Starting to read messages...")
+    for channel_name, msg, datatype, timestamp in reader.read_messages():
+        if channel_name == '/airos/device/traffic_light/data':
+            if datatype == "os.v2x.device.TrafficLightBaseData":
+                traffic_light_callback(msg)
+
+if __name__ == '__main__':
+    record_file_path = input("请输入record路径:")
+    # record_file_path = "20240716164045.record.00000"
+    read_record_file(record_file_path)
