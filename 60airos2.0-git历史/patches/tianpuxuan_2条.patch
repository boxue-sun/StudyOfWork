+        msg_obj.ParseFromString(msg)
+        # print(msg_obj)
+        obstacles_dict = MessageToDict(msg_obj)
+        checked_ok, keys1, missingkeys = is_sub_set(obstacles_dict, radar_check_dict)
+
+        if checked_ok:
+            print("\033[92mRadar 通过\033[0m")
+        else:
