+import subprocess
+import sys
+import time
+
+sys.path.append('/opt/local/cyber-rt/python/cyber/python/cyber_py3')
+sys.path.append('/home/airos/test_tools/proto_out')
+
+import cyber
+from google.protobuf.json_format import MessageToDict
+from header_pb2 import Header #os.v2x.device.RadarObstacles
+from sensor_image_pb2 import CompressedImage #adu.common.sensor.CompressedImage
+
+def proc(rtsp_url, output_file, channel_name):
+    # FFmpeg command to read RTSP stream and write to stdout
+    ffmpeg_command = [
+        'ffmpeg',
+        '-i', rtsp_url,
+        '-c', 'copy',
+        '-f', 'mpegts',
+        'pipe:1'
+    ]
+
+    process = subprocess.Popen(ffmpeg_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+    # 设置帧计数器
+    frame_count = 0
+    # 初始化 Cyber
+    cyber.init()
+    node = cyber.Node("writer")
+    writer = node.create_writer(channel_name, CompressedImage, 10240)
+
+    try:
+        with open(output_file, 'ab') as f:
+            while True:
+                data = process.stdout.read(8192)
+                if not data:
+                    break
+
+                _object = CompressedImage()
+                _object.header.timestamp_sec = time.time()
+                _object.format = "h264"
+                _object.frame_id = str(frame_count % 1024)
+                _object.data = data
+                _object.frame_type = 0
+                _object.exposure_time = 0
+                writer.write(_object)
+                print(_object)
+                f.write(data)
+
+    except KeyboardInterrupt:
+        print("Exiting program...")
+    finally:
+        process.terminate()
+
+if __name__ == '__main__':
+    # RTSP video stream URL
+    channel_name = "/sensor/ipcamera/h264/172_20_65_88"
+    rtsp_url = "rtsp://admin:baidu123@172.20.65.88:554"
+    output_file = "output_video.ts"
+    proc(rtsp_url, output_file, channel_name)
