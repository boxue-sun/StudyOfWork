+size_t GatParser::MakePacketTrafficFlow(uint8_t *frame_addr, int buf_len,
+    const std::vector<CoilFlowData> &coils) {
+  // 帧头(1) + 链路码(2) + 发送方标识(7) + 接收方标识(7) + 时间戳(6) +
+  // 生存时间(1) + 协议版本(1) + 操作类型(1) + 对象标识(2) + 签名标识(1) +
+  // 保留(3) + 消息内容(1+N*10) + CRC(2) + 帧尾(1)
+  const int min_len = 36 + 1 + static_cast<int>(coils.size()) * 10;
+  if (buf_len < min_len) {
+    return 0;
+  }
+
+  size_t offset = 0;
+  // 1. 帧头1B
+  frame_addr[offset++] = 0xC0;
+  // 2. 链路码2B: 除信号机以外的其他路侧交通管控设备
+  frame_addr[offset++] = 0x04;
+  frame_addr[offset++] = 0x00;
+  // 3.1 发送方标识 - 行政区代码3B
+  frame_addr[offset++] = (uint8_t)(kAdministrativeCode & 0xFF);
+  frame_addr[offset++] = (uint8_t)((kAdministrativeCode >> 8) & 0xFF);
+  frame_addr[offset++] = (uint8_t)((kAdministrativeCode >> 16) & 0xFF);
+  // 3.2 发送方标识 - 类型2B: 除信号机以外的其他路侧交通管控设备
+  frame_addr[offset++] = 0x00;
+  frame_addr[offset++] = 0x20;
+  // 3.3 发送方标识 - 编号2B
+  frame_addr[offset++] = 0x01;
+  frame_addr[offset++] = 0x00;
+  // 4.1 接收方标识 - 行政区代码3B
+  frame_addr[offset++] = (uint8_t)(kAdministrativeCode & 0xFF);
+  frame_addr[offset++] = (uint8_t)((kAdministrativeCode >> 8) & 0xFF);
+  frame_addr[offset++] = (uint8_t)((kAdministrativeCode >> 16) & 0xFF);
+  // 4.2 接收方标识 - 类型2B: 信号机
+  frame_addr[offset++] = 0x00;
+  frame_addr[offset++] = 0x10;
+  // 4.3 接收方标识 - 编号2B: 广播
+  frame_addr[offset++] = 0xFF;
+  frame_addr[offset++] = 0xFF;
+  // 5. 时间戳6B: 单位秒
+  const uint32_t cur_time_stamp =
+      uint32_t(GatUtil::GetCurTimestampMsec() / 1000);
+  frame_addr[offset++] = (uint8_t)(cur_time_stamp & 0xFF);
+  frame_addr[offset++] = (uint8_t)((cur_time_stamp >> 8) & 0xFF);
+  frame_addr[offset++] = (uint8_t)((cur_time_stamp >> 16) & 0xFF);
+  frame_addr[offset++] = (uint8_t)((cur_time_stamp >> 24) & 0xFF);
+  frame_addr[offset++] = 0;
+  frame_addr[offset++] = 0;
+  // 6. 生存时间1B
+  frame_addr[offset++] = 0x3C;
+  // 7. 协议版本1B
+  frame_addr[offset++] = 0x10;
+  // 8. 操作类型1B: 主动上报
+  frame_addr[offset++] = 0x82;
+  // 9. 对象标识2B: 0xF102 A13统计数据 (little-endian)
+  frame_addr[offset++] = 0x02;
+  frame_addr[offset++] = 0xF1;
+  // 10. 签名标识1B
+  frame_addr[offset++] = 0;
+  // 11. 保留3B
+  frame_addr[offset++] = 0;
+  frame_addr[offset++] = 0;
+  frame_addr[offset++] = 0;
+  // 12. 消息内容（A.51）: 检测通道数(1B) + 单路统计数据(10B)*N
+  frame_addr[offset++] = static_cast<uint8_t>(coils.size());
+  for (const auto &c : coils) {
+    // A.52 单路检测通道统计数据
+    frame_addr[offset++] = c.coil_no;    // 检测通道编号
+    frame_addr[offset++] = c.volume;     // 流量
+    frame_addr[offset++] = c.occupancy;  // 占有率（单位0.5%）
+    frame_addr[offset++] = c.avg_speed;  // 平均车速（km/h）
+    frame_addr[offset++] = c.avg_length; // 平均车长（0.1m），暂为0
+    frame_addr[offset++] = c.headway;    // 平均车头时距（s）
+    // 保留4B（A.52总计10B，待确认剩余字段）
+    frame_addr[offset++] = c.reserved[0];
+    frame_addr[offset++] = c.reserved[1];
+    frame_addr[offset++] = c.reserved[2];
+    frame_addr[offset++] = c.reserved[3];
+  }
+  // 13. 校验码2B: CRC16
+  const uint16_t crc16 = GatCrc16(frame_addr + 1, offset - 1);
+  frame_addr[offset++] = (uint8_t)(crc16 & 0xFF);
+  frame_addr[offset++] = (uint8_t)((crc16 >> 8) & 0xFF);
+  // 14. 帧尾1B
+  frame_addr[offset++] = 0xC0;
+
+  // 数据转义处理
+  for (size_t i = 1; i < (offset - 1); i++) {
+    if (frame_addr[i] == 0xC0) {
+      memmove(frame_addr + i + 2, frame_addr + i + 1, offset - i - 1);
+      offset++;
+      frame_addr[i]     = 0xDB;
+      frame_addr[i + 1] = 0xDC;
+    } else if (frame_addr[i] == 0xDB) {
+      memmove(frame_addr + i + 2, frame_addr + i + 1, offset - i - 1);
+      offset++;
+      frame_addr[i]     = 0xDB;
+      frame_addr[i + 1] = 0xDD;
+    }
+  }
+
+  return offset;
+}
+
 uint16_t GatParser::BytesToU16(uint8_t *data) {
   return uint16_t(data[0] | (data[1] << 8));
 }
