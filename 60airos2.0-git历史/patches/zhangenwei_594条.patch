+int RADAR_STATIC_COMPONENT::mqttSubscribeMsgArrvd(void *context, char *topicName, int topicLen, MQTTAsync_message *message)
+{
+    int ret = 1;
+    auto thiz = (RADAR_STATIC_COMPONENT *) context;
+    if (message->payloadlen)
+    {
+        std::string topic(topicName, topicLen);
+        std::string topicProfix = topic.substr(0, topic.find("/"));
+        if(thiz->getConfiger().enableDebugPrint)
+        {
+            RADAR_STATIC_ERROR_PRINT << "[notice]ccindex <<<<<<< radar[topic]" << topicName;
+        }
+
+        if(topicProfix == "trafficMetrics" || topic.find("static") == 0 )
+        {
+            afl::base::json j;
+            try
+            {
+                j = afl::base::json::parse((char *) message->payload, (char *) message->payload + message->payloadlen);
+            }
+            catch (...)
+            {
+                RADAR_STATIC_ERROR_PRINT << "[Inter][error]" << "parse json failure!";
+                MQTTAsync_freeMessage(&message);
+                MQTTAsync_free(topicName);
+                return ret;
+            }
+
+            if (topic.size() <= 0)
+            {
+                RADAR_STATIC_ERROR_PRINT << "[Inter][error]topic empty!";
+            }
+            else
+            {
+                //把具体的消息处理放到主线程里，和定时器在一个线程，避免出现两个线程同时修改一个vector/map
+//                thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+//                 {
+//                     thiz->mqttDispatchSubscripeMessage(topic, j);
+//                 });
+                static int message_count_trafficMetrics = 1; // 用于计数的静态变量
+                static int MAX_MESSAGE_COUNT_TAFFIC_METRICS = 1000; // 设置您的最大限制
+
+                // 根据消息计数判断是偶数还是奇数
+                if (message_count_trafficMetrics % 2 == 0) // 偶数
+                {
+                    thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+                                                 {
+                                                     if(thiz->getConfiger().enableDebugPrint)
+                                                     {
+                                                         RADAR_STATIC_ERROR_PRINT << "[notice]process msg in eventloop1";
+                                                     }
+                                                     thiz->mqttDispatchSubscripeMessage(topic, j);
+                                                 });
+                }
+                else // 奇数
+                {
+                    thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+                                                 {
+                                                     if(thiz->getConfiger().enableDebugPrint)
+                                                     {
+                                                         RADAR_STATIC_ERROR_PRINT << "[notice]process msg in eventloop2";
+                                                     }
+                                                     thiz->mqttDispatchSubscripeMessage(topic, j);
+                                                 });
+                }
+                if (message_count_trafficMetrics > MAX_MESSAGE_COUNT_TAFFIC_METRICS)
+                {
+                    message_count_trafficMetrics = 0; // 重置计数器
+                }
+                else
+                {
+                    message_count_trafficMetrics++;
+                }
+
+            }
+        }
+        else
+        {
+
+        }
+    }
+
+    MQTTAsync_freeMessage(&message);
+    MQTTAsync_free(topicName);
+
+    return ret;
+}
