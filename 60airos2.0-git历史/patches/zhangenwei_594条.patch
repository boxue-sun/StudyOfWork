+std::string OM_COMPONENT::transVector2String(std::vector<double> paramV)
+{
+    std::string transValue = "[";
+    int index = 1;
+    for(auto value:paramV)
+    {
+        transValue.append(std::to_string(value));
+        if(index < paramV.size())
+        {
+            transValue.append(",");
+        }
+        index++;
+    }
+    transValue.append("]");
+    return transValue;
+}
