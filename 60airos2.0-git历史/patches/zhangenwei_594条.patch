-bool OM_RADAR_COMPONENT::mqttPublishMsgRetries(std::string topic, std::string payload, std::string hint)
-{
-
-    for (int attempt = 1; attempt <= getConfiger().configerMqtt.mqttPublishMaxRetries; ++attempt)
-    {
-        if (mqttPushStringMsg2Broker(topic, payload, hint))
-        {
-            if(getConfiger().enableDebugPrint)
-            {
-                OM_RADAR_DEBUG_PRINT << "[sucess]Publish success!";
-            }
-            return true;  // 成功发布消息，返回true
-        }
-        else
-        {
-            if(getConfiger().enableDebugPrint)
-            {
-                OM_RADAR_DEBUG_PRINT << "[error] Publish " << hint << " data failed on attempt " << attempt << "!";
-            }
-        }
-    }
-    return false;  // 所有重试均失败，返回false
-}
