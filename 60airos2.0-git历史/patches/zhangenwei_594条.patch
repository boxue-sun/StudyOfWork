+{
+    std::regex versionPattern(R"(v(\d+\.\d+))");
+    std::smatch matches;
+    
+    if (std::regex_search(input, matches, versionPattern)) {
+        return matches[0]; // returns the complete match (e.g., "v3.1")
+    }
+    return ""; // return empty string if no match found
