+bool BS_V2X_BSM_DATA_COMPONENT::Init()
+{
+    doBaiscWork();
+
+    if (m_MqttClientConfig.v2xDataComponentConfiger.asn_version.compare("4layer") == 0)
+    {
+        m_AsnType = EnAsnType::CASE_53_2020;
+    } else if (m_MqttClientConfig.v2xDataComponentConfiger.asn_version.compare("new_4layer") == 0)
+    {
+        m_AsnType = EnAsnType::YDT_3709_2020;
+    } else
+    {
+        // pass
+    }
+    if (!mqttInit())
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<  "[error]mqttInit failure!";
+        }
+
+        return false;
+    }
+;
+    return true;
+}
+
+bool BS_V2X_BSM_DATA_COMPONENT::Proc(const std::shared_ptr<const v2xpb::asn::MessageFrame> &frame)
+{
+    if (!frame)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]frame is nullptr";
+        }
+        return false;
+    }
+    OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[notice]bs_v2x_data <<<<<< message/generated:[channel]";
+    V2xPbAsnMessageFrame2Str(frame);
+    return true;
+}
+
+
+bool BS_V2X_BSM_DATA_COMPONENT::V2xPbAsnMessageFrame2Str(const std::shared_ptr<const v2xpb::asn::MessageFrame> &frame)
+{
+    if (!frame)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]input is nullptr!";
+        }
+        return false;
+    }
+
+    std::string strAsn;
+    string strPb;
+    std::string hint = "sensor-data";
+    std::string asn_json_str;
+    if (!frame->SerializePartialToString(&strPb))
+    {
+        OM_MEC_BS_V2X_BSM_DATA_DEBUG_PRINT << "pb serialize false";
+        return false;
+    }
+    SenarioData senarioData;
+    senarioData.timeStamp =  afl::util::TimeStamp::now(true).millSeconds();
+    senarioData.seqNum = afl::util::Srand::srandStr(32);
+    senarioData.rscuEsn =  m_MqttClientConfig.basicConfiger.rscu_esn;
+    senarioData.subCodes = m_MqttClientConfig.basicConfiger.rscu_esn;
+    senarioData.asn1Data = strAsn;
+    std::string topic;
+    switch ((int)frame->payload_case())
+    {
+        case v2xpb::asn::MessageFrame::PayloadCase::kBsmFrame:
+        {
+            hint = "bsm-json";
+            m_MsgType = MT_BSM;
+            topic = m_MqttClientConfig.v2xDataComponentConfiger.topic_v2x_bsm;
+        }
+        break;
+      
+        default:
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "msg type not support ";
+        break;
+    }
+    pushCommunicationDeviceScenarioReceivingData();
+    pushCommunicationDeviceScenarioTransmissionData();
+    if (0 > message_frame_pbstr2uper_adapter(strPb, &strAsn, m_AsnType))
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]pb to asn false!";
+        return false;
+    }
+    if(!mqttPushMsg2Broker(topic, senarioData, hint))
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[notice][error] push " << hint.c_str() << " failure!";
+    }
+    
+    return true;
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::pushCommunicationDeviceScenarioReceivingData()
+{
+    afl::base::json uploadJson;
+    std::string strAsn;
+    std::string hint = "recv-data";
+    //通信设备场景回执
+    CommunicationDeviceScenarioReceivingData communicationDeviceScenarioReceivingData;
+    communicationDeviceScenarioReceivingData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    communicationDeviceScenarioReceivingData.rscuEsn =  m_MqttClientConfig.basicConfiger.rscu_esn ;
+    communicationDeviceScenarioReceivingData.deviceID =  m_MqttClientConfig.basicConfiger.euht_esn ;
+
+    if(!mqttPushMsg2Broker(m_MqttClientConfig.v2xDataComponentConfiger.topic_scene_recv, communicationDeviceScenarioReceivingData, hint))
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[notice][error] push " << hint.c_str() << " failure!";
+    }
+
+}
+void BS_V2X_BSM_DATA_COMPONENT::pushCommunicationDeviceScenarioTransmissionData()
+{
+    afl::base::json uploadJson;
+    std::string strAsn;
+    std::string hint = "transmission-data";
+    //通信设备场景回执
+    CommunicationDeviceScenarioTransmissionData communicationDeviceScenarioTransmissionData;
+    communicationDeviceScenarioTransmissionData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    communicationDeviceScenarioTransmissionData.rscuEsn =  m_MqttClientConfig.basicConfiger.rscu_esn ;
+    communicationDeviceScenarioTransmissionData.deviceID =  m_MqttClientConfig.basicConfiger.euht_esn ;
+    if(!mqttPushMsg2Broker(m_MqttClientConfig.v2xDataComponentConfiger.topic_scene_brod, communicationDeviceScenarioTransmissionData, hint))
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[notice][error] push " << hint.c_str() << " failure!";
+    }
+
+}
