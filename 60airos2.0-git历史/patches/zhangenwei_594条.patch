+bool BS_V2X_BSM_DATA_COMPONENT::mqttPublishMsg(const std::string &topic, const std::string &msg)
+{
+    if (!m_MqttConnected)
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[error]mqtt connect sucess!";
+        return false;
+    }
+
+    if (msg.size() <= 0 || topic.empty())
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[error]len < 0 or topic empty!";
+        return false;
+    }
+
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    MQTTAsync_message pubmsg = MQTTAsync_message_initializer;
+    int rc;
+
+    opts.context = m_MqttClient;
+    pubmsg.payload = (void *) msg.c_str();
+    pubmsg.payloadlen = msg.length();
+    pubmsg.qos = m_MqttClientConfig.basicConfiger.mqtt_send_qos;
+    pubmsg.retained = 0;
+
+    if ((rc = MQTTAsync_sendMessage(m_MqttClient, topic.c_str(), &pubmsg, &opts)) != MQTTASYNC_SUCCESS)
+    {
+        if (rc == MQTTASYNC_DISCONNECTED)
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]Async connect failure! it will reconnect !";
+            if (m_MqttConnected)
+            {
+                m_MqttConnected = false;
+                mqttReconnect();
+            }
+        }
+        else
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]push msg failure，[error-code]" << rc;
+        }
+
+        return false;
+    }
+
+    return true;
+}
+
+int BS_V2X_BSM_DATA_COMPONENT::mqttSubscribeMsgArrvd(void *context, char *topicName, int topicLen, MQTTAsync_message *message)
+{
+    int ret = 1;
+    auto thiz = (BS_V2X_BSM_DATA_COMPONENT *) context;
+    if (message->payloadlen)
+    {
+
+        afl::base::json j;
+        try
+        {
+            j = afl::base::json::parse((char *) message->payload, (char *) message->payload + message->payloadlen);
+        }
+        catch (...)
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[error]parse json failure!";
+            MQTTAsync_freeMessage(&message);
+            MQTTAsync_free(topicName);
+            return ret;
+        }
+
+        std::string topic(topicName, topicLen);
+        if (topic.size() <= 0)
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[error]topic empty!";
+        } else
+        {
+            //把具体的消息处理放到主线程里，和定时器在一个线程，避免出现两个线程同时修改一个vector/map
+            thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+             {
+                 thiz->mqttDispatchSubscripeMessage(topic, j);
+             });
+        }
+    }
+
+    MQTTAsync_freeMessage(&message);
+    MQTTAsync_free(topicName);
+
+    return ret;
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json &j)
+{
+
+    return;
+}
+
+bool BS_V2X_BSM_DATA_COMPONENT::mqttPushStringMsg2Broker(string topic, string info, string hint)
+{
+    if(!info.empty())
+    {
+        if(!mqttPublishMsg(topic, info))
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]push " << hint.c_str() << "failure!";
+            return false;
+        }
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
+}
+bool BS_V2X_BSM_DATA_COMPONENT::mqttPushJsonMsg2Broker(string topic, json info, string hint)
+{
+    std::string pData;
+    try{
+        pData = info.dump();
+    }catch (json::exception& e){
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+        return false;
+    }
+    if(!pData.empty())
+    {
+        if(!mqttPublishMsg(topic, pData))
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]push " << hint.c_str() << "failure!";
+            return false;
+        }
+    }else
+    {
+        return false;
+    }
+    return true;
+}
