+NAMESPACE_PROTOCOL_THREAD_START
+DeviceStatusMsgDB::DeviceStatusMsgDB(std::string databasePath, std::string tableName) : sqlite_(nullptr),
+                                                                                        tableName_(tableName),
+                                                                                        datebaseName_(databasePath)
+{
+    if(m_CloudServiceConfig.enablePrintParseInfo)
+    {
+        LOG_ERROR << "[DeviceStatusMsgDB]: MsgStatistics init![datebaseName_]%s" << datebaseName_.c_str();
+    }
+
+    // 打开数据库, 当数据库不存在时，自动创建。
+    OpenDB(datebaseName_);
+    // 创建表。如果表已经存在，该函数默认不创建
+    CreatTable(tableName_);
+}
+DeviceStatusMsgDB::~DeviceStatusMsgDB()
+{
+    CloseDB();
+}
+bool DeviceStatusMsgDB::OpenDB(const string &dbPath)
+{
+    int result = sqlite3_open(dbPath.c_str(), &sqlite_);
+    if (result != SQLITE_OK)
+    {
+        if(m_CloudServiceConfig.enablePrintParseInfo)
+        {
+            LOG_ERROR << "[DeviceStatusMsgDB]: Open datebase fail,the datebase path " << dbPath.c_str();
+        }
+        return false;
+    }
+    return false;
+}
+void DeviceStatusMsgDB::CloseDB()
+{
+    if (sqlite_)
+    {
+        sqlite3_close(sqlite_);
+        sqlite_ = nullptr;
+    }
+}
+bool DeviceStatusMsgDB::CreatTable(const string &tableName)
+{
+    std::string sql = "CREATE TABLE IF NOT EXISTS \"" + tableName + "\" ("
+                                                                    "\"TIME_STAMP\" INTEGER, "
+                                                                    "\"DEVICE_TYPE\" INTEGER, "
+                                                                    "\"DEVICE_ID\" TEXT,"
+                                                                    "\"DEVICE_STATUS\" INTEGER"
+                                                                    ")";
+    char *sErrMsg = nullptr;
+    if (sqlite3_exec(sqlite_, sql.c_str(), NULL, NULL, &sErrMsg) != SQLITE_OK)
+    {
+        if(m_CloudServiceConfig.enablePrintParseInfo)
+        {
+            LOG_ERROR << "[MsgStatistics][error]: Creat datebase table " <<  tableName.c_str() << " fail" << sErrMsg;
+        }
+        return false;
+    }
+    sqlite3_free(sErrMsg);
+
+    return true;
+}
+
+
+/**
+* @brief 在表中插入五类消息的统计数据
+*/
+void DeviceStatusMsgDB::InsertDate(MsgDeviceStatus& msgDeviceStatus)
+{
+    if(m_CloudServiceConfig.enablePrintParseInfo)
+    {
+        LOG_ERROR << "[table]" << tableName_.c_str() <<  "[msgDeviceStatus]" << msgDeviceStatus.to_string().c_str();
+    }
+    try{
+        sqlite3_stmt* stmt;
+        std::string sql = "INSERT INTO \"" + tableName_ + "\" (TIME_STAMP, DEVICE_TYPE, DEVICE_ID, DEVICE_STATUS) VALUES (?, ?, ?, ?)";
+        int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, NULL);
+        if (rc == SQLITE_OK)
+        {
+            sqlite3_bind_int64(stmt, 1, msgDeviceStatus.timeStamp);
+            sqlite3_bind_int(stmt, 2, msgDeviceStatus.deviceType);
+            sqlite3_bind_text(stmt, 3, msgDeviceStatus.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+            sqlite3_bind_int(stmt, 4, msgDeviceStatus.deviceStatus);
+            rc = sqlite3_step(stmt);
+            sqlite3_finalize(stmt);
+        }
+    }
+    catch(afl::util::Exception& e)
+    {
+        if(m_CloudServiceConfig.enablePrintParseInfo)
+        {
+            LOG_ERROR << "[error]" << e.what();
+        }
+    };
+
+
+    return;
+}
+bool DeviceStatusMsgDB::insertOrUpdateDeviceStatus(const MsgDeviceStatus& status)
+{
+    try {
+        sqlite3_stmt *stmt;
+        int count = 0;
+        std::string sql = "SELECT COUNT(*) FROM \"" + tableName_ + "\" WHERE DEVICE_ID = ?";
+        int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, nullptr);
+        if (rc == SQLITE_OK) {
+            sqlite3_bind_text(stmt, 1, status.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+            if (sqlite3_step(stmt) == SQLITE_ROW) {
+                count = sqlite3_column_int(stmt, 0);
+            } else {
+                if (m_CloudServiceConfig.enablePrintParseInfo) {
+                    LOG_ERROR << "[MsgStatistics][error]: Check exists fail";
+                }
+                rc = -1;
+                return false;
+            }
+            sqlite3_finalize(stmt);
+        } else {
+            if (m_CloudServiceConfig.enablePrintParseInfo) {
+                LOG_ERROR << "[MsgStatistics][error]: Check exists fail " << rc;
+            }
+            rc = -1;
+            return false;
+        }
+
+        if (count > 0) {
+            if (m_CloudServiceConfig.enablePrintParseInfo) {
+                LOG_ERROR << "[notice]update data, deviceID=" << status.deviceID.c_str();
+            }
+
+            sqlite3_stmt *stmt;
+            std::string sql = "UPDATE \"" + tableName_ +
+                              "\" SET TIME_STAMP = ?, DEVICE_TYPE = ?, DEVICE_STATUS = ? WHERE DEVICE_ID = ?";
+            int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, nullptr);
+            if (rc == SQLITE_OK) {
+                sqlite3_bind_int64(stmt, 1, status.timeStamp);
+                sqlite3_bind_int(stmt, 2, status.deviceType);
+                sqlite3_bind_int(stmt, 3, status.deviceStatus);
+                sqlite3_bind_text(stmt, 4, status.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+
+                rc = sqlite3_step(stmt);
+                if (rc != SQLITE_DONE) {
+                    if (m_CloudServiceConfig.enablePrintParseInfo) {
+                        LOG_ERROR << "[MsgStatistics][error]: Update fail " << rc;
+                    }
+                    rc = -1;
+                    return false;
+                }
+                sqlite3_finalize(stmt);
+            } else {
+                if (m_CloudServiceConfig.enablePrintParseInfo) {
+                    LOG_ERROR << "[MsgStatistics][error]: Update fail " << rc;
+                }
+                rc = -1;
+                return false;
+            }
+        } else {
+            if (m_CloudServiceConfig.enablePrintParseInfo) {
+                LOG_ERROR << "[notice]insert data, deviceID=" << status.deviceID.c_str();
+            }
+            sqlite3_stmt *stmt;
+            std::string sql = "INSERT INTO \"" + tableName_ +
+                              "\" (TIME_STAMP, DEVICE_TYPE, DEVICE_ID, DEVICE_STATUS) VALUES (?, ?, ?, ?)";
+            int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, NULL);
+            if (rc == SQLITE_OK) {
+                sqlite3_bind_int64(stmt, 1, status.timeStamp);
+                sqlite3_bind_int(stmt, 2, status.deviceType);
+                sqlite3_bind_text(stmt, 3, status.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+                sqlite3_bind_int(stmt, 4, status.deviceStatus);
+                rc = sqlite3_step(stmt);
+                sqlite3_finalize(stmt);
+            }
+        }
+    }catch(afl::util::Exception& e)
+    {
+        if(m_CloudServiceConfig.enablePrintParseInfo)
+        {
+            LOG_ERROR << "[error]" << e.what();
+        }
+    };
+
+    return true;
+}
+
+bool DeviceStatusMsgDB::getAllDeviceStatus(std::vector<MsgDeviceStatus>& statusList)
+{
+    try {
+        const char* kColumnNames[] = { "TIME_STAMP", "DEVICE_TYPE", "DEVICE_ID", "DEVICE_STATUS" };
+
+        sqlite3_stmt* stmt;
+        std::string sql = "SELECT ";
+        for (size_t i = 0; i < sizeof(kColumnNames) / sizeof(kColumnNames[0]); ++i)
+        {
+            sql += kColumnNames[i];
+            if (i < sizeof(kColumnNames) / sizeof(kColumnNames[0]) - 1)
+            {
+                sql += ", ";
+            }
+        }
+        sql += " FROM \"" + tableName_ + "\"";
+
+        int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, nullptr);
+        if (rc != SQLITE_OK)
+        {
+            if(m_CloudServiceConfig.enablePrintParseInfo)
+            {
+                LOG_ERROR << "[MsgStatistics][error]: Prepare statement fail " << sqlite3_errmsg(sqlite_);
+            }
+            return false;
+        }
+
+        while ((rc = sqlite3_step(stmt)) == SQLITE_ROW)
+        {
+            MsgDeviceStatus status;
+            for (size_t i = 0; i < sizeof(kColumnNames) / sizeof(kColumnNames[0]); ++i)
+            {
+                switch (sqlite3_column_type(stmt, i))
+                {
+                    case SQLITE_INTEGER:
+                        if (strcmp(kColumnNames[i], "TIME_STAMP") == 0)
+                        {
+                            status.timeStamp = sqlite3_column_int64(stmt, i);
+                        }
+                        else if (strcmp(kColumnNames[i], "DEVICE_TYPE") == 0)
+                        {
+                            status.deviceType = (DEVICE_TYPE_DB)sqlite3_column_int(stmt, i);
+                        }
+                        else if (strcmp(kColumnNames[i], "DEVICE_STATUS") == 0)
+                        {
+                            status.deviceStatus = (DEVICE_STATUS_DB)sqlite3_column_int(stmt, i);
+                        }
+                        else
+                        {
+
+                        }
+                        break;
+                    case SQLITE_TEXT:
+                        if (strcmp(kColumnNames[i], "DEVICE_ID") == 0)
+                        {
+                            status.deviceID = reinterpret_cast<const char*>(sqlite3_column_text(stmt, i));
+                        }
+                        break;
+                    default:
+                        if(m_CloudServiceConfig.enablePrintParseInfo)
+                        {
+                            LOG_ERROR << "[MsgStatistics][error]: Unsupported column type " << sqlite3_column_type(stmt, i) << " for " << kColumnNames[i];
+                        }
+                        break;
+                }
+            }
+            statusList.push_back(status);
+        }
+        sqlite3_finalize(stmt);
+
+        if (rc != SQLITE_DONE)
+        {
+            if(m_CloudServiceConfig.enablePrintParseInfo)
+            {
+                LOG_ERROR << "[MsgStatistics][error]: Error reading data " << sqlite3_errmsg(sqlite_);
+            }
+            return false;
+        }
+    }catch(afl::util::Exception& e)
+    {
+        if(m_CloudServiceConfig.enablePrintParseInfo)
+        {
+            LOG_ERROR << "[error]" << e.what();
+        }
+    };
+    return true;
+}
+
+NAMESPACE_PROTOCOL_THREAD_END
+
