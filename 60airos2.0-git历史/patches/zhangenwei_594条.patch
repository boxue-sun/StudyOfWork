+        ss << std::left << std::setw(40) << "G_Enable_Alarm: " << (Enable_Alarm ? "True" : "False") << "\n";
+        ss << std::left << std::setw(40) << "H_Enable_Keepalive: " << (Enable_Keepalive ? "True" : "False") << "\n";
