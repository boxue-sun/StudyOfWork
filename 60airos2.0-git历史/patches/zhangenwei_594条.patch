+void OM_Mec_COMPONENT::getDiskInfo(DiskInfo &diskInfo)
+{
+    struct statfs diskStatfs;
+
+    statfs("/", &diskStatfs);
+
+    float iTotalCapacity = diskStatfs.f_blocks * (diskStatfs.f_bsize * 1.0 / (1024 * 1024));
+    float iFreeCapacity = diskStatfs.f_bfree * (diskStatfs.f_bsize * 1.0 / (1024 * 1024));
+
+    diskInfo.total = iTotalCapacity;
+    diskInfo.used = iTotalCapacity - iFreeCapacity;
+    diskInfo.free = iFreeCapacity;
+
+    char cmd[] = "iostat -d -k";
+    char bufferDisk[512];
+    float arr[20];
+    char name[20];
+    FILE *pipe = popen(cmd, "r");
+    if (pipe)
+    {
+        if(fgets(bufferDisk, sizeof(bufferDisk), pipe) ==NULL)
+        {
+            ERRORPRINT("fgets error!")
+        }
+        if(fgets(bufferDisk, sizeof(bufferDisk), pipe) ==NULL)
+        {
+            ERRORPRINT("fgets error!")
+        }
+        if(fgets(bufferDisk, sizeof(bufferDisk), pipe) ==NULL)
+        {
+            ERRORPRINT("fgets error!")
+        }
+        if(fgets(bufferDisk, sizeof(bufferDisk), pipe) ==NULL)
+        {
+            ERRORPRINT("fgets error!")
+        }
+        sscanf(bufferDisk, "%s %f %f %f %f %f ", name, &arr[0], &arr[1], &arr[2], &arr[3], &arr[4]);
+        diskInfo.tps = (int) arr[0];
+        diskInfo.write = arr[1];
+        diskInfo.read = arr[2];
+        //printf("%f\n",arr[12]);
+        pclose(pipe);
+    }
+}
+
+void OM_Mec_COMPONENT::getMemInfo(MemInfo &memInfo)
+{
+    FILE *fd1 = fopen("/proc/meminfo", "r");
+    char buff[256];
+    if (fd1 != NULL)
+    {
+        char name[20];
+        unsigned long memTotal = 0;
+        unsigned long memFree = 0;
+        if(fgets(buff, sizeof(buff), fd1) == NULL)
+        {
+            ERRORPRINT("fgets error!")
+        }
+        sscanf(buff, "%s %lu ", name, &memTotal);
+        if(fgets(buff, sizeof(buff), fd1) == NULL)
+        {
+            ERRORPRINT("fgets error!")
+        }
+        sscanf(buff, "%s %lu ", name, &memFree);
+
+        fclose(fd1);
+        memInfo.total = (double) memTotal / 1024.0;
+        memInfo.used = (double) (memTotal - memFree) / 1024.0;
+        memInfo.free = (double) memFree / 1024.0;
+    }
+}
+
+void OM_Mec_COMPONENT::getCpuInfo(CpuInfo &cpuInfo)
+{
+    FILE *fd;
+    char buff[256];
+    CPU_OCCUPY cpu_occupy[8];
+    std::string cpu_use = "";
+
+    fd = fopen("/proc/stat", "r");
+    if (fd != NULL)
+    {
+        if(fgets(buff, sizeof(buff), fd) == NULL)
+        {
+            ERRORPRINT("fgets error")
+        }
+        for (int i = 0; i < 8; i++)
+        {
+            if (fgets(buff, sizeof(buff), fd) != NULL)
+            {
+                if (strstr(buff, "cpu") != NULL)
+                {
+                    sscanf(buff, "%s %u %u %u %u %u %u %u", cpu_occupy[i].name, &cpu_occupy[i].user,
+                           &cpu_occupy[i].nice, &cpu_occupy[i].system, &cpu_occupy[i].idle, &cpu_occupy[i].lowait, &cpu_occupy[i].irq, &cpu_occupy[i].softirq);
+                    if (cpu_use != "")cpu_use += ",";
+                    cpu_use += std::to_string(getCpuUse(&m_OldCpuOccupy[i], &cpu_occupy[i]) * 100) + "%";
+                }
+            }
+        }
+        fclose(fd);
+        cpuInfo.uti = cpu_use;
+    }
+
+    FILE *fd2 = fopen("/proc/loadavg", "r");
+    if (fd2 != NULL)
+    {
+        if (fgets(buff, sizeof(buff), fd2) == NULL)
+        {
+            ERRORPRINT("fgets error")
+        }
+        float a = 0.00;
+        sscanf(buff, "%f", &a);
+        fclose(fd2);
+        cpuInfo.load = a;
+        std::copy(cpu_occupy, cpu_occupy + 8, m_OldCpuOccupy);
+    }
+}
+
+double OM_Mec_COMPONENT::getCpuUse(CPU_OCCUPY *o, CPU_OCCUPY *n)
+{
+    unsigned long od, nd;
+    od = (unsigned long) (o->user + o->nice + o->system + o->idle + o->lowait + o->irq + o->softirq);
+    nd = (unsigned long) (n->user + n->nice + n->system + n->idle + n->lowait + n->irq + n->softirq);
+    double sum = nd - od;
+    double idle = n->idle - o->idle;
+    return (sum - idle) / sum;
+}
