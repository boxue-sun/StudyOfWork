+void CCINDEX_COMPONENT::mqttDispatchSubscripeMessageProto(std::string topic, void* data, int size)
+{
+    for(auto it = m_MqttClientConfig.topicUnMapCCIndex.begin(); it != m_MqttClientConfig.topicUnMapCCIndex.end(); ++it)
+    {
+		const MqttTopicConfigerCCIndex& mqttTopicConfigerCCIndex = it->second;
+		if(topic != mqttTopicConfigerCCIndex.Topic_Tc
+				|| m_MqttClientConfig.configerEnableCCIndex.Enable_Tc)
+		{
+			CCINDEX_ERROR_PRINT << "topic error or Enable_PT_Mec2Clound_Tc enable false";
+		}
+
+		adu::st::TrafficInfos tis;
+		if(!tis.ParseFromArray(data, size))
+		{
+			CCINDEX_ERROR_PRINT << "Recv radar Tc msg but proto parse fail";
+			return;
+		}
+
+		for(int i = 0; i < tis.traffic_info_size(); i++)
+		{
+			auto temp_info = tis.traffic_info().Get(i);
+			if(!temp_info.has_cross_id() || !temp_info.has_branch_id() || !temp_info.has_space_type())
+			{
+				continue;
+			}
+
+			if(temp_info.space_type() == adu::st::TrafficInfo::SpaceType::TrafficInfo_SpaceType_SPACE_FLOW)
+			{
+				if(temp_info.flow_to_type_size() <= 0)
+				{
+					CCINDEX_ERROR_PRINT << "flow type not found";
+					continue;
+				}
+
+				std::string id = temp_info.cross_id() + temp_info.branch_id() + std::to_string((int)temp_info.flow_to_type(0));
+
+				if(temp_info.has_queue_count() && temp_info.has_queue_trans_count() && temp_info.has_queue_length())
+				{
+					radarCreditControlInfo_spatcycle_level rcci;
+					rcci.crossid = temp_info.cross_id();
+					rcci.branchid = temp_info.branch_id();
+					rcci.flowtotype = temp_info.flow_to_type(0);
+					rcci.updatetime = afl::util::TimeStamp::now(true).millSeconds();
+					rcci.queuecount = temp_info.queue_count();
+					rcci.queuetranscount = temp_info.queue_trans_count();
+					rcci.queuelength = temp_info.queue_length();
+
+					m_RecvCreditControlInfo_spatcycle_levelMap[id] = rcci;
+					CCINDEX_ERROR_PRINT << "recv flow level queue_count and queue_length and queue_trans_count";
+				}
+
+
+//				if(temp_info.has_traffic_number() && temp_info.has_traffic_flow())
+//				{
+//					radarCreditControlInfo_5m_level rcci;
+//					rcci.crossid = temp_info.cross_id();
+//					rcci.branchid = temp_info.branch_id();
+//					rcci.flowtotype = temp_info.flow_to_type(0);
+//					rcci.updatetime = afl::util::TimeStamp::now(true).millSeconds();
+//					rcci.trafficnumber = temp_info.traffic_number();
+//					rcci.trafficflow = temp_info.traffic_flow();
+//
+//					m_RecvCreditControlInfo_5m_levelMap[id] = rcci;
+//					ERRORPRINT("recv flow level traffic_number and traffic_flow");
+//				}
+
+
+			}
+			else if(temp_info.space_type() == adu::st::TrafficInfo::SpaceType::TrafficInfo_SpaceType_SPACE_LANE)
+			{
+				if(!temp_info.has_lane_id())
+				{
+					CCINDEX_ERROR_PRINT << "lane id not found";
+					continue;
+				}
+
+				std::string id = temp_info.cross_id() + temp_info.branch_id() + temp_info.lane_id();
+
+				if(temp_info.has_queue_count() && temp_info.has_queue_trans_count())
+				{
+					radarCreditControlInfo_spatcycle_level rcci;
+					rcci.islanelevel = true;
+					rcci.crossid = temp_info.cross_id();
+					rcci.branchid = temp_info.branch_id();
+					rcci.laneid = temp_info.lane_id();
+					rcci.updatetime = afl::util::TimeStamp::now(true).millSeconds();
+					rcci.queuecount = temp_info.queue_count();
+					rcci.queuetranscount = temp_info.queue_trans_count();
+
+					m_RecvCreditControlInfo_spatcycle_levelMap[id] = rcci;
+					CCINDEX_ERROR_PRINT << "recv lane level queue_count and queue_trans_count";
+				}
+
+//				if(temp_info.has_traffic_number() && temp_info.has_traffic_flow())
+//				{
+//					radarCreditControlInfo_5m_level rcci;
+//					rcci.islanelevel = true;
+//					rcci.crossid = temp_info.cross_id();
+//					rcci.branchid = temp_info.branch_id();
+//					rcci.laneid = temp_info.lane_id();
+//					rcci.updatetime = afl::util::TimeStamp::now(true).millSeconds();
+//					rcci.trafficnumber = temp_info.traffic_number();
+//					rcci.trafficflow = temp_info.traffic_flow();
+//
+//					m_RecvCreditControlInfo_5m_levelMap[id] = rcci;
+//					ERRORPRINT("recv lane level traffic_number and traffic_flow");
+//				}
+//
+//				if(temp_info.has_over_flow_occur() && temp_info.has_over_flow_forecast() && temp_info.has_over_flow_grid_lock())
+//				{
+//					radarCreditControlInfo_5s_level rcci;
