+std::string OM_Mec_COMPONENT::calculateMD5(const std::string& filename)
+{
+    std::string command = "md5sum " + filename;
+    FILE* pipe = popen(command.c_str(), "r");
+    if (!pipe)
+    {
+        std::cerr << "Error executing command: " << command << std::endl;
+        return "";
+    }
+
+    char buffer[128];
+    std::stringstream output;
+    while (fgets(buffer, sizeof(buffer), pipe) != NULL)
+    {
+        output << buffer;
+    }
+
+    int exitCode = pclose(pipe);
+    if (exitCode != 0)
+    {
+        std::cerr << "Command failed with exit code: " << exitCode << std::endl;
+        return "";
+    }
+
+    std::string md5 = output.str();
+    size_t spacePos = md5.find(' ');
+    if (spacePos != std::string::npos)
+    {
+        return md5.substr(0, spacePos);
+    }
+    else
+    {
+        return "";
+    }
+}
