+            start_radar_cloud_point_pipeline "${enable_front_flag}"
+            ;;
+        mc)
+            GLOBAL_KILL_DAG_NAME="om_cloud"
+            start_om_cloud_pipeline "${enable_front_flag}"
+            ;;
+        mp)
+            GLOBAL_KILL_DAG_NAME="om_mec_ptp"
+            start_om_mec_ptp_pipeline "${enable_front_flag}"
+            ;;
+        *)
+            echo "Unknown module: ${START_FRONT_MODULE}"
+            print_usage
+            ;;
+    esac
+}
+
+function start_all() {
+    check_run "mainboard -d dag/mec_service.dag"
+    check_run "mainboard -d dag/traffic_light_service.dag"
+    check_run "mainboard -d dag/v2x_codec.dag"
+    check_run "mainboard -d dag/rsu_service.dag"
+    check_run "mainboard -d dag/rsap.dag"
+    check_run "mainboard -d dag/ccindex.dag"
+    # check_run "mainboard -d dag/perception_camera_123.dag"
+    # check_run "mainboard -d dag/msf_component.dag"
+    check_run "./bin/airos_app_framework conf/airos_v2x_app.pb"
+    check_run "mainboard -d dag/om_device_status.dag"
+    check_run "mainboard -d dag/om_radar.dag"
+    check_run "mainboard -d dag/om_camera.dag"
+    check_run "mainboard -d dag/om_cloud.dag"
+    check_run "mainboard -d dag/bs_angle_offset.dag"
+    check_run "mainboard -d dag/bs_spat_src_data.dag"
+    check_run "mainboard -d dag/bs_v2x_data.dag"
+    check_run "mainboard -d dag/bs_v2x_bsm_data.dag"
+    check_run "mainboard -d dag/om_mec.dag"
+    check_run "/home/airos/script/airos_keep_alive.sh"
+    echo '--------------'
+    ps -ef | grep main
+    echo '--------------'
+    ps -ef | grep DianYunRecorder
+    echo '--------------'
+    ps -ef | grep PTPpartlog
+    echo '--------------'
+    ps -ef | grep airos_keep_alive
+    echo '--------------'
+}
+function start_ps() {
+    ps -ef | grep main
+    echo '--------------'
+    ps -ef | grep DianYunRecorder
+    echo '--------------'
+    ps -ef | grep PTPpartlog
+    echo '--------------'
+    ps -ef | grep airos_keep_alive
+    echo '--------------'
+    ps -ef | grep ./bin/airos_app_framework
+    echo '--------------'
+}
+
+function stop_all() {
+#    echo "------------>"
+#    # 定义远程主机的IP地址或主机名
+#    REMOTE_HOST="root@127.0.0.1"  # 替换为实际的用户名和主机名/IP
+#    # 定义要执行的命令
+#    COMMAND="kill -9 `ps -ef|grep mainboard|grep -v grep|awk '{print $2}'`"  # 替换为您想要执行的命令
+#    user_passwd="fuckyou"
+#    # 使用 ssh 登录远程主机并执行命令
+#    sshpass -p ${user_passwd} ssh $REMOTE_HOST $COMMAND
+
+    pkill -f mainboard || true
+    pkill -f airos_app_framework || true
+    pkill -f airos_keep_alive || true
+    pkill -f DianYunRecorder || true
+    pkill -f PTPpartlog || true
+}
+
+function print_usage() {
+  echo "Usage: airos_launch [OPTIONS]"
+  echo "Description: This is a tool script for launch airos pipeline."
+  echo
+  echo "Options:"
+  echo "  -h                      Display this help message."
+  echo "  camera_viz              Start perception camera viz."
+  echo "  fusion_viz              Start fusion viz."
+  echo "  perception              Start perception pipeline."
+  echo "  traffic_light           Start traffic light pipeline."
+  echo "  lidar                   Start lidar perception."
+  echo "  mec                     Start [public]mec pipeline."
+  echo "  rsap                    Start protocol-1 pipeline."
+  echo "  ccindex                 Start protocol-2 pipeline."
+  echo "  angle                   Start protocol-5 [bs]angle offset pipeline."
+  echo "  signal                  Start protocol-5 [bs]signal pipeline."
+  echo "  v2xdata                 Start protocol-5 [bs]V2X data pipeline."
+  echo "  v2x_bsm_data            Start protocol-5 [bs]V2X Bsm data pipeline."
+  echo "  om_camera               Start protocol-5 [om]OM camera pipeline."
+  echo "  om_radar                Start protocol-5 [om]OM radar pipeline."
+  echo "  om_mec                  Start protocol-5 [om]OM MEC pipeline."
+  echo "  om_device_status        Start [pulibc]device status into seqlite3 pipeline."
+  echo "  radar_cloud_point       Start radar cloud point pipeline."
+  echo "  kill                    Start kill dag pipeline."
+  echo "  ps                      Check the status of pipelines."
+  echo "  all                     Start airos all pipeline."
+  echo "  stop                    Stop all pipeline."
+  echo "  sf                      Start pipeline front."
+  echo "      tl                  Start [traffic light] pipeline front."
+  echo "      mi                  Start [mec] pipeline front."
+  echo "      rp                  Start [rsap] pipeline front."
+  echo "      cc                  Start [ccindex]       pipeline front."
+  echo "      ba                  Start [angle]         pipeline front."
+  echo "      bs                  Start [signal]        pipeline front."
+  echo "      bv                  Start [v2xdata]       pipeline front."
+  echo "      bb                  Start [v2x_bsm_data]  pipeline front."
+  echo "      oc                  Start [om_camera]     pipeline front."
+  echo "      or                  Start [om_radar]      pipeline front."
+  echo "      om                  Start [om_mec]        pipeline front."
+  echo "      od                  Start [om_device_status]    pipeline front."
+  echo "      mc                  Start [om_cloud]            pipeline front."
+  echo "      rc                  Start [radar_cloud_point]   pipeline front."
+  echo "      mp                  Start [om_mec_ptp]   pipeline front."
+  echo
+}
+function release_package()
+{
+   bash /home/airos/build_airos.sh release
+}
+function tar_package()
+{
+   bash /home/airos/build_airos.sh pack
+}
+function main() {
+    if [ "$#" -eq 0 ]; then
+        print_usage
+        exit 0;
+    fi
+    case "$1" in
+        "camera_viz" | "fusion_viz" | "perception" | "traffic_light" | "lidar" | "mec" | "rsap" | \
+        "ccindex" | "angle" | "signal" | "v2xdata" | "v2x_bsm_data" | "om_camera" | "om_radar" | "om_mec" | \
+        "om_device_status" | "radar_cloud_point" | "all" | "stop" | "release")
+            stop_all
+            ;;
+    esac
+    cd /home/airos/os
+    source setup.bash
+
+    local cmd="$1"
+    GLOBAL_KILL_DAG_NAME="$2"
+    START_FRONT_MODULE="$2"
+    shift
+    case "${cmd}" in
+        camera_viz)
+            start_camera_viz
+            ;;
+        fusion_viz)
+            start_fusion_viz
+            ;;
+        perception)
+            start_perception_pipeline
+            ;;
+        traffic_light)
+            start_traffic_light_pipeline
+            ;;
+        lidar)
+            start_perception_lidar
+            ;;
+        mec)
+            start_mec_pipeline
+            ;;
+        rsap)
+            start_rsap_pipeline
+            ;;
+        ccindex)
+            start_ccindex_pipeline
+            ;;
+        angle)
+              start_angle_offset_pipeline
+              ;;
+        signal)
+              start_signal_pipeline
+              ;;
+        v2xdata)
+              start_v2xdata_pipeline
+              ;;
+        v2x_bsm_data)
+              start_v2x_bsm_data_pipeline
+              ;;
+        om_camera)
+              start_om_camera_pipeline
+              ;;
+        om_radar)
+              start_om_radar_pipeline
+              ;;
+        om_mec)
+              start_om_mec_pipeline
+              ;;
+        om_mec_ptp)
+              start_om_mec_ptp_pipeline
+              ;;
+        om_cloud)
+            start_om_cloud_pipeline
+            ;;
+        om_device_status)
+              start_om_device_status_pipeline
+              ;;
+        radar_cloud_point)
+              start_radar_cloud_point_pipeline
+              ;;
+        sf)
+          #前台启动
+              start_module_front_pipeline;
+              ;;
+        kill)
+              start_kill_dag_pipeline
+              ;;
+        ps)
+              start_ps
+              ;;
+        all)
+            start_all
+            ;;
+        stop)
+            echo "all stop!"
+            ;;
+        *)
+            print_usage
+            ;;
+    esac
+}
+
+main "$@"
