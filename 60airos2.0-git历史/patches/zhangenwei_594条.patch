+ bool CCINDEX_COMPONENT::monitorMqttConnectStatus()
+{
+    bool mqttConnected = false;
+    bool mqttConnectedCloud = false;
+    if (MQTTAsync_isConnected(m_MqttClient))
+    {
+        RADAR_MQTT_DEBUG_PRINT << "[success]Connection is still active";
+        mqttConnected = true;
+    }
+    else
+    {
+        RADAR_MQTT_DEBUG_PRINT  << "[error]Connection is lost";
+        mqttConnected = false;
+    }
+    if (MQTTAsync_isConnected(m_MqttClientCloud))
+    {
+        RADAR_MQTT_DEBUG_PRINT << "[cloud][success]Connection is still active";
+        mqttConnectedCloud = true;
+    }
+    else
+    {
+        RADAR_MQTT_DEBUG_PRINT  << "[cloud][error]Connection is lost";
+        mqttConnectedCloud = false;
+    }
+
+    if(!mqttConnectedCloud) {
+        if (m_MqttClientCloud) {
+            RADAR_MQTT_DEBUG_PRINT << "[cloud][error]Connection is lost, reconnect cloud!";
+            mqttReconnectCloud();
+        }
+    }
+    if(!mqttConnected)
+    {
+        if(m_MqttClient)
+        {
+            RADAR_MQTT_DEBUG_PRINT  << "[cloud][error]Connection is lost, reconnect cloud!";
+            mqttReconnect();
+        }
+    }
+
+}
