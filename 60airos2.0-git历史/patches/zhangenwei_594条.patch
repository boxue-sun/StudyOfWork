+    rsapMsgHeader.DataType = RCU2CLOUD_HEARTBEAT;
+    rsapMsgHeader.Version = 0x01;
+
+    uint64_t nowMillSeconds = afl::util::TimeStamp::now(true).millSeconds();
+    rsapMsgHeader.TimestampMS = (nowMillSeconds - (getCurrentYearStartSeconds() * 1000)) % (1000 * 60);
+    rsapMsgHeader.TimestampMIN = (nowMillSeconds - (getCurrentYearStartSeconds() * 1000)) / (1000 * 60);
