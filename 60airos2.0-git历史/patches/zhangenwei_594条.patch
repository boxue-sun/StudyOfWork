+bool RADAR_TRAFFIC_METRICS_COMPONENT::mqttPushStringMsg2Broker(string topic, string info, string hint)
+{
+    if(!info.empty())
+    {
+        if(!mqttPublishMsg(topic, info))
+        {
+            RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error]push " << hint.c_str() << " failure!";
+            return false;
+        }
+
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
+}
+bool RADAR_TRAFFIC_METRICS_COMPONENT::mqttPushJsonMsg2Broker(string topic, json info, string hint)
+{
+    std::string pData;
+    try{
+        pData = info.dump();
+    }
+    catch (json::exception& e)
+    {
+        RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+        return false;
+    }
+    if(!pData.empty())
+    {
+        if(getConfiger().enableDebugPrint)
+        {
+            RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[notice]ccindex >>>>> cloud [topic]" << topic  << "[data]" << std::endl << pData;
+        }
+        if(!mqttPublishMsg(topic, pData))
+        {
+            RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error]push " << hint.c_str() << " failure!";
+            return false;
+        }
+    }else
+    {
+        return false;
+    }
+    return true;
+}
