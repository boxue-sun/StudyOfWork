+void OM_RADAR_COMPONENT::mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json & subScribeJson)
+{
+    if (!m_MqttConnected)
+    {
+        ERRORPRINT("[error]mqtt clinet has not connected!");
+        return;
+    }
+
+    if (topic.empty())
+    {
+        ERRORPRINT("topic empty!")
+        return;
+    }
+    std::string hint;
+    std::string topicPT;
+
+    bool hasFindFlag = false;
+    for (auto it = m_MqttClientConfig.topicUnMapOmRadar.begin(); it != m_MqttClientConfig.topicUnMapOmRadar.end(); ++it)
+    {
+        const MqttTopicConfigerOmRadar& mqttTopicConfigerOmRadarTemp = it->second;
+        if(topic == mqttTopicConfigerOmRadarTemp.Topic_Heartbeat && m_MqttClientConfig.configerEnableOmRadar.Enable_Heartbeat)
+        {
+            hint = "心跳";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Heartbeat;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Query_Log_Ack && m_MqttClientConfig.configerEnableOmRadar.Enable_Query_Log_Ack)
+        {
+            hint = "日志查询响应";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Query_Log_Ack;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Query_Config_Ack && m_MqttClientConfig.configerEnableOmRadar.Enable_Query_Config_Ack)
+        {
+            hint = "配置查询响应";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Query_Config_Ack;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Update_Config_Ack && m_MqttClientConfig.configerEnableOmRadar.Enable_Update_Config_Ack)
+        {
+            hint = "配置修改确认";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Update_Config_Ack;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Runstatus && m_MqttClientConfig.configerEnableOmRadar.Enable_Runstatus)
+        {
+            hint = "性能";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Runstatus;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Warning && m_MqttClientConfig.configerEnableOmRadar.Enable_Warning)
+        {
+            hint = "告警";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Warning;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Ota_ACK && m_MqttClientConfig.configerEnableOmRadar.Enable_Ota_ACK)
+        {
+            hint = "远程升级响应";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Ota_ACK;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Reboot_Ack && m_MqttClientConfig.configerEnableOmRadar.Enable_Reboot_Ack)
+        {
+            hint = "远程重启响应";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Reboot_Ack;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Restore_ACK && m_MqttClientConfig.configerEnableOmRadar.Enable_Restore_ACK)
+        {
+            hint = "远程恢复响应";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Restore_ACK;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Register && m_MqttClientConfig.configerEnableOmRadar.Enable_Register)
+        {
+            hint = "设备注册";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Register;
+            hasFindFlag = true;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Synchronize && m_MqttClientConfig.configerEnableOmRadar.Enable_Synchronize)
+        {
+            hint = "设备授时";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Synchronize;
+            hasFindFlag = true;
+        }
+        else
+        {
+            hint = "";
+            topicPT = "";
+        }
+    }
+    for (auto it = m_MqttClientConfig.topicUnMapCCIndex.begin(); it != m_MqttClientConfig.topicUnMapCCIndex.end(); ++it)
+    {
+        const MqttTopicConfigerCCIndex& mqttTopicConfigerCCIndex = it->second;
+
+        if(topic == mqttTopicConfigerCCIndex.Topic_Tc && m_MqttClientConfig.configerEnableCCIndex.Enable_Tc)
+        {
+            hint = "V2X信控指标";
+            topicPT = mqttTopicConfigerCCIndex.Topic_Tc;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_Trajectories && m_MqttClientConfig.configerEnableCCIndex.Enable_Trajectories)
+        {
+            hint = "实时轨迹数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_Trajectories;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_VehiclePass && m_MqttClientConfig.configerEnableCCIndex.Enable_VehiclePass)
+        {
+            hint = "实时过车数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_VehiclePass;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_QueueUp
+                && m_MqttClientConfig.configerEnableCCIndex.Enable_QueueUp)
+        {
+            hint = "实时排队数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_QueueUp;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_AreaState
+                && m_MqttClientConfig.configerEnableCCIndex.Enable_AreaState)
+        {
+            hint = "实时区域状态数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_AreaState;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_Overflow
+                && m_MqttClientConfig.configerEnableCCIndex.Enable_Overflow)
+        {
+            hint = "实时溢出数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_Overflow;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_Outlane
+                && m_MqttClientConfig.configerEnableCCIndex.Enable_Outlane)
+        {
+            hint = "实时出口通道数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_Outlane;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_Statistics
+                && m_MqttClientConfig.configerEnableCCIndex.Enable_Statistics)
+        {
+            hint = "定时统计数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_Statistics;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_Evaluations
+                && m_MqttClientConfig.configerEnableCCIndex.Enable_Evaluations)
+        {
+            hint = "定时评价数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_Evaluations;
+        }
+        else if(topic == mqttTopicConfigerCCIndex.Topic_Nonmotor
+                && m_MqttClientConfig.configerEnableCCIndex.Enable_Nonmotor)
+        {
+            hint = "定时行人及非机动车数据";
+            topicPT = mqttTopicConfigerCCIndex.Topic_Nonmotor;
+        }
+        else
+        {
+            hint = "主题为空";
+            topicPT = "";
+        }
+    }
+
+    if(!topicPT.empty())
+    {
+        auto cloud_data = std::make_shared<os::v2x::device::CloudData>();
+        auto mqtt_data  = cloud_data->mutable_mqtt_data();
+        mqtt_data->set_topic(topicPT);
+        std::string msg = subScribeJson.dump();
+        mqtt_data->set_data(msg.data(), msg.size());
+        LOG_ERROR << "msg:" << cloud_data->DebugString();
+        Send("/v2x/cloud/report/mqtt", cloud_data);
+    }
+
+    return;
+}
