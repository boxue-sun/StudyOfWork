+	int queuetranscount;//排队数（当量数）
+	int queuelength;//排队长度
+};
+
+class CCINDEX_COMPONENT : public airos::middleware::ComponentAdapter<os::v2x::device::CloudData>
+        , public Configurable<MqttClientConfigerIndex>
+{
+public:
+    CCINDEX_COMPONENT() : Configurable<MqttClientConfigerIndex>(MODULE_NAME, MODULE_CONFIG_DIR, MODULE_CFG_NAME){};
