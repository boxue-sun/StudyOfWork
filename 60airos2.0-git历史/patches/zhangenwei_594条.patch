+
+/**
+ * @brief 写完成回调函数类型
+ * @param conn TCP连接智能指针
+*/
+typedef std::function<void (const TcpConnectionPtr&)> WriteCompleteCallback;
+
+/**
+ * @brief 消息回调函数类型
+ * @param conn TCP连接智能指针
+ * @param buffer 消息缓冲区
