+bool RADAR_CLOUD_COMPONENT::Init()
+{
+    if(!m_HasSendOnce)
+    {
+        Send("/v2x/cloud/message", m_CloudDataPtr);
+        m_HasSendOnce = true;
+    }
+
+    m_Task.reset(new std::thread([&](){ initEventLoop(); }));
+    m_TaskProcessTc.reset(new std::thread([&](){ processTcChannelData(); }));
+    m_TaskTrafficMetrics.reset(new std::thread([&](){ processTrafficMetricsChannelData(); }));
+    doBaiscWork();
+    return true;
+}
+bool RADAR_CLOUD_COMPONENT::initEventLoop()
+{
+    m_Eventloop = std::make_shared<afl::net::EventLoop>();
+    m_Eventloop->loop();
+    return true;
+}
+bool RADAR_CLOUD_COMPONENT::processTcChannelData()
+{
+    auto reader = node_->CreateReader<os::v2x::device::CloudData>(
+            "/v2x/cloud/report/radar_tc",
+            std::bind(&RADAR_CLOUD_COMPONENT::processTcChannelDataImpl, this, std::placeholders::_1));
+    return true;
+}
+bool RADAR_CLOUD_COMPONENT::processTrafficMetricsChannelData()
+{
+    auto reader = node_->CreateReader<os::v2x::device::CloudData>(
+            "/v2x/cloud/report/radar_traffic_metrics",
+            std::bind(&RADAR_CLOUD_COMPONENT::processTrafficMetricsChannelDataImpl, this, std::placeholders::_1));
+    return true;
+}
