+std::size_t curlWriteCallback(char *ptr, std::size_t size, std::size_t nmemb, void *userdata)
+{
+    ((std::string*) userdata)->append(ptr, nmemb);
+    return nmemb * size;
+}
+
+void OM_Mec_COMPONENT::threadDownloadOtaFile(void* context, OTAUpdateDownData &otaUpdateDownData)
+{
+    struct curl_slist *headers = NULL;
+    std::string httpQueryResponseStr;
+    OTAUpdateDownData otaUpdateDownDataTemp = otaUpdateDownData;
+    /* set ignore the user cert file*/
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_SSL_VERIFYPEER, 0);
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_SSL_VERIFYHOST, 0);
+
+    /* set http request method as post and set post data*/
+    //	curl_easy_setopt(m_HttpHandle, CURLOPT_POST, 1);
+
+    /* set the timeout of request and the version*/
+
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_NOSIGNAL, 1);
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_CONNECTTIMEOUT, 30);
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_TIMEOUT, 90);
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_VERBOSE, 1);
+
+    /* enable TCP keep-alive for this transfer */
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_TCP_KEEPALIVE, 1L);
+    /* keep-alive idle time to 120 seconds */
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_TCP_KEEPIDLE, 120L);
+    /* interval time between keep-alive probes: 60 seconds */
+    curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_TCP_KEEPINTVL, 60L);
+    if (m_DownloadHttpHandle)
+    {
+
+        curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_WRITEFUNCTION, curlWriteCallback);
+        curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_WRITEDATA, (void* )&httpQueryResponseStr);
+        //循环重试10次,1s时间
+        for (int loop = 0; loop < 3; loop++)
+        {
+            headers = curl_slist_append(headers, "Content-Type: application/json");
+            curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_HTTPHEADER, headers);
+            std::string authUrl = otaUpdateDownData.downloadUrl;
+            DEBUGPRINT( "[authenticationProFix]%s", authUrl.c_str());
+            curl_easy_setopt(m_DownloadHttpHandle, CURLOPT_URL, authUrl.c_str());
+
+            m_DownloadRepCode = curl_easy_perform(m_DownloadHttpHandle);
+            if (CURLE_OK == m_DownloadRepCode)
+            {
+                break;
+            }
+            else
+            {
+                usleep(10000L);
+            }
+        }
+
+        if(CURLE_OK != m_DownloadRepCode)
+        {
+            DEBUGPRINT("curl_easy_perform() failed : %s!!!", curl_easy_strerror(m_DownloadRepCode));
+
+            //对返回值进行判断
+            if(400 == m_DownloadRepCode)
+            {
+                ERRORPRINT("[error]参数异常！");
+            }
+            else if(403 == m_DownloadRepCode)
+            {
+                ERRORPRINT("[error]鉴权失败!");
+            }
+            else if(500 == m_DownloadRepCode)
+            {
+                ERRORPRINT("[error]服务器内部错误！");
+            }
+            else
+            {
+                ERRORPRINT("[error]get response message failure！the response-code: [%d]", m_DownloadRepCode);
+            }
+
+            curl_easy_cleanup(m_DownloadHttpHandle);
+            httpQueryResponseStr.clear();
+
+            std::unique_lock<std::mutex> locker(m_MutexDownload);
+            m_IsGetDownResponseSucess = false;
+            locker.unlock();
+            return;
+        }
+        else
+        {
+            //tls -file
+            std::string downloadBinRootPath =  m_MqttClientConfig.configerProjectPath.projectRoot
+                                               + "/" +  m_MqttClientConfig.configerProjectPath.binDirName;
+            std::string binFilePath = downloadBinRootPath + "/" + m_MqttClientConfig.configerProjectPath.downloadFileName;
+            if (!afl::FileUtil::isDirectory(downloadBinRootPath.c_str()))
+            {
+                afl::FileUtil::createRecursionDir(binFilePath.c_str());
+                DEBUGPRINT("[notice][the dir of storing ca`s file not exist, so we will create the dir of  [%s]！", downloadBinRootPath.c_str());
+            }
+            else
+            {
+                DEBUGPRINT("[notice][ the dir of storing  [%s] has exist!]", downloadBinRootPath.c_str());
+
+                if(!afl::FileUtil::isFileExist(binFilePath.c_str()))
+                {
+                    DEBUGPRINT("[notice]ca file not exist!");
+                }
+                else
+                {
+                    DEBUGPRINT("[notice] beacase ca file has exist, we will delete this file! ");
+                    //先 delete ，后 delete module.cfg中 map 信息，再创建 file
+                    if(-1 == remove(binFilePath.c_str()))
+                    {
+                        DEBUGPRINT("[error] delete ca file failure!");
+                    }
+                    else
+                    {
+                        DEBUGPRINT("[sucess]sucess  delete ca file !");
+                    }
+                }
+                std::fstream m(binFilePath, std::ios::out);
+                m << httpQueryResponseStr;
+                m.close();
+                DEBUGPRINT("[sucess]store ca`s file !");
+                std::unique_lock<std::mutex> locker(m_MutexDownload);
+                m_IsGetDownResponseSucess = true;
+                locker.unlock();
+            }
+        }
+    }
+}
+/**
+ * @func: 心跳信息
