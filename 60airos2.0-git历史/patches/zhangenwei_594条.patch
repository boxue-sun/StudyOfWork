+    {
+        std::stringstream ss;
+        ss << std::endl;
+        ss << std::left << std::setw(40) << "deviceESn: " << deviceESn <<  std::endl;
+        ss << std::left << std::setw(40) << "hashValue: " << hashValue <<  std::endl;
+        return ss.str();
+    }
