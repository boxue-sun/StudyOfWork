+bool BS_SPAT_SRC_DATA_COMPONENT::Proc(const std::shared_ptr<const os::v2x::device::TrafficLightBaseData>& traffic_light_data_pb)
+{
+    LOG_INFO << "Received traffic light from device";
+    if (!traffic_light_data_pb)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_WARN << "Received traffic light data failed!";
+        }
+
+        return false;
+    }
+    std::shared_ptr<os::v2x::device::TrafficLightBaseData>
+            traffic_light_device_pb = std::make_shared<os::v2x::device::TrafficLightBaseData>(*traffic_light_data_pb);
+    TrafficLightSrcData trafficLightSrcData;
+    trafficLightSrcData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    trafficLightSrcData.seqNum = afl::util::Srand::srandStr(32);
+    trafficLightSrcData.rscuEsn = m_MqttClientConfig.basicConfiger.rscu_esn;
+    trafficLightSrcData.lightEsn = m_MqttClientConfig.spatSrcDataComponentConfiger.light_esn;
+    std::string msgType;
+    switch (traffic_light_device_pb->mess_type())
+    {
+        case 0x0101:           //信号灯运行状态
+            msgType = "A.1";
+            break;
+        case 0x0102:            //信号灯控制方式
+            msgType = "A.2";
+            break;
+        case 0x0103:  //信号机灯色状态
+            msgType = "A.3";
+            break;
+        case 0x0301:  //当前信号方案色步信息
+            msgType = "A.6";
+            break;
+        case 0x0302: //下一周期信号方案色步信息
+            msgType = "A.7";
+            break;
+        default:
+            msgType = "";
+            break;
+    }
+    trafficLightSrcData.messType = msgType;
+    if(traffic_light_device_pb->has_src_data())
+    {
+        std::string spatSrcData = traffic_light_device_pb->src_data();
+        if(spatSrcData.size() > 0)
+        {
+            trafficLightSrcData.message =  traffic_light_device_pb->src_data();
+        }
+        else
+        {
+             if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "spat src data empty!";
+            }
+            return false;
+        }
+    }
+    else
+    {
+         if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "spat src data empty!";
+        }
+        return false;
+    }
+
+    std::string hint = "spat-src-data";
+    std::string topic = m_MqttClientConfig.spatSrcDataComponentConfiger.topic_v2x_spat_src_data;
+     if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+    {
+        LOG_ERROR << "[topic]" << topic << "msg:\n" << trafficLightSrcData.to_string();
+    }
+
+    if(!mqttPushMsg2Broker(topic, trafficLightSrcData, hint))
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error] push spat data failure!";
+        }
+
+    }
+    return true;
+}
