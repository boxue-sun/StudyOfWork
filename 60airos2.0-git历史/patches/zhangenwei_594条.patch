+#define OM_ALGORITHM_STATUS_FATAL_PRINT   LOG_FATAL << LOG_KEY_OM_ALGORITHM_STATUS
+using namespace os::v2x::protocol;
+using namespace os::v2x::protocol::om::mec;
+using namespace afl::base;
+using namespace os::v2x::protocol::om::db;
+#define MODULE_CONFIG_DIR "/home/airos/protocol/mec"
+#define MODULE_NAME "OmAlgorithmStatusComponent"
