+{
+    m_MqttClientConfig.basicConfiger.mqtt_broker_url        = getConfiger().basicConfiger.mqtt_broker_url;
+    m_MqttClientConfig.basicConfiger.mqtt_client_userName        = getConfiger().basicConfiger.mqtt_client_userName;
+    m_MqttClientConfig.basicConfiger.mqtt_client_password        = getConfiger().basicConfiger.mqtt_client_password;
+    m_MqttClientConfig.v2xDataComponentConfiger.mqtt_client_id_v2x_data        = getConfiger().v2xDataComponentConfiger.mqtt_client_id_v2x_data;
+    m_MqttClientConfig.basicConfiger.mqtt_clean_session        = getConfiger().basicConfiger.mqtt_clean_session;
+    m_MqttClientConfig.basicConfiger.mqtt_version        = getConfiger().basicConfiger.mqtt_version;
+    m_MqttClientConfig.basicConfiger.mqtt_keep_alive        = getConfiger().basicConfiger.mqtt_keep_alive;
+    m_MqttClientConfig.basicConfiger.mqtt_subscribe_qos        = getConfiger().basicConfiger.mqtt_subscribe_qos;
+    m_MqttClientConfig.basicConfiger.mqtt_send_qos        = getConfiger().basicConfiger.mqtt_send_qos;
+    m_MqttClientConfig.basicConfiger.mqtt_reconnect_interval        = getConfiger().basicConfiger.mqtt_reconnect_interval;
+    m_MqttClientConfig.basicConfiger.mqtt_connect_timeout        = getConfiger().basicConfiger.mqtt_connect_timeout;
+    m_MqttClientConfig.basicConfiger.mqtt_ssl_version        = getConfiger().basicConfiger.mqtt_ssl_version;
+    m_MqttClientConfig.basicConfiger.enable_print_info =      getConfiger().basicConfiger.enable_print_info;
+    m_MqttClientConfig.basicConfiger.enable_print_info_log =   getConfiger().basicConfiger.enable_print_info_log;
+    m_MqttClientConfig.basicConfiger.rscu_esn =   getConfiger().basicConfiger.rscu_esn;
+    m_MqttClientConfig.basicConfiger.euht_esn =   getConfiger().basicConfiger.euht_esn;
+
+    m_MqttClientConfig.v2xDataComponentConfiger.asn_version =  getConfiger().v2xDataComponentConfiger.asn_version;
+    m_MqttClientConfig.v2xDataComponentConfiger.topic_v2x_bsm  =  getConfiger().v2xDataComponentConfiger.topic_v2x_bsm;
+
+
+    memset(m_MqttClientConfig.basicConfiger.mqtt_subscribe_topics, 0, sizeof(m_MqttClientConfig.basicConfiger.mqtt_subscribe_topics));
+    m_MqttClientConfig.basicConfiger.mqtt_real_subscribe_topic_num = 0;
+//    m_MqttClientConfig.mqttSubscribeTopics[m_MqttClientConfig.mqttRealSubscribeTopicNum] = (char*)subscribeTopic1.c_str();
+//    m_MqttClientConfig.mqttSubscribeQoss[m_MqttClientConfig.mqttRealSubscribeTopicNum] =  m_MqttClientConfig.mqttSubscribeQos;
+//    m_MqttClientConfig.mqttRealSubscribeTopicNum++;
+//    OM_MEC_BS_V2X_BSM_DATA_DEBUG_PRINT << "[work-param]" << m_MqttClientConfig.to_string();
+    return true;
+}
