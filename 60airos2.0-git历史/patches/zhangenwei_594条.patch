+/**
+ * @func：检测设备升级版本
+ * @param contentJson
+ */
+bool OM_Mec_COMPONENT::checkOtaUpdateVersion()
+{
+    if (!m_MqttConnected)
+    {
+        OM_MEC_ERROR_PRINT << "\n\n\n\n\n[error]mqtt not connected!\n\n\n\n\n";
+        return false;
+    }
+    if(getConfiger().enableDebugPrint)
+    {
+        OM_MEC_DEBUG_PRINT << "[update][softwareVersion]" << getConfiger().configerOmCommon.softwareVersion
+        <<  "[airosVersionFromFile]"  << getConfiger().configerOtaParam.airosVersionFromFile
+        <<  "[airosVersionTarFlag]" << getConfiger().configerOtaParam.airosVersionTarFlag
+         << "[airosVersionSeqNum]" << getConfiger().configerOtaParam.airosVersionSeqNum;
+    }
+    if(getConfiger().configerOmCommon.softwareVersion == getConfiger().configerOtaParam.airosVersionFromFile)
+    {
+        if(getConfiger().enableDebugPrint)
+        {
+            OM_MEC_DEBUG_PRINT << "[update]airos-version is equal!";
+        }
+        OTAUpdateStatusUpData otaUpdateStatusUpData;
+        otaUpdateStatusUpData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+        otaUpdateStatusUpData.seqNum =  getConfiger().configerOtaParam.airosVersionSeqNum;
+        otaUpdateStatusUpData.rscuEsn = getConfiger().rscuEsn;
+        otaUpdateStatusUpData.code  = SUCCESS;
+        otaUpdateStatusUpData.softwareVersion = getConfiger().configerOmCommon.softwareVersion;
+        otaUpdateStatusUpData.hardwareVersion = getConfiger().configerOmCommon.hardwareVersion;
+
+        std::string hint = "update sucess!";
+        otaUpdateStatusUpData.description = hint;
+        publishData(m_MqttClientConfig.configerTopic.Topic_Ota_Status, otaUpdateStatusUpData, hint);
+        getConfiger().configerOtaParam.airosVersionFromFile = "";
+        getConfiger().configerOtaParam.airosVersionSeqNum = "";
+        getConfiger().configerOtaParam.airosVersionTarFlag = false;
+        saveConfiger();
+        if(getConfiger().enableDebugPrint)
+        {
+            OM_MEC_DEBUG_PRINT << "[update]save_configer sucess!";
+        }
+    }
+    else
+    {
+        if(getConfiger().enableDebugPrint)
+        {
+            OM_MEC_DEBUG_PRINT << "[update]airos-version is not equal!";
+        }
+        if (getConfiger().configerOtaParam.airosVersionTarFlag)
+        {
+            OTAUpdateStatusUpData otaUpdateStatusUpData;
+            otaUpdateStatusUpData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+            otaUpdateStatusUpData.seqNum =  getConfiger().configerOtaParam.airosVersionSeqNum;
+            otaUpdateStatusUpData.rscuEsn = getConfiger().rscuEsn;
+            otaUpdateStatusUpData.code  = FAILURE;
+            otaUpdateStatusUpData.softwareVersion = getConfiger().configerOmCommon.softwareVersion;
+            otaUpdateStatusUpData.hardwareVersion = getConfiger().configerOmCommon.hardwareVersion;
+
+            std::string hint = "update failure!";
+            otaUpdateStatusUpData.description = hint;
+            publishData(m_MqttClientConfig.configerTopic.Topic_Ota_Status, otaUpdateStatusUpData, hint);
+            getConfiger().configerOtaParam.airosVersionFromFile = "";
+            getConfiger().configerOtaParam.airosVersionSeqNum = "";
+            getConfiger().configerOtaParam.airosVersionTarFlag = false;
+            if(getConfiger().enableDebugPrint)
+            {
+                OM_MEC_DEBUG_PRINT << "[update]save_configer sucess!";
+            }
+            saveConfiger();
+        }
+    }
+    return true;
+}
