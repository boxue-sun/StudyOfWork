+/*
+ * @Author: zhangenwei
+ * @Date: 2024-02-18 9:20:01
+ * @LastEditors: zhangenwei
+ * @LastEditTime: 2024-02-20 9:21:11
+ * @Description:
+ */
+#include "rsap_component.h"
+NAMESPACE_PROTOCOL_THREAD_START
+
+bool RSAP_COMPONENT::Init()
+{
+    AINFO << "AIROS_COMPONENT_CLASS_NAME(RaspServiceComponent) Init...";
+    if (!getServerConfigInfo(m_CloudServiceConfig))
+    {
+        AERROR << "get config-info error!";
+        return false;
+    }
+    m_Task.reset(new std::thread([&](){ TcpInit(); }));
+    return true;
+}
+
+bool RSAP_COMPONENT::TcpInit()
+{
+    afl::net::InetAddress addrUp(m_CloudServiceConfig.serverIP.c_str(), m_CloudServiceConfig.serverPort);
+    std::shared_ptr <afl::net::EventLoop> eventloop = std::make_shared<afl::net::EventLoop>();
+    if (!m_TcpClient)
+    {
+        m_TcpClient = std::unique_ptr<afl::net::TcpClient>(new afl::net::TcpClient(eventloop.get(), addrUp));
+    }
+
+    m_TcpClient->setConnectionCallback(
+            std::bind(&RSAP_COMPONENT::onConnected, this,
+                      std::placeholders::_1));
+    m_TcpClient->setMessageCallback(
+            std::bind(&RSAP_COMPONENT::onMessage, this,
+                      std::placeholders::_2));
+    m_TcpClient->connect();
+    m_TcpClient->enableRetry();
+    eventloop->loop();
+}
+
+bool RSAP_COMPONENT::Proc(const std::shared_ptr<const airos::usecase::EventOutputResult> &mecDeviceData)
+{
+    AINFO << "Received mec-data from device";
+    if (!mecDeviceData)
+    {
+        AWARN << "Received mec-data failed!";
+        return false;
+    }
+    // LOG(WARNING) << mecDeviceData->DebugString();
+    // process data
+    AINFO << "receive data, process it!";
+    processPbData2RaspData(mecDeviceData);
+    //  Send("/v2x/service/mec/data", mecDeviceData);
+    return true;
+}
+
+void RSAP_COMPONENT::onMessage(afl::net::ByteBuffer *buffer)
+{
+    AIROS_ERRORPRINT("receive data!\n");
+    for (unsigned int i = 0; i < buffer->readableBytes(); i++)
+    {
+        printf("%02x ", buffer->peek()[i]);
+    }
+    AIROS_ERRORPRINT("on message up over!");
+
+    buffer->retrieveAll();
+}
+
+void RSAP_COMPONENT::onConnected(const afl::net::TcpConnectionPtr &conn)
+{
+    AINFO << "tcp connect sucess!";
+    if (conn->connected())
+    {
+        m_CurrConn = conn;
+    } else
+    {
+        AINFO << "Connection to tcp Server disconnect!";
+        m_CurrConn = conn;
+        m_CurrConn->shutdown();
+        m_TcpClient->reconnect();
+        AINFO << "reconnect to tcp Server!";
+    }
+}
+
