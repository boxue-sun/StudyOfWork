+        ss << std::left << std::setw(40) << "DeviceType: " << deviceType << "\n";
+        ss << std::left << std::setw(40) << "FaultType: " << faultType << (faultTypeEmpty ? " (empty)" : "") << "\n";
+        ss << std::left << std::setw(40) << "FaultTime: " << faultTime << (faultTimeEmpty ? " (empty)" : "") << "\n";
+        ss << std::left << std::setw(40) << "FaultDescription: " << faultDescription << (faultDescriptionEmpty ? " (empty)" : "") << "\n";
+        return ss.str();
+    }
+};
