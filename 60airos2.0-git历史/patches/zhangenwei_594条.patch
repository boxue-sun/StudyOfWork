+//点云数据：
+void OM_COMPONENT::handleMonitorDataUpdateRcpData(const std::string & deviceId, int tag, uint64_t timestamp)
+{
+    if(getConfiger().enableDebugPrint)
+    {
+        OM_CHECK_DATA_DEBUG_PRINT << "[monitor_data_ccindex_tm][tag]" << tag << "[device_id]" << deviceId;
+    }
+    for (auto& pair : m_MonitorStateCcindexRcpData)
+    {
+        OM_CHECK_DATA_DEBUG_PRINT << "[monitor_data_ccindex_tm][id]" << pair.first ;
+    }
+    // 使用 find 查找
+    auto it = m_MonitorStateCcindexRcpData.find(deviceId);
+    // 判断是否找到
+    if (it == m_MonitorStateCcindexRcpData.end())
+    {
+        OM_CHECK_DATA_ERROR_PRINT << "[monitor_data_ccindex_tm]m_MonitorRulesCcindexTm.find(deviceid) == m_MonitorRulesCcindexTm.end()";
+        return;
+    }
+
+    auto& state = m_MonitorStateCcindexRcpData[deviceId];
+
+    if (! state.enable)
+    {
+        return;
+    }
+
+    uint64_t now = afl::util::TimeStamp::now(true).millSeconds();
+
+    // 1. 喂狗：更新最后收到时间
+    state.lastReceivedTime = now;
+    if(getConfiger().enableDebugPrint)
+    {
+        OM_CHECK_DATA_DEBUG_PRINT << "[monitor_data_ccindex_tm]"<< "[lastReceivedTime]" << state.lastReceivedTime;
+    }
+    // 2. 检查恢复逻辑
+    if (state.isAlarmActive) {
+        if (state.recoveryStartTime == 0)
+        {
+            // 收到告警后的第一帧数据，开始恢复计时
+            state.recoveryStartTime = now;
+            if(getConfiger().enableDebugPrint)
+            {
+                OM_CHECK_DATA_WARN_PRINT << "[monitor_data_ccindex_tm][recovery-start] tag:" << tag ;
+            }
+        }
+        else
+        {
+            // 检查数据是否持续了足够长的时间
+            if (now - state.recoveryStartTime >=  state.recoveryMs)
+            {
+                // 满足恢复条件 -> 消除告警
+                std::string errorDetail = state.name + " [deviceId]" + deviceId ;
+                alarmDisappeared(errorDetail, state.alarmType, getConfiger().rscuEsn, errorDetail, state.alarmOccurredTime);
+                state.isAlarmActive = false;
+                state.recoveryStartTime = 0;
+                state.lastAlarmPublishTime = 0;  // 重置告警上报时间
+                if(getConfiger().enableDebugPrint)
+                {
+                     OM_CHECK_DATA_WARN_PRINT << "[monitor_data_ccindex_tm] RECOVERED: " << state.name << " [deviceId: " << deviceId << "]";
+                 }
+            }
+        }
+    }
+}
