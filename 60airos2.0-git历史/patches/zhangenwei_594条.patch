+void OM_DEVICE_STATUS_COMPONENT::alarmMonitor()
+{
+    if (!m_MqttConnected)
+    {
+        return;
+    }
+    PerformanceData performanceData;
+    auto &runningInfo = performanceData.runningInfo;
+    getCpuInfo(runningInfo.cpuInfo);
+    if(runningInfo.cpuInfo.temp > 70)
+    {
+        string hint = "温度过高";
+        alarmOccurred(hint, MEC_ALARM_TYPE_HIGH_TEMPER_CPU);
+        m_AlarmTypeFlag.alarmHighTemperCPUFlag = true;
+    }
+    else
+    {
+        string hint = "温度过高 告警消失";
+        alarmDisappeared(hint, MEC_ALARM_TYPE_HIGH_TEMPER_CPU);
+        m_AlarmTypeFlag.alarmHighTemperCPUFlag = false;
+    }
+    
+    
+    if(runningInfo.cpuInfo.uti.size() > 0)
+    {
+        std::vector<double> data_values = extractValues(runningInfo.cpuInfo.uti);
+      
+        for (double value : data_values)
+        {
+            if(value > 60)
+            {
+                string hint = "CPU负载过高";
+                alarmOccurred(hint, MEC_ALARM_TYPE_HIGH_OCCUPANCY_CPU);
+                m_AlarmTypeFlag.alarmHighOccupancyCPUFlag = true;
+            }
+            else
+            {
+                string hint = "CPU负载过高告警消失";
+                alarmDisappeared(hint, MEC_ALARM_TYPE_HIGH_OCCUPANCY_CPU);
+                m_AlarmTypeFlag.alarmHighOccupancyCPUFlag = false;
+            }
+        }
+    }
+    getMemInfo(runningInfo.memInfo);
+    if(runningInfo.memInfo.free < 512)
+    {
+      
+        string hint = "CPU负载过高";
+        alarmOccurred(hint, MEC_ALARM_TYPE_OUT_OF_DISK_SPACE);
+        m_AlarmTypeFlag.alarmOutOfDiskSpaceFlag = true;
+    }
+    else
+    {
+        string hint = "CPU负载过高";
+        alarmDisappeared(hint, MEC_ALARM_TYPE_OUT_OF_DISK_SPACE);
+        m_AlarmTypeFlag.alarmOutOfDiskSpaceFlag = false;
+    }
+    std::vector<MsgDeviceStatus> statusList;
+    std::pair<std::string, TABLE_TYPE> tableInfo;
+    tableInfo.first = m_MqttClientConfig.configerDb.DbMecDeviceAlarmTableName;
+    tableInfo.second = TABLE_TYEP_MEC_DEV_ALARM;
+    m_DeviceStatusMsgDBPtr->getAllDeviceStatus(tableInfo, statusList);
+    bool sensorDeviceOfflineFlag  = false;
+    int  sensorDeviceOfflineCount = 0;
+    for (auto status: statusList)
+    {
+        if (DEVICE_STATUS_DB_OFF == status.deviceStatus)
+        {
+            sensorDeviceOfflineFlag = true;
+            sensorDeviceOfflineCount ++;
+        }
+    }
+    if(sensorDeviceOfflineFlag && sensorDeviceOfflineCount > 0)
+    {
+        string hint = "感知设备离线";
+        alarmOccurred(hint, MEC_ALARM_TYPE_IRE_OFF_LINE);
+        m_AlarmTypeFlag.alarmIreOffLineFlag = true;
+    }
+    //    else
+    //    {
+    //          string hint = "感知设备离线告警消失";
+    //          alarmDisappeared(hint, MEC_ALARM_TYPE_IRE_OFF_LINE);
+    //          m_AlarmTypeFlag.alarmIreOffLineFlag = true;
+    //    }
+    
+    std::string freeOutput = executeCommand("free -h");
+    double memoryUsagePercentage = getMemoryUsagePercentage(freeOutput);
+    if (memoryUsagePercentage >= 70)
+    {
+      
+        string hint = "内存不足";
+        alarmOccurred(hint, MEC_ALARM_TYPE_OUT_OF_MEMORY);
+        m_AlarmTypeFlag.alarmOutOfMemoryFlag = true;
+    }
+    else
+    {
+        string hint = "内存不足告警消息";
+        alarmOccurred(hint, MEC_ALARM_TYPE_OUT_OF_MEMORY);
+        m_AlarmTypeFlag.alarmOutOfMemoryFlag = false;
+    }
+}
