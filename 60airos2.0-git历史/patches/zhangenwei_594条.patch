+void CCINDEX_COMPONENT::doBaiscWork()
+{
+    //初始化mqtt配置
+    getWorkParamFromFile();
+    getMqttConfigerMsg();
+
+    if (!mqttInit())
+    {
+        CCINDEX_ERROR_PRINT << "[error]mqttInit failure!";
+        return ;
+    }
+
+}
