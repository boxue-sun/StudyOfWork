+def validate_device_fields(device):
+    # 简化校验逻辑，保持原意
+    required_fields = ['C_deviceType', 'F_deviceEsn', 'G_deviceIp', 'L_radarPort']
+    for field in required_fields:
+        if device.get(field) is None:
+            return False, f"Missing field: {field}"
+    return True, "Valid"
