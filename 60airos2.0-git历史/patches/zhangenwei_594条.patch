+std::string RSAP_COMPONENT::deviceCodeTrans(std::string codeStr)
+{
+    auto data = codeStr;
+    AIROS_SUCESSPRINT("[data]%s",data.c_str())
+    vector<unsigned char> bytes;
+    for (int i = 0; i < data.length(); i += 2)
+    {
+        int byte_value = stoi(data.substr(i, 2), nullptr, 10);
+        bytes.push_back(static_cast<unsigned char>(byte_value));
+    }
+
+    // 将字节数组转换为字符串
+    string byteDataStr;
+    for (unsigned char byte : bytes) {
+        byteDataStr += static_cast<char>(byte);
+    }
+    return byteDataStr;
+}
