+        if (response->message)
+        {
+            OM_CLOUD_ERROR_PRINT << "[error]mqtt-cloud connect error [error-code]" << response->code << " [error-msg]" << response->message;
+        } else
+        {
+            OM_CLOUD_ERROR_PRINT << "[error]mqtt-cloud connect error [error-code]" << response->code << " [error-msg]" << response->message;
+        }
+    } else
+    {
+        OM_CLOUD_ERROR_PRINT << "[error]mqtt-cloud connect error!";
