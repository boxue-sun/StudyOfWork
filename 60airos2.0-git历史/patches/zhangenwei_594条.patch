+void OM_Mec_COMPONENT::onConnectedPushMsgOnce()
+{
+    if (!m_MqttConnected)
+    {
+        return;
+    }
+    if(!m_RegisterFlag)
+    {
+        OM_MEC_ERROR_PRINT << "[notice]" << "未注册,发送注册信息!";
+        DeviceBaseInfoQueryData deviceBaseInfoQueryData;
+
+        deviceBaseInfoQueryData.infoId = DEVICE_BASIC_INFO;
+        publishDeviceBasicInfoData(deviceBaseInfoQueryData, DEVICE_BASIC_INFO_MEC);
+        return;
+    }
+    else
+    {
+        if(m_TimerPublishBasicDeviceInfoDataOnce > 0)
+        {
+            m_Eventloop->cancelTimer(m_TimerPublishBasicDeviceInfoDataOnce);
+        }
+    }
+}
+/**
+ * @func：设备基础信息响应
+ * @param contentJson
+ */
+void OM_Mec_COMPONENT::subscribeDeviceBaseInfo(const json &contentJson)
+{
+    if (contentJson.size() < 0)
+    {
+        return;
+    }
+    DeviceBasicInfoAckData deviceBasicInfoAckData;
+    try
+    {
+        deviceBasicInfoAckData = contentJson;
+    } catch (afl::base::json::exception &e)
+    {
+        OM_MEC_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+    }
+
+    if(deviceBasicInfoAckData.rscuEsn == m_MqttClientConfig.rscuEsn)
+    {
+        if(deviceBasicInfoAckData.status == SUCESS_REGISTER)
+        {
+            m_RegisterFlag = true;
+            OM_MEC_ERROR_PRINT << "[sucess]" << "注册成功!";
+        }
+        else
+        {
+            m_RegisterFlag = false;
+            OM_MEC_ERROR_PRINT << "[error]" << "注册失败!";
+        }
+    }
+    else
+    {
+        m_RegisterFlag = false;
+        OM_MEC_ERROR_PRINT << "[error]" << "设备序列号不匹配!";
+    }
+}
 
 
