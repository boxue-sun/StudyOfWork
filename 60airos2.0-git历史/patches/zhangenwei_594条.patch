+
+        // 检查请求体
+        if (body.empty())
+        {
+            RADAR_STATIC_ERROR_PRINT << "Request body is empty!" << std::endl;
+            return false;  // 请求体为空，退出
+        }
+        // 设置响应内容
+        res.set_content(body, m_ContentType.c_str());
+    }
+    else
+    {
+        json responseJson; // 初始化响应 JSON 对象
+        // 设置错误响应
