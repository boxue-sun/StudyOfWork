+void OM_Mec_COMPONENT::upPtpStatus()
+{
+    if(!m_MqttConnected)
+    {
+        return;
+    }
+
+    if (!afl::FileUtil::isDirectory("/var/ramlog"))
+    {
+        afl::FileUtil::createRecursionDir("/var/ramlog");
+    }
+
+    system("sudo journalctl -u phc2sys -r > /var/ramlog/ptppartlog.txt");
+//	system("ifconfig > /var/ramlog/ptppartlog.txt");
+
+    std::ifstream file("/var/ramlog/ptppartlog.txt", std::ios::in);
+
+    if(!file.is_open())//打开失败
+    {
+        DEBUGPRINT("/var/ramlog/ptppartlog.txt open failed");
+        return;
+    }
+
+    long lastTime = INT_MAX;
+    long timeDifference = INT_MAX;
+    string timeDifferenceStr = "";
+    string tmp;
+    while(getline(file, tmp, '\n'))
+    {
+        string parttmp = tmp.substr(tmp.find_first_of(" "));
+
+        auto a_pos = parttmp.find("phc offset");
+        if(a_pos != string::npos)
+        {
+            //取授时时间
+            string date = parttmp.substr(1, 2);
+            string hour = parttmp.substr(4, 2);
+            string min = parttmp.substr(7, 2);
+            string sec = parttmp.substr(10, 2);
+
+            time_t t = time(0);
+            tm* now = localtime(&t);
+            string year = std::to_string(now->tm_year + 1900);
+            string mon = std::to_string(now->tm_mon + 1);
+            if(now->tm_mon < 9)
+            {
+                mon = "0" + mon;
+            }
+
+            string ptptime = year + "-" + mon + "-" + date + " " + hour + ":" + min + ":" + sec;
+            DEBUGPRINT("ptp time: %s", ptptime.c_str());
+            afl::util::DateTime::stringToDataTime(ptptime.c_str(), &lastTime);
+
+            //取授时时差
+            timeDifferenceStr = parttmp.substr(a_pos + 10);
+            DEBUGPRINT("part1 ptp line: %s", timeDifferenceStr.c_str());
+            uint32_t c_pos = timeDifferenceStr.find('s');
+            timeDifferenceStr = timeDifferenceStr.substr(0, c_pos);
+            DEBUGPRINT("part2 ptp line: %s", timeDifferenceStr.c_str());
+            string::size_type index = 0;
+            while( (index = timeDifferenceStr.find(' ', index)) != string::npos)
+            {
+                timeDifferenceStr.erase(index, 1);
+            }
+
+            if(timeDifferenceStr != "")
+            {
+                timeDifference = stold(timeDifferenceStr);
+            }
+
+            DEBUGPRINT("part3 ptp line: %s", timeDifferenceStr.c_str());
+            break;
+        }
+    }
+
+    file.clear();
+    file.close();
+
+    afl::base::json jptpstatus;
+
+    jptpstatus["timeStamp"] = afl::util::TimeStamp::now(true).millSeconds();
+    jptpstatus["seqNum"] = afl::util::Srand::srandStr(32);
+//    jptpstatus["rscuEsn"] = m_Env->getConfiger().m_RscuEsn;
+
+    uint64_t now = afl::util::TimeStamp::now(true).millSeconds();
+    jptpstatus["lastTime"] = ((uint64_t)lastTime)*1000 + now%1000;
+    jptpstatus["timeNode"] = 1;
+    jptpstatus["timeDifference"] = timeDifference;
+    std::vector<afl::base::json> jperipherals;
+
+    //感知设备授时情况数据待添加
+
+    jptpstatus["peripherals"] = jperipherals;
+
+    string ptpstatus = jptpstatus.dump();
+
+    mqttPublishMsg(m_MqttClientConfig.configerTopic.Topic_Timing, ptpstatus);
+}
