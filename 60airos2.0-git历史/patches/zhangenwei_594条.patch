+void OM_Mec_COMPONENT::processHttpPostRequest()
+{
+    m_videoAndPicturePath = getConfiger().configerHttpServerMec.videoAndPicturePath;
+    m_ftpUrl = getConfiger().configerHttpServerMec.ftpUrl;
+    m_postPath = getConfiger().configerHttpServerMec.postPath;
+    m_httpHost = getConfiger().configerHttpServerMec.httpHost;
+    m_httpPort = getConfiger().configerHttpServerMec.httpPort;
+
+    httplib::Server svr;
+    if(!svr.is_valid())
+    {
+        DEBUGPRINT("[error]http server error");
+        return;
+    }
+    else
+    {
+        DEBUGPRINT("http server start success");
+    }
+
+    svr.Post(m_postPath, [&](const httplib::Request &req, httplib::Response &res)
+    {
+        DEBUGPRINT("recv http post body:%s", req.body.c_str());
+        afl::base::json j;
+        httpPostBody hpb;
+        try
+        {
+            j = afl::base::json::parse(req.body.c_str(), req.body.c_str() + req.body.size());
+            hpb = j;
+        }
+        catch (...)
+        {
+            DEBUGPRINT("http post body, json parse error!");
+            return;
+        }
+
+        if(!afl::FileUtil::isDirectory(m_videoAndPicturePath.c_str()))
+        {
+            DEBUGPRINT("picture and video path error!");
+            return;
+        }
+
+        std::vector<std::string> urls;
+        getUrlsBytime(m_videoAndPicturePath, urls, hpb.start_time, hpb.end_time, hpb.type, hpb.device_sn);
+
+        std::vector<afl::base::json> urllist;
+        afl::base::json jrspbody;
+        if(hpb.type == "0")
+        {
+            for(uint32_t i = 0; i < urls.size(); i++)
+            {
+                afl::base::json jurl;
+                string jkey = "video_ur" + std::to_string(i);
+                jurl[jkey] = urls[i];
+                urllist.push_back(jurl);
+            }
+
+            jrspbody["video_urls"] = urllist;
+        }
+        else
+        {
+            for(uint32_t i = 0; i < urls.size(); i++)
+            {
+                afl::base::json jurl;
+                string jkey = "pic_ur" + std::to_string(i);
+                jurl[jkey] = urls[i];
+                urllist.push_back(jurl);
+            }
+            jrspbody["pic_urls"] = urllist;
+        }
+
+        std::string rspbody = jrspbody.dump();
+        res.set_content(rspbody, "application/json;charset=UTF-8");
+    });
+
+    svr.listen(getConfiger().configerHttpServerMec.httpHost.c_str(), getConfiger().configerHttpServerMec.httpPort);
+}
