+bool OM_CAMERA_COMPONENT::mqttReconnect()
+{
+    ERRORPRINT("[notice]mqtt reconnect!");
+
+    m_Eventloop->addTimer(std::bind(&OM_CAMERA_COMPONENT::mqttConnect, this), m_MqttClientConfig.configerMqtt.mqttReconnectInterval, false);
+
+    return true;
+}
