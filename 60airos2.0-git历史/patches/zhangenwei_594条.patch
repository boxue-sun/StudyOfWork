+void  OM_Mec_COMPONENT::getDiskStats(DiskInfo &diskInfo)
+{
+    long readSectors = 0;
+    long writeSectors = 0;
+    long readRequests = 0;
+    long writeRequests = 0;
+    ifstream file("/proc/diskstats");
+    if (file.is_open())
+    {
+        string line;
+        while (getline(file, line))
+        {
+            istringstream iss(line);
+            vector<string> fields;
+            string field;
+            while (iss >> field)
+            {
+                fields.push_back(field);
+            }
+            if (fields.size() >= 14)
+            {
+                string device_name = fields[2];
+                long read_sectors = stol(fields[5]);
+                long write_sectors = stol(fields[9]);
+                long read_requests = stol(fields[3]);
+                long write_requests = stol(fields[7]);
+
+                // 获取设备容量信息
+                struct statvfs fs;
+                if (statvfs(("/dev/" + device_name).c_str(), &fs) == 0)
+                {
+                    diskInfo.total += fs.f_blocks * fs.f_frsize;
+                    diskInfo.used += (fs.f_blocks - fs.f_bfree) * fs.f_frsize;
+                }
+
+                // 累加读写扇区数和请求数
+                readSectors   += read_sectors;
+                writeSectors  += write_sectors;
+                readRequests  += read_requests;
+                writeRequests += write_requests;
+            }
+        }
+        file.close();
+    }
 
+    // 计算可用磁盘空间
+    diskInfo.free = diskInfo.total - diskInfo.used;
+
+    // 计算���秒的读写数据量和 IOPS
+    diskInfo.read = readSectors * 512.0 / 1024 / 1024; // MB/s
+    diskInfo.write = writeSectors * 512.0 / 1024 / 1024; // MB/s
+    diskInfo.tps = readRequests + writeRequests;
+
+    return ;
+}
