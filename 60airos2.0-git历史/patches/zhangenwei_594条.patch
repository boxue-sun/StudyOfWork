-bool OM_Mec_COMPONENT::isUtcHourly(const std::chrono::system_clock::time_point& utc_time)
-{
-    // 将 time_point 转换为 time_t
-    std::time_t time_t_utc = std::chrono::system_clock::to_time_t(utc_time);
-
-    // 将 time_t 转换为 tm 结构
-    std::tm* utc_tm = std::gmtime(&time_t_utc);
-
-    // 检查分钟和秒是否为 0
-    return (utc_tm->tm_min == 0 && utc_tm->tm_sec == 0);
-}
