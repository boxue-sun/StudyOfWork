+    }
+
+    // 转换为字符串
+    std::string to_string() const {
+        std::stringstream ss;
+        ss << std::left << std::setw(40) << "tc_pub_flag: "         << (tc_pub_flag ? "true" : "false") << std::endl;
+        ss << std::left << std::setw(40) << "tc_sub_flag: "         << (tc_sub_flag ? "true" : "false") << std::endl;
+        return ss.str();
+    }
+};
