 //MEC自检结果： 监控数据是否超时
-void OM_COMPONENT::checkMonitorMecDataTimeouts(MonitorState& state, int tag)
+void OM_COMPONENT::checkMonitorMecDataTimeoutsImpl(MonitorState& state, int tag)
 {
     if (!m_MqttClientCloud || !m_RegisterFlag)
