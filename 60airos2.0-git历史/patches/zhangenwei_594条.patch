+void RADAR_STATIC_COMPONENT::mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json & subScribeJson)
+{
+    if (!m_MqttConnected)
+    {
+        RADAR_STATIC_ERROR_PRINT << "[Inter][error]mqtt clinet has not connected!";
+        return;
+    }
+
+    if (topic.empty())
+    {
+        RADAR_STATIC_ERROR_PRINT << "[Inter]topic empty!";
+        return;
+    }
+    std::string topicProfix = topic.substr(0, topic.find("/"));
+
+    std::string hint;
+    std::string topicPT;
+
+    if(topic.find("static") == 0)
+    {
+        for (auto it = m_MqttClientConfig.topicUnMapCCIndex.begin(); it != m_MqttClientConfig.topicUnMapCCIndex.end(); ++it)
+        {
+            const MqttTopicConfigerCCIndex &mqttTopicConfigerCCIndex = it->second;
+            if(topic == mqttTopicConfigerCCIndex.Topic_Static_Query_Ack)
+            {
+                if(getConfiger().enableDebugPrint)
+                {
+                    RADAR_STATIC_DEBUG_PRINT << "[success]find topic ![topic]" << topic;
+                }
+                ConfigUpdateResponseData configUpdateResponseData;
+                if(processConfigQeuryDataAck(topic, subScribeJson))
+                {
+                    if(getConfiger().enableDebugPrint)
+                    {
+                        RADAR_STATIC_DEBUG_PRINT << "[sucess]process config-query-ack success!";
+                    }
+                    return ;
+                }
+                else
+                {
+                    RADAR_STATIC_ERROR_PRINT << "[error]process config-query-ack failure!";
+                    return ;
+                }
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Static_Update)
+            {
+                //更新信息
+                if(getConfiger().enableDebugPrint)
+                {
+                    RADAR_STATIC_DEBUG_PRINT << "[success]find topic ![topic]" << topic;
+                }
+                if(processConfigUpdateDataAck(topic, subScribeJson))
+                {
+                    if(getConfiger().enableDebugPrint)
+                    {
+                        RADAR_STATIC_DEBUG_PRINT << "[sucess]process config-udpate success!";
+                    }
+                    return ;
+                }
+                else
+                {
+                    RADAR_STATIC_ERROR_PRINT << "[error]process config-update failure!";
+                    return ;
+                }
+            }
+        }
+    }
+    else
+    {
+        if(getConfiger().enableDebugPrint)
+        {
+            RADAR_STATIC_DEBUG_PRINT << "[noitce]no need this msg!";
+        }
+        return ;
+    }
+
+    if(!topicPT.empty())
+    {
+        if (!mqttPublishMsgRetries(topicPT, subScribeJson, hint))
+        {
+            RADAR_STATIC_ERROR_PRINT << "[Inter][error] Publish data failure![msg]" << hint.c_str();
+        }
+        else
+        {
+            if(getConfiger().enableDebugPrint)
+            {
+                RADAR_STATIC_DEBUG_PRINT << "[sucess]Publish success!";
+            }
+        }
+    }
+    else
+    {
+        if(getConfiger().enableDebugPrint)
+        {
+            RADAR_STATIC_DEBUG_PRINT << "[topicPT][" << topicPT << "]";
+        }
+    }
+
+    return;
+}
