+
+  CameraCictciDeviceFactory(){};
+
+  CameraCictciDeviceFactory(const CameraCictciDeviceFactory &) = delete;
+
+  CameraCictciDeviceFactory(CameraCictciDeviceFactory &&) = delete;
+
+ private:
+  std::map<std::string, CONSTRUCT> map_;
+};
