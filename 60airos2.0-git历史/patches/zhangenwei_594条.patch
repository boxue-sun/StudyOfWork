+void OM_COMPONENT::startAlgorithmRunningStatus()
+{
+
+    if(!getConfiger().configerMec.configerEnable.Enable_AlgorithmStatus)
+    {
+        return ;
+    }
+    uint64_t nowUtcMillSeconds = afl::util::TimeStamp::now(true).millSeconds();
+    auto timePoint = std::chrono::system_clock::time_point(std::chrono::milliseconds(nowUtcMillSeconds));
+    bool isUtcHourlyFlag = isUtcHourly(timePoint);
+    if(!getConfiger().configerMec.configerEnable.Enable_UseUtcHourly)
+    {
+        isUtcHourlyFlag = true;
+    }
+
+    if (isUtcHourlyFlag)
+    {
+        OM_MEC_WARN_PRINT << "[Algorithm-Running-Status]当前 UTC 时间是整点。";
+        if(m_TimerAlgorithmRunningStatusStart > 0)
+        {
+            m_EventloopOmMec->cancelTimer(m_TimerAlgorithmRunningStatusStart);
+            m_TimerAlgorithmRunningStatusStart = -1;
+        }
+        uploadAlgorithmRunningStatusInfo();
+        m_TimerAlgorithmRunningStatus = m_EventloopOmMec->addTimer(std::bind(&OM_COMPONENT::uploadAlgorithmRunningStatusInfo, this),
+                                                             getConfiger().configerMec.configerPublishPeriod.periodAlgorithmRunningStatusInterval, true);
+    } else {
+        OM_MEC_DEBUG_PRINT << "[Algorithm-Running-Status]当前 UTC 时间不是整点。" ;
+    }
+}
