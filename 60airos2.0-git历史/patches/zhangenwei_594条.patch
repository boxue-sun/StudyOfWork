+class OM_ALGORITHM_STATUS_COMPONENT : public airos::middleware::ComponentAdapter<airos::usecase::EventOutputResult>
+        , public Configurable<MqttClientConfigerAlgorithmStatus>
+{
+public:
+    OM_ALGORITHM_STATUS_COMPONENT() : Configurable<MqttClientConfigerAlgorithmStatus>(MODULE_NAME, MODULE_CONFIG_DIR, MODULE_CFG_NAME)
+    {
+        m_EventOutResultDataPtr = std::make_shared<airos::usecase::EventOutputResult>();
+        m_CloudDataPtr = std::make_shared<os::v2x::device::CloudData>();
+    };
+
+    virtual ~OM_ALGORITHM_STATUS_COMPONENT() override
+    {
+    };
+
+    bool Init() override;
+
+    bool Proc(const std::shared_ptr<const airos::usecase::EventOutputResult>& recv_data);
+    bool initEventLoop();
+    void doBaiscWork();
+    bool getWorkParamFromFile();
+    void showAirosChannelInfo(std::string module_log, std::string topic, std::string payload);
+    bool getDeviceEsn(std::string deviceId, std::string& deviceEsn);
+    template<typename  T>
+    bool publishData(string topic, T info, string hint, string module_log="")
+    {
+        if(!topic.empty())
+        {
+            auto cloud_data = std::make_shared<os::v2x::device::CloudData>();
+            auto mqtt_data  = cloud_data->mutable_mqtt_data();
+            mqtt_data->set_topic(topic);
+            afl::base::json publishJson;
+            try{
+                publishJson = info;
+            }
+            catch (json::exception &e)
+            {
+                OM_ALGORITHM_STATUS_ERROR_PRINT << module_log << "[what]" << e.what() << " [json-exception-id]" << e.id;
+                return false;
+            }
+
+            std::string msg = publishJson.dump();
+            mqtt_data->set_data(msg.data(), msg.size());
+            if(getConfiger().enableDebugPrint) {
+//                OM_MEC_DEBUG_PRINT << module_log << "∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨";
+                OM_ALGORITHM_STATUS_DEBUG_PRINT << module_log << "[notice]om_mec 》》》 om_cloud" << " [topic ]" << topic
+                                   << "[msg-json]" << publishJson.dump().c_str();
+                OM_ALGORITHM_STATUS_DEBUG_PRINT << module_log << "[notice]om_mec 》》》 om_cloud" << " [channel]/v2x/cloud/report/mqtt"
+                                   << " [msg-pb]" << cloud_data->DebugString();
+//                OM_MEC_DEBUG_PRINT << module_log << "∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧";
+            }
+            Send("/v2x/cloud/report/mqtt", cloud_data);
+        }
+        return true;
+    }
+private:
+    std::unique_ptr<std::thread>    m_Task;
+    /////////////////////////////////////////////////////////////
+    std::shared_ptr<afl::net::EventLoop>    m_Eventloop;
+    std::unique_ptr<afl::net::Channel>      m_Chnl;
+    std::shared_ptr <airos::usecase::EventOutputResult> m_EventOutResultDataPtr = nullptr;
+    bool m_HasSendOnce = false;
