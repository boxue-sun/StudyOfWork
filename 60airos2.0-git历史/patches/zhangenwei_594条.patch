+bool OM_MONITOR_COMPONENT::process_query_airos_status(json& j)
+{
+
+    QueryData queryData;
+    try
+    {
+        queryData  = j;
+    }
+    catch(json::exception &e)
+    {
+        OM_MONITOR_ERROR_PRINT << "json par error " << e.what();
+        return false;
+    }
+    if(getConfiger().enableDebugPrint) {
+        OM_MONITOR_DEBUG_PRINT << "[rece-data]" << queryData.to_string();
+    }
+    if(queryData.tag != QUERY_MSG_TAG::QUARY_TAG_DOCKER_STA)
+    {
+        OM_MONITOR_ERROR_PRINT << "tag error ";
+        return false;
+    }
+    if(queryData.device_esn != getConfiger().rscuEsn)
+    {
+        OM_MONITOR_ERROR_PRINT << "device-esn error! [query-esn]" << queryData.device_esn << "[rscuEsn]" << getConfiger().rscuEsn;
+        return false;
+    }
+    AirosStatus airosStatus;
+    airosStatus.tag = QUERY_MSG_TAG::QUARY_TAG_DOCKER_STA;
+    airosStatus.seqnum = queryData.seqnum;
+    airosStatus.timestamp =  afl::util::TimeStamp::now(true).millSeconds();;
+    airosStatus.device_esn = getConfiger().rscuEsn;
+    std::string command = "ps aux --sort=-%mem | grep -E 'mainboard|python' | head -n 10";
+    std::vector<ProcessInfo> airosProcessInfos = getProcessInfo(command);
+    for (const auto &processInfo : airosProcessInfos)
+    {
+        OM_MONITOR_DEBUG_PRINT << "[pid]" << processInfo.pid
+                               << "[cpu]" << processInfo.cpu
+                               << "[mem]" << processInfo.mem
+                               << "[command]" << processInfo.command;
+
+        AirosMoudlesData airosMoudlesData;
+        airosMoudlesData.module_cpu = processInfo.cpu;
+        airosMoudlesData.module_mem = processInfo.mem;
+        airosStatus.data.modules_head.push_back(airosMoudlesData);
+    }
+
+    afl::base::json publishJson;
+    try{
+        publishJson = airosStatus;
+    }
+    catch (json::exception &e)
+    {
+        OM_MONITOR_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+        return false;
+    }
+
+    std::string msg = publishJson.dump();
+    if(getConfiger().enableDebugPrint) {
+        OM_MONITOR_DEBUG_PRINT << "[upload-data]" << msg;
+    }
+    size_t slen = sendto(m_Udpfd, msg.c_str(), msg.size(), 0,
+                         (struct sockaddr*)&m_ClientAddr, sizeof(m_ClientAddr));
+    if (slen != msg.size())
+    {
+        OM_MONITOR_ERROR_PRINT << "[error]send msg error, reason:" << strerror(errno);
+        return false;
+    }
+    return true;
+}
