+    {
+        if(alarmManagementData.alarm.alarmChangedTime == 0)
+        {
+            isUpdateFlag = true;
+        }
+        else
+        {
+            isUpdateFlag = false;
+        }
+    }
 
+    msgDeviceStatus.addition = alarmManagementData.alarm.addtion;
+    msgDeviceStatus.additionNeedUpdate = true;
+    
+    std::pair<std::string, TABLE_TYPE> tableInfo;
