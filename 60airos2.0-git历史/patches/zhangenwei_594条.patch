+            objHead.height = airos::base::MathUtil::convertHeightF2I(obstacle.height());
+
+            auto positionGcs = obstacle.position_gcs();
+            objHead.longitude = airos::base::MathUtil::convertDegLatLonF2I(positionGcs.lon());
+            objHead.latitude = airos::base::MathUtil::convertDegLatLonF2I(positionGcs.lat());
+            objHead.elevation = airos::base::MathUtil::convertEleF2I(positionGcs.ele());
+
+            objHead.posConfidence = 0;
+            objHead.elevConfidence = 0;
+            objHead.speed = airos::base::MathUtil::convertSpeedF2I(obstacle.speed());
+
+            objHead.speedEast = 0;
+            objHead.speedEastConfidence = 0;
+            objHead.speedNorth = 0;
+            objHead.speedNorthConfidence = 0;
+
+            objHead.heading  = airos::base::MathUtil::convertDegHeadingF2I(obstacle.heading());
+            objHead.headConfidence  = 0;
+            objHead.accelVert = 0;
+            objHead.accelVertConfidence = 0;
+            objHead.trackedTimes = obstacle.tracking() * 1000;
+            objHead.histLocNum = 0;
+            objHead.predLocNum = 0;
+
+            objHead.laneId = 0;
+            objHead.filterInfoType = 0;
+
+            //filterInfo
+            objHead.dimension = 0;
+            //lenplateNo
+            std::string plateNoStr = obstacle.plate_no();
+            objHead.lenplateNo = plateNoStr.length();
+            buffer.write(&objHead, sizeof(objHead));
+            len += sizeof(objHead);
+            buffer.write(obstacle.plate_no());
+            len += objHead.lenplateNo;
+            ObjsTail objsTail;
+            objsTail.plateType = 0xFF;
+            int plateColorTemp;
+            switch(obstacle.plate_color())
+            {
+                case PLATE_COLOR_TYPE_OTHER:
+                    plateColorTemp = 0;
+                    break;
+                case PLATE_COLOR_TYPE_WHITE:
+                    plateColorTemp = LICENSE_PLATE_COLOR_TYPE_BLUEBOTTOM_WHITEEXT;
+                    break;
+                case PLATE_COLOR_TYPE_BLUE:
+                    plateColorTemp = LICENSE_PLATE_COLOR_TYPE_BLUE;
+                    break;
+                    break;
+                case PLATE_COLOR_TYPE_YELLOW:
+                    plateColorTemp = LICENSE_PLATE_COLOR_TYPE_YELLOW;
+                    break;
+                case PLATE_COLOR_TYPE_BLACK:
+                    plateColorTemp = LICENSE_PLATE_COLOR_TYPE_BLACK;
+                    break;
+                case PLATE_COLOR_TYPE_GREEN:
+                    plateColorTemp = LICENSE_PLATE_COLOR_TYPE_GREEN_AGRICULTURAL;
+                    break;
+                default:
+                    break;
+            }
+            objsTail.plateColor = plateColorTemp;
+
+            int objColorTemp;
+            switch(obstacle.obj_color())
+            {
+                case OBJ_COLOR_TYPE_OTHER:
+                    objColorTemp = 0;
+                    break;
+                case OBJ_COLOR_TYPE_WHITE:
+                    objColorTemp = VEHICLE_COLOR_WHITE;
+                    break;
+                case OBJ_COLOR_TYPE_BLUE:
+                    objColorTemp = VEHICLE_COLOR_BLUE;
+                    break;
+                case OBJ_COLOR_TYPE_YELLOW:
+                    objColorTemp = VEHICLE_COLOR_YELLOW;
+                    break;
+                case OBJ_COLOR_TYPE_BLACK:
+                    objColorTemp = VEHICLE_COLOR_BLACK;
+                    break;
+                case OBJ_COLOR_TYPE_GREEN:
+                    objColorTemp = VEHICLE_COLOR_GREEN;
+                    break;
+                case OBJ_COLOR_TYPE_RED:
+                    objColorTemp = VEHICLE_COLOR_RED;
+                    break;
+                case OBJ_COLOR_TYPE_SILVER:
+                    objColorTemp = VEHICLE_COLOR_SILVERWHITE;
+                    break;
+                case OBJ_COLOR_TYPE_GRAY:
+                    objColorTemp = VEHICLE_COLOR_GRAY;
+                    break;
+                case OBJ_COLOR_TYPE_PINK:
+                    objColorTemp = VEHICLE_COLOR_PINK;
+                    break;
+                case OBJ_COLOR_TYPE_GOLD:
+                    objColorTemp = VEHICLE_COLOR_OTHER;
+                    break;
+                case OBJ_COLOR_TYPE_ORANGE:
+                    objColorTemp = VEHICLE_COLOR_ORANGE;
+                    break;
+                case OBJ_COLOR_TYPE_PURPLE:
+                    objColorTemp = VEHICLE_COLOR_PURPLE;
+                    break;
+                default:
+                    break;
+            }
+            objsTail.objColor = objColorTemp;
+            objsTail.funtionTimestamp = header.message_timestamp();
+            buffer.write(&objsTail, sizeof(objsTail));
+            len += sizeof(objsTail);
+        }
+        m_CurrConn->send(&buffer);
+        return true;
+    }
+    if (mecDeviceData->output_case() == os::v2x::device::MecOutput::kEvents)
+    {
+        buffer.retrieveAll();
+        auto events = mecDeviceData->events();
+        const uint32_t eventsSum = events.event().size();
+        auto header = events.header();
+        for(int32_t i = 0; i < eventsSum; i++)
+        {
+            EventDataHead eventDataHead;
+            eventDataHead.channelId = CHANNEL_SOURCE_DATANG_ROADSIDE_PERCEPTION_DEVICE;
+            std::memcpy(eventDataHead.rcuId, m_ObjRcuId.c_str(), 8);
+            auto event = events.event()[i];
+            eventDataHead.eventType = event.event_type();
+            eventDataHead.confidence = 0;
+            eventDataHead.longitude =  airos::base::MathUtil::convertDegLatLonF2I(event.lon());
+            eventDataHead.latitude  =  airos::base::MathUtil::convertDegLatLonF2I(event.lat());
+            eventDataHead.gnssType = COORDINATE_TYPE_WGS84;
+            eventDataHead.timestamp = header.message_timestamp();
+            memcpy(eventDataHead.eventId, event.id().c_str(), 16);
+            eventDataHead.extsLen = 0;
+            buffer.write(&eventDataHead, sizeof(EventDataHead));
+            EventDataTail eventDataTail;
+            eventDataTail.targetIdsLen = 0;
+            buffer.write(&eventDataTail, sizeof(EventDataTail));
+            m_CurrConn->send(&buffer);
+        }
+
+    }
+    if (mecDeviceData->output_case() == os::v2x::device::MecOutput::kHeartBeat)
+    {
+        buffer.retrieveAll();
+        auto heart_beat = mecDeviceData->heart_beat();
+        StatusDataHead statusDataHead;
+        statusDataHead.channelId = CHANNEL_SOURCE_DATANG_ROADSIDE_PERCEPTION_DEVICE;
+        std::memcpy(statusDataHead.rcuId, m_ObjRcuId.c_str(), 8);
+        statusDataHead.status = RcuStatusTypeNormal;
+        const uint32_t device_status_info_sum = heart_beat.device_status_info().size();
+        std::vector<CamStatusTail> camDevDetailList;
+        std::vector<RadarStatusTail> radarDevDetailList;
+        std::vector<LidarStatusTail> lidarDevDetailList;
+
+
+        for(int32_t i = 0; i < device_status_info_sum; i++)
+        {
+            auto device_status_info = heart_beat.device_status_info()[i];
+            if(device_status_info.device_type() == os::v2x::device::HeartBeatDeviceType::HEART_BEAT_TYPE_CAMRA)
+            {
+                CamStatusTail camStatusTail;
+                int32_t index = camDevDetailList.size();
+                camStatusTail.id = index++;
+                memcpy(camStatusTail.camId, device_status_info.device_id().c_str(), 11);
+                camStatusTail.camStatus = device_status_info.status();
+                camDevDetailList.push_back(camStatusTail);
+            }
+            if(device_status_info.device_type() == os::v2x::device::HeartBeatDeviceType::HEART_BEAT_TYPE_MW_RADAR)
+            {
+                RadarStatusTail radarStatusTail;
+                int32_t index = radarDevDetailList.size();
+                radarStatusTail.id = index++;
+                memcpy(radarStatusTail.radarId, device_status_info.device_id().c_str(), 11);
+                radarStatusTail.radarStatus = device_status_info.status();
+                radarDevDetailList.push_back(radarStatusTail);
+            }
+            if(device_status_info.device_type() == os::v2x::device::HeartBeatDeviceType::HEART_BEAT_TYPE_RADAR)
+            {
+                LidarStatusTail lidarStatusTail;
+                int32_t index = radarDevDetailList.size();
+                lidarStatusTail.id = index++;
+                memcpy(lidarStatusTail.lidarId, device_status_info.device_id().c_str(), 11);
+                lidarStatusTail.lidarStatus = device_status_info.status();
+                lidarDevDetailList.push_back(lidarStatusTail);
+            }
+        }
+
+        CamStatusHead camStatusHead;
+        camStatusHead.camNum = camDevDetailList.size();
+        buffer.write(&camStatusHead, sizeof(CamStatusHead));
+        for(int32_t i = 0; i < camStatusHead.camNum; i++)
+        {
+            buffer.write(camDevDetailList[i]);
+        }
+
+
+        RadarStatusHead radarStatusHead;
+        radarStatusHead.radarNum = radarDevDetailList.size();
+        buffer.write(&radarStatusHead, sizeof(RadarStatusHead));
+        for(int32_t i = 0; i < radarStatusHead.radarNum; i++)
+        {
+            buffer.write(radarDevDetailList[i]);
+        }
+
+        LidarStatusHead lidarStatusHead;
+        lidarStatusHead.lidarNum = lidarDevDetailList.size();
+        buffer.write(&lidarStatusHead, sizeof(LidarStatusHead));
+        for(int32_t i = 0; i < lidarStatusHead.lidarNum; i++)
+        {
+            buffer.write(lidarDevDetailList[i]);
+        }
+        m_CurrConn->send(&buffer);
+    }
+#endif
+}
