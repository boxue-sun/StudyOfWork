+std::string OM_COMPONENT::extractDeviceID(const std::string& command, std::string regexProfix)
+{
+    std::string regexParam = regexProfix + "/([^ /]+)";
+    std::regex regex(regexParam); // 正则表达式用于匹配 deviceID
