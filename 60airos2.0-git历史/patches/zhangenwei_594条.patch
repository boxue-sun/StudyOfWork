+bool CICTCIMec::ParseJsonData2PbDataAlgorithmStatus(json &j)
+{
+    CictciAlgorithmStatus cictciAlgorithmStatus;
+    try
+    {
+        cictciAlgorithmStatus  = j;
+    }
+    catch(json::exception &e)
+    {
+        MEC_SERVICE_LOG_ERROR << "[error] " << e.what();
+        return false;
+    }
+    V2X_CODEC_LOG_INFO << j.dump().c_str();
+    auto mecAlgorithmStatus = output_data_algorithm_status->mutable_mec_algorithm_status();
+    mecAlgorithmStatus->set_msg_type(cictciAlgorithmStatus.m_MsgType);
+    mecAlgorithmStatus->set_time_stamp(TimeStampTransfer(cictciAlgorithmStatus.m_Timestamp));
+    for(int i = 0; i < cictciAlgorithmStatus.m_DevList.size(); i++)
+    {
+        auto devStatus = cictciAlgorithmStatus.m_DevList[i];
+        auto devStatusPb = mecAlgorithmStatus->add_dev_list();
+        devStatusPb->set_dev_type((airos::usecase::MecDevAlgorithmStatusDevType)devStatus.m_DevType);
+        devStatusPb->set_device_id(devStatus.m_DeviceId);
+        devStatusPb->set_status((airos::usecase::MecDevAlgorithmStatusDevStatus)devStatus.m_Status);
+        devStatusPb->set_dev_service_status((airos::usecase::MecDevAlgorithmStatusDevServiceStatus)devStatus.m_DevServiceStaus);
+    }
+    MEC_SERVICE_LOG_ERROR  << output_data_algorithm_status->DebugString();
+    sender_(output_data_algorithm_status);
+    return true;
+}
 
