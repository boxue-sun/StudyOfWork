-            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
-            {
-                OM_MEC_BS_V2X_BSM_DATA_DEBUG_PRINT << "[error] Publish " << hint << " data failed on attempt " << attempt << "!";
