+    static int getRecvBuffer(AFL_SOCKET fd, int* writeSize);
+
+    static int setOpt(AFL_SOCKET fd, int level, int name, char *value, int len);
+    static int getOpt(AFL_SOCKET fd, int level, int optname, int& optval);
