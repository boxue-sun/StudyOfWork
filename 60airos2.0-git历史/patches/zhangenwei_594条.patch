+                                    thiz->m_MqttClientConfig.configerMqttCloud.mqttSubscribeTopics,
+                                    thiz->m_MqttClientConfig.configerMqttCloud.mqttSubscribeQoss,
+                                    &opts) != MQTTASYNC_SUCCESS)
