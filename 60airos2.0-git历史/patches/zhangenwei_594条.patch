+bool OM_COMPONENT::getDeviceEsn(std::string deviceId, std::string& deviceEsn)
+{
+    for(auto sensorDeviceWorkParam:m_OmWorkParamConfiger.sensorDeviceWorkParamList)
+    {
+        if(sensorDeviceWorkParam.deviceSn == deviceId)
+        {
+            deviceEsn = sensorDeviceWorkParam.deviceEsn;
+            break;
+        }
+    }
+    return true;
+}
