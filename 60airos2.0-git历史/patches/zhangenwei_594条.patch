+
+    void mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json &j);
+
+    template<typename T>
+    bool mqttPushMsg2Broker(string topic, T info, string hint)
+    {
+        std::string pData;
+
+        try
+        {
+            afl::base::json pushInfoJson = info;
+            pData = pushInfoJson.dump();
+        } catch (json::exception &e)
+        {
+            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[what]" <<  e.what() << "[json-exception-id]" << e.id;
+            }
+
+            return false;
+        }
+
+        if (!pData.empty())
+        {
+            if (!mqttPublishMsg(topic, pData))
+            {
+                if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                {
+                    LOG_ERROR <<  "[error]push " <<  hint.c_str() << "  error!";
+                }
+
+                return false;
+            } else
+            {
+                if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                {
+                    LOG_ERROR << "[topic] " <<  topic.c_str() << "[msg]" << pData;
+                }
+
+            }
+        } else
+        {
+            return false;
+        }
+        return true;
+    }
+
