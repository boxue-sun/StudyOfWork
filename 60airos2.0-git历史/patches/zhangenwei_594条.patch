+bool BS_ANGLE_OFFSET_COMPONENT::Init()
+{
+    if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+    {
+        LOG_ERROR << "(业务数据-角度偏移组件) Init...";
+    }
+
+    doBaiscWork();
+    if (!mqttInit())
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR <<  "[error]mqttInit failure!";
+        }
+
+        return false;
+    }
+//    m_Task.reset(new std::thread([&](){ UdpInit(); }));
+    return true;
+}
+
+bool BS_ANGLE_OFFSET_COMPONENT::Proc(const std::shared_ptr<const airos::usecase::EventOutputResult> &mecDeviceData)
+{
+    if (!mecDeviceData)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "Received mec-data failed!";
+        }
+
+        return false;
+    }
+    if (mecDeviceData->has_mec_angle_offset())
+    {
+        CameraDeviceAngleOffsetLogData cameraDeviceAngleOffsetLogData;
+        auto mec_angle_offset = mecDeviceData->mec_angle_offset();
+        cameraDeviceAngleOffsetLogData.timeStamp = mec_angle_offset.time_stamp();
+        cameraDeviceAngleOffsetLogData.rscuEsn = m_MqttClientConfig.basicConfiger.rscu_esn;
+        cameraDeviceAngleOffsetLogData.protocolVersion =     m_MqttClientConfig.angleOffsetComponentConfiger.protocol_version;
+        for(int i = 0; i < mec_angle_offset.alarm_info().size(); i++)
+        {
+            cameraDeviceAngleOffsetLogData.seqNum = afl::util::Srand::srandStr(32);
+            auto alarm_info = mec_angle_offset.alarm_info()[i];
+            cameraDeviceAngleOffsetLogData.alarm.alarmLevel = (AlarmLevel)alarm_info.alarm_level();
+            cameraDeviceAngleOffsetLogData.alarm.alarmStatus = (AlarmStatus)alarm_info.alarm_status();
+            cameraDeviceAngleOffsetLogData.alarm.alarmRaisedTime = alarm_info.alarm_raised_time();
+            if(alarm_info.has_alarm_changed_time())
+            {
+                cameraDeviceAngleOffsetLogData.alarm.alarmChangedTime = alarm_info.alarm_changed_time();
+            }
+            cameraDeviceAngleOffsetLogData.alarm.alarmType = "cameraAngleOffset";
+            afl::base::json uploadJson;
+            std::string strAsn;
+            std::string hint = "angle-offset-data";
+            if(!mqttPushMsg2Broker(m_MqttClientConfig.angleOffsetComponentConfiger.topic_v2x_angle_offset, cameraDeviceAngleOffsetLogData, hint))
+            {
+                if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                {
+                    LOG_ERROR << "[error] push spat data failure!";
+                }
+
+            }
+        }
+    }
+
+    if(mecDeviceData->has_mec_heart_beat())
+    {
+        CictciHeartBeat cictciHeartBeat;
+        auto heartBeatPb  = mecDeviceData->mec_heart_beat();
+        cictciHeartBeat.m_MsgType = heartBeatPb.msg_type();
+        cictciHeartBeat.m_Timestamp = heartBeatPb.time_stamp();
+        for(int i = 0; i < heartBeatPb.device_status_info().size(); i++)
+        {
+            auto device_status_info = heartBeatPb.device_status_info()[i];
+            CictciSubDevInfo cictciSubDevInfo;
+            cictciSubDevInfo.m_DevType = device_status_info.device_type();
+            cictciSubDevInfo.m_DeviceId = device_status_info.device_id();
+            cictciSubDevInfo.m_Status = device_status_info.status();
+            cictciHeartBeat.m_SubDevStatusList.push_back(cictciSubDevInfo);
+        }
+        afl::base::json uploadJson;
+        std::string strAsn;
+        std::string hint = "mec-hearbeat-data";
+        if(!mqttPushMsg2Broker( m_MqttClientConfig.angleOffsetComponentConfiger.topic_v2x_heart_beat, cictciHeartBeat, hint))
+        {
+            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error] push spat data failure!";
+            }
+
+        }
+    }
+    return true;
+}
