+void OM_Mec_COMPONENT::uploadServiceDataStatisticsInfo()
+{
+    if (!m_MqttConnected)
+    {
+        OM_MEC_ERROR_PRINT << "[error]mqtt clinet has not connected!";
+        return;
+    }
+    if(!m_RegisterFlag)
