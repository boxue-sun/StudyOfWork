+bool CCINDEX_COMPONENT::mqttReconnectCloud()
+{
+    CCINDEX_CLOUD_ERROR_PRINT << "[notice]mqtt-cloud reconnect!";
+    m_MqttReconnectCountCloud++;
+    if(m_MqttReconnectCountCloud < 100)
+    {
+        m_Eventloop->addTimer(std::bind(&CCINDEX_COMPONENT::mqttConnectCloud, this), m_MqttClientConfig.configerMqttCloud.mqttReconnectInterval, false);
+    }
+    else
+    {
+        if(m_MqttClientCloud)
+        {
+            MQTTAsync_destroy(&m_MqttClientCloud);
+            usleep(100000L);
+            m_MqttClientCloud = nullptr;
+            if(!mqttInitCloud())
+            {
+                CCINDEX_CLOUD_ERROR_PRINT << "[error]mqtt-cloud init failure!";
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
