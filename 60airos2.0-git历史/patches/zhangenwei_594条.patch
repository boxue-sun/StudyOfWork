+        {
+            //将json转换为结构体
+            /////////////////////////////////////////////
+            ConfigQueryData configData;
+            try
+            {
+                configData = subScribeJson;
+            }
+            catch (afl::base::json::exception &e)
+            {
+                CCINDEX_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+                return false;
+            }
+            if(insertOrUpdateConfigQueryData(m_ConfigQueryData, deviceId, configData))
+            {
+                if(getConfiger().enableDebugPrint)
+                {
+                    CCINDEX_DEBUG_PRINT << "[sucess]insert Or Update Query Config Data success!";
+                }
+            }
+            else
+            {
+                CCINDEX_ERROR_PRINT << "[Inter][error]insert Or Update Query Config Data  error!";
+                return false;
+            }
+            /////////////////////////////////////////////
+
+            if(insertOrUpdateConfigQueryDataJson(m_ConfigQueryDataJson, deviceId, subScribeJson))
+            {
+                if(getConfiger().enableDebugPrint)
+                {
+                    CCINDEX_DEBUG_PRINT << "[sucess]insert Or Update Config Data Json success!";
+                }
+            }
+            else
+            {
+                CCINDEX_ERROR_PRINT << "[Inter][error]insert Or Update Config Data Json  error!";
+                return false;
+            }
+        }
+        else
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error]get device id  error!";
+            return false;
+        }
+    } catch(exception& e)
+    {
+        CCINDEX_DEBUG_PRINT << "[error]" << e.what();
+    }
+
+    return true;
+}
