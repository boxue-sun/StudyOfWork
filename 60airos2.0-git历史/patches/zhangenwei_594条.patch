+        alarmManagementData.alarm.alarmRaisedTime = alarmManagementData.timeStamp;
+        alarmManagementData.alarm.alarmChangedTime = alarmManagementData.timeStamp + getConfiger().configerPublishPeriod.periodAlarmInfoUp;
+        alarmManagementData.alarm.alarmType = "highTemperCPUe";
+        publishData(m_MqttClientConfig.configerTopic.Topic_Alarm, alarmManagementData, hint);
+    }
+    if(runningInfo.cpuInfo.uti.size() > 0)
+    {
+        std::vector<double> data_values = extractValues(runningInfo.cpuInfo.uti);
+
+        for (double value : data_values)
+        {
+            if(value > 60)
+            {
+                alarmManagementData.alarm.alarmLevel = ALERT_MAJOR;
+                alarmManagementData.alarm.alarmStatus = ALARM_OCCURRED;
+                alarmManagementData.alarm.alarmRaisedTime = alarmManagementData.timeStamp;
+                alarmManagementData.alarm.alarmChangedTime = alarmManagementData.timeStamp + getConfiger().configerPublishPeriod.periodAlarmInfoUp;
+                alarmManagementData.alarm.alarmType = "highOccupancyCPU";
+                publishData(m_MqttClientConfig.configerTopic.Topic_Alarm, alarmManagementData, hint);
+            }
         }
     }
+    getMemInfo(runningInfo.memInfo);
+    if(runningInfo.memInfo.free < 512)
+    {
+        alarmManagementData.alarm.alarmLevel = ALERT_MAJOR;
+        alarmManagementData.alarm.alarmStatus = ALARM_OCCURRED;
+        alarmManagementData.alarm.alarmRaisedTime = alarmManagementData.timeStamp;
+        alarmManagementData.alarm.alarmChangedTime = alarmManagementData.timeStamp + getConfiger().configerPublishPeriod.periodAlarmInfoUp;
+        alarmManagementData.alarm.alarmType = "outOfDiskSpace";
+        publishData(m_MqttClientConfig.configerTopic.Topic_Alarm, alarmManagementData, hint);
+    }
+
+    tableInfo.first = getConfiger().configerDb.DbDeviceStatusTableName;
+    tableInfo.second = TABLE_TYEP_DEV_STATUS;
+    m_DeviceStatusMsgDBPtr->getAllDeviceStatus(tableInfo, statusList);
+    bool sensorDeviceOfflineFlag  = false;
+    for (auto status: statusList)
+    {
+        if ( mec::db::DEVICE_STATUS_DB_OFF == status.deviceStatus)
+        {
+            sensorDeviceOfflineFlag = true;
+
+        }
+    }
+    if(!sensorDeviceOfflineFlag)
+    {
+        alarmManagementData.alarm.alarmLevel = ALERT_MAJOR;
+        alarmManagementData.alarm.alarmStatus = ALARM_OCCURRED;
+        alarmManagementData.alarm.alarmRaisedTime = alarmManagementData.timeStamp;
+        alarmManagementData.alarm.alarmChangedTime = alarmManagementData.timeStamp + getConfiger().configerPublishPeriod.periodAlarmInfoUp;
+        alarmManagementData.alarm.alarmType = "ireOffLine";
+        publishData(m_MqttClientConfig.configerTopic.Topic_Alarm, alarmManagementData, hint);
+    }
+    std::string freeOutput = executeCommand("free -h");
+    double memoryUsagePercentage = getMemoryUsagePercentage(freeOutput);
+    if (memoryUsagePercentage >= 70)
+    {
+        alarmManagementData.alarm.alarmLevel = ALERT_MAJOR;
+        alarmManagementData.alarm.alarmStatus = ALARM_OCCURRED;
+        alarmManagementData.alarm.alarmRaisedTime = alarmManagementData.timeStamp;
+        alarmManagementData.alarm.alarmChangedTime = alarmManagementData.timeStamp + getConfiger().configerPublishPeriod.periodAlarmInfoUp;
+        alarmManagementData.alarm.alarmType = "outOfMemory";
+        publishData(m_MqttClientConfig.configerTopic.Topic_Alarm, alarmManagementData, hint);
+    }
+
+}
+std::vector<double> OM_Mec_COMPONENT::extractValues(const std::string& data_str)
+{
+    std::vector<double> data_values;
+    std::stringstream ss(data_str);
+    std::string item;
+
+    while (std::getline(ss, item, ','))
+    {
+        // 去掉百分号
+        item.pop_back();
+        data_values.push_back(std::stod(item));
+    }
+
+    return data_values;
+}
+double OM_Mec_COMPONENT::getMemoryUsagePercentage(const std::string& freeOutput)
+{
+    // 使用正则表达式匹配内存信息
+    std::regex pattern(R"(Mem:\s+(\d+\.\d+)\w+\s+(\d+\.\d+)\w+\s+(\d+\.\d+)\w+)");
+    std::smatch match;
+
+    if (std::regex_search(freeOutput, match, pattern))
+    {
+        double totalMemory = std::stod(match[1]);
+        double usedMemory = std::stod(match[2]);
+
+        // 计算内存占用率
+        return (usedMemory / totalMemory) * 100;
+    } else {
+        return -1.0;
+    }
+}
+
+std::string OM_Mec_COMPONENT::executeCommand(const std::string& command)
+{
+    // 执行 shell 命令并获取输出
+    FILE* pipe = popen(command.c_str(), "r");
+    if (!pipe)
+    {
+        return "";
+    }
+
+    char buffer[128];
+    std::string output = "";
+    while (fgets(buffer, sizeof(buffer), pipe) != NULL)
+    {
+        output += buffer;
+    }
+
+    int status = pclose(pipe);
+    if (status == -1)
+    {
+        return "";
+    }
 
+    return output;
 }
 
