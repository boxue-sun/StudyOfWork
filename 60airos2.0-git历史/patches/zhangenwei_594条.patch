+bool RADAR_CLOUD_COMPONENT::Proc(const std::shared_ptr<const  os::v2x::device::CloudData>& recv_data)
+{
+    if (!recv_data)
+    {
+        RADAR_CLOUD_ERROR_PRINT << "Received  channel failed!";
+        return false;
+    }
+    if (recv_data->payload_case() != os::v2x::device::CloudData::PayloadCase::kMqttData)
+    {
+        RADAR_CLOUD_ERROR_PRINT << "NOT MQTT MSG!";
+        return false;
+    }
+    std::string hint;
+    std::string topicPT;
+
+    std::string topic = recv_data->mqtt_data().topic();
+    const std::string& payload = recv_data->mqtt_data().data();
+    std::string topicProfix = topic.substr(0, topic.find("/"));
+    std::string hintMsg;
+    if(getConfiger().enableDebugPrint)
+    {
+//        if(getConfiger().enableDebugPrint)
+//        {
+//            RADAR_CLOUD_DEBUG_PRINT << "∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨";
+//        }
+        if(topicProfix == "camera")
+        {
+            hintMsg =  "om_camera 》》》 RADAR_CLOUD 》》》 cloud";
+        }
+        else  if(topicProfix == "radar")
+        {
+            hintMsg =  "om_camera 》》》 RADAR_CLOUD 》》》 cloud";
+        }
+        else  if(topicProfix == "rscu")
+        {
+            hintMsg = "om_mec 》》》 RADAR_CLOUD 》》》 cloud";
+        }
+        else
+        {
+            hintMsg = "xxx";
+        }
+        if(getConfiger().enableDebugPrint)
+        {
+            RADAR_CLOUD_DEBUG_PRINT << "[notice]" << hintMsg << " [topic]" << topic.c_str() << "[msg-json]"
+                                 << payload.c_str();
+        }
+    }
+//    if(getConfiger().enableDebugPrint)
+//    {
+//        RADAR_CLOUD_DEBUG_PRINT << "∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧";
+//    }
+
+    if(!payload.empty() && !topic.empty())
+    {
+        if (!mqttPushStringMsg2Broker(topic, payload, hint))
+        {
+            RADAR_CLOUD_ERROR_PRINT << "[error] Publish " << hint.c_str() << " data failure!";
+        }
+    }
+
+    return true;
+}
