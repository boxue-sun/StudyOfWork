+void DBUtils::getDBInfo(std::pair<std::string, TABLE_TYPE> tableInfo, std::vector<MsgDeviceStatus>& statusList, std::string DbFilePath)
+{
+    std::unique_ptr<DeviceStatusMsgDB> m_DeviceStatusMsgDBPtrTemp;
