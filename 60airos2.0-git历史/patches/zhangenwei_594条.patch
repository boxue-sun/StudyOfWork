+ *  Change History:
+ *  Date      Author    Version  ChangeId           Description
+ *  ------------------------------------------------------------------------------
+ *  24-6-12 alfred       1.0       ————             Create this file
+ *
+ * @endverbatim
+ ********************************************************************************/
+#include "om_camera_component.h"
+NAMESPACE_START_OM_COMPONENT_CAMERA
+
+bool OM_CAMERA_COMPONENT::Init()
+{
+    LOG_ERROR << "Received traffic light from device";
+    LOGINFO("Received traffic light from device");
+    m_Task.reset(new std::thread([&](){ initEventLoop(); }));
+
+    doBaiscWork();
+    return true;
+}
+bool OM_CAMERA_COMPONENT::initEventLoop()
+{
+    m_Eventloop = std::make_shared<afl::net::EventLoop>();
+    m_Eventloop->loop();
+    return true;
+}
+
+bool OM_CAMERA_COMPONENT::Proc(const std::shared_ptr<const  os::v2x::device::CloudData>& recv_data)
+{
+    LOG_INFO << "Received traffic light from device";
+    LOGINFO("Received traffic light from device");
+    if (!recv_data)
+    {
+        LOG_WARN << "Received traffic light data failed!";
+        return false;
+    }
+    if (recv_data->payload_case() != os::v2x::device::CloudData::PayloadCase::kMqttData)
+    {
+        LOG_WARN << "NOT MQTT MSG.";
+        return false;
+    }
+    std::string hint;
+    std::string topicPT;
+    auto mq_data = recv_data->mqtt_data();
+    std::string topic = mq_data.topic();
+    std::string payload(mq_data.data(), mq_data.data().size());
+
+    for (auto it = m_MqttClientConfig.topicUnMap.begin(); it != m_MqttClientConfig.topicUnMap.end(); ++it)
+    {
+        uint32_t cameraId = it->first;
+        const MqttTopicConfigerCamera& mqttTopicMecCameraTemp = it->second;
+        if(topic == mqttTopicMecCameraTemp.Topic_Restar && m_MqttClientConfig.configerEnable.Enable_Restar)
+        {
+            hint = "设备重启";
+            topicPT = mqttTopicMecCameraTemp.Topic_Restar;
+        }
+        else if(topic == mqttTopicMecCameraTemp.Topic_Upgrade  && m_MqttClientConfig.configerEnable.Enable_Upgrade)
+        {
+            hint = "升级";
+            topicPT = mqttTopicMecCameraTemp.Topic_Upgrade;
+        }
+        else if(topic == mqttTopicMecCameraTemp.Topic_Config_Query  && m_MqttClientConfig.configerEnable.Enable_Config_Query)
+        {
+            hint = "配置查询";
+            topicPT = mqttTopicMecCameraTemp.Topic_Config_Query;
+        }
+        else if(topic == mqttTopicMecCameraTemp.Topic_Config_Down && m_MqttClientConfig.configerEnable.Enable_Config_Down)
+        {
+            hint = "配置修改";
+            topicPT = mqttTopicMecCameraTemp.Topic_Config_Down;
+        }
+        else
+        {
+            hint = "";
+            topicPT = "";
+        }
+
+    }
+    if(!topicPT.empty())
+    {
+        if (!mqttPushStringMsg2Broker(topicPT, payload, hint))
+        {
+            ERRORPRINT("[error] Publish %s data failure!", hint.c_str());
+        }
+    }
+//    Send("/v2x/service/mec/data", mecDeviceData);
+    return true;
+}
