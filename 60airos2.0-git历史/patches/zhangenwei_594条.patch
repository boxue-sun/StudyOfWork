+bool BS_V2X_DATA_COMPONENT::mqttPublishMsg(const std::string &topic, const std::string &msg)
+{
+    if (!m_MqttConnected)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR <<"[error]mqtt connect sucess!";
+        }
+        return false;
+    }
+
+    if (msg.size() <= 0 || topic.empty())
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR <<"[error]len < 0 or topic empty!";
+        }
+        return false;
+    }
+
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    MQTTAsync_message pubmsg = MQTTAsync_message_initializer;
+    int rc;
+
+    opts.context = m_MqttClient;
+    pubmsg.payload = (void *) msg.c_str();
+    pubmsg.payloadlen = msg.length();
+    pubmsg.qos = m_MqttClientConfig.basicConfiger.mqtt_send_qos;
+    pubmsg.retained = 0;
+
+    if ((rc = MQTTAsync_sendMessage(m_MqttClient, topic.c_str(), &pubmsg, &opts)) != MQTTASYNC_SUCCESS)
+    {
+        if (rc == MQTTASYNC_DISCONNECTED)
+        {
+            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error]Async connect failure! it will reconnect !";
+            }
+            if (m_MqttConnected)
+            {
+                m_MqttConnected = false;
+                mqttReconnect();
+            }
+        }
+        else
+        {
+            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error]push msg failure，[error-code]" << rc;
+            }
+        }
+
+        return false;
+    }
+
+    return true;
+}
+
+int BS_V2X_DATA_COMPONENT::mqttSubscribeMsgArrvd(void *context, char *topicName, int topicLen, MQTTAsync_message *message)
+{
+    int ret = 1;
+    auto thiz = (BS_V2X_DATA_COMPONENT *) context;
+    if (message->payloadlen)
+    {
+        if(thiz->m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[topic]" <<  topicName << " [msg-len]" << message->payloadlen
+                      << " [msg]" <<  message->payload;
+        }
+
+        afl::base::json j;
+        try
+        {
+            j = afl::base::json::parse((char *) message->payload, (char *) message->payload + message->payloadlen);
+        }
+        catch (...)
+        {
+            if(thiz->m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR <<"[error]parse json failure!";
+            }
+            MQTTAsync_freeMessage(&message);
+            MQTTAsync_free(topicName);
+            return ret;
+        }
+
+        std::string topic(topicName, topicLen);
+        if (topic.size() <= 0)
+        {
+            if(thiz->m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR <<"[error]topic empty!";
+            }
+        } else
+        {
+            //把具体的消息处理放到主线程里，和定时器在一个线程，避免出现两个线程同时修改一个vector/map
+            thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+             {
+                 thiz->mqttDispatchSubscripeMessage(topic, j);
+             });
+        }
+    }
+
+    MQTTAsync_freeMessage(&message);
+    MQTTAsync_free(topicName);
+
+    return ret;
+}
+
+void BS_V2X_DATA_COMPONENT::mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json &j)
+{
+
+    return;
+}
+
+bool BS_V2X_DATA_COMPONENT::mqttPushStringMsg2Broker(string topic, string info, string hint)
+{
+    if(!info.empty())
+    {
+        if(!mqttPublishMsg(topic, info))
+        {
+            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error]push " << hint.c_str() << "failure!";
+            }
+            return false;
+        }
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
+}
+bool BS_V2X_DATA_COMPONENT::mqttPushJsonMsg2Broker(string topic, json info, string hint)
+{
+    std::string pData;
+    try{
+        pData = info.dump();
+    }catch (json::exception& e){
+        AIROS_ERRORPRINT("[what]%s [json-exception-id]%d", e.what(),  e.id);
+        return false;
+    }
+    if(!pData.empty())
+    {
+        if(!mqttPublishMsg(topic, pData))
+        {
+            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error]push " << hint.c_str() << "failure!";
+            }
+            return false;
+        }
+    }else
+    {
+        return false;
+    }
+    return true;
+}
