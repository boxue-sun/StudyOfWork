+bool BS_V2X_BSM_DATA_COMPONENT::mqttInitConnOpts()
+{
+    m_MqttConnOpts                      = MQTTAsync_connectOptions_initializer;
+    m_MqttConnOpts.connectTimeout       = m_MqttClientConfig.basicConfiger.mqtt_connect_timeout;
+    m_MqttConnOpts.keepAliveInterval    = m_MqttClientConfig.basicConfiger.mqtt_keep_alive;
+    m_MqttConnOpts.cleansession         = m_MqttClientConfig.basicConfiger.mqtt_clean_session;
+    m_MqttConnOpts.MQTTVersion          = m_MqttClientConfig.basicConfiger.mqtt_version;
+    m_MqttConnOpts.username             = m_MqttClientConfig.basicConfiger.mqtt_client_userName.c_str();
+    m_MqttConnOpts.password             = m_MqttClientConfig.basicConfiger.mqtt_client_password.c_str();
+    m_MqttConnOpts.onSuccess            = mqttOnConnect;
+    m_MqttConnOpts.onFailure            = mqttOnConnectFailure;
+    m_MqttConnOpts.context              = this;
+
+    return true;
+}
+
+bool BS_V2X_BSM_DATA_COMPONENT::mqttInit()
+{
+    m_MqttClient = nullptr;
+    m_MqttConnected = false;
+
+    mqttInitConnOpts();
+    std::string mqtt_broker_url_temp = m_MqttClientConfig.basicConfiger.mqtt_broker_url;
+    uint64_t nowTime = afl::util::TimeStamp::now(true).millSeconds();
+    std::string mqtt_client_id_temp = m_MqttClientConfig.v2xDataComponentConfiger.mqtt_client_id_v2x_data + ":" + std::to_string(nowTime);
+    if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[mqttBroker-Url]" << m_MqttClientConfig.basicConfiger.mqtt_broker_url.c_str()
+                  << "[client-id]" << mqtt_client_id_temp.c_str()
+                  << " [username]" <<  m_MqttClientConfig.basicConfiger.mqtt_client_userName.c_str()
+                  << "[passwd]" << m_MqttClientConfig.basicConfiger.mqtt_client_password.c_str();
+    }
+    if (MQTTASYNC_SUCCESS != MQTTAsync_create(&m_MqttClient, mqtt_broker_url_temp.c_str(),
+                                              mqtt_client_id_temp.c_str(), MQTTCLIENT_PERSISTENCE_NONE, NULL))
+    {
+
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[error]create connectiont failure!";
+        return false;
+    }
+
+    MQTTAsync_setCallbacks(m_MqttClient, this, mqttConnlost, mqttSubscribeMsgArrvd, NULL);
+
+    if (!mqttConnect())
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[error]Connect Failure!";
+        return false;
+    }
+
+    return true;
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::mqttDeinit()
+{
+    if (m_MqttClient)
+    {
+        MQTTAsync_disconnectOptions opts = MQTTAsync_disconnectOptions_initializer;
+        opts.onSuccess = mqttOnDisconnect;
+        opts.context = m_MqttClient;
+        MQTTAsync_disconnect(m_MqttClient, &opts);
+
+        int cnt = 0;
+        while (m_MqttConnected && (cnt < 30))
+        {
+            usleep(10000L);
+            cnt++;
+        }
+
+        MQTTAsync_destroy(&m_MqttClient);
+        m_MqttClient = nullptr;
+        m_MqttConnected = false;
+    }
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::mqttOnConnect(void *context, MQTTAsync_successData *response)
+{
+    auto thiz = (BS_V2X_BSM_DATA_COMPONENT *) context;
+    OM_MEC_BS_V2X_BSM_DATA_SUCESS_PRINT << "[sucess]connect sucess";
+    thiz->m_MqttConnected = true;
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    opts.onSuccess = mqttOnSubscribe;
+    opts.onFailure = mqttOnSubscribeFailure;
+    opts.context = thiz;
+
+    if(thiz->m_MqttClientConfig.basicConfiger.mqtt_real_subscribe_topic_num > 0)
+    {
+        if (MQTTAsync_subscribeMany(thiz->m_MqttClient,
+                                    thiz->m_MqttClientConfig.basicConfiger.mqtt_real_subscribe_topic_num,
+                                    thiz->m_MqttClientConfig.basicConfiger.mqtt_subscribe_topics,
+                                    thiz->m_MqttClientConfig.basicConfiger.mqtt_subscribe_qoss,
+                                    &opts) != MQTTASYNC_SUCCESS)
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[error]subscribe failure";
+        }
+    }
+
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::mqttOnConnectFailure(void *context, MQTTAsync_failureData *response)
+{
+    auto thiz = (BS_V2X_BSM_DATA_COMPONENT *) context;
+    if (response)
+    {
+        if (response->message)
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]connect failure [error-code]" <<  response->code <<" [error]%s" << response->message;
+        } else
+        {
+            OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]connect failure! [error-code]" << response->code;
+        }
+    } else
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]connect failure";
+    }
+
+    thiz->mqttReconnect();
+}
+
+
+bool BS_V2X_BSM_DATA_COMPONENT::mqttConnect()
+{
+    int rc;
+    if (MQTTASYNC_SUCCESS != (rc = MQTTAsync_connect(m_MqttClient, &m_MqttConnOpts)))
+    {
+        OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[error]connect error!";
+        m_MqttConnected = false;
+        return false;
+    }
+    return true;
+}
+
+bool BS_V2X_BSM_DATA_COMPONENT::mqttReconnect()
+{
+    OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[notice]mqtt reconnect!";
+    m_Eventloop->addTimer(std::bind(&BS_V2X_BSM_DATA_COMPONENT::mqttConnect, this), m_MqttClientConfig.basicConfiger.mqtt_reconnect_interval, false);
+
+    return true;
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::mqttConnlost(void *context, char *cause)
+{
+    auto thiz = (BS_V2X_BSM_DATA_COMPONENT *) context;
+    thiz->m_MqttConnected = false;
+    OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[failure]connect failure [cause]" << cause;
+    thiz->mqttReconnect();
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::mqttOnDisconnect(void *context, MQTTAsync_successData *response)
+{
+    auto thiz = (BS_V2X_BSM_DATA_COMPONENT *) context;
+    thiz->m_MqttConnected = false;
+    OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[notice]connect dist";
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::mqttOnSubscribe(void *context, MQTTAsync_successData *response)
+{
+    auto thiz = (BS_V2X_BSM_DATA_COMPONENT *) context;
+
+    OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[sucess]subscribe sucess!";
+}
+
+void BS_V2X_BSM_DATA_COMPONENT::mqttOnSubscribeFailure(void *context, MQTTAsync_failureData *response)
+{
+    auto thiz = (BS_V2X_BSM_DATA_COMPONENT *) context;
+    OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT <<"[failure]subscribe failure!";
+}
