+'''
+ * @Author: zhangenwei
+ * @Date: 2024-07-18 21:11:20
+ * @LastEditors: zhangenwei
+ * @LastEditTime: 2024-07-18 21:31:20
+ * @Description:
+'''
+import sys
+import time
+import numpy as np
+import cv2
+import json
+import os
+
+sys.path.append('/opt/local/cyber-rt/python/cyber/python/cyber_py3')
+sys.path.append('/home/airos/test_tools/proto_out')
+
+import cyber
+from google.protobuf.json_format import MessageToDict
+from header_pb2 import Header #os.v2x.device.RadarObstacles
+from sensor_image_pb2 import CompressedImage #adu.common.sensor.CompressedImage
+
+rtsp_url_profix = "rtsp://"
+channel_name_profix = '/sensor/ipcamera/h264/'  # 替换为实际的频道名称
+rtsp_url = None
+def cur_second(time_stamp):
+    import time
+    timestamp_s = time_stamp / 1000
+    current_time = time.localtime(timestamp_s)
+    current_second = current_time.tm_sec
+    current_millisecond = time_stamp % 1000
+
+    return  current_second + current_millisecond / 1000
+
+def pubnish_channel(channel_name, rtsp):
+    # RTSP video stream URL
+    cap = cv2.VideoCapture(rtsp)
+    if not cap.isOpened():
+        print("Error opening RTSP stream")
+        exit()
+    # 设置帧计数器
+    frame_count = 0
+    # 初始化 Cyber
+    cyber.init()
+    node = cyber.Node("writer")
+    writer = node.create_writer(channel_name, CompressedImage, 12400)
+    try:
+        while True:
+            ret, frame = cap.read()
+            if ret:
+                print("[Frame shape]{} [Frame data type]{} [Frame size]{}".format(frame.shape, frame.dtype, frame.size))
+                _object = CompressedImage()
+                header = Header()
+                header.timestamp_sec = time.time()
+                _object.header.CopyFrom(header)
+                _object.format = "jpg"
+                _object.data = cv2.imencode(".jpg", frame)[1].tobytes()
+                print("write msg -> %s" % _object.format)
+                writer.write(_object)
+                time.sleep(0.1)
+                if cv2.waitKey(1) & 0xFF == ord('q'):
+                    break
+            else:
+                print("Error reading frame from RTSP stream")
+                break
+    except KeyboardInterrupt:
+        print("Exiting program...")
+    # 关闭 Cyber
+    node.shutdown()
+    cap.release()
+    cyber.shutdown()
+
+if __name__ == '__main__':
+    ############################################################################
+    json_path = f"{os.path.dirname(os.path.abspath(__file__))}/configer.json"
+    ############################################################################
+    with open(json_path, 'r') as f:
+        config = json.load(f)
+    for item in config:
+        ############################################################################
+        ip_address  = item['ip']
+        port        = item['port']
+        user_name   = item['user_name']
+        password    = item['password']
+        ############################################################################
+        ip = ip_address.replace(".", "_")
+        print("[Ip]{} [Port]{}".format(ip, port))
+        print("----------------------------")
+        ############################################################################
+        if len(ip_address) > 0:
+            # global rtsp_url_profix, channel_name_profix
+            rtsp_url = f"{rtsp_url_profix}{user_name}:{password}@{ip_address}:{port}"
+            print("[rtsp_url]{}".format(rtsp_url))
+            # rtsp_url = "rtsp://admin:baidu123@172.20.65.88:554"
+            ############################################################################
+            channel_name = f"{channel_name_profix}{ip}"
+            print("[channel_name]{}".format(channel_name))
+            pubnish_channel(channel_name, rtsp_url)
+        else:
+            print("[error] the ip is empty!")
+
