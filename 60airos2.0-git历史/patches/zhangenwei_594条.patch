+import sys
+import time
+import numpy as np
+import cv2
+import io
+import json
+import os
+sys.path.append('/opt/local/cyber-rt/python/cyber/python/cyber_py3')
+sys.path.append('/home/airos/test_tools/proto_out')
+import cyber
+from google.protobuf.json_format import MessageToDict
+from header_pb2 import Header #os.v2x.device.RadarObstacles
+from sensor_image_pb2 import CompressedImage #adu.common.sensor.CompressedImage
+##########################################################################################
+rtsp_url_profix = "rtsp://"
+channel_name_profix = '/sensor/ipcamera/h264/'  # 替换为实际的频道名称
+frame_count = 0
+def data_process_callback(data):
+    print("Format:", data.format)
+    _object = CompressedImage()
+    global frame_count
+    try:
+        ############################################################################
+        # _object.ParseFromString(data)
+        img = cv2.imdecode(np.frombuffer(data.data, dtype=np.uint8), cv2.IMREAD_COLOR)
+        cv2.imwrite(f"frame_{frame_count}.jpg", img)
+        print(f"Saved frame_{frame_count}.jpg")
+        ############################################################################
+        frame_count += 1
+    except Exception as e:
+        print(f"Failed to parse message: {e}")
+def subscribe_node_init(channel_name):
+    cyber.init()
+    node = cyber.Node("reader")
+    sub = node.create_reader(channel_name, CompressedImage, data_process_callback)
+    # 让节点运行
+    node.spin()
+    # 关闭 Cyber
+    node.shutdown()
+    cyber.shutdown()
+
+if __name__ == "__main__":
+    ############################################################################
+    json_path = f"{os.path.dirname(os.path.abspath(__file__))}/configer.json"
+    ############################################################################
+    with open(json_path, 'r') as f:
+        config = json.load(f)
+    for item in config:
+        ############################################################################
+        ip_address  = item['ip']
+        port        = item['port']
+        user_name   = item['user_name']
+        password    = item['password']
+        ############################################################################
+        ip = ip_address.replace(".", "_")
+        print("[Ip]{} [Port]{}".format(ip, port))
+        print("----------------------------")
+        ############################################################################
+        if len(ip_address) > 0:
+            channel_name = f"{channel_name_profix}{ip}"
+            print("[channel_name]{}".format(channel_name))
+            subscribe_node_init(channel_name)
+        else:
+            print("[error] the ip is empty!")
