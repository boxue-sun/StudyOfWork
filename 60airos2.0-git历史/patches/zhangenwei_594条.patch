+#define CCINDEX_COMPONENT AIROS_COMPONENT_CLASS_NAME(CCIndexComponent)
+#define LOG_KEY_CCINDEX "[ccindex]"
+#define CCINDEX_DEBUG_PRINT LOG_INFO << LOG_KEY_CCINDEX
+#define CCINDEX_WARN_PRINT LOG_WARN << LOG_KEY_CCINDEX
+#define CCINDEX_ERROR_PRINT LOG_ERROR << LOG_KEY_CCINDEX
+#define CCINDEX_SUCESS_PRINT LOG_INFO << LOG_KEY_CCINDEX
+#define CCINDEX_FATAL_PRINT   LOG_FATAL << LOG_KEY_CCINDEX
+using namespace os::v2x::protocol;
+using namespace afl::base;
+
+#define MODULE_CONFIG_DIR "/home/airos/protocol/ccindex"
