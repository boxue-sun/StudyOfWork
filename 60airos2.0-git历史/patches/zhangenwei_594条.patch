+    MqttClientConfigerRadarTrafficMetrics 	            m_MqttClientConfig;
+    /////////////////////////////////////////////////////////////
+
+    std::string m_TrustCAFilePath;
+    std::string m_KeyFilePath;
+    std::string m_PrivateKeyFilePath;
+    uint64_t m_MsgCountSubscribeTrafficMetricsJson = 0;
+    uint64_t m_MsgCountSend2ChannelTrafficMetricsPb = 0;
+};
