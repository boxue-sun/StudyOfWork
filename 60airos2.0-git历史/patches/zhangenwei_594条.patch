+//rsu客户端配置
+struct MqttClientConfigerCamera : public ConfigerData<MqttClientConfigerCamera>
+{
+    bool                                hasInited = false;
+    bool                                enableDebugPrint = true;
+    std::string                         mqttClientId = "om-camera";
+    MqttTopicConfigerCameraRcId         configerTopicRcId;
+    MqttConfigerCommon                  configerMqtt;
+    ProjectPathConfiger                 configerProjectPath;
+    MqttEnableConfigerCamera            configerEnable;
+    ////////////////////////////////////////////////////////
+    MqttTopicConfigerCamera             configerTopic;
+    std::unordered_map<uint32_t, MqttTopicConfigerCamera>  topicUnMap;
+
+private:
+    virtual void writeToFile(ConfigBlock &j) override
+    {
+        JsonSerialize(hasInited, "A_hasInited", j, false);
+        JsonSerialize(enableDebugPrint, "B_enableDebugPrint", j, false);
+        JsonSerialize(mqttClientId, "C_mqttClientId", j, false);
+        JsonSerialize(configerTopicRcId, "D_configerTopicRcId", j, false);
+        JsonSerialize(configerMqtt, "E_configerMqtt", j, false);
+        JsonSerialize(configerProjectPath, "F_configerProjectPath", j, false);
+        JsonSerialize(configerEnable, "G_configerEnable", j, false);
+        JsonSerialize(configerTopic, "H_configerTopic", j, false);
+    }
+
+    virtual void readFromFile(const ConfigBlock &j) override
+    {
+        JsonDeserialize(hasInited, "A_hasInited", j, noUse_isEmptyFlag);
+        JsonDeserialize(enableDebugPrint, "B_enableDebugPrint", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttClientId, "C_mqttClientId", j, noUse_isEmptyFlag);
+        JsonDeserialize(configerTopicRcId, "D_configerTopicRcId", j, noUse_isEmptyFlag);
+        JsonDeserialize(configerMqtt, "E_configerMqtt", j, noUse_isEmptyFlag);
+        JsonDeserialize(configerProjectPath, "F_configerProjectPath", j, noUse_isEmptyFlag);
+        JsonDeserialize(configerEnable, "G_configerEnable", j, noUse_isEmptyFlag);
+        JsonDeserialize(configerTopic, "H_configerTopic", j, noUse_isEmptyFlag);
+    }
+
+public:
+    std::string to_string() const
+    {
+        std::stringstream ss;
+        ss << std::left << std::setw(40) << "A_hasInited: " << (hasInited ? "True" : "False") << "\n";
+        ss << std::left << std::setw(40) << "B_enableDebugPrint: " << (enableDebugPrint ? "True" : "False") << "\n";
+        ss << std::left << std::setw(40) << "C_mqttClientId: " << mqttClientId << "\n";
+        ss << std::left << std::setw(40) << "D_configerTopicRcId:\n " << configerTopicRcId.to_string() << "\n";
+        ss << std::left << std::setw(40) << "E_configerMqtt:\n " << configerMqtt.to_string() << "\n";
+        ss << std::left << std::setw(40) << "F_configerProjectPath:\n " << configerProjectPath.to_string() << "\n";
+        ss << std::left << std::setw(40) << "G_configerEnable:\n " << configerEnable.to_string() << "\n";
+        ss << std::left << std::setw(40) << "H_configerTopic:\n " << configerTopic.to_string() << "\n";
