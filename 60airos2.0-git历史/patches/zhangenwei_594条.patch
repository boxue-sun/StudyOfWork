+        JsonDeserialize(bit_rate,    "I_bit_rate",    j, g_flag_empty_novalid);
+        JsonDeserialize(pixel_format,    "J_pixel_format",    j, g_flag_empty_novalid);
+        JsonDeserialize(frame_position,    "K_frame_position",    j, g_flag_empty_novalid);
+    }
+public:
+    std::string to_string() const
+    {
+        std::stringstream ss;
+        ss << std::left << std::setw(40) << "Codec Name: " << codec_name << "\n";
