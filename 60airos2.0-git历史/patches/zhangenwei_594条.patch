+bool OM_Mec_COMPONENT::Proc(const std::shared_ptr<const  os::v2x::device::CloudData>& recv_data)
+{
+    LOG_INFO << "Received traffic light from device";
+    LOGINFO("Received traffic light from device");
+    if (!recv_data)
+    {
+        LOG_WARN << "Received traffic light data failed!";
+        return false;
+    }
+    if (recv_data->payload_case() != os::v2x::device::CloudData::PayloadCase::kMqttData)
+    {
+        LOG_WARN << "NOT MQTT MSG.";
+        return false;
+    }
+    std::string hint;
+    std::string topicPT;
+    auto mq_data = recv_data->mqtt_data();
+    std::string topic = mq_data.topic();
+    std::string payload(mq_data.data(), mq_data.data().size());
+
+
+    afl::base::json subScribeJson;
+    try
+    {
+        subScribeJson = afl::base::json::parse((char *) payload.c_str(), (char *) payload.length());
+    }
+    catch (...)
+    {
+        ERRORPRINT("[error]parse json failure!");
+        return false;
+    }
+
+    if (m_MqttClientConfig.configerEnable.Enable_Device_Info_Query &&
+        topic == m_MqttClientConfig.configerTopic.Topic_Device_Info_Query )
+    {
+        //设备信息查询
+        subscribeDeviceInfoQuery(subScribeJson);
+    }
+    else if (m_MqttClientConfig.configerEnable.Enable_Config_Query_Down &&
+             topic == m_MqttClientConfig.configerTopic.Topic_Config_Query_Down)
+    {
+        //配置查询
+        subscribeRebootData(subScribeJson);
+    }
+    else if (m_MqttClientConfig.configerEnable.Enable_Config_Update &&
+             topic == m_MqttClientConfig.configerTopic.Topic_Config_Update)
+    {
+        //配置修改
+        subscribeConfigUpdateData(subScribeJson);
+    }
+    else if (m_MqttClientConfig.configerEnable.Enable_Reboot &&
+             topic == m_MqttClientConfig.configerTopic.Topic_Reboot)
+    {
+        //设备重启
+        subscribeRebootData(subScribeJson);
+    }
+    else if (m_MqttClientConfig.configerEnable.Enable_Ota_Down &&
+             topic == m_MqttClientConfig.configerTopic.Topic_Ota_Down)
+    {
+        //设备升级
+        subscribeOtaDownData(subScribeJson);
+    }
+    else
+    {
+        ERRORPRINT("no subscribe this msg!")
+    }
+    if(!topicPT.empty())
+    {
+        if (!mqttPushStringMsg2Broker(topicPT, payload, hint))
+        {
+            ERRORPRINT("[error] Publish %s data failure!", hint.c_str());
+        }
+    }
+//    Send("/v2x/service/mec/data", mecDeviceData);
+    return true;
+}
+void OM_Mec_COMPONENT::doBaiscWork()
+{
+    //初始化mqtt配置
+    getMqttConfigerMsg();
+
+    if (!mqttInit())
+    {
+        ERRORPRINT("[error]mqttInit failure!");
+        return ;
+    }
+    if(!m_threadFuncInited)
+    {
+        m_TaskHttp.reset(new std::thread([&](){ processHttpPostRequest(); }));
+    }
+    m_ptpStatusUpTimer = m_Eventloop->addTimer(std::bind(&OM_Mec_COMPONENT::upPtpStatus, this), 60, true);
+
+    //定时设备心跳信息
+    m_TimerPublishDeviceHeartBeatData = m_Eventloop->addTimer(std::bind(&OM_Mec_COMPONENT::publishDeviceHeartbeatData, this),
+                                                              getConfiger().configerPublishPeriod.periodHeartBeatUp, true);
+    DeviceBaseInfoQueryData deviceBaseInfoQueryData;
+    deviceBaseInfoQueryData.infoId = DEVICE_RUNNING_STATUS;
+    m_TimerPublishDeviceRunningStatusData = m_Eventloop->addTimer(
+            std::bind(&OM_Mec_COMPONENT::publishRunningStatusData, this, deviceBaseInfoQueryData, DEVICE_BASIC_INFO_MEC),
+            getConfiger().configerPublishPeriod.periodRunningInfoUp, true);
+    m_OtaUpdateFd =  m_Eventloop->addTimer(std::bind(&OM_Mec_COMPONENT::getBinFileAndConfig, this),
+                                           getConfiger().configerPublishPeriod.periodDownloadBin, true);
+
+}
