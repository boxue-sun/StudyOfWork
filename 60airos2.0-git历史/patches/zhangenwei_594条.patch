+#include "sqlite_device_status.h"
+NAMESPACE_START_OM_COMPONENT_DEVICE_STATUS
+DeviceStatusMsgDB::DeviceStatusMsgDB(std::string databasePath) : sqlite_(nullptr),
+                                                                 datebaseName_(databasePath)
+{
+    // 打开数据库, 当数据库不存在时，自动创建。
+    OpenDB(datebaseName_);
+    // 创建表。如果表已经存在，该函数默认不创建
+    //    CreatTable(tableInfo.first, tableInfo.second);
+}
+DeviceStatusMsgDB::~DeviceStatusMsgDB()
+{
+    CloseDB();
+}
+bool DeviceStatusMsgDB::OpenDB(const string &dbPath)
+{
+    int result = sqlite3_open(dbPath.c_str(), &sqlite_);
+    if (result == SQLITE_OK)
+    {
+        SUCESSPRINT("[Sucess]Open datebase successful,the datebase path %s", dbPath.c_str());
+        return true;
+    }
+    else
+    {
+        ERRORPRINT("[error]Open datebase fail,the datebase path %s", dbPath.c_str());
+        return false;
+    }
+}
+void DeviceStatusMsgDB::CloseDB()
+{
+    if (sqlite_)
+    {
+        sqlite3_close(sqlite_);
+        sqlite_ = nullptr;
+    }
+}
+bool DeviceStatusMsgDB::CreatTable(std::pair<std::string, TABLE_TYPE> tableInfo)
+{
+    std::string sql;
+    switch(tableInfo.second)
+    {
+        case TABLE_TYEP_DEV_STATUS:  //设备状态表
+            sql = "CREATE TABLE IF NOT EXISTS \"" + tableInfo.first + "\" ("
+                                                                      "\"TIME_STAMP\" INTEGER, "
+                                                                      "\"DEVICE_TYPE\" INTEGER, "
+                                                                      "\"DEVICE_ID\" TEXT, "
+                                                                      "\"DEVICE_STATUS\" INTEGER "
+                                                                      ")";
+            break;
+        case TABLE_TYEP_SYNCHRONIZE:  //设备授时表
+            sql = "CREATE TABLE IF NOT EXISTS \"" + tableInfo.first + "\" ("
+                                                                      "\"TIME_STAMP\" INTEGER, "
+                                                                      "\"DEVICE_TYPE\" INTEGER, "
+                                                                      "\"DEVICE_ID\" TEXT, "
+                                                                      "\"DEVICE_STATUS\" INTEGER, "
+                                                                      "\"DEV_TIME\" INTEGER, "
+                                                                      "\"LAST_TIME\" INTEGER, "
+                                                                      "\"TIME_DIFF\" INTEGER, "
+                                                                      "\"LONGITUDE\" INTEGER, "
+                                                                      "\"LATITUDE\" INTEGER, "
+                                                                      "\"ALTITUDE\" INTEGER"
+                                                                      ")";
+            break;
+        default:
+            break;
+    }
+
+    if(sql.empty())
+    {
+        return false;
+    }
+    DEBUGPRINT("[sql]%s", sql.c_str());
+    char *sErrMsg = nullptr;
+    if (sqlite3_exec(sqlite_, sql.c_str(), NULL, NULL, &sErrMsg) != SQLITE_OK)
+    {
+        DEBUGPRINT("[error]Creat datebase table %s fail, %s", tableInfo.first.c_str(), sErrMsg);
+        return false;
+    }
+    sqlite3_free(sErrMsg);
+    return true;
+}
+
+std::string DeviceStatusMsgDB::getTableUpdateSql(std::pair<std::string, TABLE_TYPE> tableInfo, TABLE_OPERA_TYPE operType, const MsgDeviceStatus& status)
+{
+    std::string sql;
+    switch(operType)
+    {
+        case  TABLE_OPERA_TYPE_UPDATE:  //更新操作
+            switch(tableInfo.second)
+            {
+                case TABLE_TYEP_DEV_STATUS:  //设备状态表
+                    sql = "UPDATE \"" + tableInfo.first + "\" SET TIME_STAMP = ?, DEVICE_TYPE = ?, DEVICE_STATUS = ? "
+                                                          " WHERE DEVICE_ID = ?";
+                    break;
+                case TABLE_TYEP_SYNCHRONIZE:  //设备授时表
+                    sql = "UPDATE \"" + tableInfo.first + "\" SET TIME_STAMP = ?, DEVICE_TYPE = ?, DEVICE_STATUS = ?,"
+                                                          " DEV_TIME = ?, LAST_TIME = ?, TIME_DIFF = ?, LONGITUDE = ?, LATITUDE = ?, ALTITUDE = ? "
+                                                          " WHERE DEVICE_ID = ?";
+                    break;
+                default:
+                    break;
+            }
+            break;
+        case TABLE_OPERA_TYPE_INSERT:  //插入
+            switch(tableInfo.second)
+            {
+                case TABLE_TYEP_DEV_STATUS:  //设备状态表
+                    sql = "INSERT INTO \"" + tableInfo.first + "\" (TIME_STAMP, DEVICE_TYPE, DEVICE_ID, DEVICE_STATUS"
+                                                               ") VALUES (?, ?, ?, ?)";;
+                    break;
+                case TABLE_TYEP_SYNCHRONIZE:  //设备授时表
+                    sql = "INSERT INTO \"" + tableInfo.first + "\" (TIME_STAMP, DEVICE_TYPE, DEVICE_ID, DEVICE_STATUS, DEV_TIME, LAST_TIME, TIME_DIFF, LONGITUDE, LATITUDE, ALTITUDE"
+                                                               ") VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";
+                    break;
+                default:
+                    break;
+            }
+            break;
+
+        default:
+
+            break;
+
+    }
+    return sql;
+};
+
+bool DeviceStatusMsgDB::insertOrUpdateDeviceStatus(std::pair<std::string, TABLE_TYPE> tableInfo, const MsgDeviceStatus& status)
+{
+    sqlite3_stmt* stmt;
+    int count = 0;
+
+    std::string sql = "SELECT COUNT(*) FROM \"" + tableInfo.first + "\" WHERE DEVICE_ID = ?";
+    int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, nullptr);
+    if (rc == SQLITE_OK)
+    {
+        sqlite3_bind_text(stmt, 1, status.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+        if (sqlite3_step(stmt) == SQLITE_ROW)
+        {
+            count = sqlite3_column_int(stmt, 0);
+        }
+        else
+        {
+            DEBUGPRINT("[error]Check exists fail");
+            rc = -1;
+            return false;
+        }
+        //        sqlite3_finalize(stmt);
+    }
+    else
+    {
+        DEBUGPRINT("[error]Check exists fail %d", rc);
+        rc = -1;
+        return false;
+    }
+
+    if (count > 0)
+    {
+        std::string sql = getTableUpdateSql(tableInfo, TABLE_OPERA_TYPE_UPDATE, status);
+        int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, NULL);
+        if (rc == SQLITE_OK)
+        {
+            switch (tableInfo.second)
+            {
+                case TABLE_TYEP_DEV_STATUS:
+                    sqlite3_bind_int64(stmt, 1, status.timeStamp);
+                    sqlite3_bind_int(stmt, 2, status.deviceType);
+                    sqlite3_bind_int(stmt, 3, status.deviceStatus);
+                    sqlite3_bind_text(stmt, 4, status.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+                    break;
+                case TABLE_TYEP_SYNCHRONIZE:
+                    sqlite3_bind_int64(stmt, 1, status.timeStamp);
+                    sqlite3_bind_int(stmt, 2, status.deviceType);
+                    sqlite3_bind_int(stmt, 3, status.deviceStatus);
+                    sqlite3_bind_int64(stmt, 4, status.devTime);
+                    sqlite3_bind_int64(stmt, 5, status.lastTime);
+                    sqlite3_bind_int64(stmt, 6, status.timeDiff);
+                    sqlite3_bind_int64(stmt, 7, status.longitude);
+                    sqlite3_bind_int64(stmt, 8, status.latitude);
+                    sqlite3_bind_int64(stmt, 9, status.altitude);
+                    sqlite3_bind_text(stmt, 10, status.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+                    break;
+                default:
+                    break;
+            }
+
+            if(!stmt)
+            {
+                DEBUGPRINT("[error]stmt is null!");
+                return false;
+            }
+            char* expandedSql = sqlite3_expanded_sql(stmt);
+            DEBUGPRINT("[sql]\n%s", expandedSql);
+            sqlite3_free(expandedSql);
+            rc = sqlite3_step(stmt);
+            if (rc != SQLITE_DONE)
+            {
+                DEBUGPRINT("[error]: Update fail %d", rc);
+                rc = -1;
+                return false;
+            }
+            SUCESSPRINT("[sucess]update sucess!")
+            sqlite3_finalize(stmt);
+        }
+        else
+        {
+            DEBUGPRINT("[error]: Update fail %d", rc);
+            rc = -1;
+            return false;
+        }
+    }
+    else
+    {
+        std::string sql = getTableUpdateSql(tableInfo, TABLE_OPERA_TYPE_INSERT, status);
+        int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, NULL);
+        if (rc == SQLITE_OK)
+        {
+            switch (tableInfo.second)
+            {
+                case TABLE_TYEP_DEV_STATUS:
+                    sqlite3_bind_int64(stmt, 1, status.timeStamp);
+                    sqlite3_bind_int(stmt, 2, status.deviceType);
+                    sqlite3_bind_text(stmt, 3, status.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+                    sqlite3_bind_int(stmt, 4, status.deviceStatus);
+                    break;
+                case TABLE_TYEP_SYNCHRONIZE:
+                    sqlite3_bind_int64(stmt, 1, status.timeStamp);
+                    sqlite3_bind_int(stmt, 2, status.deviceType);
+                    sqlite3_bind_text(stmt, 3, status.deviceID.c_str(), -1, SQLITE_TRANSIENT);
+                    sqlite3_bind_int(stmt, 4, status.deviceStatus);
+                    sqlite3_bind_int64(stmt, 5, status.devTime);
+                    sqlite3_bind_int64(stmt, 6, status.lastTime);
+                    sqlite3_bind_int64(stmt, 7, status.timeDiff);
+                    sqlite3_bind_int64(stmt, 8, status.longitude);
+                    sqlite3_bind_int64(stmt, 9, status.latitude);
+                    sqlite3_bind_int64(stmt, 10, status.altitude);
+                    break;
+                default:
+                    break;
+            }
+            if(!stmt)
+            {
+                DEBUGPRINT("[error]stmt is null!");
+                return false;
+            }
+            char* expandedSql = sqlite3_expanded_sql(stmt);
+            DEBUGPRINT("[sql]\n%s", expandedSql);
+            sqlite3_free(expandedSql);
+            rc = sqlite3_step(stmt);
+            if (rc != SQLITE_DONE)
+            {
+                DEBUGPRINT("[error]: Update fail %d", rc);
+                rc = -1;
+                return false;
+            }
+            SUCESSPRINT("[sucess]insert sucess!")
+            sqlite3_finalize(stmt);
+        }
+    }
+
+    return true;
+}
+
+bool DeviceStatusMsgDB::getAllDeviceStatus(std::pair<std::string, TABLE_TYPE> tableInfo, std::vector<MsgDeviceStatus>& statusList)
+{
+    std::vector<std::string> kColumnNames;
+    switch (tableInfo.second)
+    {
+        case TABLE_TYEP_DEV_STATUS:
+            kColumnNames = {"TIME_STAMP", "DEVICE_TYPE", "DEVICE_ID", "DEVICE_STATUS"};
+            break;
+        case TABLE_TYEP_SYNCHRONIZE:
+            kColumnNames = {"TIME_STAMP", "DEVICE_TYPE", "DEVICE_ID", "DEVICE_STATUS", "DEV_TIME", "LAST_TIME", "TIME_DIFF", "LONGITUDE", "LATITUDE", "ALTITUDE"};
+            break;
+        default:
+            break;
+    }
+
+    sqlite3_stmt* stmt;
+    std::string sql = "SELECT ";
+    for (const auto& columnName : kColumnNames)
+    {
+        sql += columnName;
+        if (&columnName != &kColumnNames.back())
+        {
+            sql += ", ";
+        }
+    }
+    sql += " FROM \"" + tableInfo.first + "\"";
+
+    int rc = sqlite3_prepare_v2(sqlite_, sql.c_str(), -1, &stmt, nullptr);
+    if (rc != SQLITE_OK)
+    {
+        DEBUGPRINT("[error]: Prepare statement fail %s", sqlite3_errmsg(sqlite_));
+        return false;
+    }
+    char* expandedSql = sqlite3_expanded_sql(stmt);
+    DEBUGPRINT("[sql]\n%s", expandedSql);
+    sqlite3_free(expandedSql);
+    while ((rc = sqlite3_step(stmt)) == SQLITE_ROW)
+    {
+        MsgDeviceStatus status;
+        for (size_t i = 0; i < kColumnNames.size(); ++i)
+        {
+            switch (sqlite3_column_type(stmt, i))
+            {
+                case SQLITE_INTEGER:
+                    if (strcmp(kColumnNames[i].c_str(), "TIME_STAMP") == 0)
+                    {
+                        status.timeStamp = sqlite3_column_int64(stmt, i);
+                    }
+                    else if (strcmp(kColumnNames[i].c_str(), "DEVICE_TYPE") == 0)
+                    {
+                        status.deviceType = (DEVICE_TYPE_DB)sqlite3_column_int(stmt, i);
+                    }
+                    else if (strcmp(kColumnNames[i].c_str(), "DEVICE_STATUS") == 0)
+                    {
+                        status.deviceStatus = (DEVICE_STATUS_DB)sqlite3_column_int(stmt, i);
+                    }
+                    else if (strcmp(kColumnNames[i].c_str(), "DEV_TIME") == 0)
+                    {
+                        status.devTime = sqlite3_column_int64(stmt, i);
+                    }
+                    else if (strcmp(kColumnNames[i].c_str(), "LAST_TIME") == 0)
+                    {
+                        status.lastTime = sqlite3_column_int64(stmt, i);
+                    }
+                    else if (strcmp(kColumnNames[i].c_str(), "TIME_DIFF") == 0)
+                    {
+                        status.timeDiff = sqlite3_column_int64(stmt, i);
+                    }
+                    else if (strcmp(kColumnNames[i].c_str(), "LONGITUDE") == 0)
+                    {
+                        status.longitude = sqlite3_column_int64(stmt, i);
+                    }
+                    else if (strcmp(kColumnNames[i].c_str(), "LATITUDE") == 0)
+                    {
+                        status.latitude = sqlite3_column_int64(stmt, i);
+                    }
+                    else if (strcmp(kColumnNames[i].c_str(), "ALTITUDE") == 0)
+                    {
+                        status.altitude = sqlite3_column_int64(stmt, i);
+                    }
+                    else
+                    {
+
+                    }
+                    break;
+                case SQLITE_TEXT:
+                    if (strcmp(kColumnNames[i].c_str(), "DEVICE_ID") == 0)
+                    {
+                        status.deviceID = reinterpret_cast<const char*>(sqlite3_column_text(stmt, i));
+                    }
+                    break;
+                default:
+                    DEBUGPRINT("[error]: Unsupported column type %d for %s", sqlite3_column_type(stmt, i), kColumnNames[i].c_str());
+                    break;
+            }
+        }
+        statusList.push_back(status);
+    }
+    sqlite3_finalize(stmt);
+
+    if (rc != SQLITE_DONE)
+    {
+        DEBUGPRINT("[error]Error reading data %s", sqlite3_errmsg(sqlite_));
+        return false;
+    }
+
+    return true;
+}
+NAMESPACE_ENDED_OM_COMPONENT_DEVICE_STATUS
