+#!/usr/bin/env bash
+set -e
+
+# log_file=/home/airos/log/airos_launch.log."$(date +%Y%m%d-%H%M%S)"
+GLOBAL_KILL_DAG_NAME=""
+START_FRONT_MODULE=""
+return_info() {
+  local DATE_N=$(date "+%Y-%m-%d %H:%M:%S")
+  [[ $# -eq 0 ]] && return
+  echo -e "\033[1;32m [INFO]--- ${DATE_N} $* \033[0m"
+}
+
+function check_run() {
+  local command_line="$1"
+  if [[ -n ${command_line} ]]; then
+    launch_cmd="${command_line} > /dev/null 2>&1 &"
+    eval ${launch_cmd}
+    return_info "${launch_cmd} , run successfully! "
+  fi
+}
+function check_run_del_flag() {
+  local command_line="$1"
+  if [[ -n ${command_line} ]]; then
+    local service_name="${command_line##*/}"
+    service_name="${service_name%%.*}"
+    rm_module_flag="/home/airos/protocol/"
+    case "${service_name}" in
+          ccindex)
+              rm ${rm_module_flag}"ccindex/ccindex.flag"
+              ;;
+          om_device_status)
+              rm ${rm_module_flag}"ds/om_device_status.flag"
+              ;;
+          om_radar)
+              rm ${rm_module_flag}"radar/om_radar.flag"
+              ;;
+          om_camera)
+              rm ${rm_module_flag}"camera/om_camera.flag"
+              ;;
+          om_cloud)
+              rm ${rm_module_flag}"cloud/om_cloud.flag"
+              ;;
+          bs_angle_offset)
+              rm ${rm_module_flag}"mec/bs_angle_offset.flag"
+              ;;
+          bs_spat_src_data)
+              rm ${rm_module_flag}"mec/bs_spat_src_data.flag"
+              ;;
+          bs_v2x_data)
+              rm ${rm_module_flag}"mec/bs_v2x_data.flag"
+              ;;
+          bs_v2x_bsm_data)
+              rm ${rm_module_flag}"mec/bs_v2x_bsm_data.flag"
+              ;;
+          om_mec)
+              rm ${rm_module_flag}"mec/om_mec.flag"
+              ;;
+          *)
+#              echo "Unknown module: ${START_FRONT_MODULE}"
+#              print_usage
+              ;;
+      esac
+
+    launch_cmd="${command_line} > /dev/null 2>&1 &"
+    eval ${launch_cmd}
+    return_info "${launch_cmd} , run successfully! Service: ${service_name}"
+  fi
+}
+function check_run_front() {
+    local command_line="$1"
+    if [[ -n ${command_line} ]]; then
+      launch_cmd="${command_line}"
+      eval ${launch_cmd}
+    fi
+}
+function start_camera_viz() {
