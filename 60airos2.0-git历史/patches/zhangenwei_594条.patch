+                     std::to_string(rsapMsgHeader.TimestampMIN).c_str());
+    bufferUp.write(&rsapMsgHeader, sizeof(rsapMsgHeader));
+    printBufferData(bufferUp);
+    m_CurrConn->send(&bufferUp);
+    bufferUp.retrieveAll();
