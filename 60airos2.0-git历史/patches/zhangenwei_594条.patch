+/**
+ * @brief 获取服务器连接信息
+ * @return
+ */
+bool RSAP_COMPONENT::getServerConfigInfo(CloudServiceConfig &cloudServiceConfig)
+{
+    if (!LoadConfig(&m_Conf))
+    {
+        AERROR << "load component proto config error" << std::endl;
+        return false;
+    }
+    YAML::Node root_node = YAML::LoadFile(m_Conf.tcp_config().config_file());
+    if (!root_node.IsMap())
+    {
+        LOG(ERROR) << "config file format invalid, file=" << m_Conf.tcp_config().config_file();
+        return false;
+    }
+
+    //ip
+    std::string server_ip = root_node["server_ip"].as<std::string>();
+
+    int server_port = root_node["server_port"].as<int>();
+    uint16_t local_port = root_node["local_port"].as<int>();
+
+    std::string local_ip;
+    if (root_node["local_ip"].IsScalar())
+    {
+        local_ip = root_node["local_ip"].as<std::string>();
+    }
+    std::string protocol = "tcp";
+    if (root_node["protocol"].IsScalar())
+    {
+        protocol = root_node["protocol"].as<std::string>();
+    }
+    if (root_node["obj_rcuId"].IsScalar())
+    {
+        m_ObjRcuId = root_node["obj_rcuId"].as<std::string>();
+    }
+    if (root_node["obj_deviceType"].IsScalar())
+    {
+        m_ObjDeviceType = root_node["obj_deviceType"].as<int>();
+    }
+
+    LOG(WARNING) << "server_ip: " << server_ip << "\nserver_port: " << server_port
+                 << "\nlocal_ip: " << local_ip << "\nlocal_port: " << local_port
+                 << "\nprotocol: " << protocol;
+
+    m_CloudServiceConfig.serverIP = server_ip;
+    m_CloudServiceConfig.serverPort = server_port;
+    m_CloudServiceConfig.localPort = local_port;
+    return true;
+}
