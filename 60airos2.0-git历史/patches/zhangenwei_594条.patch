+double OM_DEVICE_STATUS_COMPONENT::getMemoryUsagePercentage(const std::string& freeOutput)
+{
+    // 使用正则表达式匹配内存信息
+    std::regex pattern(R"(Mem:\s+(\d+\.\d+)\w+\s+(\d+\.\d+)\w+\s+(\d+\.\d+)\w+)");
+    std::smatch match;
+    
+    if (std::regex_search(freeOutput, match, pattern))
+    {
+        double totalMemory = std::stod(match[1]);
+        double usedMemory = std::stod(match[2]);
+
+        // 计算内存占用率
+        return (usedMemory / totalMemory) * 100;
+    } else {
+        return -1.0;
+    }
+}
+std::vector<double> OM_DEVICE_STATUS_COMPONENT::extractValues(const std::string& data_str)
+{
+    std::vector<double> data_values;
+    std::stringstream ss(data_str);
+    std::string item;
+    
+    while (std::getline(ss, item, ','))
+    {
+        // 去掉百分号
+        item.pop_back();
+        data_values.push_back(std::stod(item));
+    }
+
+    return data_values;
+}
+std::string OM_DEVICE_STATUS_COMPONENT::executeCommand(const std::string& command)
+{
+    // 执行 shell 命令并获取输出
+    FILE* pipe = popen(command.c_str(), "r");
+    if (!pipe)
+    {
+        return "";
+    }
+    
+    char buffer[128];
+    std::string output = "";
+    while (fgets(buffer, sizeof(buffer), pipe) != NULL)
+    {
+        output += buffer;
+    }
+
+    int status = pclose(pipe);
+    if (status == -1)
+    {
+        return "";
+    }
+
+    return output;
+}
+void  OM_DEVICE_STATUS_COMPONENT::getDiskStats(DiskInfo &diskInfo)
+{
+    long readSectors = 0;
+    long writeSectors = 0;
+    long readRequests = 0;
+    long writeRequests = 0;
+    ifstream file("/proc/diskstats");
+    if (file.is_open())
+    {
+        string line;
+        while (getline(file, line))
+        {
+            istringstream iss(line);
+            vector<string> fields;
+            string field;
+            while (iss >> field)
+            {
+                fields.push_back(field);
+            }
+            if (fields.size() >= 14)
+            {
+                string device_name = fields[2];
+                long read_sectors = stol(fields[5]);
+                long write_sectors = stol(fields[9]);
+                long read_requests = stol(fields[3]);
+                long write_requests = stol(fields[7]);
+
+                // 获取设备容量信息
+                struct statvfs fs;
+                if (statvfs(("/dev/" + device_name).c_str(), &fs) == 0)
+                {
+                    diskInfo.total += fs.f_blocks * fs.f_frsize;
+                    diskInfo.used += (fs.f_blocks - fs.f_bfree) * fs.f_frsize;
+                }
+
+                // 累加读写扇区数和请求数
+                readSectors   += read_sectors;
+                writeSectors  += write_sectors;
+                readRequests  += read_requests;
+                writeRequests += write_requests;
+            }
+        }
+        file.close();
+    }
+
+    // 计算可用磁盘空间
+    diskInfo.free = diskInfo.total - diskInfo.used;
+
+    // 计算���秒的读写数据量和 IOPS
+    diskInfo.read = readSectors * 512.0 / 1024 / 1024; // MB/s
+    diskInfo.write = writeSectors * 512.0 / 1024 / 1024; // MB/s
+    diskInfo.tps = readRequests + writeRequests;
+
+    return ;
+}
+void OM_DEVICE_STATUS_COMPONENT::getMemInfo(MemInfo &memInfo)
+{
+    FILE *fd1 = fopen("/proc/meminfo", "r");
+    char buff[256];
+    if (fd1 != NULL)
+    {
+        char name[20];
+        unsigned long memTotal = 0;
+        unsigned long memFree = 0;
+        if(fgets(buff, sizeof(buff), fd1) == NULL)
+        {
+            OM_DS_ERROR_PRINT << "fgets error";
+        }
+        sscanf(buff, "%s %lu ", name, &memTotal);
+        if(fgets(buff, sizeof(buff), fd1) == NULL)
+        {
+            OM_DS_ERROR_PRINT << "fgets error";
+        }
+        sscanf(buff, "%s %lu ", name, &memFree);
+
+        fclose(fd1);
+        memInfo.total = (double) memTotal / 1024.0;
+        memInfo.used = (double) (memTotal - memFree) / 1024.0;
+        memInfo.free = (double) memFree / 1024.0;
+    }
+}
