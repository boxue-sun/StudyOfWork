+
+    enum MESSAGE_TYPE{MT_BSM = 111, MT_MAP=3618, MT_SPAT=3619, MT_RTE=3622, MT_RTS=3620,  MT_RSM=3623};
+    int                                     m_MsgType;
+
+};
