+
+#include "camera_cictci_component.h"
+
+namespace os {
+namespace v2x {
+namespace device {
+
+bool AIROS_COMPONENT_CLASS_NAME(CameraCictciComponent)::Init()
+{
+  if (!LoadConfig(&conf_))
+  {
+    CAMERA_CICTCI_SERVICE_LOG_ERROR << "load component proto config error";
+    return false;
+  }
+  MEC_SERVICE_LOG_INFO << "device:" << conf_.device();
+  device_ = CameraCictciDeviceFactory::Instance().GetUnique(conf_.device(),
+      std::bind(&AIROS_COMPONENT_CLASS_NAME(CameraCictciComponent)::CallBack, this, std::placeholders::_1));
+
+  if (device_ == nullptr || !device_->Init(conf_.config_file()))
+  {
+    CAMERA_CICTCI_SERVICE_LOG_ERROR << "device_ init error";
+    return false;
+  }
+  else
+  {
+    CAMERA_CICTCI_SERVICE_LOG_INFO << "device init sucess!";
+  }
+
+  task_.reset(new std::thread([&]() { device_->Start(); }));
+
+  return true;
+}
+
+bool AIROS_COMPONENT_CLASS_NAME(CameraCictciComponent)::Proc(
+    const std::shared_ptr<const adu::common::sensor::CompressedImage>& recv_data) {
+  device_->WriteToDevice(recv_data);
+  return true;
+}
+
+void AIROS_COMPONENT_CLASS_NAME(CameraCictciComponent)::CallBack(const CameraCictciDataType& data)
+{
+  Send("/v2x/device/mec/data", data);
+}
