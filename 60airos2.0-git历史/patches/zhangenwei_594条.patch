+    }
+
+    if (mecDeviceData->events_size() > 0)
+    {
+        makeEventUpData(mecDeviceData);
+        return true;
+    }
+
+    if (mecDeviceData->has_mec_heart_beat())
+    {
+        makeStatusUpData(mecDeviceData);
+        return true;
+    }
+
     return true;
