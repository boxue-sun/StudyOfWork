+#pragma once
+#include <iomanip>
+#include "base/common/network/serializable_data.h"
+namespace os {
+namespace v2x {
+namespace device {
+using namespace afl::base;
+struct CameraConfigerData : public afl::base::SerializableData
+{
+    std::string remote_ip;
+    int         remote_port;
+    std::string host_ip = "";
+    int         host_port = 0;
+    std::string user;
+    std::string password;
+    std::string camera_manufactor;
+    std::string lens_type;
+    std::string img_mode;
+    std::string protocol;
+public:
+    virtual void serialize(json& j) override
+    {
+        JsonSerialize(remote_ip, "remote_ip", j, false);
+        JsonSerialize(remote_port, "remote_port", j, false);
+        JsonSerialize(host_ip, "host_ip", j, false);
+        JsonSerialize(host_port, "host_port", j, false);
+        JsonSerialize(user, "user", j, false);
+        JsonSerialize(password, "password", j, false);
+        JsonSerialize(camera_manufactor, "camera_manufactor", j, false);
+        JsonSerialize(lens_type, "lens_type", j, false);
+        JsonSerialize(img_mode, "img_mode", j, false);
+        JsonSerialize(protocol, "protocol", j, false);
+    }
+
+    virtual void deserialize(const json& j) override
+    {
+        JsonDeserialize(remote_ip, "remote_ip", j, g_flag_empty_novalid);
+        JsonDeserialize(remote_port, "remote_port", j, g_flag_empty_novalid);
+        JsonDeserialize(host_ip, "host_ip", j, g_flag_empty_novalid);
+        JsonDeserialize(host_port, "host_port", j, g_flag_empty_novalid);
+        JsonDeserialize(user, "user", j, g_flag_empty_novalid);
+        JsonDeserialize(password, "password", j, g_flag_empty_novalid);
+        JsonDeserialize(camera_manufactor, "camera_manufactor", j, g_flag_empty_novalid);
+        JsonDeserialize(lens_type, "lens_type", j, g_flag_empty_novalid);
+        JsonDeserialize(img_mode, "img_mode", j, g_flag_empty_novalid);
+        JsonDeserialize(protocol, "protocol", j, g_flag_empty_novalid);
+    }
+public:
+    std::string to_string() const
+    {
+        std::stringstream ss;
+        ss << std::left << std::setw(40) << "remote_ip: " << remote_ip << "\n";
+        ss << std::left << std::setw(40) << "remote_port: " << remote_port << "\n";
+        ss << std::left << std::setw(40) << "host_ip: " << host_ip << "\n";
+        ss << std::left << std::setw(40) << "host_port: " << host_port << "\n";
+        ss << std::left << std::setw(40) << "user: " << user << "\n";
+        ss << std::left << std::setw(40) << "password: " << password << "\n";
+        ss << std::left << std::setw(40) << "camera_manufactor: " << camera_manufactor << "\n";
+        ss << std::left << std::setw(40) << "lens_type: " << lens_type << "\n";
+        ss << std::left << std::setw(40) << "img_mode: " << img_mode << "\n";
+        ss << std::left << std::setw(40) << "protocol: " << protocol << "\n";
+        return ss.str();
+    }
+};
