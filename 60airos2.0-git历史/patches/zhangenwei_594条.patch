+void OM_Mec_COMPONENT::publishConfigQueryAckData(ConfigQueryData &configQueryData)
+{
+    if (!m_MqttConnected)
+    {
+        return;
+    }
+
+    std::string hint = "配置查询响应";
+    ConfigQueryAckData configQueryAckData;
+    configQueryAckData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    configQueryAckData.seqNum    = configQueryData.seqNum;
+    configQueryAckData.rscuEsn   = m_MqttClientConfig.rscuEsn;
+    configQueryAckData.pointNo   = getConfiger().configerOmCommon.pointNo;
+    configQueryAckData.pointName = getConfiger().configerOmCommon.pointName;
+    configQueryAckData.deviceName = getConfiger().configerOmCommon.deviceName;
+    configQueryAckData.longitude = getConfiger().configerOmCommon.longitude;
+    configQueryAckData.latitude     = getConfiger().configerOmCommon.latitude;
+    configQueryAckData.altitude = getConfiger().configerOmCommon.elevation;
+    configQueryAckData.height   = getConfiger().configerOmCommon.height;
+    configQueryAckData.siteType  = (SiteTypeEnum)getConfiger().configerOmCommon.siteType;
+    if (!mqttPushMsg2Broker(m_MqttClientConfig.configerTopic.Topic_Config_Query_Down,configQueryAckData, hint))
+    {
+        ERRORPRINT("[error] Publish %s data failure!", hint.c_str());
+    }
