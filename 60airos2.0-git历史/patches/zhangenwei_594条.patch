+        ss << std::left << std::setw(40) << "sensor_data_up_obj_package: "                  << sensor_data_up_obj_package << std::endl;
+        ss << std::left << std::setw(40) << "sensor_data_up_obj_num: "                  << sensor_data_up_obj_num << std::endl;
+        return ss.str();
+    }
+};
