+    virtual void deserialize(const json &j) override
+    {
+        JsonDeserialize(mec_device_yaml_path, "A_mec_device_yaml_path", j, noUse_isEmptyFlag);
+    }
+
+public:
+    std::string to_string() const
+    {
+        std::stringstream ss;
