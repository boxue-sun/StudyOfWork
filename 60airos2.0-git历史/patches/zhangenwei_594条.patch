+void OM_CAMERA_COMPONENT::mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json & subScribeJson)
+{
+    if (!m_MqttConnected)
+    {
+        ERRORPRINT("[error]mqtt clinet has not connected!");
+        return;
+    }
+
+    if (topic.empty())
+    {
+        ERRORPRINT("topic empty!")
+        return;
+    }
+    std::string hint;
+    std::string topicPT;
+    for (auto it = m_MqttClientConfig.topicUnMap.begin(); it != m_MqttClientConfig.topicUnMap.end(); ++it)
+    {
+        uint32_t cameraId = it->first;
+        const MqttTopicConfigerCamera& mqttTopicMecCameraTemp = it->second;
+        if(topic == mqttTopicMecCameraTemp.Topic_Register && m_MqttClientConfig.configerEnable.Enable_Register)
+        {
+            hint = "设备注册";
+            topicPT = mqttTopicMecCameraTemp.Topic_Register;
+        }
+        else  if(topic == mqttTopicMecCameraTemp.Topic_Keepalive  && m_MqttClientConfig.configerEnable.Enable_Keepalive)
+        {
+            hint = "心跳信息";
+            topicPT = mqttTopicMecCameraTemp.Topic_Keepalive;
+        }
+        else  if(topic == mqttTopicMecCameraTemp.Topic_Alarm  && m_MqttClientConfig.configerEnable.Enable_Alarm)
+        {
+            hint = "告警事件";
+            topicPT = mqttTopicMecCameraTemp.Topic_Alarm;
+        }
+        else  if(topic == mqttTopicMecCameraTemp.Topic_Synchronize  && m_MqttClientConfig.configerEnable.Enable_Synchronize)
+        {
+            hint = "校时";
+            topicPT = mqttTopicMecCameraTemp.Topic_Synchronize;
+        }
+        else  if(topic == mqttTopicMecCameraTemp.Topic_Config_Query_Ack  && m_MqttClientConfig.configerEnable.Enable_Config_Query_Ack)
+        {
+            hint = "配置查询响应";
+            topicPT = mqttTopicMecCameraTemp.Topic_Config_Query_Ack;
+        }
+        else  if(topic == mqttTopicMecCameraTemp.Topic_Config_Down_ACK && m_MqttClientConfig.configerEnable.Enable_Config_Down_ACK)
+        {
+            hint = "配置修改确认";
+            topicPT = mqttTopicMecCameraTemp.Topic_Config_Down_ACK;
+        }
+        else  if(topic == mqttTopicMecCameraTemp.Topic_Runstatus && m_MqttClientConfig.configerEnable.Enable_Runstatus)
+        {
+            hint = "性能上报";
+            topicPT = mqttTopicMecCameraTemp.Topic_Runstatus;
+        }
+        else  if(topic == mqttTopicMecCameraTemp.Topic_UpgradeStatus && m_MqttClientConfig.configerEnable.Enable_UpgradeStatus)
+        {
+            hint = "升级状态";
+            topicPT = mqttTopicMecCameraTemp.Topic_UpgradeStatus;
+        }
+        else
+        {
+            hint = "";
+            topicPT = "";
+        }
+    }
+
+
+    if(!topicPT.empty())
+    {
+        auto cloud_data = std::make_shared<os::v2x::device::CloudData>();
+        auto mqtt_data  = cloud_data->mutable_mqtt_data();
+        mqtt_data->set_topic(topicPT);
+        std::string msg = subScribeJson.dump();
+        mqtt_data->set_data(msg.data(), msg.size());
+        LOG_ERROR << "msg:" << cloud_data->DebugString();
+        Send("/v2x/cloud/report/mqtt", cloud_data);
+    }
+
+    return;
+}
