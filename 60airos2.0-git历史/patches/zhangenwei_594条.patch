+                ss << "\n" << std::setfill(' ') << std::setw(25) << "latitude: "<< std::hex  << std::setfill('0') << std::setw(2)  << static_cast<uint64_t>(vehiclePositionInfo.latitude) ;
+                ss << "\n" << std::setfill(' ') << std::setw(25) << "posConfidence: " << std::hex  << std::setfill('0') << std::setw(2)   << static_cast<int>(vehiclePositionInfo.posConfidence);
+                ss << "\n" << std::setfill(' ') << std::setw(25) << "speed: " << std::hex  << std::setfill('0') << std::setw(2)   << static_cast<int>(vehiclePositionInfo.speed);
+                ss << "\n" << std::setfill(' ') << std::setw(25) << "speedConfidence: " << std::hex  << std::setfill('0') << std::setw(2)   << static_cast<int>(vehiclePositionInfo.speedConfidence);
+                ss << "\n" << std::setfill(' ') << std::setw(25) << "heading: " << std::hex  << std::setfill('0') << std::setw(2)  << static_cast<uint64_t>(vehiclePositionInfo.heading);
+                ss << "\n" << std::setfill(' ') << std::setw(25) << "headConfidence: " << std::hex  << std::setfill('0') << std::setw(2) << static_cast<int>(vehiclePositionInfo.headConfidence);
+                ss << "\n ---------- \n";
+            }
+        }
+
+
+    }catch(afl::util::Exception & e)
+    {
+        LOG_ERROR << "[error]" << e.what();
+    }
+    return ss.str();
+}
