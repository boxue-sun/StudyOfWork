+
+#include "cictci_camera.h"
+#include "base/common/log.h"
+
+namespace os {
+namespace v2x {
+namespace device {
+CameraCictci::~CameraCictci()
+{
+
+}
+
+bool CameraCictci::Init(const std::string &config_file)
+{
+    if(!has_send_once)
+    {
+        sender_(output_data_image_);
+        has_send_once = true;
+    }
+
+    try {
+        YAML::Node root_node = YAML::LoadFile(config_file);
+        if (!root_node.IsMap())
+        {
+            CAMERA_CICTCI_SERVICE_LOG_ERROR << "config file format invalid, file=" << config_file;
+            return false;
+        }
+        camera_configer_data.remote_ip = root_node["ip"].as<std::string>();
+        camera_configer_data.remote_port = root_node["port"].as<int>();
+        camera_configer_data.user = root_node["user"].as<std::string>();
+        camera_configer_data.password = root_node["password"].as<std::string>();
+        camera_configer_data.protocol = root_node["protocol"].as<std::string>();
+        camera_configer_data.host_port = root_node["local_port"].as<int>();
+
+        CAMERA_CICTCI_SERVICE_LOG_INFO << camera_configer_data.to_string();
+
+        if (!InitProtocol(camera_configer_data))
+        {
+            CAMERA_CICTCI_SERVICE_LOG_ERROR << "cictci-mec worker init failed!";
+            return false;
+        }
+    } catch (...) {
+    CAMERA_CICTCI_SERVICE_LOG_ERROR << "Config file format wrong! Please check the format, file=" << config_file;
+        return false;
+    }
+
+    return true;
+}
+
+void CameraCictci::Start()
+{
+
+    thread_process_recv_.reset(new std::thread(std::bind(&CameraCictci::TaskProcessRecvFrame, this)));
+    return;
+}
+
+void CameraCictci::WriteToDevice(const std::shared_ptr<const adu::common::sensor::CompressedImage> &re_proto)
+{
+    return;
+}
+
+
+void CameraCictci::Stop()
+{
+    stop_ = true;
+    if (thread_process_recv_ != nullptr && thread_process_recv_->joinable())
+    {
+        thread_process_recv_->join();
+    }
+}
+void CameraCictci::TaskProcessRecvFrame()
+{
+    CAMERA_CICTCI_SERVICE_LOG_ERROR << "start task : process response.";
+    auto oriBuf = afl::net::ByteBuffer(512, 65536);
+    ssize_t recv_len = -1;
+    int             ret;
+    while (!stop_)
+    {
+        do {
+            ret = av_read_frame(ifmt_ctx, &pkt);
+            if (!nRestart)
+            {
+                pVst            = ifmt_ctx->streams[video_st_index];
+                pVideoCodecCtx  = pVst->codec;
+                pVideoCodec     = avcodec_find_decoder(pVideoCodecCtx->codec_id);
+                if (pVideoCodec == nullptr)
+                {
+                    return;
+                }
+                if (avcodec_open2(pVideoCodecCtx, pVideoCodec, nullptr) < 0)
+                {
+                    return;
+                }
+
+                nRestart = true;
+            }
+            if (pkt.stream_index == video_st_index)
+            {
+                std::stringstream hex_stream;
+                hex_stream << std::hex << std::setfill('0');
+                for (int i = 0; i < std::min(pkt.size, 16); i++) {
+                    hex_stream << std::setw(2) << static_cast<int>(pkt.data[i]) << " ";
+                }
+                CAMERA_CICTCI_SERVICE_LOG_INFO << "[size]" << pkt.size
+                                                   << "[pts]" <<  pkt.pts  << "[data]" << hex_stream.str();
+
+                oriBuf.ensureWritableBytes(pkt.size);
+                memcpy(oriBuf.beginWrite(), pkt.data, pkt.size);
+                oriBuf.hasWritten(pkt.size);
+                if(pkt.size > 0)
+                {
+                    AVCodec* pCodec = avcodec_find_decoder(pVideoCodecCtx->codec_id);
+                    const char* codec_name = pCodec->name;
+                    video_info.codec_name = pCodec->name;
+
+                    AVPixelFormat pixel_format = pVideoCodecCtx->pix_fmt;
+                    video_info.pixel_format = pVideoCodecCtx->pix_fmt;
+
+                    int width = pVideoCodecCtx->width;
+                    video_info.width = pVideoCodecCtx->width;
+                    int height = pVideoCodecCtx->height;
+                    video_info.height = pVideoCodecCtx->height;
+
+                    AVStream* pStream = ifmt_ctx->streams[pkt.stream_index];
+                    double fps = av_q2d(pStream->avg_frame_rate);
+                    video_info.fps = av_q2d(pStream->avg_frame_rate);
+
+                    AVRational time_base = pStream->time_base;
+                    video_info.time_base = pStream->time_base;
+
+                    double duration = pStream->duration * av_q2d(pStream->time_base);
+                    video_info.duration =  pStream->duration * av_q2d(pStream->time_base);
+
+                    double start_time = pStream->start_time * av_q2d(pStream->time_base);
+                    video_info.start_time = pStream->start_time * av_q2d(pStream->time_base);
+
+                    int bit_rate = pVideoCodecCtx->bit_rate;
+                    video_info.bit_rate = pVideoCodecCtx->bit_rate;
+
+                    //帧序号
+                    video_info.frame_position = av_frame_get_pkt_pos(pFrame);
+                    CAMERA_CICTCI_SERVICE_LOG_INFO << video_info.to_string();
+                    auto header = output_data_image_->mutable_header();
+                    header->set_module_name("camera-cictci");
+                    header->set_timestamp_sec(afl::util::TimeStamp::now(true).millSeconds());
+                    header->set_sequence_num(m_sequence_num++);
+                    header->set_frame_id(std::to_string(video_info.frame_position));
+
+                    output_data_image_->set_frame_id(std::to_string(video_st_index));
+                    output_data_image_->set_format(video_info.codec_name);
+                    output_data_image_->set_data(oriBuf.peek(), oriBuf.readableBytes());
+                    CAMERA_CICTCI_SERVICE_LOG_INFO << output_data_image_->DebugString();
+//                    printBufferData(oriBuf, "摄像机数据");
+                    oriBuf.retrieveAll();
+                }
+
+            }
+        }while (ret == AVERROR(EAGAIN));
+        if (ret < 0)
+        {
+            CAMERA_CICTCI_SERVICE_LOG_INFO << "[error]Could not read frame," << av_make_error_string(errbuf, sizeof(errbuf), ret);
+            if (nullptr != ifmt_ctx)
+            {
+                avformat_close_input(&ifmt_ctx);
+                ifmt_ctx = nullptr;
+            }
+        }
+
+        if (pkt.stream_index == video_st_index)
+        {
+            CAMERA_CICTCI_SERVICE_LOG_INFO << "Video Packet size:" << pkt.size;
+        }
+        else if (pkt.stream_index == audio_st_index)
+        {
+            CAMERA_CICTCI_SERVICE_LOG_INFO << "Audio Packet size:" << pkt.size;
+        }
+        else
+        {
+            CAMERA_CICTCI_SERVICE_LOG_INFO << "Unknow Packet size:" << pkt.size;
+        }
+        av_packet_unref(&pkt);
+
+
+
+    }
+
+    CAMERA_CICTCI_SERVICE_LOG_ERROR << "task over : process response.";
+
+}
+
+bool CameraCictci::InitProtocol(CameraConfigerData& camera_configer_data)
+{
+    std::string rtsp_url = "rtsp://admin:baidu123@172.20.65.88:554";
+
+    av_register_all();
+    avformat_network_init();
+    av_init_packet(&pkt);
+    pkt.data = nullptr;
+    pkt.size = 0;
+
+    pFrame      = av_frame_alloc();
+    pFrameRGB   = av_frame_alloc();
+
+    int             ret;
+
+    if ((ret = avformat_open_input(&ifmt_ctx, rtsp_url.c_str(), 0, &optionsDict)) < 0)
+    {
+        CAMERA_CICTCI_SERVICE_LOG_ERROR  << "[error]Could not open input file " <<   rtsp_url.c_str() << "error: " << av_make_error_string(errbuf, sizeof(errbuf), ret);
+        if (nullptr != ifmt_ctx)
+        {
+            avformat_close_input(&ifmt_ctx);
+            ifmt_ctx = nullptr;
+        }
+    }
+
+    if ((ret = avformat_find_stream_info(ifmt_ctx, NULL)) < 0)
+    {
+        CAMERA_CICTCI_SERVICE_LOG_ERROR  << "[error]Could not open find stream info " <<  av_make_error_string(errbuf, sizeof(errbuf), ret);
+        if (nullptr != ifmt_ctx)
+        {
+            avformat_close_input(&ifmt_ctx);
+            ifmt_ctx = nullptr;
+        }
+    }
+
+
+    for (int i = 0; i < ifmt_ctx->nb_streams; i++)
+    {
+        av_dump_format(ifmt_ctx, i, rtsp_url.c_str(), 0);
+    }
+
+    for (int i = 0; i < ifmt_ctx->nb_streams; i++)
+    {
+        st = ifmt_ctx->streams[i];
+        switch (st->codec->codec_type)
+        {
+            case AVMEDIA_TYPE_AUDIO: audio_st_index = i; break;
+            case AVMEDIA_TYPE_VIDEO: video_st_index = i; break;
+            default: break;
+        }
+    }
+
+
+    if (-1 == video_st_index)
+    {
+        CAMERA_CICTCI_SERVICE_LOG_ERROR << "No H.264 video stream in the input file!";
+        if (nullptr != ifmt_ctx)
+        {
+            avformat_close_input(&ifmt_ctx);
+            ifmt_ctx = nullptr;
+        }
+    }
+
+    return true;
+}
+
+void CameraCictci::printBufferData(afl::net::ByteBuffer& buf, std::string hint)
+{
+
