+std::string OM_COMPONENT::executeCommand(const std::string& command)
+{
+    // 执行 shell 命令并获取输出
+    FILE* pipe = popen(command.c_str(), "r");
+    if (!pipe)
+    {
+        return "";
+    }
+
+    char buffer[128];
+    std::string output = "";
+    while (fgets(buffer, sizeof(buffer), pipe) != NULL)
+    {
+        output += buffer;
+    }
+
+    int status = pclose(pipe);
+    if (status == -1)
+    {
+        return "";
+    }
+
+    return output;
+}
