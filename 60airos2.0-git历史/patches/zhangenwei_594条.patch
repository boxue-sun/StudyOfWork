+bool BS_V2X_BSM_DATA_COMPONENT::getWorkParamFromFile()
+{
+    OmWorkParamConfiger  omWorkParamConfiger;
+    WorkParam::getWorkParamFromFile(getConfiger().configerWorkParam.workParamFilePath, omWorkParamConfiger);
+    OM_MEC_BS_V2X_BSM_DATA_ERROR_PRINT << "[work-param]" << omWorkParamConfiger.to_string().c_str();
+
+    getConfiger().basicConfiger.rscu_esn = omWorkParamConfiger.mecDeviceWorkParam.deviceEsn;
+    getConfiger().basicConfiger.euht_esn = omWorkParamConfiger.mecDeviceWorkParam.euhtEsn;
+    saveConfiger();
+
+    return true;
+}
