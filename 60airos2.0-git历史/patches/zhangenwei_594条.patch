+void OM_COMPONENT::uploadAlgorithmRunningStatusInfo() {
+    if (!m_MqttConnected) {
+        OM_MEC_ERROR_PRINT << "[error]mqtt clinet has not connected!";
+        return;
+    }
+    if (!m_RegisterFlag) {
+        return;
+    }
+    m_AlgorithmRunningStatusStartFlag = false;
+    PerceptionAlgorithmRunningStatus perceptionAlgorithmRunningStatusTemp;
+    {
+        std::unique_lock<std::mutex> lock(m_PerceptionAlgorithmRunningStatusMutex);
+        perceptionAlgorithmRunningStatusTemp = m_PerceptionAlgorithmRunningStatus;
+    }
+
+    PerceptionAlgorithmRunningStatus perceptionAlgorithmRunningStatusUp;
+
+    perceptionAlgorithmRunningStatusUp.timestamp = afl::util::TimeStamp::now(true).millSeconds();
+    perceptionAlgorithmRunningStatusUp.seqNum =  afl::util::Srand::srandStr(32);
+    perceptionAlgorithmRunningStatusUp.rscuEsn = getConfiger().rscuEsn;
+    perceptionAlgorithmRunningStatusUp.algStatus = perceptionAlgorithmRunningStatusTemp.algStatus;
+    OM_MEC_DEBUG_PRINT << "[notice]ALGORITHM_STATUS_ERROR  == perceptionAlgorithmRunningStatusUp.algStatus!";
+    if(ALGORITHM_STATUS_ERROR  == perceptionAlgorithmRunningStatusUp.algStatus)
+    {
+        OM_MEC_DEBUG_PRINT << "[notice]ALGORITHM_STATUS_ERROR  == perceptionAlgorithmRunningStatusUp.algStatus!";
+        perceptionAlgorithmRunningStatusUp.description = perceptionAlgorithmRunningStatusTemp.description;
+        perceptionAlgorithmRunningStatusUp.descriptionEmpty = false;
+    }
+
+
+    for(auto sensorDeviceWorkParam:m_OmWorkParamConfiger.sensorDeviceWorkParamList)
+    {
+//        OM_MEC_DEBUG_PRINT << "[notice]" << sensorDeviceWorkParam.to_string();
+        if(sensorDeviceWorkParam.deviceType ==  WorkParamDeviceTypeCamera )
+        {
+            OM_MEC_DEBUG_PRINT << "[notice] sensorDeviceWorkParam.deviceType ==  WorkParamDeviceTypeCamera ";
+            CameraStatus cameraStatus;
+            cameraStatus.deviceSn = sensorDeviceWorkParam.deviceSn;
+            cameraStatus.deviceID = sensorDeviceWorkParam.deviceEsn;
+            bool isFindDeviceEsn = false;
+            for(auto cameraStatusTemp: perceptionAlgorithmRunningStatusTemp.camerasStatus)
+            {
+                if(cameraStatus.deviceID == cameraStatusTemp.deviceID)
+                {
+                    cameraStatus.dataStatus = cameraStatusTemp.dataStatus;
+                    isFindDeviceEsn = true;
+                    break;
+                }
+            }
+            if(!isFindDeviceEsn)
+            {
+                cameraStatus.dataStatus =  CAMERA_STATUS_NO_VIDEO;
+            }
+            perceptionAlgorithmRunningStatusUp.camerasStatus.push_back(cameraStatus);
+        }
+        if(sensorDeviceWorkParam.deviceType ==  WorkParamDeviceTypeRadar)
+        {
+            OM_MEC_DEBUG_PRINT << "[notice] sensorDeviceWorkParam.deviceType ==  WorkParamDeviceTypeRadar ";
+            RadarStatus radarStatus;
+            radarStatus.deviceSn = sensorDeviceWorkParam.deviceSn;
+            radarStatus.deviceID = sensorDeviceWorkParam.deviceEsn;
+            bool isFindDeviceEsn = false;
+            for(auto radarsStatusTemp: perceptionAlgorithmRunningStatusTemp.radarsStatus)
+            {
+                if(radarStatus.deviceID == radarsStatusTemp.deviceID)
+                {
+                    radarStatus.dataStatus = radarsStatusTemp.dataStatus;
+                    isFindDeviceEsn = true;
+                    break;
+                }
+            }
+            if(!isFindDeviceEsn)
+            {
+                radarStatus.dataStatus =  RADAR_STATUS_NO_DATA;
+            }
+            perceptionAlgorithmRunningStatusUp.radarsStatus.push_back(radarStatus);
+        }
+    }
+    if(perceptionAlgorithmRunningStatusUp.camerasStatus.size() > 0)
+    {
+        OM_MEC_DEBUG_PRINT << "[notice] perceptionAlgorithmRunningStatusUp.camerasStatus.size() > 0 ";
+        perceptionAlgorithmRunningStatusUp.camerasStatusEmpty = false;
+    }
+    if(perceptionAlgorithmRunningStatusUp.radarsStatus.size() > 0)
+    {
+        OM_MEC_DEBUG_PRINT << "[notice] perceptionAlgorithmRunningStatusUp.radarsStatus.size() > 0 ";
+        perceptionAlgorithmRunningStatusUp.radarsStatusEmpty = false;
+    }
+
+    std::string topicPT =  m_MqttClientConfig.configerMec.configerTopic.Topic_Algorithm_Status;
+    std::string hint = "algorithm status";
+    if(!topicPT.empty())
+    {
+        if(!mqttPushMsg2BrokerCloud(topicPT, perceptionAlgorithmRunningStatusUp, hint))
+        {
+            OM_MEC_ERROR_PRINT << "[error] push spat data failure!";
+            return ;
+        }
+        else
+        {
+            if(getConfiger().configerMec.enableDebugPrint)
+            {
+                OM_MEC_DEBUG_PRINT << "[sucess]Publish success!";
+            }
+        }
+    }
+}
