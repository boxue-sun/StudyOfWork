+void  OM_COMPONENT::processAlgorithmStatusData(const std::shared_ptr<const airos::usecase::EventOutputResult> &mecDeviceData)
+{
+    if(!getConfiger().configerMec.configerEnable.Enable_AlgorithmStatus)
+    {
+        return ;
+    }
+    if (!m_MqttConnectedCloud)
+    {
+        return ;
+    }
+    if (!m_RegisterFlag)
+    {
+        return;
+    }
+    if (!mecDeviceData)
+    {
+        OM_MEC_ERROR_PRINT << "Received mec-data failed!";
+        return ;
+    }
+    if (mecDeviceData->has_mec_algorithm_status())
+    {
+        bool isGetMecAlgorithmStatus  = false;
+        PerceptionAlgorithmRunningStatus perceptionAlgorithmRunningStatus;
+        auto mec_algorithm_status = mecDeviceData->mec_algorithm_status();
+        perceptionAlgorithmRunningStatus.timestamp = mec_algorithm_status.time_stamp();
+        perceptionAlgorithmRunningStatus.seqNum = afl::util::Srand::srandStr(32);
+        perceptionAlgorithmRunningStatus.rscuEsn = getConfiger().rscuEsn;
+        for(int i = 0; i < mec_algorithm_status.dev_list().size(); i++)
+        {
+            auto dev_status = mec_algorithm_status.dev_list()[i];
+            switch(dev_status.dev_type())
+            {
+                case  airos::usecase::MecDevAlgorithmStatusDevType::DEV_TYPE_MEC:
+                    perceptionAlgorithmRunningStatus.algStatus = (os::v2x::protocol::om::common::AlgorithmStatusType)((int)dev_status.dev_service_status() - 1);//mec:1正常 2异常 -> 平台：0正常 1异常
+                    isGetMecAlgorithmStatus = true;
+                    break;
+                case airos::usecase::MecDevAlgorithmStatusDevType::DEV_TYPE_CAMERE:
+                {
+                    std::string deviceSn = dev_status.device_id();
+                    std::string deviceEsn;
+                    if(getDeviceEsn(deviceSn, deviceEsn))
+                    {
+                        CameraStatus cameraStatus;
+                        cameraStatus.deviceID = deviceEsn;
+                        cameraStatus.deviceSn = deviceSn;
+                        cameraStatus.dataStatus = (os::v2x::protocol::om::common::CameraStatusType)((int)dev_status.dev_service_status() - 1);
+                        perceptionAlgorithmRunningStatus.camerasStatus.push_back(cameraStatus);
+                        perceptionAlgorithmRunningStatus.camerasStatusEmpty = false;
+                    }
+                }
+                    break;
+                case airos::usecase::MecDevAlgorithmStatusDevType::DEV_TYPE_MW_RADAR:
+                {
+                    std::string deviceSn = dev_status.device_id();
+                    std::string deviceEsn;
+                    if(getDeviceEsn(deviceSn, deviceEsn))
+                    {
+                        RadarStatus radarStatus;
+                        radarStatus.deviceID = deviceEsn;
+                        radarStatus.deviceSn = deviceSn;
+                        radarStatus.dataStatus = (os::v2x::protocol::om::common::RadarStatusType)((int)dev_status.dev_service_status() - 1);
+                        perceptionAlgorithmRunningStatus.radarsStatus.push_back(radarStatus);
+                        perceptionAlgorithmRunningStatus.radarsStatusEmpty = false;
+                    }
+                }
+                    break;
+                case airos::usecase::MecDevAlgorithmStatusDevType::DEV_TYPE_RADAR:
+                {
+                    std::string deviceSn = dev_status.device_id();
+                    std::string deviceEsn;
+                    if(getDeviceEsn(deviceSn, deviceEsn))
+                    {
+                        RadarStatus radarStatus;
+                        radarStatus.deviceID = deviceEsn;
+                        radarStatus.deviceSn = deviceSn;
+                        radarStatus.dataStatus = (os::v2x::protocol::om::common::RadarStatusType)((int)dev_status.dev_service_status() - 1);
+                        perceptionAlgorithmRunningStatus.radarsStatus.push_back(radarStatus);
+                        perceptionAlgorithmRunningStatus.radarsStatusEmpty = false;
+                    }
+                }
+                    break;
+                default:
+                    break;
+
+            }
+        }
+        if(!isGetMecAlgorithmStatus)
+        {
+            perceptionAlgorithmRunningStatus.algStatus =  ALGORITHM_STATUS_ERROR;
+        }
+
+
+        std::string topicPT =  m_MqttClientConfig.configerMec.configerTopic.Topic_Algorithm_Status;
+        std::string hint = "algorithm status";
+        if(!topicPT.empty())
+        {
+            if(!mqttPushMsg2BrokerCloud(topicPT, perceptionAlgorithmRunningStatus, hint))
+            {
+                OM_MEC_ERROR_PRINT << "[error] push spat data failure!";
+                return ;
+            }
+            else
+            {
+                if(getConfiger().configerMec.enableDebugPrint)
+                {
+                    OM_MEC_DEBUG_PRINT << "[sucess]Publish success!";
+                }
+            }
+        }
+
+    }
+}
