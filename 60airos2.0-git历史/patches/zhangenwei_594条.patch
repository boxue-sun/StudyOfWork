+void BS_V2X_DATA_COMPONENT::mqttOnConnect(void *context, MQTTAsync_successData *response)
+{
+    auto thiz = (BS_V2X_DATA_COMPONENT *) context;
+    if(thiz->m_MqttClientConfig.basicConfiger.enable_print_info_log)
+    {
+        LOG_ERROR << "[sucess]connect sucess";
+    }
+
+    thiz->m_MqttConnected = true;
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    opts.onSuccess = mqttOnSubscribe;
+    opts.onFailure = mqttOnSubscribeFailure;
+    opts.context = thiz;
+
+    if(thiz->m_MqttClientConfig.basicConfiger.mqtt_real_subscribe_topic_num > 0)
+    {
+        if (MQTTAsync_subscribeMany(thiz->m_MqttClient,
+                                    thiz->m_MqttClientConfig.basicConfiger.mqtt_real_subscribe_topic_num,
+                                    thiz->m_MqttClientConfig.basicConfiger.mqtt_subscribe_topics,
+                                    thiz->m_MqttClientConfig.basicConfiger.mqtt_subscribe_qoss,
+                                    &opts) != MQTTASYNC_SUCCESS)
+        {
+            if(thiz->m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR <<"[error]subscribe failure";
+            }
+        }
+    }
+
+}
+
+void BS_V2X_DATA_COMPONENT::mqttOnConnectFailure(void *context, MQTTAsync_failureData *response)
+{
+    auto thiz = (BS_V2X_DATA_COMPONENT *) context;
+    if (response)
+    {
+        if (response->message)
+        {
+            if(thiz->m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error]connect failure [error-code]" <<  response->code <<" [error]%s" << response->message;
+            }
+
+        } else
+        {
+            if(thiz->m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error]connect failure! [error-code]" << response->code;
+            }
+
+        }
+    } else
+    {
+        if(thiz->m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error]connect failure";
+        }
+    }
+
+    thiz->mqttReconnect();
+}
