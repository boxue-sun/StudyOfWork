+////////////////////////////////////////////////////////////////////////////////
+void BS_V2X_DATA_COMPONENT::processUdpMsgFromCommunicationDevice(int sockfd)
+{
+    auto buf = afl::net::ByteBuffer(512, 40960);
+    sockaddr communicationDeviceIpAddr;
+    unsigned int ipAddrLength = sizeof(communicationDeviceIpAddr);
+    int recvlen = recvfrom(sockfd, buf.beginWrite(), buf.writableBytes(), 0,
+                           &communicationDeviceIpAddr, &ipAddrLength);
+    if (recvlen < 0)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[错误]客户端接收数据长度<0!";
+        }
+
+        return;
+    }
+    buf.hasWritten(recvlen);
+
+//    if ((uint32_t)recvlen < sizeof(DkMecProtocolHead))
+//    {
+//        AIROS_ERRORPRINT("[错误]长度不对应!");
+//        return ;
+//    }
+}
+////////////////////////////////////////////////////////////////////////////////
+bool BS_V2X_DATA_COMPONENT::initUdpConfig(int &socketFd)
+{
+    socketFd = socket(PF_INET, SOCK_DGRAM, 0);
+    if (socketFd < 0)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error]UDP socket create error! " <<  strerror(errno);
+        }
+
+        return false;
+    }
+    sockaddr_in s_addr;
+    memset(&s_addr, 0, sizeof(struct sockaddr_in));
+    s_addr.sin_family = AF_INET;
+    if (inet_pton(AF_INET, "0.0.0.0", &s_addr.sin_addr) <= 0)
+    {
+
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error]" << strerror(errno);
+        }
+        return false;
+    }
+    s_addr.sin_port = htons(m_MqttClientConfig.v2xDataComponentConfiger.udp_local_port);
+    if (bind(socketFd, (struct sockaddr *) &s_addr, sizeof(s_addr)) < 0)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error]socket bind error! reason:" << strerror(errno);
+        }
+
+        return false;
+    }
+
+    return true;
+
+}
