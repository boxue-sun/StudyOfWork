+void OM_Mec_COMPONENT::getNetInfo(NetInfo &netInfo)
+{
+    double periodRunningInfoUpTemp = m_MqttClientConfig.configerPublishPeriod.periodRunningInfoUp;
+    netInfo.rx = (int) (m_RecievePackage / periodRunningInfoUpTemp);
+    netInfo.tx = (int) (m_SendPackage / periodRunningInfoUpTemp);
+    netInfo.rxByte = (float) m_RecievePerSecond / periodRunningInfoUpTemp;
+    netInfo.txByte = (float) m_SendPerSecond / periodRunningInfoUpTemp;
+    FILE *net_dev_file;
+    char bufferNet[512];
+    if ((net_dev_file = fopen("/proc/net/dev", "r")) != NULL)
+    {
+        long long rx = 0, tx = 0, rxByte = 0, txByte = 0;
+        if (fgets(bufferNet, sizeof(bufferNet), net_dev_file) == NULL)
+        {
+            ERRORPRINT("fgets error")
+        }
+        if (fgets(bufferNet, sizeof(bufferNet), net_dev_file) == NULL)
+        {
+            ERRORPRINT("fgets error")
+        }
+        for (int i = 0; i < 20; i++)
+        {
+            if (fgets(bufferNet, sizeof(bufferNet), net_dev_file) != NULL)
+            {
+                if (strstr(bufferNet, "eth0:") != NULL || strstr(bufferNet, "lo:") != NULL ||
+                    strstr(bufferNet, "lmi40:") != NULL)
+                {
+                    //printf("%d   %s\n",i,buffer);
+                    long long arrs[20];
+                    sscanf(bufferNet, "%s %lld %lld %lld %lld %lld %lld %lld %lld %lld %lld ",
+                           bufferNet, &arrs[0], &arrs[1], &arrs[2], &arrs[3], &arrs[4], &arrs[5], &arrs[6], &arrs[7],
+                           &arrs[8], &arrs[9]);
+                    rx += arrs[1];
+                    rxByte += arrs[0];
+                    tx += arrs[9];
+                    txByte += arrs[8];
+                }
+            }
+        }
+        netInfo.rx = (int) ((rx - m_Oldrx) / periodRunningInfoUpTemp);
+        netInfo.tx = (int) ((tx - m_Oldtx) / periodRunningInfoUpTemp);
+        netInfo.rxByte = (rxByte - m_OldrxByte) / periodRunningInfoUpTemp;
+        netInfo.txByte = (txByte - m_OldtxByte) / periodRunningInfoUpTemp;
+        m_OldtxByte = rx;
+        m_Oldtx = tx;
+        m_OldrxByte = rxByte;
+        m_OldtxByte = txByte;
+        fclose(net_dev_file);
+    }
+}
