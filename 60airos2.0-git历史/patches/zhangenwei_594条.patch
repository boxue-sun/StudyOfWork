+void OM_Mec_COMPONENT::mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json & subScribeJson)
+{
+    if (!m_MqttConnected)
+    {
+        ERRORPRINT("[error]mqtt clinet has not connected!");
+        return;
+    }
+
+    if (topic.empty())
+    {
+        ERRORPRINT("topic empty!")
+        return;
+    }
+    std::string hint;
+    std::string topicPT;
+
+    bool hasFindFlag = false;
+    if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Brod && m_MqttClientConfig.configerEnable.Enable_Scene_Brod)
+    {
+        //场景广播回执
+        hint = "通信设备广播回执";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Brod;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Recv && m_MqttClientConfig.configerEnable.Enable_Scene_Recv)
+    {
+        hint = "通信设备回执";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Recv;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Sensor_Angle_Offset && m_MqttClientConfig.configerEnable.Enable_Sensor_Angle_Offset )
+    {
+        hint = "角度偏移日志数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Sensor_Angle_Offset;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Signal && m_MqttClientConfig.configerEnable.Enable_Signal)
+    {
+        hint = "信号灯原始数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Signal;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Spat && m_MqttClientConfig.configerEnable.Enable_Scene_Spat)
+    {
+        hint = "信号灯数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Spat;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Map && m_MqttClientConfig.configerEnable.Enable_Scene_Map)
+    {
+        hint = "地图数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Map;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Rsi && m_MqttClientConfig.configerEnable.Enable_Scene_Rsi)
+    {
+        hint = "RSI数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Rsi;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Rsc && m_MqttClientConfig.configerEnable.Enable_Scene_Rsc)
+    {
+        hint = "RSC数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Rsc;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Ssm && m_MqttClientConfig.configerEnable.Enable_Scene_Ssm)
+    {
+        hint = "SSM数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Ssm;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Rtcm && m_MqttClientConfig.configerEnable.Enable_Scene_Rtcm)
+    {
+        hint = "Rtcm数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Rtcm;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Vir && m_MqttClientConfig.configerEnable.Enable_Scene_Vir)
+    {
+        hint = "Vir数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Vir;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Pam && m_MqttClientConfig.configerEnable.Enable_Scene_Pam)
+    {
+        hint = "Pam数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Pam;
+    }
+    else if(topic ==  m_MqttClientConfig.configerTopic.Topic_Scene_Perception && m_MqttClientConfig.configerEnable.Enable_Scene_Perception)
+    {
+        hint = "Perception数据";
+        topicPT = m_MqttClientConfig.configerTopic.Topic_Scene_Perception;
+    }
+    else
+    {
+        hint = "";
+        topicPT = "";
+    }
+
+    if(!topicPT.empty())
+    {
+        auto cloud_data = std::make_shared<os::v2x::device::CloudData>();
+        auto mqtt_data  = cloud_data->mutable_mqtt_data();
+        mqtt_data->set_topic(topicPT);
+        std::string msg = subScribeJson.dump();
+        mqtt_data->set_data(msg.data(), msg.size());
+        LOG_ERROR << "msg:" << cloud_data->DebugString();
+        Send("/v2x/cloud/report/mqtt", cloud_data);
+    }
+
+    return;
+}
