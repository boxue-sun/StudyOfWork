+    m_DeviceDataOld.ssmMsgSendEmpty = false;
+    m_DeviceDataOld.bsmMsgReceivedEmpty = false;
+    m_DeviceDataOld.psmMsgReceivedEmpty = false;
+    m_DeviceDataOld.virMsgReceivedEmpty = false;
+    m_DeviceDataOld.vpmMsgReceivedEmpty = false;
+    m_DeviceDataOld.ismMsgReceivedEmpty = false;
+    m_DeviceDataOld.samMsgReceivedEmpty = false;
+    serviceDataStatistics.dataList.push_back(m_DeviceDataOld);
+    json subScribeJson;
+    try
