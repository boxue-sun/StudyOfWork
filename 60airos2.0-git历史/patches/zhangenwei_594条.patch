+bool OM_MONITOR_COMPONENT::Proc(const std::shared_ptr<const  airos::usecase::EventOutputResult>& recv_data)
+{
+//    OM_MONITOR_DEBUG_PRINT <<  recv_data->DebugString();
+    if (!recv_data)
+    {
+        OM_MONITOR_ERROR_PRINT << "data empty!";
+        return false;
+    }
+    int tag = 0;
+    if (recv_data->has_mec_sensor_data_monitor())
+    {
+        const auto& mec_sensor_data_monitor = recv_data->mec_sensor_data_monitor();
+        try{
+            tag = mec_sensor_data_monitor.tag();
+        }    catch (...)
+        {
+            OM_MONITOR_ERROR_PRINT << "[error]" << "parse json failure!";
+            return false;
+        }
+        switch (tag)
+        {
+            case airos::usecase::MonitorMsgTag::MONITOR_TAG_SENSOR_DATA_IN:
+            {
+                auto sensor_data_in = mec_sensor_data_monitor.sensor_data_in();
+                m_SensorDataStatusDataIn.timestamp = mec_sensor_data_monitor.timestamp();
+                m_SensorDataStatusDataIn.data.sensor_data_in_port = sensor_data_in.sensor_data_in_port();
+                m_SensorDataStatusDataIn.data.sensor_data_in_flag = sensor_data_in.sensor_data_in_flag();        // 是否接收到感知数据
+                m_SensorDataStatusDataIn.data.sensor_data_in_obj_package = sensor_data_in.sensor_data_in_obj_package();                 // 感知目标2011大包个数
+                m_SensorDataStatusDataIn.data.sensor_data_in_obj_num = sensor_data_in.sensor_data_in_obj_num();                     // 感知目标2011 总目标个数
+            }
+                break;
+            case airos::usecase::MonitorMsgTag::MONITOR_TAG_SENSOR_DATA_UP:
+            {
+                auto sensor_data_up = mec_sensor_data_monitor.sensor_data_up();
+                m_SensorDataStatusDataUp.timestamp = mec_sensor_data_monitor.timestamp();
+                m_SensorDataStatusDataUp.data.sensor_cloud_ip = sensor_data_up.sensor_cloud_ip();                    // 感知运控的ip
+                m_SensorDataStatusDataUp.data.sensor_cloud_port = sensor_data_up.sensor_cloud_port();                  // 感知运控的端口
+                m_SensorDataStatusDataUp.data.sensor_cloud_con_flag = sensor_data_up.sensor_cloud_con_flag();                     // 感知上云模块连接云控是否正常
+                m_SensorDataStatusDataUp.data.sensor_data_up_flag = sensor_data_up.sensor_dat_up_flag();                       // 感知数据上云是否成功
+                m_SensorDataStatusDataUp.data.sensor_data_up_obj_package = sensor_data_up.sensor_data_up_obj_package();                 // 感知目标2011大包个数
+                m_SensorDataStatusDataUp.data.sensor_data_up_obj_num = sensor_data_up.sensor_data_up_obj_num();                     // 感知目标2011 总目标个数
+                break;
+            }
+            default:
+                break;
+        }
+    }
+
+
+   return true;
+}
