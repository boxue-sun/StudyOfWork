+void OM_Mec_COMPONENT::processAlarmSensorAngleOffset(const std::string &topic, const afl::base::json & subScribeJson)
+{
+    if (!m_MqttConnected)
+    {
+        OM_MEC_ERROR_PRINT << "[error]mqtt clinet has not connected!";
+        return;
+    }
+    
+    CameraDeviceAngleOffsetLogData cameraDeviceAngleOffsetLogData;
+    try
+    {
+        cameraDeviceAngleOffsetLogData = subScribeJson;
+    } catch (afl::base::json::exception &e)
+    {
+        OM_MEC_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+    }
+    std::string hint = "摄像机角度偏移";
+    OM_MEC_ERROR_PRINT << "[cameraDeviceAngleOffsetLogData]" << cameraDeviceAngleOffsetLogData.to_string();
 
+    AlarmManagementData alarmManagementData;
+    alarmManagementData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    alarmManagementData.rscuEsn =  m_MqttClientConfig.rscuEsn;
+    alarmManagementData.protocolVersion = getConfiger().configerOmCommon.protocolVersion;
+    alarmManagementData.alarm.alarmLevel = ALERT_CRITICAL;
+    alarmManagementData.alarm.alarmStatus = ALARM_OCCURRED;
+    alarmManagementData.alarm.alarmRaisedTime = afl::util::TimeStamp::now(true).millSeconds();
+    alarmManagementData.alarm.alarmChangedTime = 0;
+    alarmManagementData.alarm.alarmType = (MecAlarmTypeErrorCodeEnum)MEC_ALARM_TYPE_CAMERA_ANGLE_OFFSET;
+    alarmManagementData.alarm.addtion = cameraDeviceAngleOffsetLogData.alarm.addition;
+    alarmManagementData.alarm.addtionEmpty = false;
+    publishData(m_MqttClientConfig.configerTopic.Topic_Alarm, alarmManagementData, hint);
+}
