+void OM_COMPONENT::publishConfigQueryAckData(ConfigQueryData &configQueryData)
+{
+    if (!m_MqttConnected)
+    {
+        return;
+    }
+
+    if(!m_MqttClientConfig.configerMec.configerEnable.Enable_Config_Query_Down_Ack || !m_RegisterFlag)
+    {
+        return;
+    }
+    std::string hint = "publish Config-Query-Ack info";
+
+    ConfigQueryAckData configQueryAckData;
+    configQueryAckData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    configQueryAckData.seqNum    = configQueryData.seqNum;
+    configQueryAckData.rscuEsn   = getConfiger().rscuEsn;
+    configQueryAckData.pointNo   = getConfiger().configerMec.configerOmCommon.pointNo;
+    configQueryAckData.pointName = getConfiger().configerMec.configerOmCommon.pointName;
+    configQueryAckData.longitude = getConfiger().configerMec.configerOmCommon.longitude;
+    configQueryAckData.latitude     = getConfiger().configerMec.configerOmCommon.latitude;
+    configQueryAckData.altitude = getConfiger().configerMec.configerOmCommon.elevation;
+    configQueryAckData.height   = getConfiger().configerMec.configerOmCommon.height;
+    configQueryAckData.siteType  = (SiteTypeEnum)getConfiger().configerMec.configerOmCommon.siteType;
+
+    //德清项目增加
+    configQueryAckData.protocolVersion = PROTOCOL_VERSION;
+    configQueryAckData.protocolVersionEmpty = false;
+    configQueryAckData.runningInfoRate = getConfiger().configerMec.configerPublishPeriod.periodRunningInfoUp;
+    configQueryAckData.runningInfoRateEmpty = false;
+
+    configQueryAckData.heartRate = getConfiger().configerMec.configerPublishPeriod.periodHeartBeatUp;
+    configQueryAckData.heartRateEmpty = false;
+
+    configQueryAckData.addressChg =     getConfiger().configerMqttCloud.mqttBrokerUrl;
+    configQueryAckData.addressChgEmpty = false;
+
+    configQueryAckData.addressIP =     getConfiger().configerMec.configerOmCommon.addressIP;
+    configQueryAckData.addressIPEmpty = false;
+
+    configQueryAckData.netMask = getConfiger().configerMec.configerOmCommon.netMask;
+    configQueryAckData.netMaskEmpty = false;
+
+    configQueryAckData.gateway = getConfiger().configerMec.configerOmCommon.gateway;
+    configQueryAckData.gatewayEmpty = false;
+
+    configQueryAckData.logLevel =(LogLevelEnum)getConfiger().configerMec.configerOmCommon.logLevel;
+    configQueryAckData.logLevelEmpty = false;
+    configQueryAckData.time = getConfiger().configerMec.configerOmCommon.timingSystem;
+    configQueryAckData.timeEmpty = false;
+
+    if (getConfiger().configerMec.configerOmCommon.timeConfig != STR_DEFAULT_VALUE)
+    {
+        configQueryAckData.timeConfig = getConfiger().configerMec.configerOmCommon.timeConfig;
+        configQueryAckData.timeConfigEmpty = false;
+    }
+    if (getConfiger().configerMec.configerOmCommon.ptpLayer >= 0)
+    {
+        configQueryAckData.ptpLayer = getConfiger().configerMec.configerOmCommon.ptpLayer;
+        configQueryAckData.ptpLayerEmpty = false;
+    }
+    if (getConfiger().configerMec.configerOmCommon.timePeriod >= 0)
+    {
+        configQueryAckData.timePeriod = getConfiger().configerMec.configerOmCommon.timePeriod;
+        configQueryAckData.timePeriodEmpty = false;
+    }
+    if (getConfiger().configerMqttCloud.mqttBrokerUrl.size() >= 0)
+    {
+        auto mqttCloudBrokerUrl = getConfiger().configerMqttCloud.mqttBrokerUrl;
+        std::string ip;
+        int port;
+        if (extractIpPort(mqttCloudBrokerUrl, ip, port))
+        {
+            configQueryAckData.serverPort = port;
+            configQueryAckData.serverPortEmpty = false;
+        }
+    }
+
+    if (getConfiger().configerMec.configerOmCommon.omcIp != STR_DEFAULT_VALUE)
+    {
+        configQueryAckData.omcIp = getConfiger().configerMec.configerOmCommon.omcIp;
+        configQueryAckData.omcIpEmpty = false;
+    }
+
+    if (getConfiger().configerMec.configerOmCommon.omcPort != NUM_DEFAULT_VALUE)
+    {
+        configQueryAckData.omcPort = getConfiger().configerMec.configerOmCommon.omcPort;
+        configQueryAckData.omcPortEmpty = false;
+    }
+    if (getConfiger().configerMec.configerOmCommon.rsuIp != STR_DEFAULT_VALUE)
+    {
+        configQueryAckData.rsuIp = getConfiger().configerMec.configerOmCommon.rsuIp;
+        configQueryAckData.rsuIpEmpty = false;
+    }
+    if (getConfiger().configerMec.configerOmCommon.rsuPort != NUM_DEFAULT_VALUE)
+    {
+        configQueryAckData.rsuPort = getConfiger().configerMec.configerOmCommon.rsuPort;
+        configQueryAckData.rsuPortEmpty = false;
+    }
+
+
+    if(getConfiger().enableDebugPrint) {
+        OM_MEC_DEBUG_PRINT << "[config-query-ack]" << hint << "[timeStamp]" << configQueryAckData.timeStamp;
+    }
+    mqttPushMsg2BrokerCloud(m_MqttClientConfig.configerMec.configerTopic.Topic_Config_Query_Down_Ack, configQueryAckData, hint);
+}
+bool OM_COMPONENT::extractIpPort(const std::string& input, std::string& ip, int& port)
+{
+    size_t colonPos = input.find_last_of(':');
+
+    if (colonPos != std::string::npos && colonPos + 1 < input.length())
+    {
+        try
+        {
+            std::string portStr = input.substr(colonPos + 1);
+            port = atoi(portStr.c_str());
+        }
+        catch (exception& e)
+        {
+            OM_MEC_ERROR_PRINT <<  "[what]" << e.what();
+        }
+
+        ip = input.substr(input.find("://") + 3, colonPos - (input.find("://") + 3));
+        if (input.find("://") == std::string::npos)
+        {
+            ip = input.substr(0, colonPos);
+        }
+        return true;
+    }
+    else
+    {
+        OM_MEC_ERROR_PRINT << "not find ip or port!" ;
+        return false;
+    }
+}
+void OM_COMPONENT::updateLogLevel(const std::string& newLogLevel)
+{
+    std::string filename = "/home/airos/os/setup.bash";
+    std::ifstream file(filename);
+    std::stringstream buffer;
+
+    if (file.is_open())
+    {
+        std::string line;
+        bool found = false;
+
+        while (std::getline(file, line))
+        {
+            // 检查行是否包含 "GLOG_minloglevel"
+            if (line.find("GLOG_minloglevel") != std::string::npos)
+            {
+                // 修改值
+                size_t pos = line.find("=");
+                if (pos != std::string::npos)
+                {
+                    line = line.substr(0, pos + 1) + newLogLevel; // 更新值
+                    found = true;
+                }
+            }
+            buffer << line << std::endl; // 将行写入缓冲区
+        }
+        file.close();
+
+        // 如果找到了并修改了值，则写回文件
+        if (found)
+        {
+            std::ofstream outFile(filename);
+            if (outFile.is_open())
+            {
+                outFile << buffer.str(); // 写入缓冲区内容
+                outFile.close();
+                OM_MEC_SUCESS_PRINT <<  "Log level updated to: " << newLogLevel;
+            }
+            else
+            {
+                OM_MEC_ERROR_PRINT <<  "Unable to open file for writing.";
+            }
+        }
+        else
+        {
+            OM_MEC_ERROR_PRINT <<  "GLOG_minloglevel not found in the file.";
+        }
+    } else {
+        OM_MEC_ERROR_PRINT <<  "Unable to open file.";
+    }
+}
