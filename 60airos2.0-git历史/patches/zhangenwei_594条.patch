+bool OM_CLOUD_COMPONENT::mqttConnect()
+{
+    int rc;
+    if (MQTTASYNC_SUCCESS != (rc = MQTTAsync_connect(m_MqttClient, &m_MqttConnOpts)))
+    {
+        ERRORPRINT("[error]connect error!");
+        m_MqttConnected = false;
+        return false;
+    }
+    return true;
+}
+
+bool OM_CLOUD_COMPONENT::mqttReconnect()
+{
+    ERRORPRINT("[notice]mqtt reconnect!");
+    m_MqttReconnectCount++;
+    if(m_MqttReconnectCount < 100)
+    {
+        m_Eventloop->addTimer(std::bind(&OM_CLOUD_COMPONENT::mqttConnect, this), m_MqttClientConfig.configerMqtt.mqttReconnectInterval, false);
+    }
+    else
+    {
+        if(m_MqttClient)
+        {
+            MQTTAsync_destroy(&m_MqttClient);
+            usleep(100000L);
+            m_MqttClient = nullptr;
+            if(!mqttInit())
+            {
+                ERRORPRINT( "[error]mqttInit failure!");
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
