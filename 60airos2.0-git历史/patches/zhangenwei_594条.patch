+std::string OM_COMPONENT::getContentBetweenFirstAndSecondSlash(const std::string& input)
+{
+        size_t firstSlash = input.find('/');
+        size_t secondSlash = input.find('/', firstSlash + 1);
+
+        if (firstSlash != std::string::npos && secondSlash != std::string::npos)
+        {
+            return input.substr(firstSlash + 1, secondSlash - firstSlash - 1);
+        }
+
+        return ""; // 如果没有找到，返回空字符串
+}
+
+bool OM_COMPONENT::isUtcHourly(const std::chrono::system_clock::time_point& utc_time)
+{
+    // 将 time_point 转换为 time_t
+    std::time_t time_t_utc = std::chrono::system_clock::to_time_t(utc_time);
+
+    // 将 time_t 转换为 tm 结构
+    std::tm* utc_tm = std::gmtime(&time_t_utc);
+
+    // 检查分钟和秒是否为 0
+    return (utc_tm->tm_min == 0 && utc_tm->tm_sec == 0);
+}
