+bool CCINDEX_COMPONENT::processConfigUpdateDataAck(std::string topic, const json& subScribeJson)
+{
+    try{
+        std::string deviceId;
+        if(getDeviceIdFromSubscribeData(topic, deviceId))
+        {
+            //将json转换为结构体
+            /////////////////////////////////////////////
+            ConfigUpdateData configData;
+            try
+            {
+                configData = subScribeJson;
+            }
+            catch (afl::base::json::exception &e)
+            {
+                CCINDEX_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+                return false;
+            }
+//        if(getConfiger().enableDebugPrint)
+//        {
+//            CCINDEX_DEBUG_PRINT << "[deviceId]" << deviceId;
+//        }
+            if(insertOrUpdateConfigUpdateData(m_ConfigUpdateData, deviceId, configData))
+            {
+                if(getConfiger().enableDebugPrint)
+                {
+                    CCINDEX_DEBUG_PRINT << "[sucess]insert Or Update Update-Config-Data success!";
+                }
+            }
+            else
+            {
+                CCINDEX_ERROR_PRINT << "[error]insert Or Update Update-Config-Data  error!";
+                return false;
+            }
+            /////////////////////////////////////////////
+
+            if(insertOrUpdateConfigQueryDataJson(m_ConfigUpdateDataJson, deviceId, subScribeJson))
+            {
+                if(getConfiger().enableDebugPrint)
+                {
+                    CCINDEX_DEBUG_PRINT << "[sucess]insert Or Update Update-Config-Data Json success!";
+                }
+            }
+            else
+            {
+                CCINDEX_ERROR_PRINT << "[error]insert Or Update Update-Config-Data Json  error!";
+                return false;
+            }
+        }
+        else
+        {
+            CCINDEX_ERROR_PRINT << "[error]get device-id failure!";
+            return false;
+        }
+
+    }catch(exception& e)
+    {
+        CCINDEX_DEBUG_PRINT << "[error]" << e.what();
+    }
+
+
+    return true;
+}
+bool CCINDEX_COMPONENT::processConfigQeuryDataAck(std::string topic, const json& subScribeJson)
+{
+    try{
