+bool CCINDEX_COMPONENT::mqttInitInter()
+{
+    m_MqttClientInter = nullptr;
+    m_MqttConnectedInter  = false;
+
+    mqttInitConnOptsInter();
+    std::string clientIdTemp = m_MqttClientConfig.mqttClientIdInter + ":" +
+                               std::to_string(afl::util::TimeStamp::now(true).microSeconds());
+    CCINDEX_ERROR_PRINT << "[Inter][mqttBroker-Url]" << m_MqttClientConfig.configerMqttInter.mqttBrokerUrl.c_str()
+                        << " [client-id]" << clientIdTemp.c_str()
+                        << " [username]" << m_MqttClientConfig.configerMqttInter.mqttUserName.c_str()
+                        << " [passwd]" << m_MqttClientConfig.configerMqttInter.mqttPassword.c_str();
+    if (MQTTASYNC_SUCCESS != MQTTAsync_create(&m_MqttClientInter, m_MqttClientConfig.configerMqttInter.mqttBrokerUrl.c_str(),
+                                              clientIdTemp.c_str(), MQTTCLIENT_PERSISTENCE_NONE, NULL))
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][error]create connectiont failure!";
+        return false;
+    }
+
+    MQTTAsync_setCallbacks(m_MqttClientInter, this, mqttConnlostInter, mqttSubscribeMsgArrvdInter, NULL);
+
+    if (!mqttConnectInter())
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][error]Connect Failure!";
+        return false;
+    }
+
+    return true;
+}
+
+void CCINDEX_COMPONENT::mqttDeinitInter()
+{
+    if (m_MqttClientInter)
+    {
+        MQTTAsync_disconnectOptions opts = MQTTAsync_disconnectOptions_initializer;
+        opts.onSuccess = mqttOnDisconnectInter;
+        opts.context = m_MqttClientInter;
+        MQTTAsync_disconnect(m_MqttClientInter, &opts);
+
+        int cnt = 0;
+        while (m_MqttConnectedInter && (cnt < 30))
+        {
+            usleep(10000L);
+            cnt++;
+        }
+
+        MQTTAsync_destroy(&m_MqttClientInter);
+        m_MqttClientInter = nullptr;
+        m_MqttConnectedInter  = false;
+    }
+}
+int printMqttTlsErrorInter(const char *str, size_t len, void *u)
+{
+    CCINDEX_ERROR_PRINT << "[Inter][ssl error]" << str;
+    return 0;
+}
+bool CCINDEX_COMPONENT::mqttInitConnOptsInter()
+{
+    m_MqttConnOptsInter = MQTTAsync_connectOptions_initializer;
+    m_MqttConnOptsInter.connectTimeout = m_MqttClientConfig.configerMqttInter.mqttConnectTimeOut;
+    m_MqttConnOptsInter.keepAliveInterval = m_MqttClientConfig.configerMqttInter.mqttKeepAliveInterval;
+    m_MqttConnOptsInter.cleansession = m_MqttClientConfig.configerMqttInter.mqttCleanSession;
+    m_MqttConnOptsInter.MQTTVersion = m_MqttClientConfig.configerMqttInter.mqttVersion;
+    m_MqttConnOptsInter.username = m_MqttClientConfig.configerMqttInter.mqttUserName.c_str();
+    m_MqttConnOptsInter.password = m_MqttClientConfig.configerMqttInter.mqttPassword.c_str();
+    m_MqttConnOptsInter.onSuccess = mqttOnConnectInter;
+    m_MqttConnOptsInter.onFailure = mqttOnConnectFailureInter;
+    m_MqttConnOptsInter.context = this;
+    return true;
+}
+void CCINDEX_COMPONENT::mqttOnConnectInter(void *context, MQTTAsync_successData *response)
+{
+    CCINDEX_SUCESS_PRINT << "[Inter][sucess]connect sucess!";
+    auto thiz = (CCINDEX_COMPONENT *) context;
+    thiz->m_MqttConnectedInter  = true;
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    opts.onSuccess = mqttOnSubscribeInter;
+    opts.onFailure = mqttOnSubscribeFailureInter;
+    opts.context = thiz;
+
+
+    if(thiz->m_MqttClientConfig.configerMqttInter.mqttRealSubscribeTopicNum > 0)
+    {
+        if (MQTTAsync_subscribeMany(thiz->m_MqttClientInter, thiz->m_MqttClientConfig.configerMqttInter.mqttRealSubscribeTopicNum,
+                                    thiz->m_MqttClientConfig.configerMqttInter.mqttSubscribeTopics,
+                                    thiz->m_MqttClientConfig.configerMqttInter.mqttSubscribeQoss,
+                                    &opts) != MQTTASYNC_SUCCESS)
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error]subscribe error";
+        }
+    }
+}
+
+void CCINDEX_COMPONENT::mqttOnConnectFailureInter(void *context, MQTTAsync_failureData *response)
+{
+    if (response)
+    {
+        if (response->message)
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error]connect error [error-code]" << response->code << "[error-msg]" << response->message;
+        } else
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error]connect error [error-code]" << response->code << " [error-msg]" << response->message;
+        }
+    } else
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][error]connect error!";
+    }
+
+    auto thiz = (CCINDEX_COMPONENT *) context;
+    thiz->mqttReconnectInter();
+}
+
+
+bool CCINDEX_COMPONENT::mqttConnectInter()
+{
+    int rc;
+    if (MQTTASYNC_SUCCESS != (rc = MQTTAsync_connect(m_MqttClientInter, &m_MqttConnOptsInter)))
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][error]connect error!";
+        m_MqttConnectedInter  = false;
+        return false;
+    }
+    return true;
+}
+
+bool CCINDEX_COMPONENT::mqttReconnectInter()
+{
+    CCINDEX_ERROR_PRINT << "[Inter][notice]mqtt reconnect!";
+
+    m_Eventloop->addTimer(std::bind(&CCINDEX_COMPONENT::mqttConnectInter, this), m_MqttClientConfig.configerMqttInter.mqttReconnectInterval, false);
+
+    return true;
+}
+
+void CCINDEX_COMPONENT::mqttConnlostInter(void *context, char *cause)
+{
+    auto thiz = (CCINDEX_COMPONENT *) context;
+    thiz->m_MqttConnectedInter  = false;
+    CCINDEX_ERROR_PRINT << "[Inter][error]connect lost! [cause]" << cause;
+    thiz->mqttReconnectInter();
+}
+
+void CCINDEX_COMPONENT::mqttOnDisconnectInter(void *context, MQTTAsync_successData *response)
+{
+    CCINDEX_ERROR_PRINT << "[Inter][notice]disconnect!";
+    auto thiz = (CCINDEX_COMPONENT *) context;
+    thiz->m_MqttConnectedInter  = false;
+}
 
+void CCINDEX_COMPONENT::mqttOnSubscribeInter(void *context, MQTTAsync_successData *response)
+{
+    CCINDEX_SUCESS_PRINT << "[Inter][sucess]" << "subscribe sucess!";
+}
+
+void CCINDEX_COMPONENT::mqttOnSubscribeFailureInter(void *context, MQTTAsync_failureData *response)
+{
+    CCINDEX_ERROR_PRINT << "[Inter][error]subscribe failure!";
+}
+
+bool CCINDEX_COMPONENT::mqttPublishMsgInter(const std::string &topic, const std::string &msg)
+{
+    if (!m_MqttConnectedInter)
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][error]mqtt has not connected!";
+        return false;
+    }
+
+    if (msg.size() <= 0 || topic.empty())
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][error]len < 0 or topic empty!";
+        return false;
+    }
+
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    MQTTAsync_message pubmsg = MQTTAsync_message_initializer;
+    int rc;
+
+    opts.context = m_MqttClientInter;
+    pubmsg.payload = (void *) msg.c_str();
+    pubmsg.payloadlen = msg.length();
+    pubmsg.qos = m_MqttClientConfig.configerMqttInter.mqttSendQos;
+    pubmsg.retained = 0;
+
+    if ((rc = MQTTAsync_sendMessage(m_MqttClientInter, topic.c_str(), &pubmsg, &opts)) != MQTTASYNC_SUCCESS)
+    {
+        if (rc == MQTTASYNC_DISCONNECTED)
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error]Async Connect failure，will connect!";
+            if (m_MqttConnectedInter)
+            {
+                m_MqttConnectedInter = false;
+                mqttReconnectInter();
+            }
+        } else
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error]push msg error，[error-code]" << rc;
+        }
+
+        return false;
+    }
+
+    return true;
+}
+
+int CCINDEX_COMPONENT::mqttSubscribeMsgArrvdInter(void *context, char *topicName, int topicLen, MQTTAsync_message *message)
+{
+    int ret = 1;
+    auto thiz = (CCINDEX_COMPONENT *) context;
+    if (message->payloadlen)
+    {
+        std::string topic(topicName, topicLen);
+        std::string topicProfix = topic.substr(0, topic.find("/"));
+        CCINDEX_ERROR_PRINT << "[Inter]topicprofix:" << topicProfix;
+        CCINDEX_ERROR_PRINT << "[Inter][subscirbe-topic]" << topicName << " [msg-len]" << message->payloadlen << " [msg]" << (char *)(message->payload);
+        if(topicProfix == "trafficMetrics")
+        {
+            afl::base::json j;
+            try
+            {
+                j = afl::base::json::parse((char *) message->payload, (char *) message->payload + message->payloadlen);
+            }
+            catch (...)
+            {
+                CCINDEX_ERROR_PRINT << "[Inter][error]" << "parse json failure!";
+                MQTTAsync_freeMessage(&message);
+                MQTTAsync_free(topicName);
+                return ret;
+            }
+
+            if (topic.size() <= 0)
+            {
+                CCINDEX_ERROR_PRINT << "[Inter][error]topic empty!";
+            } else
+            {
+                //把具体的消息处理放到主线程里，和定时器在一个线程，避免出现两个线程同时修改一个vector/map
+                thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+                 {
+                     thiz->mqttDispatchSubscripeMessageInter(topic, j);
+                 });
+            }
+        }
+        else if(topicProfix == "upload")
+        {
+            std::string topic(topicName, topicLen);
+            if (topic.size() <= 0)
+            {
+                CCINDEX_ERROR_PRINT << "[Inter][error]topic empty!";
+            }
+            else
+            {
+                std::string msg((char*)message->payload, message->payloadlen);
+                //把具体的消息处理放到主线程里，和定时器在一个线程，避免出现两个线程同时修改一个vector/map
+                thiz->m_Eventloop->runInLoop([thiz, topic, msg]()
+					  {
+						  thiz->mqttDispatchSubscripeMessageProto(topic, (void*)msg.c_str(), msg.size());
+					  });
+            }
+        }
+        else
+        {
+
+        }
+    }
+
+    MQTTAsync_freeMessage(&message);
+    MQTTAsync_free(topicName);
+
+    return ret;
+}
+
+bool CCINDEX_COMPONENT::mqttPushStringMsg2BrokerInter(string topic, string info, string hint)
+{
+    if(!info.empty())
+    {
+        if(!mqttPublishMsgInter(topic, info))
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error]push " << hint.c_str() << " failure!";
+            return false;
+        }
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
+}
+bool CCINDEX_COMPONENT::mqttPushJsonMsg2BrokerInter(string topic, json info, string hint)
+{
+    std::string pData;
+    try{
+        pData = info.dump();
+    }
+    catch (json::exception& e)
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][what]" << e.what() << " [json-exception-id]" << e.id;
+        return false;
+    }
+    if(!pData.empty())
+    {
+        if(!mqttPublishMsgInter(topic, pData))
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error]push " << hint.c_str() << " failure!";
+            return false;
+        }
+    }else
+    {
+        return false;
+    }
+    return true;
+}
+void CCINDEX_COMPONENT::mqttDispatchSubscripeMessageInter(const std::string &topic, const afl::base::json & subScribeJson)
+{
+    if (!m_MqttConnected)
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][error]mqtt clinet has not connected!";
+        return;
+    }
+
+    if (topic.empty())
+    {
+        CCINDEX_ERROR_PRINT << "[Inter]topic empty!";
+        return;
+    }
+    std::string topicProfix = topic.substr(0, topic.find("/"));
+
+    std::string hint;
+    std::string topicPT;
+    bool hasFindFlag = false;
+    if(topicProfix == "trafficMetrics")
+    {
+        for (auto it = m_MqttClientConfig.topicUnMapCCIndex.begin(); it != m_MqttClientConfig.topicUnMapCCIndex.end(); ++it)
+        {
+            const MqttTopicConfigerCCIndex& mqttTopicConfigerCCIndex = it->second;
+
+            if(topic == mqttTopicConfigerCCIndex.Topic_Tc && m_MqttClientConfig.configerEnableCCIndex.Enable_Tc)
+            {
+                hint = "V2X信控指标";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Tc;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Trajectories && m_MqttClientConfig.configerEnableCCIndex.Enable_Trajectories)
+            {
+                hint = "实时轨迹数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Trajectories;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_VehiclePass && m_MqttClientConfig.configerEnableCCIndex.Enable_VehiclePass)
+            {
+                hint = "实时过车数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_VehiclePass;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_QueueUp
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_QueueUp)
+            {
+                hint = "实时排队数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_QueueUp;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_AreaState
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_AreaState)
+            {
+                hint = "实时区域状态数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_AreaState;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Overflow
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Overflow)
+            {
+                hint = "实时溢出数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Overflow;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Outlane
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Outlane)
+            {
+                hint = "实时出口通道数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Outlane;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Statistics
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Statistics)
+            {
+                hint = "定时统计数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Statistics;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Evaluations
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Evaluations)
+            {
+                hint = "定时评价数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Evaluations;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Nonmotor
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Nonmotor)
+            {
+                hint = "定时行人及非机动车数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Nonmotor;
+            }
+            else
+            {
+                hint = "主题为空";
+                topicPT = "";
+            }
+        }
+    }
+    else
+    {
+        CCINDEX_ERROR_PRINT << "[Inter][error]topic error!";
+    }
+
+    if(!topicPT.empty())
+    {
+        if (!mqttPushJsonMsg2Broker(topicPT, subScribeJson, hint))
+        {
+            CCINDEX_ERROR_PRINT << "[Inter][error] Publish data failure![msg]" << hint.c_str();
+        }
+    }
+
+    return;
+}
 NAMESPACE_ENDED_RADAR_CCINDEX
 
