-uint8_t RADAR_TC_COMPONENT::CovertGatLightColor(uint8_t gat_light_color)
-{
-  uint8_t std_light_color = 0;
-  if (gat_light_color & 0x2) 
-  {  // red
-    std_light_color = 3;
-  } 
-  else if ((gat_light_color >> 2) & 0x2) 
-  {  // yellow
-    std_light_color = 2;
-  } 
-  else if ((gat_light_color >> 4) & 0x2) 
-  {  // green  
-    std_light_color = 1;
-  }
-
-  return std_light_color;
-}
