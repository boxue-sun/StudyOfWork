+bool RADAR_CLOUD_COMPONENT::processTcChannelDataImpl(const std::shared_ptr<const  os::v2x::device::CloudData>& recv_data)
+{
+    if (!recv_data)
+    {
+        RADAR_CLOUD_ERROR_PRINT << "Received  channel failed!";
+        return false;
+    }
+    if (recv_data->payload_case() != os::v2x::device::CloudData::PayloadCase::kMqttData)
+    {
+        RADAR_CLOUD_ERROR_PRINT << "NOT MQTT MSG!";
+        return false;
+    }
+    std::string hint;
+    std::string topicPT;
+
+    std::string topic = recv_data->mqtt_data().topic();
+    const std::string& payload = recv_data->mqtt_data().data();
+    std::string topicProfix = topic.substr(0, topic.find("/"));
+    std::string hintMsg;
+    if(getConfiger().enableDebugPrint)
+    {
+        if(topicProfix == "upload")
+        {
+            hintMsg =  "radar_tc 》》》 radar_cloud 》》》 cloud";
+            m_MsgCountRecvFromChannelTc++;
+            RADAR_CLOUD_ERROR_PRINT << "[tc-pb-from-channel]" << m_MsgCountRecvFromChannelTc;
+        }
+        else if(topicProfix == "test")
+        {
+            m_MsgCountRecvFromChannelTc = 0;
+            m_MsgCountSend2CloudTc = 0;
+        }
+        else
+        {
+            hintMsg = "xxx";
+        }
+        if(getConfiger().enableDebugPrint)
+        {
+            RADAR_CLOUD_DEBUG_PRINT << "[notice]" << hintMsg << " [topic]" << topic.c_str() << "[msg-json]"
+                                    << payload.c_str();
+        }
+    }
+
+    if(!payload.empty() && !topic.empty())
+    {
+
+        static int message_count_tc_channel = 1; // 用于计数的静态变量
+        static int MAX_MESSAGE_COUNT_TC_CHANNEL = 1000; // 设置您的最大限制
+
+        // 根据消息计数判断是偶数还是奇数
+        if (message_count_tc_channel % 2 == 0) // 偶数
+        {
+            m_Eventloop->runInLoop([this, topic, payload, hint]()
+           {
+               if (!this->mqttPushStringMsg2Broker(topic, payload, hint))
+               {
+                   RADAR_CLOUD_ERROR_PRINT << "[error] Publish " << hint.c_str() << " data failure!";
+               }
+               else
+               {
+                   m_MsgCountSend2CloudTc++;
+                   if(this->getConfiger().enableDebugPrint)
+                   {
+                       RADAR_CLOUD_DEBUG_PRINT << "[sucess]Publish success!";
+                   }
+                   else
+                   {
+                       RADAR_CLOUD_ERROR_PRINT << "[tc-pb-2-cloud]" << m_MsgCountSend2CloudTc;
+                   }
+               }
+           });
+        }
+        else // 奇数
+        {
+            m_Eventloop->runInLoop([this, topic, payload, hint]()
+           {
+               if (!this->mqttPushStringMsg2Broker(topic, payload, hint))
+               {
+                   RADAR_CLOUD_ERROR_PRINT << "[error] Publish " << hint.c_str() << " data failure!";
+               }
+               else
+               {
+                   m_MsgCountSend2CloudTc++;
+                   if(this->getConfiger().enableDebugPrint)
+                   {
+                       RADAR_CLOUD_DEBUG_PRINT << "[sucess]Publish success!";
+                   }
+                   else
+                   {
+                       RADAR_CLOUD_ERROR_PRINT << "[tc-pb-2-cloud]" << m_MsgCountSend2CloudTc;
+                   }
+               }
+           });
+        }
+        if (message_count_tc_channel > MAX_MESSAGE_COUNT_TC_CHANNEL)
+        {
+            message_count_tc_channel = 0; // 重置计数器
+        }
+        else
+        {
+            message_count_tc_channel++;
+        }
+    }
+}
