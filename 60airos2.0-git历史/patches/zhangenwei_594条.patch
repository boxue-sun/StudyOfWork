+bool RADAR_CLOUD_COMPONENT::mqttPublishMsg(const std::string &topic, const std::string &msg)
+{
+    if (!m_MqttConnected)
+    {
+        RADAR_CLOUD_ERROR_PRINT << "[error]mqtt has not connected!";
+        return false;
+    }
+
+    if (msg.size() <= 0 || topic.empty())
+    {
+        RADAR_CLOUD_ERROR_PRINT << "[error]len < 0 or topic empty!";
+        return false;
+    }
+
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    MQTTAsync_message pubmsg = MQTTAsync_message_initializer;
+    int rc;
+
+    opts.context = m_MqttClient;
+    pubmsg.payload = (void *) msg.c_str();
+    pubmsg.payloadlen = msg.length();
+    pubmsg.qos = m_MqttClientConfig.configerMqtt.mqttSendQos;
+    pubmsg.retained =  m_MqttClientConfig.configerMqtt.mqttRetained;;
+
+    if ((rc = MQTTAsync_sendMessage(m_MqttClient, topic.c_str(), &pubmsg, &opts)) != MQTTASYNC_SUCCESS)
+    {
+        if (rc == MQTTASYNC_DISCONNECTED)
+        {
+            RADAR_CLOUD_ERROR_PRINT << "[error]Async Connect failure，will connect!";
+            if (m_MqttConnected)
+            {
+                m_MqttConnected = false;
+                mqttReconnect();
+            }
+        } else
+        {
+            RADAR_CLOUD_ERROR_PRINT << "[error]push msg error，[error-code]" << rc;
+        }
+
+        return false;
+    }
+
+    return true;
+}
+
+int RADAR_CLOUD_COMPONENT::mqttSubscribeMsgArrvd(void *context, char *topicName, int topicLen, MQTTAsync_message *message)
+{
+    int ret = 1;
+    auto thiz = (RADAR_CLOUD_COMPONENT *) context;
+    if (message->payloadlen)
+    {
+        if(thiz->getConfiger().enableDebugPrint) {
+//            RADAR_CLOUD_DEBUG_PRINT << "∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨";
+            RADAR_CLOUD_DEBUG_PRINT << "[notice]cloud 》》》 RADAR_CLOUD" << " [topic]" << topicName << "[msg]" << (char *) (message->payload);
+//            RADAR_CLOUD_DEBUG_PRINT << "∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧";
+        }
+        afl::base::json j;
+        try
+        {
+            j = afl::base::json::parse((char *) message->payload, (char *) message->payload + message->payloadlen);
+        }
+        catch (...)
+        {
+            RADAR_CLOUD_ERROR_PRINT << "[error]parse json failure!";
+            MQTTAsync_freeMessage(&message);
+            MQTTAsync_free(topicName);
+            return ret;
+        }
+
+        std::string topic(topicName, topicLen);
+        if (topic.size() <= 0)
+        {
+            RADAR_CLOUD_ERROR_PRINT << "[error]topic empty!";
+        } else
+        {
+//            thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+//                  {
+//                      thiz->mqttDispatchSubscripeMessage(topic, j);
+//                  });
+            static int message_count = 1; // 用于计数的静态变量
+            static int MAX_MESSAGE_COUNT = 1000; // 设置您的最大限制
+
+            // 根据消息计数判断是偶数还是奇数
+            if (message_count % 2 == 0) // 偶数
+            {
+                thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+                                             {
+                                                 thiz->mqttDispatchSubscripeMessage(topic, j);
+                                             });
+            }
+            else // 奇数
+            {
+                thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+                                             {
+                                                 thiz->mqttDispatchSubscripeMessage(topic, j);
+                                             });
+            }
+            if (message_count > MAX_MESSAGE_COUNT)
+            {
+                message_count = 0; // 重置计数器
+            }
+            else
+            {
+                message_count++;
+            }
+        }
+    }
+
+    MQTTAsync_freeMessage(&message);
+    MQTTAsync_free(topicName);
+
+    return ret;
+}
+
+bool RADAR_CLOUD_COMPONENT::mqttPushStringMsg2Broker(string topic, string info, string hint)
+{
+    if(!info.empty())
+    {
+        if(!mqttPublishMsg(topic, info))
+        {
+            RADAR_CLOUD_ERROR_PRINT << "[error]push " << hint.c_str() << " failure!";
+            return false;
+        }
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
+}
+bool RADAR_CLOUD_COMPONENT::mqttPushJsonMsg2Broker(string topic, json info, string hint)
+{
+    std::string pData;
+    try{
+        pData = info.dump();
+    }
+    catch (json::exception& e)
+    {
+        RADAR_CLOUD_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+        return false;
+    }
+    if(!pData.empty())
+    {
+        if(!mqttPublishMsg(topic, pData))
+        {
+            RADAR_CLOUD_ERROR_PRINT << "[error]push " << hint.c_str() << " failure!";
+            return false;
+        }
+    }else
+    {
+        return false;
+    }
+    return true;
+}
