-        {
-            CCINDEX_ERROR_PRINT << "[error]topic empty!";
-        } else
-        {
-            //把具体的消息处理放到主线程里，和定时器在一个线程，避免出现两个线程同时修改一个vector/map
-//            thiz->m_Eventloop->runInLoop([thiz, topic, j]()
