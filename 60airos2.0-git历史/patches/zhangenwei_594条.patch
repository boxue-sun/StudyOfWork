+bool OM_Mec_COMPONENT::mqttPushStringMsg2Broker(string topic, string info, string hint)
+{
+    if(!info.empty())
+    {
+        if(!mqttPublishMsg(topic, info))
+        {
+            ERRORPRINT("[error]push %s failure!", hint.c_str());
+            return false;
+        }
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
+}
+bool OM_Mec_COMPONENT::mqttPushJsonMsg2Broker(string topic, json info, string hint)
+{
+    std::string pData;
+    try{
+        pData = info.dump();
+    }
+    catch (afl::base::json::exception& e)
+    {
+        ERRORPRINT("[what]%s [json-exception-id]%d", e.what(),  e.id);
+        return false;
+    }
+    if(!pData.empty())
+    {
+        if(!mqttPublishMsg(topic, pData))
+        {
+            ERRORPRINT("[error]push %s failure!", hint.c_str());
+            return false;
+        }
+    }else
+    {
+        return false;
+    }
+    return true;
+}
