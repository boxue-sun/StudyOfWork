+#include "base/common/network/srand.h"
+#define SUBSCRIBE_NUM 256
+NAMESPACE_START_OM_COMPONENT_COMMON
+using namespace afl::base;
+using namespace afl::util;
+
+struct MqttConfigerCommon : public afl::base::SerializableData
+{
+    std::string mqttBrokerUrl = "tcp://127.0.0.1:1883";
+    std::string mqttUserName = "root";
+    std::string mqttPassword = "root";
+    int         mqttCleanSession = 1;
+    int         mqttVersion = 4;
+    double      mqttKeepAliveInterval = 60;
+    int         mqttSendQos = 0;
+    int         mqttSubScribeQos = 1;
+    double      mqttReconnectInterval = 10;
+    double      mqttConnectTimeOut = 60;
+    int         mqttSslVersion = MQTT_SSL_VERSION_TLS_1_2;
+    std::string sslPrivateKeyPassword = "123456";
+    uint32_t 	mqttRealSubscribeTopicNum;
+    char* 		mqttSubscribeTopics[SUBSCRIBE_NUM];
+    int 		mqttSubscribeQoss[SUBSCRIBE_NUM];
+
+    virtual void serialize(afl::base::json &j) override
+    {
+        JsonSerialize(mqttBrokerUrl,    "A_mqttBrokerUrl", j, false);
+        JsonSerialize(mqttUserName,     "B_mqttUserName", j, false);
+        JsonSerialize(mqttPassword,     "B_mqttPassword", j, false);
+        JsonSerialize(mqttKeepAliveInterval,    "D_mqttKeepAliveInterval", j, false);
+        JsonSerialize(mqttSendQos,      "E_mqttSendQos", j, false);
+        JsonSerialize(mqttSubScribeQos, "F_mqttSubScribeQos", j, false);
+        JsonSerialize(mqttCleanSession, "G_mqttCleanSession", j, false);
+        JsonSerialize(mqttReconnectInterval,    "H_mqttReconnectInterval", j, false);
+        JsonSerialize(mqttSslVersion,           "I_mqttSslVersion", j, false);
+        JsonSerialize(mqttVersion,              "J_mqttVersion", j, false);
+        JsonSerialize(mqttConnectTimeOut,       "K_mqttConnectTimeOut", j, false);
+        JsonSerialize(sslPrivateKeyPassword,    "L_sslPrivateKeyPassword", j, false);
+    }
+
+    virtual void deserialize(const afl::base::json &j) override
+    {
+        JsonDeserialize(mqttBrokerUrl,    "A_mqttBrokerUrl", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttUserName,     "B_mqttUserName", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttPassword,     "B_mqttPassword", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttKeepAliveInterval,    "D_mqttKeepAliveInterval", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttSendQos,      "E_mqttSendQos", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttSubScribeQos, "F_mqttSubScribeQos", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttCleanSession, "G_mqttCleanSession", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttReconnectInterval,    "H_mqttReconnectInterval", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttSslVersion,           "I_mqttSslVersion", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttVersion,              "J_mqttVersion", j, noUse_isEmptyFlag);
+        JsonDeserialize(mqttConnectTimeOut,       "K_mqttConnectTimeOut", j, noUse_isEmptyFlag);
+        JsonDeserialize(sslPrivateKeyPassword,    "L_sslPrivateKeyPassword", j, noUse_isEmptyFlag);
+    }
+public:
+    std::string to_string() const
+    {
+        std::stringstream ss;
+        ss << std::left << std::setw(40) << "A_MqttBrokerUrl: " << mqttBrokerUrl << "\n";
+        ss << std::left << std::setw(40) << "B_MqttUserName: " << mqttUserName << "\n";
+        ss << std::left << std::setw(40) << "C_MqttPassword: " << mqttPassword << "\n";
+        ss << std::left << std::setw(40) << "D_MqttCleanSession: " << mqttCleanSession << "\n";
+        ss << std::left << std::setw(40) << "E_MqttVersion: " << mqttVersion << "\n";
+        ss << std::left << std::setw(40) << "F_MqttKeepAliveInterval: " << mqttKeepAliveInterval << "\n";
+        ss << std::left << std::setw(40) << "G_MqttSendQos: " << mqttSendQos << "\n";
+        ss << std::left << std::setw(40) << "H_MqttSubScribeQos: " << mqttSubScribeQos << "\n";
+        ss << std::left << std::setw(40) << "I_MqttReconnectInterval: " << mqttReconnectInterval << "\n";
+        ss << std::left << std::setw(40) << "J_MqttConnectTimeOut: " << mqttConnectTimeOut << "\n";
+        ss << std::left << std::setw(40) << "K_MqttSslVersion: " << mqttSslVersion << "\n";
+        ss << std::left << std::setw(40) << "L_SslPrivateKeyPassword: " << sslPrivateKeyPassword << "\n";
+        ss << std::left << std::setw(40) << "M_MqttRealSubscribeTopicNum: " << mqttRealSubscribeTopicNum << "\n";
+//        for (uint32_t i = 0; i < mqttRealSubscribeTopicNum; i++)
+//        {
+//            ss << std::left  << "SubscribeQos[" <<  mqttSubscribeQoss[i] << "] " << "SubscribeTopic[" << i << "]: " << mqttSubscribeTopics[i] << "\n";
+//        }
+        return ss.str();
+    }
+};
+
+//项目路径配置
+struct ProjectPathConfigerCommon : public afl::base::SerializableData
+{
+public:
+    std::string projectRoot = "/data/airos/cfg/";
+    std::string tlsDirName = "ssl";
+    std::string tlsCAFileName = "ca.crt";
+    std::string tlsClientKeyFileName = "client.crt";
+    std::string tlsClientPrivateKeyFileName = "client.key";
+    std::string tlsClientPrivateKeyPassword = "123456";
+    std::string tlsCAFilePath;
+    std::string tlsClientKeyFilePath;
+    std::string tlsClientPrivateKeyFilePath;
+    std::string workParamFilePath = "/home/airos/protocol/om_config.flag";
+
+private:
+    virtual void serialize(afl::base::json &j)
+    {
+        JsonSerialize(projectRoot, "A_ProjectRoot", j, false);
+        JsonSerialize(tlsDirName, "A_TlsDirName", j, false);
+        JsonSerialize(tlsCAFileName, "B_TlsCAFileName", j, false);
+        JsonSerialize(tlsClientKeyFileName, "C_TlsClientKeyFileName", j, false);
+        JsonSerialize(tlsClientPrivateKeyFileName, "D_TlsClientPrivateKeyFileName", j, false);
+        JsonSerialize(tlsClientPrivateKeyPassword, "E_TlsClientPrivateKeyPassword", j, false);
+        JsonSerialize(workParamFilePath, "F_WorkParamFilePath", j, false);
+    }
+
+    virtual void deserialize(const afl::base::json &j) override
+    {
+        JsonDeserialize(projectRoot, "A_ProjectRoot", j, noUse_isEmptyFlag);
+        JsonDeserialize(tlsDirName, "A_TlsDirName", j, noUse_isEmptyFlag);
+        JsonDeserialize(tlsCAFileName, "B_TlsCAFileName", j, noUse_isEmptyFlag);
+        JsonDeserialize(tlsClientKeyFileName, "C_TlsClientKeyFileName", j, noUse_isEmptyFlag);
+        JsonDeserialize(tlsClientPrivateKeyFileName, "D_TlsClientPrivateKeyFileName", j, noUse_isEmptyFlag);
+        JsonDeserialize(tlsClientPrivateKeyPassword, "E_TlsClientPrivateKeyPassword", j, noUse_isEmptyFlag);
+        JsonDeserialize(workParamFilePath, "F_WorkParamFilePath", j, noUse_isEmptyFlag);
+    }
+public:
+    std::string to_string() const
+    {
+        std::stringstream ss;
+        ss << std::left << std::setw(40) << "A_projectRoot: " << projectRoot << "\n";
+        ss << std::left << std::setw(40) << "B_tlsDirName: " << tlsDirName << "\n";
+        ss << std::left << std::setw(40) << "C_tlsCAFileName: " << tlsCAFileName << "\n";
+        ss << std::left << std::setw(40) << "D_tlsClientKeyFileName: " << tlsClientKeyFileName << "\n";
+        ss << std::left << std::setw(40) << "E_tlsClientPrivateKeyFileName: " << tlsClientPrivateKeyFileName << "\n";
+        ss << std::left << std::setw(40) << "F_tlsClientPrivateKeyPassword: " << tlsClientPrivateKeyPassword << "\n";
+        ss << std::left << std::setw(40) << "G_tlsCAFilePath: " << tlsCAFilePath << "\n";
+        ss << std::left << std::setw(40) << "H_tlsClientKeyFilePath: " << tlsClientKeyFilePath << "\n";
+        ss << std::left << std::setw(40) << "I_tlsClientPrivateKeyFilePath: " << tlsClientPrivateKeyFilePath << "\n";
+        ss << std::left << std::setw(40) << "J_WorkParamFilePath: " << workParamFilePath << "\n";
+        return ss.str();
+    }
+};
+
+NAMESPACE_ENDED_OM_COMPONENT_COMMON
+#endif //AIROS2_0_CONFIGER_COMMON_H
