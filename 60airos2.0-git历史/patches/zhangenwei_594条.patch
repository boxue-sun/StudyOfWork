+#include "bs_v2x_data_component.h"
+NAMESPACE_PROTOCOL_THREAD_START
+
+bool BS_V2X_DATA_COMPONENT::Init()
+{
+    if(m_MqttClientConfig.basicConfiger.enable_print_info_log )
+    {
+        LOG_ERROR << "[version](1.0) 场景数据组件启动";
+    }
+    doBaiscWork();
+
+
+    m_Task.reset(new std::thread([&](){ UdpInit(); }));
+
+    if (m_MqttClientConfig.v2xDataComponentConfiger.asn_version.compare("4layer") == 0)
+    {
+        m_AsnType = EnAsnType::CASE_53_2020;
+    } else if (m_MqttClientConfig.v2xDataComponentConfiger.asn_version.compare("new_4layer") == 0)
+    {
+        m_AsnType = EnAsnType::YDT_3709_2020;
+    } else
+    {
+        // pass
+    }
+    if (!mqttInit())
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR <<  "[error]mqttInit failure!";
+        }
+
+        return false;
+    }
+;
+    return true;
+}
+
+bool BS_V2X_DATA_COMPONENT::Proc(const std::shared_ptr<const v2xpb::asn::MessageFrame> &frame)
+{
+    if (!frame)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error]frame is nullptr";
+        }
+        return false;
+    }
+    V2xPbAsnMessageFrame2Json(frame);
+    return true;
+}
+bool BS_V2X_DATA_COMPONENT::UdpInit()
+{
+    afl::net::InetAddress addrUp(m_MqttClientConfig.v2xDataComponentConfiger.udp_server_ip.c_str(),
+                                 m_MqttClientConfig.v2xDataComponentConfiger.udp_server_port);
+    m_Eventloop = std::make_shared<afl::net::EventLoop>();
+
+    initUdpConfig(m_UdpSockeFd);
+    if (!m_Chnl)
+    {
+        m_Chnl = std::unique_ptr<afl::net::Channel>(new afl::net::Channel(m_Eventloop.get(), m_UdpSockeFd));
+    }
+
+    m_Chnl->setReadCallback(std::bind(&BS_V2X_DATA_COMPONENT::processUdpMsgFromCommunicationDevice, this, m_UdpSockeFd));
+    m_Chnl->enableReading();
+
+    m_Eventloop->loop();
+
+    return true;
+}
+
+bool BS_V2X_DATA_COMPONENT::V2xPbAsnMessageFrame2Json(const std::shared_ptr<const v2xpb::asn::MessageFrame> &frame)
+{
+    if (!frame)
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error]input is nullptr!";
+        }
+        return false;
+    }
+
+    std::string strAsn;
+    string strPb;
+    std::string hint;
+
+    if (!frame->SerializePartialToString(&strPb))
+    {
+        AIROS_ERRORPRINT("pb serialize false");
+        return false;
+    }
+
+    if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+    {
+        LOG_DEBUG << "[strPb]" <<  strPb.c_str();
+    }
+
+    PushParam pushParam;
+    switch ((int)frame->payload_case())
+    {
+        //业务数据-地图数据
+        case v2xpb::asn::MessageFrame::PayloadCase::kMapFrame:
+            {
+                hint = "map-json";
+                if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                {
+                    LOG_WARN << "[notice]" << hint.c_str();
+                }
+
+                m_MsgType = MT_MAP;
+                pushParam.topic = m_MqttClientConfig.v2xDataComponentConfiger.topic_v2x_map;
+                pushParam.strPb = strPb;
+                pushParam.eventType = 27;
+                pushMapData(pushParam);
+                pushCommunicationDeviceScenarioReceivingData(pushParam.eventType);
+                pushCommunicationDeviceScenarioTransmissionData(pushParam.eventType);
+            }
+            break;
+            //业务数据-信号灯数据
+        case v2xpb::asn::MessageFrame::PayloadCase::kSpatFrame:
+            {
+                hint = "spat-json";
+                if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                {
+                    LOG_WARN << "[notice]" << hint.c_str();
+                }
+                m_MsgType = MT_SPAT;
+                pushParam.topic = m_MqttClientConfig.v2xDataComponentConfiger.topic_v2x_spat;
+                pushParam.strPb = strPb;
+                pushParam.eventType = 1000;
+                pushTrafficLightData(pushParam);
+                pushCommunicationDeviceScenarioReceivingData( pushParam.eventType );
+                pushCommunicationDeviceScenarioTransmissionData( pushParam.eventType );
+            }
+            break;
+            //持续性场景
+            //监控性场景
+        case v2xpb::asn::MessageFrame::PayloadCase::kRsiFrame:
+            {
+                hint = "rsi-json";
+                if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                {
+                    LOG_WARN << "[notice]" << hint.c_str();
+                }
+                auto rsiFramePb = frame->rsiframe();
+//                int64_t  startTimePb = rsiFramePb.start_time_stamp();
+//                int64_t  endTimePb = rsiFramePb.end_time_stamp();
+                int64_t  startTimePb = 0;
+                int64_t  endTimePb = 0;
+                if(rsiFramePb.rtes_size() > 0)
+                {
+                    for(int i = 0; i < rsiFramePb.rtes_size(); i++)
+                    {
+                        auto rtePb = rsiFramePb.rtes(i);
+                        pushParam.eventType = rtePb.event_type();
+                        pushParam.topic = m_MqttClientConfig.v2xDataComponentConfiger.topic_v2x_rsi;
+                        pushParam.strPb = strPb;
+
+                        if(startTimePb >= 0)
+                        {
+                            pushParam.startTimePb = startTimePb;
+                            pushParam.timeType = TimeTypeStart;
+                            if(pushRteData(pushParam))
+                            {
+                                pushCommunicationDeviceScenarioReceivingData(pushParam.eventType);
+                                pushCommunicationDeviceScenarioTransmissionData(pushParam.eventType);
+                            }
+                        }
+
+                        if(endTimePb >= 0)
+                        {
+                            pushParam.startTimePb = endTimePb;
+                            pushParam.timeType = TimeTypeEnd;
+                            if(pushRteData(pushParam))
+                            {
+                                pushCommunicationDeviceScenarioReceivingData(pushParam.eventType);
+                                pushCommunicationDeviceScenarioTransmissionData(pushParam.eventType);
+                            }
+                        }
+
+                    }
+                }
+                ///////////////////////////////////////////////////////////////////////
+                if(rsiFramePb.rtss_size() > 0)
+                {
+                    for(int i = 0; i < rsiFramePb.rtss_size(); i++)
+                    {
+                        auto rtsPb = rsiFramePb.rtss(i);
+                        pushParam.eventType = rtsPb.sign_type();
+                        pushParam.topic = m_MqttClientConfig.v2xDataComponentConfiger.topic_v2x_rsi;
+                        pushParam.strPb = strPb;
+                        if(pushRtsData(pushParam))
+                        {
+                            pushCommunicationDeviceScenarioReceivingData(pushParam.eventType);
+                            pushCommunicationDeviceScenarioTransmissionData(pushParam.eventType);
+                        }
+                    }
+                }
+                break;
+            }
+        case v2xpb::asn::MessageFrame::PayloadCase::kBsmFrame:
+            {
+                hint = "bsm-json";
+                m_MsgType = MT_BSM;
+            }
+            break;
+
+        case v2xpb::asn::MessageFrame::PayloadCase::kRsmFrame:
+            {
+                hint = "rsm-json";
+                m_MsgType = MT_RSM;
+            }
+            break;
+        default:
+            LOG_WARN << "msg type not support ";
+            break;
+    }
+
+
+    return true;
+}
+
+void BS_V2X_DATA_COMPONENT::pushCommunicationDeviceScenarioReceivingData(int sceneNo)
+{
+    afl::base::json uploadJson;
+    std::string strAsn;
+    std::string hint = "recv-data";
+    //通信设备场景回执
+    CommunicationDeviceScenarioReceivingData communicationDeviceScenarioReceivingData;
+    communicationDeviceScenarioReceivingData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    communicationDeviceScenarioReceivingData.rscuEsn =  m_MqttClientConfig.basicConfiger.rscu_esn ;
+    communicationDeviceScenarioReceivingData.deviceID =  m_MqttClientConfig.basicConfiger.euht_esn ;
+
+    if(!mqttPushMsg2Broker(m_MqttClientConfig.v2xDataComponentConfiger.topic_scene_recv, communicationDeviceScenarioReceivingData, hint))
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_WARN << "[notice][error] push " << hint.c_str() << " failure!";
+        }
+    }
+
+}
+void BS_V2X_DATA_COMPONENT::pushCommunicationDeviceScenarioTransmissionData(int sceneNo)
+{
+    afl::base::json uploadJson;
+    std::string strAsn;
+    std::string hint = "transmission-data";
+    //通信设备场景回执
+    CommunicationDeviceScenarioTransmissionData communicationDeviceScenarioTransmissionData;
+    communicationDeviceScenarioTransmissionData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    communicationDeviceScenarioTransmissionData.rscuEsn =  m_MqttClientConfig.basicConfiger.rscu_esn ;
+    communicationDeviceScenarioTransmissionData.deviceID =  m_MqttClientConfig.basicConfiger.euht_esn ;
+    if(!mqttPushMsg2Broker(m_MqttClientConfig.v2xDataComponentConfiger.topic_scene_brod, communicationDeviceScenarioTransmissionData, hint))
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_WARN << "[notice][error] push " << hint.c_str() << " failure!";
+        }
+    }
+
+}
+bool BS_V2X_DATA_COMPONENT::pushRtsData(PushParam& pushParam)
+{
+    afl::base::json uploadJson;
+    std::string strAsn;
+    std::string hint = "rts-data";
+    std::string asn_json_str;
+    if (0 > message_frame_pbstr2uper_adapter(pushParam.strPb, &strAsn, m_AsnType, &asn_json_str))
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error]pb to asn false!";
+        }
+        return false;
+    }
+
+
+    AIROS_ERRORPRINT("[asn_json_str]%s", asn_json_str.c_str());
+    ContinuousServScenarioData continuousServScenarioData;
+    continuousServScenarioData.time = afl::util::TimeStamp::now(true).millSeconds();
+    continuousServScenarioData.MECEsn = m_MqttClientConfig.basicConfiger.rscu_esn;
+    continuousServScenarioData.sceneNo = std::to_string(pushParam.eventType);
+    continuousServScenarioData.mesCon = asn_json_str;
+    if(!mqttPushMsg2Broker(pushParam.topic, continuousServScenarioData, hint))
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_WARN << "[notice][error] push " << hint.c_str() << " failure!";
+        }
+
+        return false;
+    }
+
+    return true;
+}
+
+
+// 检查字符串是否为有效的 UTF-8 编码
+bool BS_V2X_DATA_COMPONENT::isValidUTF8(const std::string& data)
+{
+    std::wstring_convert<std::codecvt_utf8<char32_t>, char32_t> conv;
+    try {
+        conv.from_bytes(data);
+        return true;
+    } catch (const std::range_error&)
+    {
+        return false;
+    }
+}
+bool BS_V2X_DATA_COMPONENT::pushRteData(PushParam& pushParam)
+{
+    afl::base::json uploadJson;
+    std::string strAsn;
+    std::string hint = "rte-data";
+    std::string asn_json_str;
+    if (0 > message_frame_pbstr2uper_adapter(pushParam.strPb, &strAsn, m_AsnType, &asn_json_str))
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[error]pb to asn false!";
+        }
+        return false;
+    }
+
+    if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+    {
+        LOG_ERROR << "[asn_json_str]" << asn_json_str.c_str();
+    }
+    switch ((int)pushParam.timeType)
+    {
+        case TimeTypeStart:
+            {
+                if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                {
+                    LOG_ERROR << "[TimeTypeStart]" ;
+                }
+                MonitoringServScenarioStartData monitoringServScenarioStartData;
+                monitoringServScenarioStartData.time = afl::util::TimeStamp::now(true).millSeconds();
+                monitoringServScenarioStartData.MECEsn = m_MqttClientConfig.basicConfiger.rscu_esn;
+                monitoringServScenarioStartData.sceneNo = std::to_string(pushParam.eventType);
+                monitoringServScenarioStartData.sceneSeq =    afl::util::Srand::srandStr(32);
+                monitoringServScenarioStartData.startTime = pushParam.startTimePb;
+                monitoringServScenarioStartData.mesCon = asn_json_str;
+                if(!mqttPushMsg2Broker(pushParam.topic, monitoringServScenarioStartData, hint))
+                {
+                    if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                    {
+                        LOG_WARN << "[notice][error] push " << hint.c_str() << " failure!";
+                    }
+                }
+                break;
+            }
+        case TimeTypeEnd:
+            {
+                if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                {
+                    LOG_ERROR << "[TimeTypeEnd]" ;
+                }
+                MonitoringServScenarioEndData monitoringServScenarioEndData;
+                monitoringServScenarioEndData.time = afl::util::TimeStamp::now(true).millSeconds();
+                monitoringServScenarioEndData.MECEsn = m_MqttClientConfig.basicConfiger.rscu_esn;
+                monitoringServScenarioEndData.sceneNo = std::to_string(pushParam.eventType);
+                monitoringServScenarioEndData.sceneSeq = afl::util::Srand::srandStr(32);
+                monitoringServScenarioEndData.endTime = pushParam.startTimePb;
+                monitoringServScenarioEndData.mesCon = asn_json_str;
+                if(!mqttPushMsg2Broker(pushParam.topic, monitoringServScenarioEndData, hint))
+                {
+                    if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+                    {
+                        LOG_WARN << "[notice][error] push " << hint.c_str() << " failure!";
+                    }
+                    return false;
+                }
+                break;
+            }
+        default:
+            break;
+    }
+    return true;
+}
+/**
+ * @func 信号机数据
