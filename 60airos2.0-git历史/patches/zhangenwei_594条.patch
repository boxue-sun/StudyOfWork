+{
+    if(getConfiger().hasInited)
+    {
+        SUCESSPRINT("[sucess]has inited!")
+        return true;
+    }
+    OmWorkParamConfiger  omWorkParamConfiger;
+    WorkParam::getWorkParamFromFile(getConfiger().configerProjectPath.workParamFilePath, omWorkParamConfiger);
+    ERRORPRINT("[work-param]%s", omWorkParamConfiger.to_string().c_str());
+    bool needSaveConfiger = false;
+    bool hasErased = false;
+    for(auto& v : omWorkParamConfiger.sensorDeviceWorkParamList)
+    {
+        if(v.deviceType == WorkParamDeviceTypeRadar && !v.deviceEsn.empty())
+        {
+            ERRORPRINT("[error]mqttInit failure!");
+            needSaveConfiger = true;
+            if(!hasErased)
+            {
+                getConfiger().configerTopicRadarID.radarIDs.clear();
+                hasErased = true;
+            }
+            getConfiger().configerTopicRadarID.radarIDs.push_back(v.deviceEsn);
+            getConfiger().configerTopicRadarID.cross_id = v.radarCrossId;
+
+        }
+    }
+    getConfiger().rscuEsn = omWorkParamConfiger.mecDeviceWorkParam.deviceEsn;
+//    getConfiger().hasInited = true;
+    if(needSaveConfiger)
+    {
+        saveConfiger();
+    }
+
+    return true;
