+    }
+
+    for (uint32_t i = 0; i < m_MqttClientConfig.configerMqtt.mqttRealSubscribeTopicNum; i++)
+    {
+        m_MqttClientConfig.configerMqtt.mqttSubscribeQoss[i] =  m_MqttClientConfig.configerMqtt.mqttSubScribeQos;
