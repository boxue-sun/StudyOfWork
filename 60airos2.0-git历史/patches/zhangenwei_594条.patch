+bool OM_ALGORITHM_STATUS_COMPONENT::Init()
+{
+    if(!m_HasSendOnce)
+    {
+        Send("/v2x/cloud/report/mqtt", m_CloudDataPtr);
+        m_HasSendOnce = true;
+    }
+    m_Task.reset(new std::thread([&](){ initEventLoop(); }));
+    if(!getConfiger().enableRegister)
+    {
+        m_RegisterFlag = true;
+    }
+
+    doBaiscWork();
+    return true;
+}
+bool OM_ALGORITHM_STATUS_COMPONENT::initEventLoop()
+{
+    m_Eventloop = std::make_shared<afl::net::EventLoop>();
+    m_Eventloop->loop();
+    return true;
+}
+void OM_ALGORITHM_STATUS_COMPONENT::showAirosChannelInfo(std::string module_log, std::string topic, std::string payload)
+{
+    if(getConfiger().enableDebugPrint)
+    {
+//        OM_MEC_DEBUG_PRINT << "∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨";
+        OM_ALGORITHM_STATUS_DEBUG_PRINT << module_log << "[notice]om_cloud 》》》 om_algorithm_status" << " [topic]" << topic.c_str()<< "[msg]" << payload.c_str();
+//        OM_MEC_DEBUG_PRINT << "∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧";
+    }
+}
+bool OM_ALGORITHM_STATUS_COMPONENT::Proc(const std::shared_ptr<const   airos::usecase::EventOutputResult>& recv_data)
+{
+    if (!recv_data)
+    {
+        OM_ALGORITHM_STATUS_ERROR_PRINT << "data empty!";
+        return false;
+    }
+    if (recv_data->has_mec_algorithm_status())
+    {
+        bool isGetMecAlgorithmStatus  = false;
+        PerceptionAlgorithmRunningStatus perceptionAlgorithmRunningStatus;
+        auto mec_algorithm_status = recv_data->mec_algorithm_status();
+        perceptionAlgorithmRunningStatus.timestamp = mec_algorithm_status.msg_type();
+        perceptionAlgorithmRunningStatus.seqNum = afl::util::Srand::srandStr(32);
+        perceptionAlgorithmRunningStatus.rscuEsn = getConfiger().rscuEsn;
+        for(int i = 0; i < mec_algorithm_status.dev_list().size(); i++)
+        {
+            auto dev_status = mec_algorithm_status.dev_list()[i];
+            switch(dev_status.dev_type())
+            {
+            case  airos::usecase::MecDevAlgorithmStatusDevType::DEV_TYPE_MEC:
+                perceptionAlgorithmRunningStatus.algStatus = (os::v2x::protocol::om::common::AlgorithmStatusType)dev_status.dev_service_status();
+                isGetMecAlgorithmStatus = true;
+                break;
+            case airos::usecase::MecDevAlgorithmStatusDevType::DEV_TYPE_CAMERE:
+                {
+                    std::string deviceSn = dev_status.device_id();
+                    std::string deviceEsn;
+                    if(getDeviceEsn(deviceSn, deviceEsn))
+                    {
+                        CameraStatus cameraStatus;
+                        cameraStatus.deviceID = deviceEsn;
+                        cameraStatus.deviceSn = deviceSn;
+                        cameraStatus.dataStatus = (os::v2x::protocol::om::common::CameraStatusType)dev_status.dev_service_status();
+                        perceptionAlgorithmRunningStatus.camerasStatus.push_back(cameraStatus);
+                        perceptionAlgorithmRunningStatus.camerasStatusEmpty = false;
+                    }
+                }
+                break;
+            case airos::usecase::MecDevAlgorithmStatusDevType::DEV_TYPE_MW_RADAR:
+                {
+                    std::string deviceSn = dev_status.device_id();
+                    std::string deviceEsn;
+                    if(getDeviceEsn(deviceSn, deviceEsn))
+                    {
+                        RadarStatus radarStatus;
+                        radarStatus.deviceID = deviceEsn;
+                        radarStatus.deviceSn = deviceSn;
+                        radarStatus.dataStatus = (os::v2x::protocol::om::common::RadarStatusType)dev_status.dev_service_status();
+                        perceptionAlgorithmRunningStatus.radarsStatus.push_back(radarStatus);
+                        perceptionAlgorithmRunningStatus.radarsStatusEmpty = false;
+                    }
+                }
+                break;
+            case airos::usecase::MecDevAlgorithmStatusDevType::DEV_TYPE_RADAR:
+                {
+                    std::string deviceSn = dev_status.device_id();
+                    std::string deviceEsn;
+                    if(getDeviceEsn(deviceSn, deviceEsn))
+                    {
+                        RadarStatus radarStatus;
+                        radarStatus.deviceID = deviceEsn;
+                        radarStatus.deviceSn = deviceSn;
+                        radarStatus.dataStatus = (os::v2x::protocol::om::common::RadarStatusType)dev_status.dev_service_status();
+                        perceptionAlgorithmRunningStatus.radarsStatus.push_back(radarStatus);
+                        perceptionAlgorithmRunningStatus.radarsStatusEmpty = false;
+                    }
+                }
+                break;
+            default:
+                break;
+
+            }
+        }
+        if(!isGetMecAlgorithmStatus)
+        {
+            perceptionAlgorithmRunningStatus.algStatus =  ALGORITHM_STATUS_ERROR;
+        }
+
+        json subScribeJson;
+        try
+        {
+            subScribeJson = perceptionAlgorithmRunningStatus;
+        }
+        catch (afl::base::json::exception &e)
+        {
+            OM_ALGORITHM_STATUS_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id;
+            return false;
+        }
+
+        std::string topic = getConfiger().configerTopic.Topic_Profix + getConfiger().rscuEsn + getConfiger().configerTopic.Topic_Algorithm_Status;
+        std::string hint = "algorithm status";
+        if(!topic.empty())
+        {
+            auto mqtt_data  = m_CloudDataPtr->mutable_mqtt_data();
+            std::string upTopic = topic;
+            mqtt_data->set_topic(upTopic);
+            std::string msg = subScribeJson.dump();
+            mqtt_data->set_data(msg.data(), msg.size());
+
+            if(getConfiger().enableDebugPrint)
+            {
+                //            OM_MEC_DEBUG_PRINT << "∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨";
+                OM_ALGORITHM_STATUS_ERROR_PRINT << "[notice]om_mec 》》》 om_cloud" << "[topic]" << upTopic << " msg:" << std::endl << m_CloudDataPtr->DebugString();
+                //            OM_MEC_DEBUG_PRINT << "∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧";
+            }
+
+            Send("/v2x/cloud/report/mqtt", m_CloudDataPtr);
+        }
+
+    }
+
+    return true;
+}
+void OM_ALGORITHM_STATUS_COMPONENT::doBaiscWork()
+{
+    getWorkParamFromFile();
+}
+
+bool OM_ALGORITHM_STATUS_COMPONENT::getWorkParamFromFile()
+{
+    WorkParam::getWorkParamFromFile(getConfiger().configerWorkParam.workParamFilePath, m_OmWorkParamConfiger);
+    if(getConfiger().enableDebugPrint) {
+        OM_ALGORITHM_STATUS_DEBUG_PRINT << "[work-param]" << m_OmWorkParamConfiger.to_string().c_str();
+    }
+    getConfiger().rscuEsn = m_OmWorkParamConfiger.mecDeviceWorkParam.deviceEsn;
+    getConfiger().enableDebugPrint = m_OmWorkParamConfiger.hasedInit;
+    saveConfiger();
+    return true;
+}
+bool OM_ALGORITHM_STATUS_COMPONENT::getDeviceEsn(std::string deviceId, std::string& deviceEsn)
+{
+    for(auto sensorDeviceWorkParam:m_OmWorkParamConfiger.sensorDeviceWorkParamList)
+    {
+        if(sensorDeviceWorkParam.deviceSn == deviceId)
+        {
+            deviceEsn = sensorDeviceWorkParam.deviceEsn;
+            break;
+        }
+    }
+    return true;
+}
+NAMESPACE_ENDED_OM_COMPONENT_ALGORITHN_STATUS
