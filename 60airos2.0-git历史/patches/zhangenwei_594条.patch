+void OM_DEVICE_STATUS_COMPONENT::getCpuInfo(CpuInfo &cpuInfo)
+{
+    FILE *fd;
+    char buff[256];
+    CPU_OCCUPY cpu_occupy[8];
+    std::string cpu_use = "";
+
+    fd = fopen("/proc/stat", "r");
+    if (fd != NULL)
+    {
+        if(fgets(buff, sizeof(buff), fd) == NULL)
+        {
+            OM_DS_ERROR_PRINT << "fgets error";
+        }
+        for (int i = 0; i < 8; i++)
+        {
+            if (fgets(buff, sizeof(buff), fd) != NULL)
+            {
+                if (strstr(buff, "cpu") != NULL)
+                {
+                    sscanf(buff, "%s %u %u %u %u %u %u %u", cpu_occupy[i].name, &cpu_occupy[i].user,
+                           &cpu_occupy[i].nice, &cpu_occupy[i].system, &cpu_occupy[i].idle, &cpu_occupy[i].lowait, &cpu_occupy[i].irq, &cpu_occupy[i].softirq);
+                    if (cpu_use != "")cpu_use += ",";
+                    cpu_use += std::to_string(getCpuUse(&m_OldCpuOccupy[i], &cpu_occupy[i]) * 100) + "%";
+                }
+            }
+        }
+        fclose(fd);
+        cpuInfo.uti = cpu_use;
+    }
+
+    FILE *fd2 = fopen("/proc/loadavg", "r");
+    if (fd2 != NULL)
+    {
+        if (fgets(buff, sizeof(buff), fd2) == NULL)
+        {
+            OM_DS_ERROR_PRINT << "fgets error";
+        }
+        float a = 0.00;
+        sscanf(buff, "%f", &a);
+        fclose(fd2);
+        cpuInfo.load = a;
+        std::copy(cpu_occupy, cpu_occupy + 8, m_OldCpuOccupy);
+    }
+
+    std::vector<double> temperatures;
+    // 遍历 /sys/class/thermal/thermal_zone* 目录
+    for (int i = 0; i < 10; i++)
+    {
+        std::string path = "/sys/class/thermal/thermal_zone" + std::to_string(i) + "/temp";
+        std::ifstream file(path);
+        if (file.is_open()) {
+            int temp;
+            file >> temp;
+            if(temp > 0)
+            {
+                temperatures.push_back(static_cast<double>(temp) / 1000.0); // 温度值以毫度为单位
+            }
+            file.close();
+        }
+    }
+    double temperaturesSum = 0;
+    for(auto t : temperatures)
+    {
+        temperaturesSum += t;
+    }
+    cpuInfo.temp = temperaturesSum/temperatures.size();
+    //    // 遍历 /sys/devices/platform/coretemp.*/hwmon/hwmon*/temp*_input 目录
+    //    for (int i = 0; ; i++)
+    //    {
+    //        std::string path = "/sys/devices/platform/coretemp." + std::to_string(i) + "/hwmon/hwmon*/temp1_input";
+    //        std::ifstream file(path);
+    //        if (file.is_open()) {
+    //            int temp;
+    //
+    //            file >> temp;
+    //            temperatures.push_back(static_cast<double>(temp) / 1000.0); // 温度值以毫度为单位
+    //            file.close();
+    //        }
+    //        else
+    //        {
+    //            break;
+    //        }
+    //    }
+
+}
+
+double OM_DEVICE_STATUS_COMPONENT::getCpuUse(CPU_OCCUPY *o, CPU_OCCUPY *n)
+{
+    unsigned long od, nd;
+    od = (unsigned long) (o->user + o->nice + o->system + o->idle + o->lowait + o->irq + o->softirq);
+    nd = (unsigned long) (n->user + n->nice + n->system + n->idle + n->lowait + n->irq + n->softirq);
+    double sum = nd - od;
+    double idle = n->idle - o->idle;
+    return (sum - idle) / sum;
+}
