+    void mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json & subScribeJson);
+    void mqttDispatchSubscripeMessageProto(std::string topic, void* data, int size);
+    bool udpInit();
+    void readUdpData();
+    uint8_t CovertGatLightColor(uint8_t gat_light_color);
+    bool mqttPublishMsgRetries(std::string topic, json payload, std::string hint);
+    template<typename T>
+    bool mqttPushMsg2Broker(string topic, T info, string hint)
+    {
+        std::string pData;
+
+        try
+        {
+            afl::base::json pushInfoJson = info;
+            pData = pushInfoJson.dump();
+        } catch (json::exception &e)
+        {
+            RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[what]" << e.what() << " [json-exception-id]" << e.id << std::endl;
+            return false;
+        }
+
+        if (!pData.empty())
+        {
+            if (!mqttPublishMsg(topic, pData))
+            {
+                RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error]push " << hint.c_str() << " error!";
+                return false;
+            } else
+            {
+                RADAR_TRAFFIC_METRICS_DEBUG_PRINT << "[notice]radar_traffic_metrics >>> cloud" << "[topic]" << topic.c_str() << " [content]" << pData.c_str();
+            }
+        } else
+        {
+            return false;
+        }
+        return true;
+    }
+    bool mqttPushStringMsg2Broker(string topic, string info, string hint);
+    bool mqttPushJsonMsg2Broker(string topic, json info, string hint);
+    template<typename  T>
+    bool publishData(string topic, T info, string hint, string module_log="")
+    {
+        if(!topic.empty())
+        {
+            auto cloud_data = std::make_shared<os::v2x::device::CloudData>();
+            auto mqtt_data  = cloud_data->mutable_mqtt_data();
+            mqtt_data->set_topic(topic);
+            afl::base::json publishJson;
+            try{
+                publishJson = info;
+            }
+            catch (json::exception &e)
+            {
+                RADAR_TRAFFIC_METRICS_ERROR_PRINT << module_log << "[what]" << e.what() << " [json-exception-id]" << e.id;
+                return false;
+            }
+
+
+            std::string msg = publishJson.dump();
+            mqtt_data->set_data(msg.data(), msg.size());
+            if(getConfiger().enableDebugPrint) {
+//                RADAR_TRAFFIC_METRICS_DEBUG_PRINT << module_log << "∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨∨";
+                RADAR_TRAFFIC_METRICS_DEBUG_PRINT << module_log << "[notice]radar_traffic_metrics 》》》 radar_cloud" << " [topic ]" << topic
+                                   << "[msg-json]" << publishJson.dump().c_str();
+                RADAR_TRAFFIC_METRICS_DEBUG_PRINT << module_log << "[notice]radar_traffic_metrics 》》》 om_cloud" << " [channel]/v2x/cloud/report/mqtt"
+                                   << " [msg-pb]" << cloud_data->DebugString();
+//                RADAR_TRAFFIC_METRICS_DEBUG_PRINT << module_log << "∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧∧";
+            }
+            m_MsgCountSend2ChannelTrafficMetricsPb++;
+            Send("/v2x/cloud/report/radar_traffic_metrics", cloud_data);
+            if(getConfiger().configerTestParam.trafficMetricsTest)
+            {
+                RADAR_TRAFFIC_METRICS_DEBUG_PRINT << "[pb-2-channel]" << m_MsgCountSend2ChannelTrafficMetricsPb;
+            }
+
+        }
+        return true;
+    }
+private:
+    std::unique_ptr<std::thread>    m_Task;
+    /////////////////////////////////////////////////////////////
+    std::shared_ptr<afl::net::EventLoop>    m_Eventloop;
