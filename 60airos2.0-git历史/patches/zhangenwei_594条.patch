+bool BS_ANGLE_OFFSET_COMPONENT::mqttPushStringMsg2Broker(string topic, string info, string hint)
+{
+    if(!info.empty())
+    {
+        if(!mqttPublishMsg(topic, info))
+        {
+            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error]push " << hint.c_str() << "failure!";
+            }
+
+            return false;
+        }
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
+}
+bool BS_ANGLE_OFFSET_COMPONENT::mqttPushJsonMsg2Broker(string topic, json info, string hint)
+{
+    std::string pData;
+    try{
+        pData = info.dump();
+    }catch (json::exception& e){
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR << "[what]" << e.what() << " [json-exception-id]" << e.id;
+        }
+
+        return false;
+    }
+    if(!pData.empty())
+    {
+        if(!mqttPublishMsg(topic, pData))
+        {
+            if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+            {
+                LOG_ERROR << "[error]push " << hint.c_str() << "failure!";
+            }
+
+            return false;
+        }
+    }else
+    {
+        return false;
+    }
+    return true;
+}
