+// 处理Mec监控数据：处理数据更新逻辑
+void OM_COMPONENT::handleMonitorDataUpdate(int tag, uint64_t timestamp)
+{
+    if (m_MonitorRules.find(tag) == m_MonitorRules.end())
+    {
+        return;
+    }
+
+    auto& rule = m_MonitorRules[tag];
+    if (!rule.enable)
+    {
+        return;
+    }
+    auto& state = m_MonitorStates[tag];
+    uint64_t now = afl::util::TimeStamp::now(true).millSeconds();
+
+    // 1. 喂狗：更新最后收到时间
+    state.lastReceivedTime = now;
+    OM_MEC_DEBUG_PRINT << "[monitor][lastReceivedTime]" << state.lastReceivedTime;
+    // 2. 检查恢复逻辑
+    if (state.isAlarmActive) {
+        if (state.recoveryStartTime == 0)
+        {
+            // 收到告警后的第一帧数据，开始恢复计时
+            state.recoveryStartTime = now;
+            if (getConfiger().enableDebugPrint)
+            {
+                OM_MEC_DEBUG_PRINT << "[monitor][recovery-start] tag:" << tag;
+            }
+        }
+        else
+        {
+            // 检查数据是否持续了足够长的时间
+            if (now - state.recoveryStartTime >= rule.recoveryMs)
+            {
+                // 满足恢复条件 -> 消除告警
+                alarmDisappeared(rule.name, rule.alarmType, getConfiger().rscuEsn, "", state.alarmOccurredTime);
+                state.isAlarmActive = false;
+                state.recoveryStartTime = 0;
+                state.lastAlarmPublishTime = 0;  // 重置告警上报时间
+                OM_MEC_SUCESS_PRINT << "[Monitor] RECOVERED: " << rule.name;
+            }
+        }
+    }
+}
+
+//处理Mec监控数据： 处理链路状态逻辑
+void OM_COMPONENT::handleMonitorLinkUpdate(int tag, bool status, uint64_t timestamp)
+{
+    if (m_MonitorRules.find(tag) == m_MonitorRules.end())
+    {
+        return;
+    }
+
+    auto& rule = m_MonitorRules[tag];
+    if (!rule.enable)
+    {
+        return;
+    }
+    auto& state = m_MonitorStates[tag];
+    uint64_t now = afl::util::TimeStamp::now(true).millSeconds();
+    // 1. 喂狗：只要收到消息，说明模块在线，更新心跳时间
+    state.lastReceivedTime = now;
+    OM_MEC_DEBUG_PRINT << "[monitor][lastReceivedTime]" << state.lastReceivedTime;
+    // 2. 检查链路内容状态
+    // 如果之前是告警状态 (可能是因为超时导致的，也可能是因为status=false导致的)
+    // 或者是正常状态但收到了 false
+
+    if (status == false)
+    {
+        // 链路显式报错
+        if (!state.isAlarmActive)
+        {
+            alarmOccurred(rule.name + " [link down]", rule.alarmType, getConfiger().rscuEsn, "");
+            state.isAlarmActive = true;
+            state.alarmOccurredTime = now;
+            state.lastAlarmPublishTime = now;  // 记录首次告警上报时间
+        }
+        // 如果已经在告警，检查是否需要重复上报
+        else
+        {
+            // 检查是否需要重复上报告警
+            if (state.lastAlarmPublishTime > 0)
+            {
+                uint64_t alarmPublishTimeDiff = (now - state.lastAlarmPublishTime) ;
+                if (getConfiger().enableDebugPrint)
+                {
+                    OM_MEC_DEBUG_PRINT << "[Monitor][link-alarm-repeat][tag]" << tag 
+                                       << "[name]" << rule.name 
+                                       << "[timeDiff(ms)]" << alarmPublishTimeDiff
+                                       << "[interval(ms)]" << rule.timeoutMs;
+                }
+                
+                // 如果距离上次上报时间已经超过配置的重复上报间隔，则重复上报
+                if (alarmPublishTimeDiff >= rule.timeoutMs)
+                {
+                    alarmOccurred(rule.name + " [link down]", rule.alarmType, getConfiger().rscuEsn, "");
+                    state.lastAlarmPublishTime = now;  // 更新上次上报时间
+                    OM_MEC_ERROR_PRINT << "[Monitor] LINK ALARM REPEATED: " << rule.name 
+                                      << " (repeat interval: " 
+                                      << rule.timeoutMs << "ms)";
+                }
+            }
+        }
+    }
+    else // status == true
+    {
+        // 链路正常
+        if (state.isAlarmActive) {
+            // 链路恢复通常不需要持续时间，收到 true 即认为恢复
+            // 如果需要持续时间，可以在这里加类似 handleMonitorDataUpdate 的逻辑
+            alarmDisappeared(rule.name, rule.alarmType, getConfiger().rscuEsn, "", state.alarmOccurredTime);
+            state.isAlarmActive = false;
+            state.recoveryStartTime = 0;
+            state.lastAlarmPublishTime = 0;  // 重置告警上报时间
+            OM_MEC_SUCESS_PRINT << "[Monitor] LINK RECOVERED: " << rule.name;
+        }
+    }
+
+    state.lastLinkStatus = status;
+}
