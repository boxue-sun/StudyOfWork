-  ts.it_value.tv_sec     = 3;
-  ts.it_value.tv_nsec    = 0;
-
-  if (0 != timer_settime(timer_keep_connection_, 0, &ts, NULL)) {
-    TRAFFIC_LIFGT_SERVICE_LOG_ERROR << "timer set failed.";
