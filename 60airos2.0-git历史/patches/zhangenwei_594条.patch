-    TRAFFIC_LIFGT_SERVICE_LOG_WARN << "remote ip: " << ip << "\nremote port: " << port
-             << "\nhost ip: " << local_ip << "\nhost port: " << local_port
-             << "\nprotocol: " << protocol;
