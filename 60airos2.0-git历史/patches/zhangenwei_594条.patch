-
-    // 遍历 map 中的其他 JSON 对象
-    for (auto it = std::next(firstPair); it != m_ConfigUpdateDataJson.end(); ++it)
-    {
-        const json& currentJson = it->second;
-
-        // 检查当前 JSON 对象中是否存在 "data" 字段
-        if (currentJson.find("data") != currentJson.end())
-        {
-            const json& currentData = currentJson["data"];
