+        ss << std::left << std::setw(40) << "I_configerEnableCCIndex:\n " << configerEnableCCIndex.to_string() << "\n";
+        ss << std::left << std::setw(40) << "K_configerTopicCCIndex:\n " << configerTopicCCIndex.to_string() << "\n";
+        ss << "---------------------------------------------------\n";
+        ss << "--->ccindex\n";
+        ss << std::left << std::setw(40) << "M_topicUnMapCCIndex-Size: " << topicUnMapCCIndex.size() << "\n";
+        for (const auto& pair : topicUnMapCCIndex)
+        {
+            ss << std::left << "om-Radar-topic[" << pair.first << "]" << "\n" ;
+            ss << pair.second.to_string() << "\n";
+            ss << "---------------------------------------------------\n";
+        }
+        ss << std::left << std::setw(40) << "configerWorkParam:\n " << configerWorkParam.to_string() << "\n";
+        return ss.str();
+    }
+};
