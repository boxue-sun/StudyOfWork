+void RADAR_TRAFFIC_METRICS_COMPONENT::mqttOnConnect(void *context, MQTTAsync_successData *response)
+{
+    RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[sucess]connect sucess!";
+    auto thiz = (RADAR_TRAFFIC_METRICS_COMPONENT *) context;
+    thiz->m_MqttConnected = true;
+    MQTTAsync_responseOptions opts = MQTTAsync_responseOptions_initializer;
+    opts.onSuccess = mqttOnSubscribe;
+    opts.onFailure = mqttOnSubscribeFailure;
+    opts.context = thiz;
+
+
+    if(thiz->m_MqttClientConfig.configerMqtt.mqttRealSubscribeTopicNum > 0)
+    {
+        if (MQTTAsync_subscribeMany(thiz->m_MqttClient, thiz->m_MqttClientConfig.configerMqtt.mqttRealSubscribeTopicNum,
+                                    thiz->m_MqttClientConfig.configerMqtt.mqttSubscribeTopics,
+                                    thiz->m_MqttClientConfig.configerMqtt.mqttSubscribeQoss,
+                                    &opts) != MQTTASYNC_SUCCESS)
+        {
+            RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error]subscribe error";
+        }
+    }
+}
+
+void RADAR_TRAFFIC_METRICS_COMPONENT::mqttOnConnectFailure(void *context, MQTTAsync_failureData *response)
+{
+    if (response)
+    {
+        if (response->message)
+        {
+            RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error]connect error [error-code]" << response->code << "[error-msg]" << response->message;
+        } else
+        {
+            RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error]connect error [error-code]" << response->code << " [error-msg]" << response->message;
+        }
+    } else
+    {
+        RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error]connect error!";
+    }
+
+    auto thiz = (RADAR_TRAFFIC_METRICS_COMPONENT *) context;
+    thiz->mqttReconnect();
+}
