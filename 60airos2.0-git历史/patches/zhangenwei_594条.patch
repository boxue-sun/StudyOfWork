+std::string ParseInfo::rsapMsgHeaderToString(RsapMsgHeader &rsapMsgHeader) const
+{
+    std::stringstream ss;
+    try{
+        ss << std::hex << std::setfill(' ');
+
+        ss << std::setw(25) << "StartFlag: " << std::hex << static_cast<int>(rsapMsgHeader.StartFlag) ;
+        int dataLen = (static_cast<int>(rsapMsgHeader.DataLen[2]) << 16) |
+                      (static_cast<int>(rsapMsgHeader.DataLen[1]) << 8) |
+                      static_cast<int>(rsapMsgHeader.DataLen[0]);
+        ss << "\n" << std::setw(25) << "DataLen: "
+           << std::hex << std::setfill('0') << std::setw(2) << static_cast<int>(rsapMsgHeader.DataLen[0])
+           << " " << std::hex << std::setfill('0') << std::setw(2) << static_cast<int>(rsapMsgHeader.DataLen[1])
+           << " " << std::hex << std::setfill('0') << std::setw(2) <<  static_cast<int>(rsapMsgHeader.DataLen[2])
+           << "(" << std::dec  << dataLen << ")";
+        ss << std::hex << std::setfill(' ');
+        ss << "\n" << std::setw(25) << "DataType: " << std::hex  << std::setfill('0') << std::setw(2)  << static_cast<int>(rsapMsgHeader.DataType);
+        ss << "\n" << std::setfill(' ') << std::setw(25) << "Version: " << std::hex  << std::setfill('0') << std::setw(2)  << static_cast<int>(rsapMsgHeader.Version);
+        ss << "\n" << std::setfill(' ') << std::setw(25) << "TimestampMS: "  << std::hex  << std::setfill('0') << std::setw(2) << static_cast<unsigned long long>(rsapMsgHeader.TimestampMS);
+        ss << "\n" <<  std::hex << std::setfill(' ') << std::setw(25) << "TimestampMIN: "  << std::hex  << std::setfill('0') << std::setw(2)  << static_cast<unsigned long long>(rsapMsgHeader.TimestampMIN);
+    }
+    catch(afl::util::Exception & e)
+    {
+        LOG_ERROR << "[error]" << e.what();
+    }
+    return ss.str();
+
+}
