diff --git a/base/common/network/date_time.cc b/base/common/network/date_time.cc
new file mode 100644
index 0000000..4403442
--- /dev/null
+++ b/base/common/network/date_time.cc
@@ -0,0 +1,245 @@
+/*********************************************************************************
+ * @file		date_time.cc
+ * @brief		date_time belongs to CICTCI
+ * @details		
+ * @author		alfred
+ * @email       zhangenwei64@gmail.com
+ * @date		2014-09-17
+ * @copyright	Copyright (c) 2024 CICTCI-Airos Division.
+ * @verbatim
+ *
+ *  Change History:
+ *  Date      Author    Version  ChangeId           Description
+ *  ------------------------------------------------------------------------------
+ *  2014-09-17 alfred       1.0       ————             Create this file
+ *
+ * @endverbatim
+ ********************************************************************************/
+#include "date_time.h"
+
+NAMESPACE_AFL_UTIL_START
+
+#define AFL_LOCALTIME(a, b)  localtime_r(a, b)
+
+bool DateTime::isLeapYear(int year)
+{
+    return ((0 == year % 4) && (year % 100 != 0)) || (0 == year % 400);
+}
+
+void DateTime::currentDateTime(struct tm* ptm)
+{
+    time_t now = time(NULL);
+    AFL_LOCALTIME(&now, ptm);
+}
+
+void DateTime::currentDateTime(char* buf, size_t size)
+{
+    struct tm result;
+    currentDateTime(&result);
+
+    AFL_SNPRINTF(buf, size, "%04d-%02d-%02d %02d:%02d:%02d"
+            , result.tm_year + 1900, result.tm_mon + 1, result.tm_mday
+            , result.tm_hour, result.tm_min, result.tm_sec);
+}
+
+std::string DateTime::currentDateTime()
+{
+    char buf[sizeof("YYYY-MM-DD HH:SS:MM")];
+    currentDateTime(buf, sizeof(buf));
+    return buf;
+}
+
+void DateTime::currentDate(char* buffer, size_t size)
+{
+    struct tm result;
+    time_t now = time(NULL);
+
+    AFL_LOCALTIME(&now, &result);
+    AFL_SNPRINTF(buffer, size, "%04d-%02d-%02d", result.tm_year + 1900, result.tm_mon + 1,
+                 result.tm_mday);
+}
+
+std::string DateTime::currentDate()
+{
+    char buffer[sizeof("YYYY-MM-DD")];
+    currentDate(buffer, sizeof(buffer));
+    return buffer;
+}
+
+void DateTime::currentTime(char* buffer, size_t size)
+{
+    time_t now = time(NULL);
+    struct tm result;
+    AFL_LOCALTIME(&now, &result);
+    AFL_SNPRINTF(buffer, size, "%02d:%02d:%02d", result.tm_hour, result.tm_min, result.tm_sec);
+}
+
+std::string DateTime::currentTime()
+{
+    char time_buffer[sizeof("HH:SS:MM")];
+    currentTime(time_buffer, sizeof(time_buffer));
+    return time_buffer;
+}
+
+bool DateTime::stringToDataTime(const char* strTime, struct tm* datetime)
+{
+    const char* pos = strTime;
+
+    size_t str_len = strlen(pos);
+    if (str_len != sizeof("YYYY-MM-DD HH:MM:SS") - 1)
+        return false;
+
+    if ((pos[4] != '-') || (pos[7] != '-') || (pos[10] != ' ') || (pos[13] != ':') || (pos[16] != ':'))
+        return false;
+
+    datetime->tm_year = atoi(pos);
+    if ((datetime->tm_year > 3000) || (datetime->tm_year < 1900))
+        return false;
+
+    pos += sizeof("YYYY");
+    datetime->tm_mon = atoi(pos);
+    if ((datetime->tm_mon > 12) || (datetime->tm_mon < 1))
+        return false;
+
+    pos += sizeof("MM");
+    datetime->tm_mday = atoi(pos);
+    if (datetime->tm_mday < 1)
+        return false;
+    // 闂板勾浜屾湀29澶�
+    if ((DateTime::isLeapYear(datetime->tm_year)) && (2 == datetime->tm_mon)
+        && (datetime->tm_mday > 29))
+        return false;
+    else if (datetime->tm_mday > 28)
+        return false;
+
+    pos += sizeof("DD");
+    datetime->tm_hour = atoi(pos);
+    if ((datetime->tm_hour > 24) || (datetime->tm_hour < 0))
+        return false;
+
+    pos += sizeof("HH");
+    datetime->tm_min = atoi(pos);
+    if ((datetime->tm_min > 60) || (datetime->tm_min < 0))
+        return false;
+
+    pos += sizeof("MM");
+    datetime->tm_sec = atoi(pos);
+    if ((datetime->tm_sec > 60) || (datetime->tm_sec < 0))
+        return false;
+
+    datetime->tm_isdst = 0;
+    datetime->tm_wday = 0;
+    datetime->tm_yday = 0;
+
+    // 璁＄畻鏀瑰ぉ鏄竴骞翠腑鐨勭鍑犲ぉ
+    for (int i = 1; i <= datetime->tm_mon; ++i)
+    {
+        if (i == datetime->tm_mon)
+        {
+            // 鍒氬ソ鏄繖涓湀
+            datetime->tm_yday += datetime->tm_mday;
+        }
+        else
+        {
+            // 1,3,5,7,8,10,12
+            if ((1 == i) || (3 == i) || (5 == i) || (7 == i) || (8 == i) || (10 == i) || (12 == i))
+            {
+                datetime->tm_yday += 31;
+            }
+            else if (2 == i)
+            {
+                if (DateTime::isLeapYear(datetime->tm_year))
+                    datetime->tm_yday += 29;
+                else
+                    datetime->tm_yday += 28;
+            }
+            else
+            {
+                datetime->tm_yday += 30;
+            }
+        }
+    }
+
+    // 鏈堝熀鏁�
+    static int leap_month_base[] = { -1, 0, 3, 4, 0, 2, 5, 0, 3, 6, 1, 4, 6 };
+    static int common_month_base[] = { -1, 0, 3, 3, 6, 1, 4, 0, 3, 5, 0, 3, 5 };
+
+    int year_base;
+    int* month_base;
+    if (DateTime::isLeapYear(datetime->tm_year))
+    {
+        year_base = 2;
+        month_base = leap_month_base;
+    }
+    else
+    {
+        year_base = 1;
+        month_base = common_month_base;
+    }
+
+    // 璁＄畻鏄熸湡鍑�
+    datetime->tm_wday = (datetime->tm_year
+                         + datetime->tm_year / 4
+                         + datetime->tm_year / 400
+                         - datetime->tm_year / 100
+                         - year_base
+                         + month_base[datetime->tm_mon]
+                         + datetime->tm_mday) / 7;
+
+    // 骞存湀澶勭悊
+    datetime->tm_mon -= 1;
+    datetime->tm_year -= 1900;
+
+    return true;
+}
+
+bool DateTime::stringToDataTime(const char* strTime, time_t* datetime)
+{
+    struct tm result;
+    if (!stringToDataTime(strTime, &result))
+        return false;
+
+    *datetime = mktime(&result);
+    return true;
+}
+
+void DateTime::dateTimeToString(struct tm* datetime, char* buf, size_t size)
+{
+    AFL_SNPRINTF(buf, size, "%04d-%02d-%02d %02d:%02d:%02d"
+            , datetime->tm_year + 1900, datetime->tm_mon + 1, datetime->tm_mday
+            , datetime->tm_hour, datetime->tm_min, datetime->tm_sec);
+}
+
+std::string DateTime::dateTimeToString(struct tm* datetime)
+{
+    char buf[sizeof("YYYY-MM-DD HH:SS:MM")];
+    dateTimeToString(datetime, buf, sizeof(buf));
+    return buf;
+}
+
+void DateTime::dateToString(struct tm* datetime, char* buf, size_t size)
+{
+    AFL_SNPRINTF(buf, size, "%04d-%02d-%02d"
+            , datetime->tm_year + 1900, datetime->tm_mon + 1, datetime->tm_mday);
+}
+
+std::string DateTime::dateToString(struct tm* datetime)
+{
+    char buf[sizeof("YYYY-MM-DD")];
+    dateToString(datetime, buf, sizeof(buf));
+    return buf;
+}
+
+void DateTime::timeToString(struct tm* datetime, char* buf, size_t size)
+{
+    AFL_SNPRINTF(buf, size, "%02d:%02d:%02d", datetime->tm_hour, datetime->tm_min, datetime->tm_sec);
+}
+
+std::string DateTime::timeToString(struct tm* datetime)
+{
+    char buf[sizeof("HH:SS:MM")];
+    timeToString(datetime, buf, sizeof(buf));
+    return buf;
+}
