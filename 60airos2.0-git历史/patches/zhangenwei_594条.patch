+int CCINDEX_COMPONENT::mqttSubscribeMsgArrvd(void *context, char *topicName, int topicLen, MQTTAsync_message *message)
+{
+    int ret = 1;
+    auto thiz = (CCINDEX_COMPONENT *) context;
+    if (message->payloadlen)
+    {
+        std::string topic(topicName, topicLen);
+        std::string topicProfix = topic.substr(0, topic.find("/"));
+        if(thiz->getConfiger().enableDebugPrint)
+        {
+            CCINDEX_INTER_DEBUG_PRINT << "[topic]" << topicName;
+        }
+
+        if(topicProfix == "trafficMetrics" )
+        {
+            if (!thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_TrafficMetrics)
+            {
+                return false;
+            }
+            afl::base::json j;
+            try
+            {
+                j = afl::base::json::parse((char *) message->payload, (char *) message->payload + message->payloadlen);
+            }
+            catch (...)
+            {
+                CCINDEX_INTER_ERROR_PRINT << "[error]mqtt-inter " << "parse json failure!";
+                MQTTAsync_freeMessage(&message);
+                MQTTAsync_free(topicName);
+                return ret;
+            }
+
+            if (topic.size() <= 0)
+            {
+                CCINDEX_INTER_ERROR_PRINT << "[error]mqtt-inter topic empty!";
+            }
+            else
+            {
+                if(topic.find("trafficMetrics/trajectories") == 0)
+                {
+                    if (!thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_Trajectories)
+                    {
+                        return false;
+                    }
+                    if (topic.find("desaysv") != std::string::npos)
+                    {
+                        CCINDEX_INTER_ERROR_PRINT << "find 'desaysv'";
+                        thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+                         {
+                             thiz->mqttDispatchSubscribeMessage(topic, j);
+                         });
+                    }
+                    else
+                    {
+
+                        thiz->m_Eventloop->runInLoop([thiz, topic, j]()
+                         {
+                            CCINDEX_INTER_ERROR_PRINT << "not find 'desaysv'" ;
+                             thiz->mqttDispatchSubscribeMessageTrajectories(topic, j);
+                         });
+                    }
+                }
+                else
+                {
+                    CCINDEX_INTER_ERROR_PRINT << "[topic]" << topic;
+                    if(topic.find("trafficMetrics/vehiclePass") == 0 && !thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_VehiclePass)
+                    {
+                        return false;
+                    }
+                    else  if(topic.find("trafficMetrics/queueUp") == 0 && !thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_QueueUp)
+                    {
+                        return false;
+
+                    }
+                    else  if(topic.find("trafficMetrics/areaState") == 0 && !thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_AreaState)
+                    {
+                        return false;
+
+                    }
+                    else  if(topic.find("trafficMetrics/overflow") == 0 && !thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_Overflow)
+                    {
+                        return false;
+
+                    }
+                    else  if(topic.find("trafficMetrics/outlane") == 0 && !thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_Outlane)
+                    {
+                        return false;
+                    }
+                    else  if(topic.find("trafficMetrics/statistics") == 0 && !thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_Statistics)
+                    {
+                        return false;
+                    }
+                    else  if(topic.find("trafficMetrics/evaluations") == 0 && !thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_Evaluations)
+                    {
+                        return false;
+                    }
+                    else  if(topic.find("trafficMetrics/nonmotor") == 0 && !thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_Nonmotor)
+                    {
+                        return false;
+                    }
+
+                    std::string hint = "trafficMetrics";
+                    static int message_count_trafficMetrics = 1; // 用于计数的静态变量
+                    static int MAX_MESSAGE_COUNT_TAFFIC_METRICS = 1000; // 设置您的最大限制
+
+                    // 根据消息计数判断是偶数还是奇数
+                    if (message_count_trafficMetrics % 2 == 0) // 偶数
+                    {
+                        thiz->m_Eventloop->runInLoop([thiz, topic, j, hint]()
+                         {
+                             thiz->mqttPushMsg2BrokerCloud(topic, j, hint);
+                         });
+                    }
+                    else // 奇数
+                    {
+                        thiz->m_Eventloop->runInLoop([thiz, topic, j, hint]()
+                         {
+                             thiz->mqttPushMsg2BrokerCloud(topic, j, hint);
+                         });
+                    }
+                    if (message_count_trafficMetrics > MAX_MESSAGE_COUNT_TAFFIC_METRICS)
+                    {
+                        message_count_trafficMetrics = 0; // 重置计数器
+                    }
+                    else
+                    {
+                        message_count_trafficMetrics++;
+                    }
+                }
+
+            }
+        }
+        else if(topicProfix == "upload")
+        {
+            if (!thiz->m_MqttClientConfig.configerEnableCCIndex.Enable_Tc)
+            {
+                return false;
+            }
+            std::string topic(topicName, topicLen);
+            if (topic.size() <= 0)
+            {
+                RADAR_TC_ERROR_PRINT << "[Inter][error]topic empty!";
+            }
+            else
+            {
+                std::string msg((char*)message->payload, message->payloadlen);
+                static int message_count_upload = 1; // 用于计数的静态变量
+                static int MAX_MESSAGE_COUNT_UPLOAD = 1000; // 设置您的最大限制
+
+                // 根据消息计数判断是偶数还是奇数
+                if (message_count_upload % 2 == 0) // 偶数
+                {
+                    thiz->m_Eventloop->runInLoop([thiz, topic, msg]()
+                     {
+                         thiz->mqttDispatchSubscribeMessageProto(topic, (void*)msg.c_str(), msg.size());
+                     });
+                }
+                else // 奇数
+                {
+                    thiz->m_Eventloop->runInLoop([thiz, topic, msg]()
+                     {
+                         thiz->mqttDispatchSubscribeMessageProto(topic, (void*)msg.c_str(), msg.size());
+                     });
+                }
+                if (message_count_upload > MAX_MESSAGE_COUNT_UPLOAD)
+                {
+                    message_count_upload = 0; // 重置计数器
+                }
+                else
+                {
+                    message_count_upload++;
+                }
+            }
+        }
+        else
+        {
+
+        }
+    }
+
+    MQTTAsync_freeMessage(&message);
+    MQTTAsync_free(topicName);
+
+    return ret;
+}
