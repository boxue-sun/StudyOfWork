+bool OM_COMPONENT::mqttPushStringMsg2Broker(string topic, string info, string hint)
+{
+    if(!info.empty())
+    {
+        if(!mqttPublishMsg(topic, info))
+        {
+            OM_CLOUD_ERROR_PRINT << "[error]mqtt-cloud push " << hint.c_str() << " failure!";
+            return false;
+        }
+    }
+    else
+    {
+        return false;
+    }
+
+    return true;
