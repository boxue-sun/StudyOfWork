+        mec_sensor_data_monitor->set_timestamp( afl::util::TimeStamp::now(true).millSeconds());
+        auto* sensor_data_in = mec_sensor_data_monitor->mutable_sensor_data_in();
+        sensor_data_in->set_sensor_data_in_port(std::to_string(sensor_data_in_port));
+        sensor_data_in->set_sensor_data_in_flag(false);
+        sensor_data_in->set_sensor_data_in_obj_package(0);
+        sender_(output_data_obj_);
+        MEC_SERVICE_LOG_ERROR << "[notice] no sensor-data!" << output_data_obj_->DebugString();
+        receive_obj_package_old++;
+    }
+}
 
