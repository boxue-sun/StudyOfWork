+def tsCRC16(data):
+    ucCRCHi = 0xFF
+    ucCRCLo = 0xFF
+    data = np.array(data, dtype=np.uint8)  # 确保data是NumPy数组
+
+    for d in data:
+        iIndex = ucCRCLo ^ d
+        ucCRCLo = np.uint8(ucCRCHi ^ aucCRCHi[iIndex])
+        ucCRCHi = aucCRCLo[iIndex]
+
+    return np.uint16((ucCRCHi << 8) | ucCRCLo)
