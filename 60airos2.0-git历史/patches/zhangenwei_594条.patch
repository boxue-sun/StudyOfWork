+ *
+ * @endverbatim
+ ********************************************************************************/
+
+#ifndef AIROS2_0_CONFIGER_COMMON_H
+#define AIROS2_0_CONFIGER_COMMON_H
+#include "namespace.h"
+#include "base/common/network/serializable_data.h"
+#include "base/common/network/print.h"
+#include "base/common/network/channel.h"
