+/**
+ * @func: 配置查询响应
+ * @param configQueryData
+ */
+void OM_Mec_COMPONENT::subscribeConfigUpdateData(const json & subscribeJson)
+{
+    if (!m_MqttConnected)
+    {
+        return;
+    }
+    ConfigUpdateData configUpdateData;
+    try
+    {
+        configUpdateData = subscribeJson;
+    } catch (afl::base::json::exception &e)
+    {
+        ERRORPRINT("[what]%s [json-exception-id]%d", e.what(), e.id);
+    }
+
+    if(m_MqttClientConfig.rscuEsn == configUpdateData.rscuEsn)
+    {
+        if(configUpdateData.actionName == "baseInfoEnquire")
+        {
+            getConfiger().configerOmCommon.protocolVersion  = configUpdateData.protocolVersion;
+            if(getConfiger().configerPublishPeriod.periodRunningInfoUp == 0)
+            {
+                if(configUpdateData.runningInfoRate == 0)
+                {
+                    ERRORPRINT("[notice]no need do!");
+                }
+                else if(configUpdateData.runningInfoRate > 0)
+                {
+                    DeviceBaseInfoQueryData deviceBaseInfoQueryData;
+                    deviceBaseInfoQueryData.infoId = DEVICE_RUNNING_STATUS;
+                    getConfiger().configerPublishPeriod.periodRunningInfoUp = configUpdateData.runningInfoRate;
+                    saveConfiger();
+                    m_TimerPublishDeviceRunningStatusData = m_Eventloop->addTimer(
+                            std::bind(&OM_Mec_COMPONENT::publishRunningStatusData, this, deviceBaseInfoQueryData, DEVICE_BASIC_INFO_MEC),
+                            getConfiger().configerPublishPeriod.periodRunningInfoUp, true);
+                }
+                else
+                {
+                    ERRORPRINT("[notice]no need do!");
+                }
+
+            }
+            else if( getConfiger().configerPublishPeriod.periodRunningInfoUp > 0)
+            {
+                if(configUpdateData.runningInfoRate == 0)
+                {
+
+                    ERRORPRINT("[notice]cancle running-status timer!");
+                    m_Eventloop->cancelTimer(m_TimerPublishDeviceRunningStatusData);
+                    m_TimerPublishDeviceRunningStatusData = -1;
+                }
+                else if(configUpdateData.runningInfoRate > 0)
+                {
+                    m_Eventloop->cancelTimer(m_TimerPublishDeviceRunningStatusData);
+                    m_TimerPublishDeviceRunningStatusData = -1;
+                    getConfiger().configerPublishPeriod.periodRunningInfoUp  = configUpdateData.runningInfoRate;
+                    saveConfiger();
+                    DeviceBaseInfoQueryData deviceBaseInfoQueryData;
+                    deviceBaseInfoQueryData.infoId = DEVICE_RUNNING_STATUS;
+                    m_TimerPublishDeviceRunningStatusData = m_Eventloop->addTimer(
+                            std::bind(&OM_Mec_COMPONENT::publishRunningStatusData, this, deviceBaseInfoQueryData, DEVICE_BASIC_INFO_MEC),
+                            getConfiger().configerPublishPeriod.periodRunningInfoUp, true);
+                }
+                else
+                {
+                    ERRORPRINT("[notice]no need do!");
+                }
+            }
+            else
+            {
+                ERRORPRINT("[notice]no need do!");
+            }
+
+            if(getConfiger().configerPublishPeriod.periodHeartBeatUp == 0)
+            {
+                if(configUpdateData.heartRate == 0)
+                {
+                    ERRORPRINT("[notice]no need do!");
+                }
+                else if(configUpdateData.heartRate > 0)
+                {
+                    getConfiger().configerPublishPeriod.periodHeartBeatUp  = configUpdateData.heartRate;
+                    saveConfiger();
+                    m_TimerPublishDeviceHeartBeatData = m_Eventloop->addTimer(
+                            std::bind(&OM_Mec_COMPONENT::publishDeviceHeartbeatData, this),
+                            getConfiger().configerPublishPeriod.periodHeartBeatUp, true);
+                }
+                else
+                {
+                    ERRORPRINT("[notice]no need do!");
+                }
+
+            }
+            else if( getConfiger().configerPublishPeriod.periodHeartBeatUp > 0)
+            {
+                if(configUpdateData.heartRate == 0)
+                {
+
+                    ERRORPRINT("[notice]cancle running-status timer!");
+                    m_Eventloop->cancelTimer(m_TimerPublishDeviceHeartBeatData);
+                    m_TimerPublishDeviceHeartBeatData = -1;
+                }
+                else if(configUpdateData.heartRate > 0)
+                {
+                    m_Eventloop->cancelTimer(m_TimerPublishDeviceHeartBeatData);
+                    m_TimerPublishDeviceHeartBeatData = -1;
+                    getConfiger().configerPublishPeriod.periodHeartBeatUp  = configUpdateData.heartRate;
+                    saveConfiger();
+
+                    m_TimerPublishDeviceHeartBeatData = m_Eventloop->addTimer(
+                            std::bind(&OM_Mec_COMPONENT::publishDeviceHeartbeatData, this),
+                            getConfiger().configerPublishPeriod.periodHeartBeatUp, true);
+                    getConfiger().configerPublishPeriod.periodHeartBeatUp  = configUpdateData.heartRate;
+                }
+                else
+                {
+                    ERRORPRINT("[notice]no need do!");
+                }
+            }
+            else
+            {
+                ERRORPRINT("[notice]no need do!");
+            }
+            getConfiger().configerMqtt.mqttBrokerUrl  = configUpdateData.addressChg;
+            getConfiger().configerOmCommon.addressIP        = configUpdateData.addressIP;
+            getConfiger().configerOmCommon.netMask         = configUpdateData.netMask;
+            getConfiger().configerOmCommon.gateway         = configUpdateData.gateway;
+            getConfiger().configerOmCommon.logLevel        = configUpdateData.logLevel;
+
+            pulishConfigUpdateAckData(configUpdateData);
+        }
+    }
+    else
+    {
+        ERRORPRINT("[error]rscuEsn no sucess!");
+    }
+}
+void OM_Mec_COMPONENT::pulishConfigUpdateData(ConfigUpdateData& configUpdateData)
+{
+    if (!m_MqttConnected)
+    {
+        return;
+    }
+
+
+    string hint = "配置修改数据上报";
+    configUpdateData.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    configUpdateData.rscuEsn = m_MqttClientConfig.rscuEsn;
+    configUpdateData.actionName = "baseInfoEnquire";
+    configUpdateData.protocolVersion = m_MqttClientConfig.configerOmCommon.protocolVersion;
+    configUpdateData.runningInfoRate = m_MqttClientConfig.configerPublishPeriod.periodRunningInfoUp;
+    configUpdateData.heartRate = m_MqttClientConfig.configerPublishPeriod.periodHeartBeatUp;
+    configUpdateData.addressChg = m_MqttClientConfig.configerMqtt.mqttBrokerUrl;
+    configUpdateData.addressIP =  m_MqttClientConfig.configerOmCommon.addressIP;
+    configUpdateData.netMask = m_MqttClientConfig.configerOmCommon.netMask;
+    configUpdateData.gateway = m_MqttClientConfig.configerOmCommon.gateway;
