+
+bool OM_COMPONENT::mqttConnect()
+{
+    int rc;
+    if (MQTTASYNC_SUCCESS != (rc = MQTTAsync_connect(m_MqttClient, &m_MqttConnOpts)))
+    {
+        OM_INTER_ERROR_PRINT << "[error]mqtt-inter connect error!";
+        m_MqttConnected = false;
+        return false;
+    }
+    return true;
+}
