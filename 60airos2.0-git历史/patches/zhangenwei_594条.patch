-void zk_DTUParser::ResetAllCurrPlanStep(std::map<uint8_t, std::vector<zk_DTULightStep>> &new_curr_plan_step)
-{
-    // 相邻同色灯时长结合
-    std::map<uint8_t, std::vector<zk_DTULightStep>> cur_new_cur_plan_step;
-    for(auto &kv : new_curr_plan_step) 
-    {
-        for(auto &item : kv.second) 
-        {
-            std::vector<zk_DTULightStep> &the_period = cur_new_cur_plan_step[kv.first];
-            if(!the_period.empty()) 
-            {
-                if (the_period[the_period.size() - 1].color != item.color) 
-                {
-                    the_period.push_back(item);
-                } 
-                else 
-                {
-                    the_period[the_period.size() - 1].duration += item.duration;
-                }
-            } 
-            else 
-            {
-                the_period.push_back(item);
-            }
-        }
-    }
-
-    monitor_->FlushCurrPlanStep(cur_new_cur_plan_step);
-
-    bool is_changed = false;
-    std::map<uint8_t, std::vector<zk_DTULightStep>> tmp_all_light_period;
