+/////////////////////////////////////////////////////
+void RADAR_TRAFFIC_METRICS_COMPONENT::mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json & subScribeJson)
+{
+    if (!m_MqttConnected)
+    {
+        RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error]mqtt clinet has not connected!";
+        return;
+    }
+
+    if (topic.empty())
+    {
+        RADAR_TRAFFIC_METRICS_ERROR_PRINT << "topic empty!";
+        return;
+    }
+    std::string topicProfix = topic.substr(0, topic.find("/"));
+
+    std::string hint;
+    std::string topicPT;
+
+    if(topicProfix == "trafficMetrics")
+    {
+        m_MsgCountSubscribeTrafficMetricsJson ++;
+        for (auto it = m_MqttClientConfig.topicUnMapCCIndex.begin(); it != m_MqttClientConfig.topicUnMapCCIndex.end(); ++it)
+        {
+            const MqttTopicConfigerCCIndex& mqttTopicConfigerCCIndex = it->second;
+
+            if(topic == mqttTopicConfigerCCIndex.Topic_Tc && m_MqttClientConfig.configerEnableCCIndex.Enable_Tc)
+            {
+                hint = "V2X信控指标";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Tc;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Trajectories && m_MqttClientConfig.configerEnableCCIndex.Enable_Trajectories)
+            {
+                hint = "实时轨迹数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Trajectories;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_VehiclePass && m_MqttClientConfig.configerEnableCCIndex.Enable_VehiclePass)
+            {
+                hint = "实时过车数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_VehiclePass;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_QueueUp
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_QueueUp)
+            {
+                hint = "实时排队数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_QueueUp;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_AreaState
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_AreaState)
+            {
+                hint = "实时区域状态数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_AreaState;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Overflow
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Overflow)
+            {
+                hint = "实时溢出数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Overflow;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Outlane
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Outlane)
+            {
+                hint = "实时出口通道数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Outlane;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Statistics
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Statistics)
+            {
+                hint = "定时统计数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Statistics;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Evaluations
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Evaluations)
+            {
+                hint = "定时评价数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Evaluations;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_Nonmotor
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Nonmotor)
+            {
+                hint = "定时行人及非机动车数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_Nonmotor;
+                break;
+            }
+            else if(topic == mqttTopicConfigerCCIndex.Topic_DeviceStatus
+                    && m_MqttClientConfig.configerEnableCCIndex.Enable_Nonmotor)
+            {
+                hint = "定时行人及非机动车数据";
+                topicPT = mqttTopicConfigerCCIndex.Topic_DeviceStatus;
+                break;
+            }
+            else
+            {
+                hint = "主题为空";
+                topicPT = "";
+            }
+        }
+    }
+    else  if(topicProfix == "test")
+    {
+        m_MsgCountSubscribeTrafficMetricsJson = 0;
+        m_MsgCountSend2ChannelTrafficMetricsPb = 0;
+    }
+    else
+    {
+        if(getConfiger().enableDebugPrint)
+        {
+            RADAR_TRAFFIC_METRICS_DEBUG_PRINT << "[noitce]no need this msg!";
+        }
+        return ;
+    }
+
+
+    if(!topicPT.empty())
+    {
+        if(getConfiger().configerTestParam.trafficMetricsTest)
+        {
+            RADAR_TRAFFIC_METRICS_DEBUG_PRINT << "[sub-json]" << m_MsgCountSubscribeTrafficMetricsJson;
+        }
+
+        static int message_count_trafficMetrics_channel = 1; // 用于计数的静态变量
+        static int MAX_MESSAGE_COUNT_TAFFIC_METRICS_CHANNEL = 1000; // 设置您的最大限制
+
+        // 根据消息计数判断是偶数还是奇数
+        if (message_count_trafficMetrics_channel % 2 == 0) // 偶数
+        {
+            m_Eventloop->runInLoop([this, topicPT, subScribeJson, hint]()
+             {
+                 m_Eventloop->runInLoop([this, topicPT, subScribeJson, hint]()
+                {
+                    if (!this->publishData(topicPT, subScribeJson, hint))
+                    {
+                        RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error] Publish data failure![msg]" << hint.c_str();
+                    }
+                    else
+                    {
+                        if(this->getConfiger().enableDebugPrint)
+                        {
+                            RADAR_TRAFFIC_METRICS_DEBUG_PRINT << "[sucess]Publish success!";
+                        }
+                    }
+                });
+             });
+        }
+        else // 奇数
+        {
+            m_Eventloop->runInLoop([this, topicPT, subScribeJson, hint]()
+             {
+                 if (!this->publishData(topicPT, subScribeJson, hint))
+                 {
+                     RADAR_TRAFFIC_METRICS_ERROR_PRINT << "[error] Publish data failure![msg]" << hint.c_str();
+                 }
+                 else
+                 {
+                     if(this->getConfiger().enableDebugPrint)
+                     {
+                         RADAR_TRAFFIC_METRICS_DEBUG_PRINT << "[sucess]Publish success!";
+                     }
+                 }
+             });
+        }
+        if (message_count_trafficMetrics_channel > MAX_MESSAGE_COUNT_TAFFIC_METRICS_CHANNEL)
+        {
+            message_count_trafficMetrics_channel = 0; // 重置计数器
+        }
+        else
+        {
+            message_count_trafficMetrics_channel++;
+        }
+    }
+    else
+    {
+        if(getConfiger().enableDebugPrint)
+        {
+            RADAR_TRAFFIC_METRICS_DEBUG_PRINT << "[topicPT][" << topicPT << "]";
+        }
+    }
+
+    return;
+}
