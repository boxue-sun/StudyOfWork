+//
+// Created by root on 24-6-9.
+//
+
+#ifndef AIROS2_0_SQLITE_DEVICE_STATUS_H
+#define AIROS2_0_SQLITE_DEVICE_STATUS_H
+#include "namespace.h"
+#include <sqlite3.h>
+#include "base/common/network/print.h"
+NAMESPACE_START_OM_COMPONENT_DEVICE_STATUS
+using namespace os::v2x::protocol::om::db;
+using namespace std;
+enum TABLE_OPERA_TYPE
+{
+    TABLE_OPERA_TYPE_INSERT,  //插入操作
+    TABLE_OPERA_TYPE_UPDATE  //更新
+};
+
+enum TABLE_TYPE
+{
+    TABLE_TYEP_DEV_STATUS,  //设备状态表
+    TABLE_TYEP_SYNCHRONIZE  //设备授时表
+};
+enum DEVICE_TYPE_DB
+{
+    DEVICE_TYPE_DB_CAMRA,
+    DEVICE_TYPE_DB_MW_RADAR,
+    DEVICE_TYPE_DB_RADAR,
+};
+enum DEVICE_STATUS_DB
+{
+    DEVICE_STATUS_DB_ON,
+    DEVICE_STATUS_DB_OFF
+};
+struct MsgDeviceStatus
+{
+    uint64_t timeStamp = 0;
+    DEVICE_TYPE_DB deviceType;
+    string   deviceID = "";
+    DEVICE_STATUS_DB deviceStatus;
+    //////////////////////////////
+    uint64_t devTime = 0;
