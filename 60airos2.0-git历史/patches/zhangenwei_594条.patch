+std::string OM_Mec_COMPONENT::getSoftwareVersion()
+{
+    std::string softwareVersionFromFile;
+    if( afl::FileUtil::isFileExist(getConfiger().configerVersionFilePath.c_str()))
+    {
+        std::ifstream softwareVersionFile(getConfiger().configerVersionFilePath.c_str());
+        if(softwareVersionFile) {
+            OM_MEC_ERROR_PRINT << "[notice] 版本文件" << getConfiger().configerVersionFilePath << "存在";
+            // 读取第一行内容
+            std::string line;
+            if (std::getline(softwareVersionFile, line))
+            {
+                if( getConfiger().configerOmCommon.softwareVersion  != line)
+                {
+                    softwareVersionFromFile =  getConfiger().configerOmCommon.softwareVersion = line;
+                }
+                OM_MEC_ERROR_PRINT << "[softwareVersion]" << getConfiger().configerOmCommon.softwareVersion;
+            } else {
+                OM_MEC_ERROR_PRINT << "[error]文件为空！";
+                softwareVersionFromFile =  getConfiger().configerOmCommon.softwareVersion;
+            }
+            softwareVersionFile.close();// 关闭文件
+        }
+    }
+    else
+    {
+        softwareVersionFromFile = getConfiger().configerOmCommon.softwareVersion;
+        OM_MEC_ERROR_PRINT << "[error]" << getConfiger().configerVersionFilePath << " 文件不存在！";
+    }
+    return softwareVersionFromFile;
+}
