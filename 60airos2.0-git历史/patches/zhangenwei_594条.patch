+bool BS_SPAT_SRC_DATA_COMPONENT::Init()
+{
+    if(m_MqttClientConfig.basicConfiger.enable_print_info_log )
+    {
+        LOG_ERROR << "[version](1.0) 信号机原始数据组件启动";
+    }
+
+    doBaiscWork();
+    if (!mqttInit())
+    {
+        if(m_MqttClientConfig.basicConfiger.enable_print_info_log)
+        {
+            LOG_ERROR <<  "[error]mqttInit failure!";
+        }
+
+        return false;
+    }
+//    m_Task.reset(new std::thread([&](){ UdpInit(); }));
+//
+    return true;
+}
