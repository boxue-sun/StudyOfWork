+bool OM_RADAR_COMPONENT::Init()
+{
+    LOG_ERROR << "Received traffic light from device";
+    LOGINFO("Received traffic light from device");
+    m_Task.reset(new std::thread([&](){ initEventLoop(); }));
+
+    doBaiscWork();
+    return true;
+}
+bool OM_RADAR_COMPONENT::initEventLoop()
+{
+    m_Eventloop = std::make_shared<afl::net::EventLoop>();
+    m_Eventloop->loop();
+    return true;
+}
+
+bool OM_RADAR_COMPONENT::Proc(const std::shared_ptr<const  os::v2x::device::CloudData>& recv_data)
+{
+    LOG_INFO << "Received traffic light from device";
+    LOGINFO("Received traffic light from device");
+    if (!recv_data)
+    {
+        LOG_WARN << "Received traffic light data failed!";
+        return false;
+    }
+    if (recv_data->payload_case() != os::v2x::device::CloudData::PayloadCase::kMqttData)
+    {
+        LOG_WARN << "NOT MQTT MSG.";
+        return false;
+    }
+    std::string hint;
+    std::string topicPT;
+    auto mq_data = recv_data->mqtt_data();
+    std::string topic = mq_data.topic();
+    std::string payload(mq_data.data(), mq_data.data().size());
+
+    for (auto it = m_MqttClientConfig.topicUnMapOmRadar.begin(); it != m_MqttClientConfig.topicUnMapOmRadar.end(); ++it)
+    {
+        const MqttTopicConfigerOmRadar& mqttTopicConfigerOmRadarTemp = it->second;
+        if(topic == mqttTopicConfigerOmRadarTemp.Topic_Query_Log && m_MqttClientConfig.configerEnableOmRadar.Enable_Query_Log)
+        {
+            hint = "日志查询";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Query_Log;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Query_Config && m_MqttClientConfig.configerEnableOmRadar.Enable_Query_Config)
+        {
+            hint = "配置查询";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Query_Config;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Update_Config && m_MqttClientConfig.configerEnableOmRadar.Enable_Update_Config)
+        {
+            hint = "配置修改";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Update_Config;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Ota && m_MqttClientConfig.configerEnableOmRadar.Enable_Ota)
+        {
+            hint = "远程升级";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Ota;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Reboot && m_MqttClientConfig.configerEnableOmRadar.Enable_Reboot)
+        {
+            hint = "远程重启";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Reboot;
+        }
+        else if(topic == mqttTopicConfigerOmRadarTemp.Topic_Restore && m_MqttClientConfig.configerEnableOmRadar.Enable_Restore)
+        {
+            hint = "远程恢复";
+            topicPT = mqttTopicConfigerOmRadarTemp.Topic_Restore;
+        }
+        else
+        {
+            hint = "";
+            topicPT = "";
+        }
+    }
+    if(!topicPT.empty())
+    {
+        if (!mqttPushStringMsg2Broker(topicPT, payload, hint))
+        {
+            ERRORPRINT("[error] Publish %s data failure!", hint.c_str());
+        }
+    }
+//    Send("/v2x/service/mec/data", mecDeviceData);
+    return true;
+}
+void OM_RADAR_COMPONENT::doBaiscWork()
+{
+    //初始化mqtt配置
+    getMqttConfigerMsg();
+
+    if (!mqttInit())
+    {
+        ERRORPRINT("[error]mqttInit failure!");
+        return ;
+    }
+}
