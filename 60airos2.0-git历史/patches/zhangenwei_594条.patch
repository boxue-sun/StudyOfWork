+bool OM_DEVICE_STATUS_COMPONENT::initDeviceStatusTable(std::pair<std::string, TABLE_TYPE> tableInfo, std::string topic, int deviceType, int deviceStatus)
+{
+    MsgDeviceStatus msgDeviceStatus;
+    msgDeviceStatus.timeStamp = afl::util::TimeStamp::now(true).millSeconds();
+    msgDeviceStatus.deviceType = (DEVICE_TYPE_DB)deviceType;
+    msgDeviceStatus.deviceStatus = (DEVICE_STATUS_DB)deviceStatus;
+    msgDeviceStatus.deviceID = getDeviceID(topic);
+
+    switch(tableInfo.second)
+    {
+        case TABLE_TYEP_DEV_STATUS:  //设备状态表
+            if(!m_DeviceStatusMsgDBPtr->insertOrUpdateDeviceStatus(tableInfo, msgDeviceStatus))
+            {
+                ERRORPRINT("[error]insert camera(%s)-device-status data failure!", msgDeviceStatus.deviceID.c_str());
+            }
+            break;
+        case TABLE_TYEP_SYNCHRONIZE:  //设备授时表
+            msgDeviceStatus.devTime = 0;
+            msgDeviceStatus.lastTime = 0;
+            msgDeviceStatus.timeDiff = 0;
+            msgDeviceStatus.longitude = 0;
+            msgDeviceStatus.latitude = 0;
+            msgDeviceStatus.altitude = 0;
+            if(!m_DeviceStatusMsgDBPtr->insertOrUpdateDeviceStatus(tableInfo, msgDeviceStatus))
+            {
+                ERRORPRINT("[error]insert camera(%s)-device-status data failure!", msgDeviceStatus.deviceID.c_str());
+            }
+            break;
+        default:
+            break;
+    }
+
+
+    return true;
+}
+
+std::string OM_DEVICE_STATUS_COMPONENT::getDeviceID(const std::string& topic)
+{
+    // 从主题中提取 radarID
+    size_t start = topic.find('/') + 1;
+    size_t end = topic.find('/', start);
+    if (start != std::string::npos && end != std::string::npos)
+    {
+        return topic.substr(start, end - start);
+    }
+    else
+    {
+        std::cerr << "Invalid topic format: " << topic << std::endl;
+        return "";
+    }
+}
+void OM_DEVICE_STATUS_COMPONENT::mqttDispatchSubscripeMessage(const std::string &topic, const afl::base::json &subScribeJson) \
+{
+    if (!m_MqttConnected)
+    {
+        ERRORPRINT("[error]mqtt clinet has not connected!");
+        return;
+    }
+
+    if (topic.empty()) {
+        ERRORPRINT("topic empty!")
+        return;
+    }
+    std::string hint;
+    std::string topicPT;
+    for (uint32_t i = 0; i < m_MqttClientConfig.topicUnMapSubscribe.size(); i++)
+    {
+        auto topicUnMapTemp = m_MqttClientConfig.topicUnMapSubscribe[i];
+        //雷达心跳
+        if (topic == topicUnMapTemp.Topic_Radar_Heartbeat)
+        {
+            processRadarHearBeat(topic);
+        }
+        else if(topic == topicUnMapTemp.Topic_Radar_Synchronize)
+        {
+            processRadarSynchronize(topic,  subScribeJson);
+        }
+        else if (topic == topicUnMapTemp.Topic_Camera_Keepalive)
+        {
+            processCameraHearBeat(topic);
+        }
+        else if(topic == topicUnMapTemp.Topic_Camera_Synchronize)
+        {
+            processCameraSynchronize(topic,  subScribeJson);
+        }
+        else
+        {
+            ERRORPRINT("[notice-radar]no need insert db!")
+        }
+    }
+}
