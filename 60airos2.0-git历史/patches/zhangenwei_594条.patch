+struct OmWorkParamConfiger: public ConfigerData<OmWorkParamConfiger>
+{
+public:
+
+    bool                            hasedInit = false;
+    MecDeviceWorkParam              mecDeviceWorkParam;
+    int                             sensorDeviceNum = 0;
+    std::vector<SensorDeviceWorkParam>           sensorDeviceWorkParamList;
+public:
+    OmWorkParamConfiger()
+    {
+        for(uint8_t i = 0; i < 24; i++)
+        {
+            SensorDeviceWorkParam sensorDeviceWorkParamTemp;
+            sensorDeviceWorkParamTemp.serialNumber = i + 1;
+            sensorDeviceWorkParamTemp.routeId = "SY-285";
+            sensorDeviceWorkParamTemp.deviceType = (WorkParamDeviceType)(i%2==0 ? 2 : 3);
+            sensorDeviceWorkParamTemp.mecSn = "R321123";
+            sensorDeviceWorkParamTemp.deviceSn ="R3211234" + std::to_string(i);
+            sensorDeviceWorkParamTemp.deviceEsn = "110220330440550660770" + std::to_string(i);
+            sensorDeviceWorkParamTemp.deviceLongitude = 116.1233210 + i;
+            sensorDeviceWorkParamTemp.deviceLatitude = 39.3211230 + i;
+            sensorDeviceWorkParamTemp.deviceAltitude = 118.12 + i;
+            sensorDeviceWorkParamTemp.radarCrossId = "1001" + std::to_string(i);
+
+            sensorDeviceWorkParamList.push_back(sensorDeviceWorkParamTemp);
+        }
+    }
+
+private:
+    virtual void writeToFile(ConfigBlock &j) override
+    {
+        JsonSerialize(hasedInit,               "A_hasedInit",               j, false);
+        JsonSerialize(mecDeviceWorkParam,      "B_mecDeviceWorkParam",      j, false);
+        JsonSerialize(sensorDeviceNum,      "C_sensorDeviceNum",      j, false);
+        JsonSerialize(sensorDeviceWorkParamList,   "D_sensorDeviceWorkParamList",   j, false);
+    }
+
+    virtual void readFromFile(const ConfigBlock &j) override
+    {
+        JsonDeserialize(hasedInit,               "A_hasedInit",               j, noUse_isEmptyFlag);
+        JsonDeserialize(mecDeviceWorkParam,      "B_mecDeviceWorkParam",      j, noUse_isEmptyFlag);
+        JsonDeserialize(sensorDeviceNum,            "C_sensorDeviceNum",      j, noUse_isEmptyFlag);
+        JsonDeserialize(sensorDeviceWorkParamList,   "D_sensorDeviceWorkParamList",   j, noUse_isEmptyFlag);
+    }
+public:
+    std::string to_string() const
+    {
+        std::stringstream ss;
+        ss << std::left << std::setw(40) << "HasedInit: " << (hasedInit ? "True" : "False") << "\n";
+        ss << std::left << std::setw(40) << "MecDeviceWorkParam:\n " << mecDeviceWorkParam.to_string() << "\n";
+        ss << std::left << std::setw(40) << "sensorDeviceNum:\n " << sensorDeviceNum << "\n";
+        ss << std::left << std::setw(40) << "SensorDeviceWorkParamList:\n";
+        for (const auto& param : sensorDeviceWorkParamList) {
+            ss << param.to_string() << "\n";
+        }
+        return ss.str();
+    }
+};
+
+class WorkParam
+{
+public:
+    WorkParam() = default;
+    virtual ~WorkParam();
+
+    static bool getWorkParamFromFile(std::string workParamFilePath, OmWorkParamConfiger&  omWorkParamConfiger)
+    {
+        ERRORPRINT("[work-param-file-path]%s", workParamFilePath.c_str());
+        std::ifstream file(workParamFilePath);
+        if (!file)
+        {
+            ERRORPRINT("[error]Failed to open file!");
+            return false;
+        }
+        afl::base::json workParamJson;
+        try {
+            file >> workParamJson;
+            omWorkParamConfiger = workParamJson;
+        }
+        catch (afl::base::json::exception &e)
+        {
+            ERRORPRINT("[error]%s", e.what());
+            return false;
+        }
+        return true;
+    }
+};
