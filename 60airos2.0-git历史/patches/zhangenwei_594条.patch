-    avformat_network_init();
-    av_init_packet(&pkt);
-    pkt.data = nullptr;
-    pkt.size = 0;
-
-    pFrame      = av_frame_alloc();
-    pFrameRGB   = av_frame_alloc();
-
-    int             ret;
-
-    if ((ret = avformat_open_input(&ifmt_ctx, rtsp_url.c_str(), 0, &optionsDict)) < 0)
-    {
-        CAMERA_CICTCI_SERVICE_LOG_ERROR  << "[error]Could not open input file " <<   rtsp_url.c_str() << "error: " << av_make_error_string(errbuf, sizeof(errbuf), ret);
