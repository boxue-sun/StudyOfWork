diff --git a/middleware/protocol/proto/traffic_info.proto b/middleware/protocol/proto/traffic_info.proto
new file mode 100644
index 0000000..b84ea58
--- /dev/null
+++ b/middleware/protocol/proto/traffic_info.proto
@@ -0,0 +1,406 @@
+syntax = "proto2";
+package adu.st;
+
+import "middleware/protocol/proto/st_header.proto";
+import "middleware/protocol/proto/cross.proto";
+import "middleware/protocol/proto/line.proto";
+
+message PassVehicleInfo{
+  optional string plate_id = 1;  //车牌id
+  optional string pass_time = 2;  //过车时间
+  optional string vehicle_color = 3; //车牌颜色
+  optional string vehicle_type = 4; //车牌类型
+}
+
+// 指标数据，可以是一个车道的指标，也可以是一个流向的指标
+message TrafficInfo {
+  // 一般只用到1和2，分别代表车道级指标和流向级指标
+  enum SpaceType {
+    SPACE_NONE = 0;
+    SPACE_LANE = 1; // 车道级,lane_id必须有值
+    SPACE_FLOW = 2;   // 流向级,lane_id、flow_to_type(仅给一个即可)必须有值
+    SPACE_BRANCH = 3; // branch级branch_id必须有值
+    SPACE_LINK = 4;
+    SPACE_SEGMENT = 5; // 路段级指标
+    SPACE_ARTERIAL = 6; // 干线级指标
+    SPACE_ZONE = 7; // 信控区域
+    SPACE_CROSS = 8; // 路口级
+  }
+
+    // 指标的时间粒度
+    enum TimeType {
+      // 周期级指标，特指信号灯周期
+        TIME_CYCLE = 0;
+      // 时钟级指标，具体时间周期长度看time_span，因不便表达具体周期长度，后续会逐渐废弃
+      TIME_CLOCK = 1;
+      TIME_SECOND = 2;
+      TIME_MINUTE = 3;
+      TIME_HOUR = 4;
+      TIME_DAY = 5;
+      TIME_WEEK = 6;
+      TIME_MONTH = 7;
+      TIME_QUARTER = 8;
+      TIME_YEAR = 9;
+      TIME_30_SECOND = 10; // 30秒周期
+      TIME_5_MINUTE = 11; // 5分钟周期
+      TIME_15_MINUTE = 12; // 15分钟周期
+      TIME_0_SECOND = 13; // 起始和结束为0，目前用在脉冲式，后面会加一个time_rate类型也是TimeType表达发送频次(实时感应、5s周期频次等)
+      TIME_5_SECOND = 14; //5秒周期
+      TIME_1_SECOND = 15; //1秒周期
+      TIME_3_SECOND = 16; //3秒周期
+    }
+
+    // 流向
+    enum FlowToType {
+        FLOW_NONE = 0;
+        FLOW_FORWARD = 1;
+        FLOW_LEFT = 2;
+        FLOW_RIGHT = 3;
+        FLOW_TURN_AROUND = 4;
+    }
+
+    enum SourceType {
+      VIDEO = 0; // 默认值，视频感知类指标
+      DICI = 1; // 地磁类型指标
+      V2X = 2; // v2x类型指标
+      RADAR = 3; //雷视设备指标
+      MAP_CONDITION = 4; // 来自地图路况类指标
+      MAP_TRAJECTORY = 5; // 来自地图轨迹类指标
+    }
+
+    // base info
+    // 头信息，里边主要是时间戳和crossId两个信息，这两个信息是必要的
+    optional StHeader header = 1;
+    optional string description = 2;
+    // 指标是否正常
+    optional bool normal = 3;
+    optional SourceType source_type = 4 [default = VIDEO];
+    // 周期ID，信控用
+    optional int32 cycle_id = 5;
+
+    // space info
+    optional SpaceType space_type = 100;
+    repeated FlowToType flow_to_type = 101;
+    // 车道id
+    optional string lane_id = 102;
+    // 干线id
+  optional string branch_id = 103;
+  // 路口id
+  optional string cross_id = 104;
+  // 后边四个似乎没用到
+  optional string link_id = 105;
+  optional string segment_id = 106;
+  optional string arterial_id = 107;
+  optional adu.stb_map.CustomDirection direction = 108;
+  // 车道流向
+  optional adu.stb_map.LaneTurnType lane_turn_type = 109;
+
+  // 轨迹区域id，用于信控区域拥堵指标
+  optional string zone_id = 111;
+
+  // time info
+  // 时间维度
+  optional TimeType time_type = 200;
+  // 开始时间
+  optional double start_time = 201;
+  // 结束时间
+  optional double end_time = 202;
+    // 时间长度
+    optional double time_span = 203;
+    // 绿灯启亮时间
+    optional double green_start_time = 204;
+    //  0表示单向的子干线，1表示父干线是双向的
+    optional int32 arterial_type = 205;
+
+    // traffic status info
+    // 这是一个tag，用来表示此traffic_info中有哪些指标
+    enum TrafficStatausType {
+        ALL = 0;
+        DETECTOR = 1;
+        PASS_TIME = 2;
+        PASS_VELOCITY = 3;
+        DELAY = 4;
+        FREE_VELOCITY = 5;
+        STOP_DELAY = 6;
+        STOP_TIMES = 7;
+        QUEUE_LENGTH = 8;
+        HEAD_TIME_DIFF = 9;
+        FULL_HEAD_TIME_DIFF = 10;
+        FULL_FLOW_RATE = 11;
+        FULL_FLOW_LEVEL = 12;
+        EMPTY_TIME = 13;
+        TRAFFIC_FLOW = 14; // 溢流预警
+        TRAFFIC_NUMBER = 15;
+        WASTE_TIME = 16;
+        GREEN_TIME = 17;
+        QUEUE_DISAPPEAR_TIME = 18;
+        OCCUPANCY_RATE = 19;
+        TRAFFIC_BIG_NUMBER = 20;
+        QUEUE_COUNT = 21;
+        CAR_COUNT_WHEN_RED = 22;
+        QUEUE_TRANS_COUNT = 23;
+        CAR_TRANS_COUNT_WHEN_RED = 24;
+        WAITING_ZONE_TRAFFIC_FLOW = 25;
+        WAITING_ZONE_TRAFFIC_NUMBER = 26;
+        QUEUE_LENGTH_AVG = 27;
+        QUEUE_LENGTH_QUANTILE = 28;
+        DELAY_200_300 = 29;
+        DELAY_300_500 = 30;
+        DELAY_500_800 = 31;
+        STOP_COUNT = 32;
+        CAR_COUNT_WHEN_GREEN = 33;
+        CAR_TRANS_COUNT_WHEN_GREEN = 34;
+        OVER_FLOW_FORECAST = 35;
+        OCCUPANCY_RATE_OF_UP_STREAM_LANE = 36;
+        AVG_VELOCITY_OF_UP_STREAM_LANE = 37;
+      DICI_QUEUE_INDEX = 38;
+      DICI_QUEUE_LENGTH = 39;
+      ZONE_TRAFFIC_JAM = 40; // 区域拥堵系数指标
+      SHOOT_TRAJECTORY_NUM = 41;
+      SHOOT_TRAJECTORY_STOP_NUM = 42;
+      OVER_FLOW_OCCUR = 43; // 确实发生溢流
+      OVER_FLOW_TIME = 44; // 溢流时间
+      CAR_COUNT_THIRTY_SECOND = 45;
+      CAR_TRANS_COUNT_THIRTY_SECOND = 46;
+      OVER_FLOW_LEVEL = 47;
+      FULL_CLASS_FLOW_LEVEL = 48 ; //类饱和度
+      CYCLE_LENGTH = 49; // 周期时长
+
+      CAR_COUNT = 50;  // 5秒类排队 自然数
+      CAR_TRANS_COUNT = 51;  // 5秒类排队 当量数
+
+      OVER_FLOW_GRID_LOCK = 52; //溢流死锁
+      HEAD_TIME_DIFF_TIME = 53; //车辆经过停止线时间
+
+      //  STOP_COUNT 停车次数原来就有以下无
+      CONGEST_INDEX = 2001; //  拥堵指数
+      CONGEST_LENGTH = 2002; //  拥堵,拥堵里程
+      CONGEST_LENGTH4 = 2003; // 严重拥堵,拥堵里程
+      CONGEST_LENGTH3 = 2004; // 拥堵,拥堵里程
+      CONGEST_LENGTH2 = 2005; // 缓行,拥堵里程
+      CONGEST_LENGTH234 = 2006; // 进口道连续拥堵长度,全部拥堵长度
+      CONGEST_LENGTH34 = 2007; // 进口道连续拥堵长度,严重拥堵长度
+      UNCONGEST_LENGTH = 2008; // 起始线未拥堵长度
+        AVG_TIME = 2009; // 车均行程时间
+        AVG_SPEED = 2010; // 平均速度
+        CHANGTONG_SPEED = 2011; // 畅通速度
+        DT200 = 2012; // 车均延误200
+        DT300 = 2013; // 车均延误300
+        DT500 = 2014; // 车均延误500
+      DT800 = 2015; // 车均延误800
+      DTALL = 2016; // 总车均延误
+      STOP_DISTANCE = 2018; // 停车距离
+      MAX_STOP_DISTANCE = 2019; // 停车距离
+      MIN_STOP_DISTANCE = 2020; // 停车距离
+      QUANTILE_STOP_DISTANCE = 2021; // 停车距离
+      AVG_DT_ALL = 2022; // avg_dt_all车均延误
+      AVG_STOP_COUNT = 2023; // 干线平均停车率
+      TRAJ_COUNT = 2024; // 计算指标用到的轨迹数目
+      PED_CROSS_STREET = 2025; //行人過街
+      BICYCLE_CROSS_STREET = 2026; //非机动车過街
+      LANE_OCCUPATION_RATIO = 2027; //车道占有率
+      WIDEN_LANE_OCCUPATION_RATIO = 2028; //变宽车道占有率
+
+      DIAGNOSE_INDEX = 3000; //诊断
+    }
+
+    // 这是一个tag，用来表示此traffic_info中有哪些指标，可以用这个来知道一共包含了几个指标，分别处理。
+    repeated TrafficStatausType traffic_status_type = 300;
+    optional double detector = 301;
+    // 通行时间
+    optional double pass_time = 302;
+    // 通行速度
+    optional double pass_velocity = 303;
+    // 延迟
+    optional double delay = 304;
+    // 自由流速度
+    optional double free_velocity = 305;
+    // 停车导致的延迟
+    optional double stop_delay = 306;
+    // 停车次数
+    optional double stop_times = 307;
+    // 排队长度
+    optional double queue_length = 308;
