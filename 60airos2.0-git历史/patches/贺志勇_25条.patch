+void OM_RADAR_COMPONENT::mqttDispatchSubscripeMessageProto(std::string topic, void* data, int size)
+{
+    for(auto it = m_MqttClientConfig.topicUnMapCCIndex.begin(); it != m_MqttClientConfig.topicUnMapCCIndex.end(); ++it)
+    {
+		const MqttTopicConfigerCCIndex& mqttTopicConfigerCCIndex = it->second;
+		if(topic != mqttTopicConfigerCCIndex.Topic_Tc
+				|| m_MqttClientConfig.configerEnableCCIndex.Enable_Tc)
+		{
+			OM_RADAR_ERROR_PRINT << "topic error or Enable_PT_Mec2Clound_Tc enable false";
+		}
+
+		adu::st::TrafficInfos tis;
+		if(!tis.ParseFromArray(data, size))
+		{
+			OM_RADAR_ERROR_PRINT << "Recv radar Tc msg but proto parse fail";
+			return;
+		}
+
+		for(int i = 0; i < tis.traffic_info_size(); i++)
+		{
+			auto temp_info = tis.traffic_info().Get(i);
+			if(!temp_info.has_cross_id() || !temp_info.has_branch_id() || !temp_info.has_space_type())
+			{
+				continue;
+			}
+
