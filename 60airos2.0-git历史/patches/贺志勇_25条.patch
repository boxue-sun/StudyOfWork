+bool OM_RADAR_COMPONENT::udpInit()
+{
+	m_Udpfd = socket(AF_INET, SOCK_DGRAM, 0);
+	if(m_Udpfd < 0)
+	{
+		OM_RADAR_ERROR_PRINT << "Create socket error! reason:" << strerror(errno);
+		return false;
+	}
+
+	struct sockaddr_in addr;
+	addr.sin_family = AF_INET;
+	addr.sin_addr.s_addr = inet_addr("0.0.0.0");
+	addr.sin_port = htons(50500);
+
+	if(bind(m_Udpfd, (struct sockaddr*)&addr, sizeof(addr)) < 0)
+	{
+		OM_RADAR_ERROR_PRINT << "Socket bind error! reason %s", strerror(errno);
+		return false;
+	}
+
+	m_UdpChnl.reset(new afl::net::Channel(m_Eventloop.get(), m_Udpfd));
+	m_UdpChnl->setReadCallback(std::bind(&OM_RADAR_COMPONENT::readUdpData, this) );
+	m_UdpChnl->enableReading();
+
+	return true;
+}
+
+void OM_RADAR_COMPONENT::readUdpData()
+{
+    ssize_t recv_len = 0;
+    struct sockaddr_in recv_addr;
+    socklen_t sock_len;
+    sock_len = sizeof(recv_addr);
+    recv_len = recvfrom(m_Udpfd, m_UdpBuffer->beginWrite(), m_UdpBuffer->writableBytes(), 0, (struct sockaddr *) &recv_addr, &sock_len);
+
+    if (recv_len < 48)
+    {
+		OM_RADAR_ERROR_PRINT << "recv udp data len error:%d(must > 48)!", recv_len;
+        return;
+    }
+    m_UdpBuffer->hasWritten(recv_len);
+
+    uint16_t type = uint16_t(*(m_UdpBuffer->peek() + 26)) | uint16_t(*(m_UdpBuffer->peek() + 27) << 8);
+    if(type != 0x0103)
+    {
+		OM_RADAR_ERROR_PRINT << "recv udp data type error:%02x(must be 0x0103)!", type;
+		m_UdpBuffer->retrieveAll();
+    	return;
+    }
+
+    uint8_t entrance_cnt = *(m_UdpBuffer->peek() + 44);
+
+    int offset = 45;
+    uint8_t light_cnt = 0;
+//    uint8_t light_type = 0;
+    uint8_t light_color = 0;
+    uint8_t light_countdown = 0;
+    uint8_t light_id = 0;
+
+    adu::st::TrafficInfos tis;
+	tis.mutable_traffic_info();
+
+    for(uint8_t i = 0; i < entrance_cnt; i++)
+    {
+		if((offset + 3) >= recv_len)
+		{
+			OM_RADAR_ERROR_PRINT << "curr period error, frame data len illegal.";
+			m_UdpBuffer->retrieveAll();
+			return;
+		}
+		light_cnt = *(m_UdpBuffer->peek() + offset + 2);
+		offset += 3;
+
+		for(uint8_t j = 0; j < light_cnt; j++)
+		{
+			if ((offset + 4) >= recv_len)
+			{
+				OM_RADAR_ERROR_PRINT << "curr period error, frame data len illegal.";
+				m_UdpBuffer->retrieveAll();
+				return;
+			}
+			light_id = *(m_UdpBuffer->peek() + offset);
+	//		light_type  = *(m_udpbuffer->peek() + offset + 1);
+			light_color = *(m_UdpBuffer->peek() + offset + 2);// 0-关灯 1-红 2-黄 3-绿  11-红闪 12-黄闪 13-绿闪
+			light_color = CovertGatLightColor(light_color);
+			if(light_color == 0)
+			{
+				OM_RADAR_ERROR_PRINT << "light state invalid, light_id= %d color is zero.", light_id;
+			}
+			light_countdown = *(m_UdpBuffer->peek() + offset + 3);
+
+			bool is2green = (((light_color == 1) || (light_color == 11)) && light_countdown == 1);//绿灯启亮
+			bool is2red = (((light_color == 2) || (light_color == 12)) && light_countdown == 1);//红灯启亮
+
+			if(m_LaneOrFlowPhaseIdMap.find(light_id) != m_LaneOrFlowPhaseIdMap.end()
+					&& m_RecvCreditControlInfo_spatcycle_levelMap.find(m_LaneOrFlowPhaseIdMap[light_id]) != m_RecvCreditControlInfo_spatcycle_levelMap.end()
+					&& (is2green || is2red))
+			{
+				auto tempInfo = m_RecvCreditControlInfo_spatcycle_levelMap[m_LaneOrFlowPhaseIdMap[light_id]];
+				uint64_t nowtime = afl::util::TimeStamp::now(true).millSeconds();
+				if(nowtime - tempInfo.updatetime < 2000)//雷达上报信控数据频率为1hz，不处理超过2s的数据
+				{
+					auto ti = tis.add_traffic_info();
+					ti->set_cross_id(tempInfo.crossid);
+					ti->set_branch_id(tempInfo.branchid);
+
+					if(tempInfo.islanelevel)//车道级：绿灯启亮or红灯启亮
+					{
+						ti->set_lane_id(tempInfo.laneid);
+						if(is2red)
+						{
+							ti->set_car_count_when_green(tempInfo.queuecount);
+							ti->set_car_trans_count_when_green(tempInfo.queuetranscount);
+						}
+						else
+						{
+							ti->set_car_count_when_red(tempInfo.queuecount);
+							ti->set_car_trans_count_when_red(tempInfo.queuetranscount);
+						}
+
+					}
+					else if(is2red)//流向级：绿灯启亮
+					{
+						ti->mutable_flow_to_type();
+						ti->add_flow_to_type(adu::st::TrafficInfo_FlowToType(tempInfo.flowtotype));
+						ti->set_car_count_when_green(tempInfo.queuecount);
+						ti->set_car_trans_count_when_green(tempInfo.queuetranscount);
+						ti->set_queue_length(tempInfo.queuelength);
+					}
+				}
+			}
+			offset += 4;
+		}
+    }
+
+    if(tis.traffic_info_size() > 0)
+    {
+    	std::string trafficinfos = tis.SerializeAsString();
+
+        auto cloud_data = std::make_shared<os::v2x::device::CloudData>();
+        auto mqtt_data  = cloud_data->mutable_mqtt_data();
+        mqtt_data->set_topic(m_MqttClientConfig.configerTopicCCIndex.Topic_Tc);
+
+        mqtt_data->set_data(trafficinfos.data(), trafficinfos.size());
+        OM_RADAR_ERROR_PRINT << "msg:" << cloud_data->DebugString();
+        Send("/v2x/cloud/report/mqtt", cloud_data);
+    }
+
+    m_UdpBuffer->retrieveAll();
+}
+
+uint8_t OM_RADAR_COMPONENT::CovertGatLightColor(uint8_t gat_light_color)
+{
+  uint8_t std_light_color = 0;
+  if (gat_light_color & 0x2) {  // red
+    if ((gat_light_color & 0x3) == 0x2) {
+      std_light_color = 1;
+    } else {
+      std_light_color = 11;
+    }
+  } else if ((gat_light_color >> 2) & 0x2) {  // yellow
+    if (((gat_light_color >> 2) & 0x3) == 0x2) {
+      std_light_color = 2;
+    } else {
+      std_light_color = 12;
+    }
+  } else if ((gat_light_color >> 4) & 0x2) {  // green
+    if (((gat_light_color >> 4) & 0x3) == 0x2) {
+      std_light_color = 3;
+    } else {
+      std_light_color = 13;
+    }
+  }
+
+  return std_light_color;
+}
