+bool CooperationLaneChange::isEmergencyVeh(int type)
+{
+	bool isEmerge = false;
+	switch(type)
+	{
+	case 60:
+		isEmerge = true;
+		break;
+	default:
+		break;
+	}
+
+	return isEmerge;
