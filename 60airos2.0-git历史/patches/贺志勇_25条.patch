+  optional double avg_dt_all = 2022; // avg_dt_all车均延误
+  optional double avg_stop_count = 2023; // 干线平均停车率
+  optional double traj_count = 2024; // 计算指标用到的轨迹数目
+  optional string diagnose_index = 3000;
+  optional Diagnose diagnose = 3001;
+}
+
+
+message Diagnose{
+  repeated int32 diagnose_index = 1;
+  repeated double confidence = 2;
+  optional string remark = 3;
+  repeated DiagnoseFeature diagnose_feature = 4;
+  optional string cross = 5;
+  optional string stime = 6;
+  optional string etime = 7;
+  optional string type = 8;
+}
+
+message DiagnoseFeature {
+  optional string flow = 1; // 流向文本
+  optional double fflc = 2; // 类饱和度值
+  optional double ffl = 3; // 饱和度
+  optional double ccrbCt = 6;  // 红启排队车辆数>=8辆 流向或车道个数
+  optional double ccrlCt = 7; // 红启排队车辆数>1辆 流向或车道个数
+  optional double fflcblCt = 8; // 连续
+  optional double allCt = 9; // 所有参与计算个数
+  optional double clbCt = 10; // 轨迹连续拥堵长度>200m
+  optional double clnCt = 11; // 轨迹连续拥堵长度<200m && >100m
+  optional double cllCt = 12; // 轨迹连续拥堵长度<100m
+  optional double ullCt = 13; // 出口连续未拥堵长度
+}
+
+// 多个traffic_info打包成TrafficInfos
+message TrafficInfos {
+  repeated TrafficInfo traffic_info = 1;
+}
