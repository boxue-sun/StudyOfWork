```cpp
avformat_open_input(&ctx, url, nullptr, nullptr)  // ① 打开 RTSP 连接
avformat_find_stream_info(ctx, nullptr)           // ② 拉取流信息
for (i in ctx->nb_streams)                        // ③ 找到视频流
